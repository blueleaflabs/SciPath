---
import { activeOrg } from '../lib/tenant';
import { originForOrg } from '../lib/deployment';
import { themeFonts } from '../config/fonts';
import Masthead from '../components/Masthead.astro';
import Footer from '../components/Footer.astro';
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/ui.css';

interface Props {
  title: string;
  description?: string;
  /** Kept out of search results. Used by anything holding a bearer token. */
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;

/* Hostname on an on-demand route, PUBLIC_ORG on a prerendered one. */
const org = activeOrg(Astro);

const pageTitle = `${title} · ${org.name}`;
/**
 * THE CANONICAL ADDRESS, WHICH IS NOT THE PATH THIS RENDERED AT.
 *
 * Two things were wrong with the one line this replaces.
 *
 * The origin was a constant naming a host the site no longer answers on, and
 * it was one origin for four tenants, so every school declared the same
 * canonical address for the same path and asked a crawler to keep one of
 * them. That is `originForOrg`.
 *
 * And the path is the build path. A public page is prerendered once per
 * tenant at `/{slug}/about/`, and the middleware pushes the slug on at
 * request time so nobody ever sees it — but the page has already been
 * written, with the slug in its own canonical tag, pointing at an address
 * that answers nothing. A tag naming a URL that 404s is worse than no tag.
 *
 * Only this tenant's own slug is stripped, never any tenant's. A platform
 * address whose first segment happens to match some other school's slug is
 * still a real address, and stripping against the whole set rather than
 * against the one would take it apart.
 */
const slugPrefix = `/${org.slug}`;
const path =
  Astro.url.pathname === slugPrefix
    ? '/'
    : Astro.url.pathname.startsWith(`${slugPrefix}/`)
      ? Astro.url.pathname.slice(slugPrefix.length)
      : Astro.url.pathname;

const canonical = new URL(path, originForOrg(org)).href;
const fontHref = themeFonts[org.theme];
---

<!doctype html>
<html lang="en" data-theme={org.theme} data-school={org.slug}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={org.name} />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />

    <link rel="alternate" type="application/rss+xml" title={org.name} href="/feed.xml" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href={fontHref} rel="stylesheet" />

    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Masthead org={org} />
    <main id="main">
      <slot />
    </main>
    <Footer org={org} />
  </body>
</html>
