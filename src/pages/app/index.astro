---
export const prerender = false;

import Base from '../../layouts/Base.astro';
import { formatDate } from '../../lib/dates';
import AppShell from '../../components/AppShell.astro';
import { activeOrg } from '../../lib/tenant';
import { programTitle, programKind, participationVerb, staffWord } from '../../lib/program-names';
import { serverClient } from '../../lib/supabase';
import { standing, roleLabel } from '../../lib/roles';
import { checkDateOrder, worstFinding } from '../../lib/dateOrder';
import { assess, tally } from '../../lib/attention';
import { afterPost, outcomeFrom, leaveTo } from '../../lib/post-redirect';
import { safeNext, HOME } from '../../lib/next-path';

const { configured, session, account, roles } = Astro.locals;
const org = activeOrg(Astro);

/* Where they were headed before being asked to sign in. Kept through the
   form and through Google's round trip. */
const next = safeNext(Astro.url.searchParams.get('next'));
/* Ours, not the provider's. See the comment in middleware.ts: sharing the
   `error` parameter with Supabase produced a redirect loop. */
const signin = Astro.url.searchParams.get('signin');

if (configured && session && !account) return Astro.redirect('/app/welcome/');

const me = standing(roles, account?.population);
const today = new Date().toISOString().slice(0, 10);

const supabase = account
  ? serverClient(Astro.request, Astro.cookies, (Astro.locals as any).runtime?.env)
  : null;

/* Seeded from the redirect a POST answers with. `cleared` was a count that
   could not survive one, so it became the sentence it was rendered as. See
   src/lib/post-redirect.ts. */
let { error: error2, note: attached } = outcomeFrom(Astro.url);

/**
 * Two different people post to this page, and the guard is per action.
 *
 * Joining a program is a student's, attaching somebody to a project is the
 * club's, and the whole handler used to sit behind `me.runsTheClub` — so a
 * student's join would have been dropped without a word. The action is also
 * explicit on every branch now: attaching was the `else`, and a form that
 * forgot its action fell into it.
 */
if (Astro.request.method === 'POST' && supabase) {
  const form = await Astro.request.formData();
  const action = String(form.get('action') ?? '');

  /* Joining a cohort. A person enrolls, and no project is invented in order
     to have somewhere to put the enrolment (22.1). */
  /* Starting a project.
  
     There was no way to do this at all: `start_entry` made one as a side
     effect of entering something, and separating the two (22.1) left a
     student who had joined a class with nothing to click. A project exists
     because somebody started work, so this is its own act. */
  /* Putting an existing project into a cohort somebody has been admitted
     to. The same act as the picker on the project page, offered where a
     student is when they are told they are in (22.5). */
  if (action === 'attach_cohort') {
    const { error: e } = await supabase.rpc('set_project_cohort', {
      p_project_id: String(form.get('project_id') ?? ''),
      p_cohort_id: String(form.get('cohort_id') ?? ''),
      p_in: true,
    });

    if (e) error2 = e.message;
    else return leaveTo(`/app/project/${String(form.get('project_id') ?? '')}/`);
  } else if (action === 'start_project') {
    const title = String(form.get('title') ?? '').trim();

    if (!title) {
      error2 = 'Give the project a working title. You can change it later.';
    } else {
      const { data: projectId, error: e } = await supabase.rpc('start_project', {
        p_title: title,
        p_started_on: String(form.get('started_on') ?? '') || null,
        p_cohort_id: String(form.get('cohort_id') ?? '') || null,
      });

      if (e) error2 = e.message;
      else return leaveTo(`/app/project/${projectId}/`);
    }
  } else if (action === 'join_cohort') {
    const { error: e } = await supabase.rpc('join_cohort', {
      p_cohort_id: String(form.get('program_id') ?? ''),
    });

    if (e) error2 = e.message;
    else {
      /* What happens next, in the order it happens. A request that says "you
         are in" when a teacher has not decided is telling somebody something
         untrue. */
      /* Named, because a student asking to join three things in a row gets
         three identical confirmations otherwise and cannot tell which one
         this was. */
      const { data: program } = await supabase
        .from('programs')
        .select('joining, name')
        .eq('id', String(form.get('program_id') ?? ''))
        .maybeSingle();

      const what = program?.name ?? 'it';

      attached =
        program?.joining === 'approval'
          ? `Request to join ${what} sent. You can start a project while you wait for approval.`
          : `You are in ${what}. Start a project when you are ready.`;
    }
  } else if (action === 'join') {
    const title = String(form.get('title') ?? '').trim();

    if (!title) {
      error2 = 'Give the project a working title. You can change it later.';
    } else {
      const { data: entryId, error: e } = await supabase.rpc('start_entry', {
        p_program_id: String(form.get('program_id') ?? ''),
        p_title: title,
        p_started_on: String(form.get('started_on') ?? '') || null,
      });

      if (e) error2 = e.message;
      /* The top of their new project, not wherever the last outcome was.
         See leaveTo. */
      else return leaveTo(`/app/entry/${entryId}/`);
    }
  } else if (action === 'enter_existing') {
    /* **Research you are already doing, taken somewhere.**
    
       The card had one form and it called `start_entry`, which makes a
       project — so a student entering the fair with the work they had been
       doing since August got a second, empty project with the same title and
       none of the notebook. Nothing prevented it and nothing said so.
    
       No new function was needed for this. `enter_program` is the one path
       that attaches a project to an opportunity, and `start_entry` calls it
       too, having made the project first. So the difference between the two
       routes is exactly the thing that differs: whether there is already a
       project.
    
       No title, because it has one. No start date, because it has one or has
       deliberately been left without one, and a fair entry form is not where
       that gets rewritten: `checkDateOrder` reads that date against the
       sponsor's signature, and "work began before a sponsor agreed" ends
       seasons. */
    const projectId = String(form.get('project_id') ?? '');

    if (!projectId) {
      error2 = 'Choose which research you are entering.';
    } else {
      const { data: entryId, error: e } = await supabase.rpc('enter_program', {
        p_project_id: projectId,
        p_program_id: String(form.get('program_id') ?? ''),
      });

      if (e) error2 = e.message;
      else return leaveTo(`/app/entry/${entryId}/`);
    }
  } else if (!me.runsTheClub) {
    error2 = 'Only an officer or your advisor can do that.';
    /* A `detach` branch stood here and no form on this page posted to it —
       left behind when removing somebody moved to the team page, where the
       row being removed is visible. It called `detach_from_project` with a
       project, which no longer exists as a signature: oversight names a
       place now. Dead code that would not compile against its own function
       is worse than dead code, so it is gone rather than updated. */
  } else if (action === 'select') {
    /* Which projects a school puts forward. The advisor's, and the function
       says so too; this only decides whether the control is offered. */
    if (!me.isAdvisor) {
      error2 = 'Only your advisor decides which projects go forward.';
    } else {
      const { error: e } = await supabase.rpc('set_selection', {
        p_participation_id: String(form.get('participation_id') ?? ''),
        p_state: String(form.get('state') ?? 'candidate'),
        p_note: String(form.get('note') ?? '') || null,
      });
      if (e) error2 = e.message;
    }
  } else if (action === 'attach') {
    const { data, error: e } = await supabase.rpc('attach_to_project', {
      p_project_id: String(form.get('project_id') ?? ''),
      p_user_id: String(form.get('user_id') ?? ''),
      p_role: String(form.get('role') ?? 'mentor'),
      p_dated: String(form.get('dated') ?? '') || null,
    });
    if (e) {
      error2 = e.message;
    } else {
      const n = data ?? 0;
      attached = `Attached. ${n} approval obligation${n === 1 ? '' : 's'} cleared.`;
    }
  }

  /* A refresh should re-read this page, not send the form again. */
  return afterPost(Astro.url, { error: error2, note: attached });
}

/* --- What a student sees: their own entries -------------------------- */
let myEntries: any[] = [];
let myReviews: any[] = [];
let myManuscripts = new Set<string>();

/* --- What everyone else sees: the projects they are responsible for --- */
let watched: any[] = [];
let staffPeople: any[] = [];

if (supabase && account) {
  if (me.isStudent || !me.runsTheClub) {
    /* Scoped by authorship. The policy lets an officer read every entry at
       the school, which is right for the club table below and wrong for a
       section headed "this season". */
    const { data: authored } = await supabase
      .from('project_authors')
      .select('project_id')
      .eq('user_id', account.id)
      .eq('role', 'author');

    const myProjectIds = (authored ?? []).map((a: any) => a.project_id);

    /**
     * The projects, and where each of them went.
     *
     * **Read from projects, not from entries.** This listed entries, so a
     * project that had not been submitted anywhere did not exist to it: a
     * student who started work and joined a class saw *nothing yet this
     * season* while looking at their own project's page in another tab.
     *
     * That was the conflation surviving in a query. Work exists because
     * somebody started it, and entering it somewhere is a later and optional
     * thing (22.1). A project with no entry is the ordinary state of every
     * project for its first month.
     */
    const { data: mineProjects } = myProjectIds.length
      ? await supabase
          .from('projects')
          .select('id, title, created_at')
          .in('id', myProjectIds)
          .is('archived_at', null)
          .order('created_at', { ascending: false })
      : { data: [] as any[] };

    const { data: theirEntries } = myProjectIds.length
      ? await supabase
          .from('opportunity_participations')
          .select('id, status, placement, program_id, project_id, programs:program_id(name, season_year, fair_date, kind, roles)')
          .in('project_id', myProjectIds)
          .order('entered_at', { ascending: false })
      : { data: [] as any[] };

    /* The classes and clubs these projects are in, which is a separate
       question from what they have been entered in. Before the merge a
       cohort had no participation row to read, so this line could not be
       written and the list below said "not entered anywhere yet" to a
       student whose project was sitting in IRPD. */
    const { data: theirCohorts } = myProjectIds.length
      ? await supabase
          .from('cohort_participations')
          .select('id, program_id, project_id, programs:program_id(name, season_year, kind, roles)')
          .in('project_id', myProjectIds)
      : { data: [] as any[] };

    const entriesFor = new Map<string, any[]>();
    for (const e of theirEntries ?? []) {
      entriesFor.set(e.project_id, [...(entriesFor.get(e.project_id) ?? []), e]);
    }

    const cohortsFor = new Map<string, any[]>();
    for (const c of theirCohorts ?? []) {
      cohortsFor.set(c.project_id, [...(cohortsFor.get(c.project_id) ?? []), c]);
    }

    /* One row per project, carrying whatever it has been entered in. A
       project entered nowhere still gets a row, which is the fix. */
    myEntries = (mineProjects ?? []).map((project: any) => ({
      project,
      entries: entriesFor.get(project.id) ?? [],
      cohorts: cohortsFor.get(project.id) ?? [],
    }));

    /* Which of these already have a manuscript, so the link can say "start"
       or "open" rather than making somebody click to find out. */
    const { data: started } = myProjectIds.length
      ? await supabase.from('manuscripts').select('project_id').in('project_id', myProjectIds)
      : { data: [] as any[] };

    myManuscripts = new Set((started ?? []).map((m: any) => m.project_id));

    /* Reviewing is an attachment rather than a standing role, so it appears
       nowhere in the nav. If it did not appear here it would appear nowhere
       at all, which is exactly how an assignment sits untouched until the
       week of the fair. */
    const { data: assigned } = await supabase
      .from('reviews')
      .select('id, due_at, submitted_at, submissions(manuscripts(title))')
      .is('submitted_at', null)
      .order('due_at', { ascending: true });

    myReviews = assigned ?? [];
  }
}

/* --- What is open to join ------------------------------------------------
 *
 * This was its own page, listing the same entries as the section above it
 * with a different row. Two pages holding one list is the sprawl this pass
 * exists to remove, so the joining half moved here and the page it came
 * from redirects.
 */
let joinable: any[] = [];
let enteredIn = new Set<string>();

/**
 * Why a program cannot be entered yet, if it cannot.
 *
 * The same function `enter_program` and `start_entry` call, so a form drawn
 * here is a form that will be accepted. Drawing the door and refusing at it
 * is worse than not drawing it: the student has already decided to go
 * through by the time anybody tells them.
 */
let gateFor = new Map<string, string>();
let entryFor = new Map<string, string>();

/* Cohorts this person is in or waiting on, so a card can say which. Asking
   twice does nothing and reads as though the first request vanished. */
let cohortState = new Map<string, string>();

/* And who decided it, when, and what they said. A refusal that names nobody
   is a refusal nobody can respond to. */
let cohortDecider = new Map<string, string>();
let cohortDecidedOn = new Map<string, string>();
let cohortJoinedOn = new Map<string, string>();
let cohortNote = new Map<string, string>();

/* Cohorts this person is actually in, for the picker when starting a
   project. A pending request is not one of them. */
let myMemberships: any[] = [];

/* This person's projects, and which cohorts each is already in, so a card
   can offer the ones that are not. */
let myProjects: any[] = [];
let projectCohorts = new Map<string, Set<string>>();

/* And which opportunities each is already entered in, plus, per opportunity,
   the title of the project already holding this student's place. */
let projectEntries = new Map<string, Set<string>>();
let holdsPlace = new Map<string, string>();

const myProjectsForCohort = (cohortId: string) =>
  myProjects.filter((p: any) => !(projectCohorts.get(p.id) ?? new Set()).has(cohortId));

/**
 * The projects this person could enter in an opportunity, right now.
 *
 * Empty for two different reasons, and the card distinguishes them: nothing
 * to offer because everything is already in, and nothing offerable because
 * one of their projects is already competing here. `holdsPlace` answers the
 * second, and a card with an answer there says so instead of drawing a
 * picker the server would refuse.
 */
const myProjectsForOpportunity = (programId: string) =>
  holdsPlace.has(programId)
    ? []
    : myProjects.filter((p: any) => !(projectEntries.get(p.id) ?? new Set()).has(programId));

if (supabase && account) {
  const { data: open } = await supabase
    .from('programs')
    .select('id, name, season_year, fair_date, description, website_url, advances_to_fairs, status, kind, level, joining, places, program_role')
    .eq('status', 'open')
    .order('fair_date', { ascending: true });

  joinable = open ?? [];


  const { data: mine } = await supabase
    .from('memberships')
    .select('cohort_id, state, note, joined_at, decided_at, decided:decided_by(display_name)')
    .eq('user_id', account.id);

  for (const m of mine ?? []) {
    cohortState.set(m.cohort_id, m.state);
    /* Who decided, so a refusal names somebody a student can go and ask.
       The column has been recorded since the table was written; nothing had
       ever read it back. */
    const who = (m as any).decided?.display_name;
    if (who) cohortDecider.set(m.cohort_id, who);

    /* When they got in. `decided_at` is the day somebody approved it and is
       null for a cohort anybody may join, so `joined_at` is the fallback and
       the sentence below says which of the two happened. */
    const on = (m as any).decided_at ?? (m as any).joined_at;
    if (on) cohortJoinedOn.set(m.cohort_id, formatDate(on, 'long'));
    if ((m as any).decided_at) {
      cohortDecidedOn.set(m.cohort_id, formatDate((m as any).decided_at, 'short'));
    }
    if ((m as any).note) cohortNote.set(m.cohort_id, (m as any).note);
  }

  /* Newest first, because the picker below defaults to the first of these.
  
     A student who has just been let into a class and has no project yet is,
     almost always, about to start that class's project -- so the answer they
     were about to give is the one that should already be selected. Where
     somebody is in two, the one they were most recently admitted to is the
     better guess than whichever the database happened to return first.
  
     `decided_at` is null for a cohort that admits without approval, so
     `joined_at` is the fallback and the sort is stable either way. */
  const { data: joined } = await supabase
    .from('memberships')
    .select('cohort_id, decided_at, joined_at, programs:cohort_id(name, season_year, kind, program_role)')
    .eq('user_id', account.id)
    .eq('state', 'member')
    .order('decided_at', { ascending: false, nullsFirst: false })
    .order('joined_at', { ascending: false });

  myMemberships = joined ?? [];

  const { data: authored } = await supabase
    .from('project_authors')
    .select('project_id, projects(id, title)')
    .eq('user_id', account.id)
    .eq('role', 'author');

  myProjects = (authored ?? []).map((a: any) => a.projects).filter(Boolean);

  if (myProjects.length > 0) {
    const { data: attached } = await supabase
      .from('cohort_participations')
      .select('project_id, program_id')
      .in('project_id', myProjects.map((p: any) => p.id));

    for (const row of attached ?? []) {
      const held = projectCohorts.get(row.project_id) ?? new Set<string>();
      held.add(row.program_id);
      projectCohorts.set(row.project_id, held);
    }

    /* **Where this person's work already is, so a card offers only what the
       server would accept.**
    
       Two different refusals live in here and they need different sentences.
       A project already entered in this fair is simply not offered again. A
       project entered in this fair by *this student* means no other project
       of theirs may be entered at all -- `app.entry_conflict` refuses a
       second one, because two projects from one student compete against each
       other for one place -- and the card has to say which project holds it
       rather than presenting a picker that cannot succeed.
    
       `withdrawn` is excluded on purpose: withdrawing is how a place is given
       back, and the trigger reads it the same way. */
    const { data: entered } = await supabase
      .from('opportunity_participations')
      .select('project_id, program_id, status, projects:project_id(title)')
      .in('project_id', myProjects.map((p: any) => p.id))
      .neq('status', 'withdrawn');

    for (const row of entered ?? []) {
      const held = projectEntries.get(row.project_id) ?? new Set<string>();
      held.add(row.program_id);
      projectEntries.set(row.project_id, held);
      holdsPlace.set(row.program_id, (row as any).projects?.title ?? 'another project');
    }
  }

  const { data: gates } = await supabase.rpc('entry_gates');
  for (const g of gates ?? []) gateFor.set(g.program_id, g.reason);

  /* A program already entered shows the way in rather than the form.
   *
   * `myEntries` is one row per *project*, each carrying its entries -- so
   * `e.program_id` was undefined on every pass and `enteredIn` only ever
   * collected `undefined`. Every program therefore kept offering its entry
   * form to somebody who had already entered it. This predates the merge;
   * it is fixed here because the loop had to be read anyway.
   */
  for (const group of myEntries) {
    for (const entry of group.entries) {
      enteredIn.add(entry.program_id);
      entryFor.set(entry.program_id, entry.id);
    }
  }
}

/* --- What everyone else sees: the projects they are responsible for --- */
if (supabase && account) {
  if (me.runsTheClub) {
    /* Every project at the school. Row level security decides who may run
       this at all; the heading says so, unlike the section above. */
    const { data: projects } = await supabase
      .from('projects')
      .select('id, title, started_on, project_authors(role, participation_id, self_managed_at, users(id, display_name, grad_year))')
      .is('archived_at', null)
      .order('created_at', { ascending: false });

    const ids = (projects ?? []).map((p: any) => p.id);

    /* Per participation, not per project.
    
       This picked one entry per project with `.find`, which is arbitrary the
       moment a project is in two programs — and it is the reason the table
       could not be grouped by program or carry a selection state, both of
       which belong to a participation rather than to the work. */
    const { data: entries } = ids.length
      ? await supabase
          .from('opportunity_participations')
          .select('id, project_id, status, selection_state, selection_decided_at, programs:program_id(id, name, season_year, fair_date, kind, roles, selection_cap)')
          .in('project_id', ids)
          .in('status', ['entered', 'competed'])
      : { data: [] as any[] };

    const { data: sponsorRows } = ids.length
      ? await supabase
          .from('project_sponsors')
          .select('teacher_name, participations!inner(project_id)')
          .in('participations.project_id', ids)
          .is('superseded_at', null)
      : { data: [] as any[] };

    const entryIds = (entries ?? []).map((e: any) => e.id);

    const { data: milestones } = entryIds.length
      ? await supabase
          .from('entry_milestones')
          .select('id, participation_id, name, kind, due_on, required, blocks_experimentation, completed_on')
          .in('participation_id', entryIds)
      : { data: [] as any[] };

    /* One row per participation, and a project in no program still gets a
       row, because a project nobody has entered anywhere is exactly the one
       an advisor should see. */
    const pairs = (projects ?? []).flatMap((p: any) => {
      const its = (entries ?? []).filter((e: any) => e.project_id === p.id);
      return its.length ? its.map((entry: any) => ({ p, entry })) : [{ p, entry: null }];
    });

    watched = pairs.map(({ p, entry }: any) => {
      const mine = (milestones ?? []).filter((m: any) => m.participation_id === entry?.id);

      const findings = checkDateOrder({
        startedOn: p.started_on,
        today,
        obligations: mine.map((m: any) => ({
          id: m.id,
          name: m.name,
          dueOn: m.due_on,
          completedOn: m.completed_on,
          blocksExperimentation: m.blocks_experimentation,
          required: m.required,
        })),
      });

      const officers = (p.project_authors ?? []).filter((a: any) => a.role === 'officer');
      const selfManaged = (p.project_authors ?? []).filter(
        (a: any) => a.role === 'officer' && a.self_managed_at
      );
      const sponsor = (sponsorRows ?? []).find((s: any) => s.participations?.project_id === p.id) ?? null;
      const worst = worstFinding(findings);

      return {
        ...p,
        entry,
        authors: (p.project_authors ?? []).filter((a: any) => a.role === 'author'),
        officers,
        selfManaged,
        sponsor,
        done: mine.filter((m: any) => m.completed_on).length,
        total: mine.length,

        /* Where the project is: the next thing not done, by date. Undated
           steps sort last, because a step nobody has scheduled is not the
           next thing to worry about.
         
           Events are skipped. "Applications open" is a day on the fair's
           calendar rather than something anybody does, and a column of forty
           projects all reading "Applications open" says nothing about any of
           them. */
        next:
          mine
            .filter((m: any) => !m.completed_on && m.kind !== 'event')
            .sort((a: any, b: any) => (a.due_on ?? '9999').localeCompare(b.due_on ?? '9999'))[0] ??
          mine
            .filter((m: any) => !m.completed_on)
            .sort((a: any, b: any) => (a.due_on ?? '9999').localeCompare(b.due_on ?? '9999'))[0] ??
          null,
        worst,
        verdict: assess({
          worst,
          hasOfficer: officers.length > 0 || selfManaged.length > 0,
          hasSponsor: Boolean(sponsor),
          startedOn: p.started_on,
          obligationsDone: mine.filter((m: any) => m.completed_on).length,
          obligationsTotal: mine.length,
        }),
      };
    });

    const { data: rows } = await supabase
      .from('user_roles')
      .select('user_id, role, users:user_id(id, display_name)')
      .is('revoked_at', null)
      .in('role', ['mentor', 'officer']);

    const seen = new Set<string>();
    staffPeople = (rows ?? []).filter((r: any) => {
      if (!r.users?.id || seen.has(r.users.id)) return false;
      seen.add(r.users.id);
      return true;
    });
  }
}

const fmt = (d: string | null) => formatDate(d, 'long', 'To be announced');

/* There was a stageLabel map here, five literals describing a competition's
   lifecycle. Where a project is comes from its steps now: the next one that
   is not done, which is both more accurate and more useful than a bucket
   name, because it says what to do rather than roughly where you are. */

/* An officer sees every project by role and looks after the ones assigned to
   them. Counting the first as "in your care" told Marchetti she was
   responsible for a project nobody had given her. */
const mine = watched.filter((w) =>
  w.officers.some((o: any) => o.users?.id === account?.id) ||
  w.selfManaged.some((o: any) => o.users?.id === account?.id)
);

const counts = tally(watched.map((w) => w.verdict));

/**
 * The oversight table, grouped by program.
 *
 * This and the selection screen were the same list of the same projects with
 * six of seven columns in common, and the seventh — the selection state —
 * is a column rather than a page. So selection moved here and that route
 * redirects.
 *
 * Grouped because the club and the class are not one decision: an advisor
 * putting projects forward to a fair is not choosing which class projects
 * are good, and a cap belongs to a program. Grouping also lets the staff
 * column say the program's own word, which one table could not.
 */
const filter = Astro.url.searchParams.get('show') ?? 'all';

const shown = watched.filter((w) => {
  if (filter === 'no_officer') return w.officers.length === 0 && w.selfManaged.length === 0;
  if (filter === 'no_sponsor') return !w.sponsor;
  if (filter === 'flagged') return w.worst?.severity === 'disqualifying';
  if (filter === 'selected') return w.entry?.selection_state === 'selected';
  return true;
});

const filters = [
  ['all', 'Everything'],
  ['selected', 'Selected'],
  ['no_officer', 'No officer'],
  ['no_sponsor', 'No sponsor'],
  ['flagged', 'Disqualifying'],
];

const groups = (() => {
  const by = new Map<string, { program: any; rows: any[] }>();

  for (const row of shown) {
    const program = row.entry?.programs ?? null;
    /* A project in no program is still somebody's to look after, and it
       groups under its own heading rather than vanishing. */
    const key = program?.id ?? 'none';
    const held = by.get(key) ?? { program, rows: [] };
    held.rows.push(row);
    by.set(key, held);
  }

  return [...by.values()].sort((a, b) => {
    if (!a.program) return 1;
    if (!b.program) return -1;
    return (a.program.name ?? '').localeCompare(b.program.name ?? '');
  });
})();

/* Selected against the cap, per program. Only a competition selects: a class
   has nowhere to put projects forward to, so the column is absent rather
   than empty. */
const selects = (program: any) => program?.kind === 'competition';

function standingOf(group: { program: any; rows: any[] }) {
  const chosen = group.rows.filter((r) => r.entry?.selection_state === 'selected').length;
  const cap = group.program?.selection_cap ?? null;
  if (!selects(group.program)) return `${group.rows.length} in progress`;
  return cap ? `${chosen} of ${cap} selected` : `${chosen} selected`;
}

/* --- Grouped, because a mixed list is read as a mixed list ---------------
 *
 * Six cards in one grid put a class between two fairs and a grant beside a
 * journal, and a reader deciding what to do had to sort them by eye first.
 * They are different acts -- you join a class, you enter a fair, you apply
 * for a grant -- so the grouping is by act rather than by date.
 *
 * Classes and clubs first: joining one is the ordinary path and the one that
 * decides a project's process, and 22.4 says the interface should offer it
 * before the solo route. Fairs next, because that is what most of them are
 * preparing for. Grants and the journal last, since both are things you do
 * with work that already exists.
 */
const GROUPS: { id: string; title: string; blurb: string; holds: (p: any) => boolean }[] = [
  {
    id: 'cohorts',
    title: 'Classes and clubs',
    blurb: 'A group you belong to, with its own calendar and its own teacher.',
    holds: (p) => p.program_role === 'cohort',
  },
  {
    id: 'fairs',
    title: 'Fairs',
    blurb: 'Where a project is judged. You enter one with a project.',
    holds: (p) => p.program_role !== 'cohort' && p.kind === 'competition',
  },
  {
    id: 'grants',
    title: 'Grants',
    blurb: 'Money for research you are doing. You apply with a project.',
    holds: (p) => p.program_role !== 'cohort' && p.kind === 'grant',
  },
  {
    id: 'publishing',
    title: 'Publishing',
    blurb: 'Where finished work is read.',
    holds: (p) => p.program_role !== 'cohort' && ['publication', 'showcase'].includes(p.kind),
  },
];

/* Anything a group does not claim still appears, rather than vanishing
   because somebody added a kind and not a group. */
const grouped = () => {
  const seen = new Set<string>();
  const out = GROUPS.map((g) => {
    const items = joinable.filter((p: any) => g.holds(p));
    for (const p of items) seen.add(p.id);
    return { ...g, items };
  }).filter((g) => g.items.length > 0);

  const rest = joinable.filter((p: any) => !seen.has(p.id));
  if (rest.length > 0) {
    out.push({
      id: 'other',
      title: 'Everything else',
      blurb: '',
      holds: () => true,
      items: rest,
    } as any);
  }
  return out;
};

