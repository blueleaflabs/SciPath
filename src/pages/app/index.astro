          */}
        <div id="outcome" tabindex="-1">
          {error2 && <p class="note flash" role="alert">{error2}</p>}
          {attached && <p class="note flash" role="status">{attached}</p>}
        </div>

        {/* The advisor hears, on the page, that somebody's socket would not
            carry today (2.8). One line; the log has the rest. */}
        {me.isAdvisor && (
          <div data-live="live-incidents">
            {fellBack.length > 0 && (
              <p class="note flash" role="status">
                Live updates fell back to polling for {fellBack.length} {fellBack.length === 1 ? 'person' : 'people'} in the last day ({fellBack.join(', ')}). <a href="/app/live/">The log</a>
              </p>
            )}
