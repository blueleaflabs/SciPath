  .going a:hover {
    color: var(--ink);
  }
  /* The measure belongs to the prose, not to the container. With it on the
     hero, a one line row of six figures wrapped at 74 characters while two
     thirds of the page sat empty beside it. */
  .hero { padding: 44px 0 28px; }
  .hero .t-lbl, .hero h1, .hero .lede { max-width: 74ch; }
  .hero .t-lbl { margin-bottom: 14px; }
  .fixture { margin-top: 34px; padding: 18px 20px; border: 1px dashed var(--rule); max-width: 52ch; }
  .fixture .t-lbl { margin-bottom: 8px; }
  .fixrow { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 12px; }
  .fixrow input { flex: 1 1 14ch; padding: 8px 10px; border: 1px solid var(--rule); background: var(--card); color: var(--ink); font: inherit; font-size: 0.94rem; }
  .fixrow button { padding: 8px 14px; border: 1px solid var(--ink); background: var(--ink); color: var(--paper); font-family: var(--face-ui); font-size: 0.9rem; cursor: pointer; }
  /* A grid rather than a flex row. Sized to content, the fourth cell dropped
     to a line of its own as soon as one label ran long, which left a gap
     beside "disqualifying" and a stranded number underneath. Equal columns
     put all four on one line and wrap them in pairs rather than one at a
     time. */
  .countdown {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin-top: 26px;
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
  }
  .countdown > div {
    padding: 14px 22px 14px 0;
    border-right: 1px solid var(--rule-fine);
  }
  .countdown > div:last-child { border-right: 0; }

  @media (max-width: 720px) {
    .countdown { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    /* The divider belongs between columns, so it comes off the right hand
       one and the first row gains a rule underneath it. */
    .countdown > div:nth-child(2n) { border-right: 0; }
    .countdown > div:nth-child(-n + 2) { border-bottom: 1px solid var(--rule-fine); }
  }
  .countdown b { display: block; font-size: 1.05rem; line-height: 1.2; }
