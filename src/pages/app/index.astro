                  </p>

                  <div class="asked-do">
                    {/* Only where there is somebody to pass it to, which
                        `my_nudges` decides from the same oversight row
                        `public.nudge` checks — so the button cannot appear
                        where the function would refuse it. */}
                    {n.relay_to_id && (
                      <form method="POST" action="#outcome" class="inline">
                        <input type="hidden" name="action" value="nudge" />
                        <input type="hidden" name="milestone_id" value={n.milestone_id} />
                        <input type="hidden" name="recipient_id" value={n.relay_to_id} />
                        <button class="btn btn-sm" type="submit">
                          Nudge {String(n.relay_to_name ?? '').split(' ')[0] || 'them'}
                        </button>
                      </form>
                    )}

                    {!n.relay_to_id && (
                      <a
                        class="btn btn-sm"
                        href={`/app/project/${n.project_id}/in/${n.program_id}/#deliverables`}
                      >
                        Submit it
                      </a>
                    )}

                    {/* "Got it" for everybody who was asked: one word back,
                        so whoever asked can tell waiting from chasing (2.8). */}
                    {n.acknowledged_at ? (
                      <span class="sub ack">You said you had this</span>
                    ) : (
                      <form method="POST" action="#outcome" class="inline">
                        <input type="hidden" name="action" value="ack" />
                        <input type="hidden" name="milestone_id" value={n.milestone_id} />
                        <button class="btn btn-2 btn-sm" type="submit">Got it</button>
                      </form>
                    )}
                  </div>

                </li>
              ))}
            </ul>
          </section>
        )}

        {/* The *Due* list that stood here, every obligation across the
            reader's own projects, is gone: it was the project's own
            deadlines table again, and the project is where it is done. The
            cover card still says what is next and points at it. */}

        {/* Oversight first (2.8): the page is driven by what is in the
            reader's care; their own project follows. */}
        {/* ---------------- OVERSIGHT ---------------- */}
        {me.runsTheClub && (
          watched.length > 0 ? (
            <>
              <div id="projects" tabindex="-1"></div>

              {/* **One list, and a count.** 6.9 gives an officer exactly
                  what they look after plus what nobody has taken, and the
                  two are opposite jobs: one is work to chase, the other work
                  to claim. The second list lives on the assign page now,
                  where claiming is one click; this page carries the count
                  and the link. */}
              <section class="sec" id="care" data-live="care">
                <div class="sec-h">
                  <b><span class="sec-n">{no('care')}</span>In my care</b>
                  <span>
                    {careGroups.reduce((n: number, g: any) => n + g.rows.length, 0)}
                    {' projects'}{careOverdue.length ? ` · ${careOverdue.length} behind` : ' · nothing late'}{careQuiet.length ? ` · ${careQuiet.length} ${careQuiet.length === 1 ? 'notebook' : 'notebooks'} quiet` : ''}
                  </span>
                </div>

                {/* **What nobody has taken, said once and pointed at the
                    queue.** The list itself lived here, under a heading
                    whose purpose was to be empty, beside the list of work to
                    chase. They are opposite jobs, and the assign page is
                    where one project becomes somebody's with one click, so
                    the list is there and this is the count. */}
                {careGroups.length === 0 && (
                  <div class="allclear"><b>Nothing assigned</b>Nothing is assigned to you here yet.</div>
                )}

                {careGroups.map((group: any) => (
                <div class="care-group">
                  <div class="group-h care-h">
                    <span>{group.elder !== undefined ? (group.elder ? `${staffWord(group.program, group.elder.includes(',') ? 'plural' : 'singular')}: ${group.elder}` : `No ${staffWord(group.program, 'singular').toLowerCase()} yet`) : group.program ? programTitle(group.program) : 'In no program'}</span>
                    <span class="t-num">{group.elder !== undefined ? `${group.rows.length} ${group.rows.length === 1 ? 'project' : 'projects'}${group.rows.filter((r: any) => r.daysToNext !== null && r.daysToNext < 0).length ? ` · ${group.rows.filter((r: any) => r.daysToNext !== null && r.daysToNext < 0).length} behind` : ''}` : standingOf(group)}</span>
                  </div>

                  {/* **CARDS, NOT A TABLE (2.8).** One component, two
                      arrangements: three across for an Elder's family, one
                      column of wide cards for a teacher's class. The
                      arrangement is a word on the wrapper (`careLayout`), so
                      the switch is a query or a cookie away and a control
                      for it can be surfaced later without touching the
                      card. Everything the row carried is on the card:
                      standing, names, the three counts, both next tasks with
                      "Do it" where the Elder's is ready, the exports, the
                      selection on a fair, and the nudge with its track. */}
                  <div class:list={['care-cards', careLayout(group)]}>
                    {group.rows.map((w: any) => (
                      <CareCard
                        w={w}
                        nextTask={w.entry ? nextTaskFor.get(w.entry.id) ?? null : null}
                        readyTask={w.entry ? readyTaskFor.get(w.entry.id) ?? null : null}
                        elderWord={staffWord(group.program, 'singular')}
                        selects={Boolean(me.isAdvisor && selects(group.program))}
                        formatDate={formatDate}
                        daysWord={daysWord}
                      />
                    ))}
                  </div>
                </div>
                ))}
              </section>

            </>
          ) : (
            <section class="sec">
              <div class="sec-h"><b>All projects</b><span>0</span></div>
              <div class="note">
                <h4>No projects yet</h4>
                <p>Projects appear here as students register them.</p>
              </div>
            </section>
          )
        )}

        {/* *Yours to do*, the Elder's task list, is a column of the care
            table now (Next Elder Task): a task belongs on the row of the
            project it is about. */}

        {/* ---------------- YOUR OWN WORK ----------------

            **Gated on having work, not on holding a role.** This asked
            `me.isStudent || !me.runsTheClub`, which is a role question
            answering a data question: an officer whose `population` was
            recorded as `staff` lost half the interface with no message, and
            a teacher who happens to author a project could not see it.
            Decision 67. Somebody with work of their own has this section;
            somebody with none does not, and a teacher naturally meets the
            care lists first because hers is empty rather than because the
            page sorted itself for her. */}
        {(hasOwnWork) && (
          <>
            {myReviews.length > 0 && (
              <section class="sec" id="review">
                <div class="sec-h">
                  <b><span class="sec-n">{no('review')}</span>To review</b>
                  <span>{myReviews.length} waiting</span>
                </div>
                <ul class="plain">
                  {myReviews.map((r) => {
                    const late = new Date(r.due_at) < new Date();
                    return (
                      <li>
                        <a href={`/app/review/${r.id}/`}>
                          {r.submissions?.manuscripts?.title ?? 'A submission'}
                        </a>
                        <span class:list={['t-sm', late && 'late']}>
                          {late ? 'overdue, was due ' : 'due '}{fmt(r.due_at)}
                        </span>
                      </li>
                    );
                  })}
                </ul>
              </section>
            )}

            <section class="sec" id="research">
              {/* *This season* named the calendar; what a student opens this
                  page for is their own work, and the season is on every row
                  below it. */}
              <div class="sec-h">
                <b><span class="sec-n">{no('research')}</span>My current research</b>
                <span>
                  {myEntries.length
                    ? `${myEntries.length} ${myEntries.length === 1 ? 'project' : 'projects'}`
                    : 'nothing yet'}
                </span>
              </div>
              {/* **Cards, because this is the thing the page is for.**

                  A student's own work was a list of links with a grey
                  sentence under each, rendered lighter than the table of
                  other people's projects below it. Each project is an
                  object now: its name, where it lives, and the one fact
                  that decides whether to open it today, which is what is
                  next and whether it is late. */}
              {myEntries.length > 0 && (
                <ul class="projects">
                  {myEntries.map((e) => (
                    <li class={e.late ? 'is-late' : ''}>
                      {/* The folder's label: where it lives, and its standing
                          in the accent. */}
                      <p class="ord">
                        <span>
                          {e.cohorts[0]
                            ? programTitle(e.cohorts[0].programs)
                            : e.entries[0]
                              ? programTitle(e.entries[0].programs)
                              : 'On its own'}
                        </span>
                        <b>{e.late ? 'Behind' : e.next ? 'On track' : 'Clear'}</b>
                      </p>

                      {/* The project, which is the hub (22.9). A project may
                          have gone nowhere, or to three places, and either
                          way the work is the thing to open. */}
                      <a class="t" href={`/app/project/${e.project.id}/`}>{e.project.title}</a>

                      {/* Classes and clubs first, then entries. A project in
                          IRPD and nowhere else is not "not entered anywhere
                          yet" — it is in a class, which is the more useful
                          thing to say and the thing the old copy denied. */}
                      {e.cohorts.length > 0 || e.entries.length > 0 ? (
                        <p class="where">
                          {e.cohorts.map((c: any) => (
                            <a class="chip" href={`/app/project/${e.project.id}/in/${c.program_id}/`}>
                              {programTitle(c.programs)}
                            </a>
                          ))}
                          {e.entries.map((entry: any) => (
                            <a class="chip work" href={`/app/project/${e.project.id}/in/${entry.program_id}/`}>
                              {programTitle(entry.programs)}
                            </a>
                          ))}
                        </p>
                      ) : (
                        /* Neither, which is the case the noun has to be
                           careful about: we do not know whether this school
                           runs a fair, a class, or both. */
                        <p class="where"><span class="chip draft">Not in a class or entered anywhere</span></p>
                      )}

                      {/* What is next, on the card, as a pill, and the way
                          in. The overview could say where a project lived
                          and not whether it wanted anything, so the only way
                          to find out was to open all of them. */}
                      <p class="meta">
                        <span class:list={['pill', e.late ? 'late' : e.days !== null && e.days <= 7 ? 'soon' : e.next ? 'quiet' : 'ok']}>
                          {e.next ? `${e.next} · ${daysWord(e.days)}` : 'Nothing outstanding'}
                        </span>
                        <span>
                          <a href={`/app/project/${e.project.id}/`}>Notebook</a>
                          {' · '}
                          <a href={`/app/project/${e.project.id}/notebook/`}>Export</a>
                          {e.cohorts.some((c: any) => c.programs?.showcase === 'private') && (
                            <>{' · '}<a href={`/app/project/${e.project.id}/showcase/`}>My showcase</a></>
                          )}
                          {gradesFor.get(e.project.id) && e.cohorts[0] && (
                            <>{' · '}<a href={`/app/project/${e.project.id}/in/${e.cohorts[0].program_id}/#grades`}>
                              Grades {gradesFor.get(e.project.id)!.score} of {gradesFor.get(e.project.id)!.outOf}
                            </a></>
                          )}
                        </span>
                      </p>
                    </li>
                  ))}
                </ul>
              )}

              {/* ONE FORM, TWO SITUATIONS.
              
                  This was rendered only in the empty state, so the way to
                  start a project disappeared the moment somebody had one.
                  A student in a class who then wants to enter a fair with
                  different work had no way to say so: the model has allowed
                  it since the merge, and `app.entry_conflict` is written
                  specifically to permit it, because a class is not a fair
                  and only a fair refuses a student a second project.
              
                  Rendered once rather than twice. Two copies of a form with
                  a cohort picker in it is two things to keep in agreement,
                  and the picker is the part that will change again. Open on
                  arrival for somebody with nothing, folded away for somebody
                  who already has a project and is not usually here to start
                  another. */}
              <div class:list={['startbox', myEntries.length === 0 && 'note']}>
                {myEntries.length === 0 && (
                  <>
                    {/* No noun here on purpose. With nothing joined we do not
                        know whether this student's school runs a fair, a
                        class, or both, and "no fair entered" is wrong for
                        somebody whose only option is IRPD. */}
                    <h4>Nothing yet this season</h4>
                    <p class="t-sm" style="max-width:var(--measure-text)">
                      Start a project whenever you are ready. It does not have
                      to be entered anywhere, or belong to a class, to be
                      worth keeping a notebook for.
                    </p>
                  </>
                )}

                <details class="starter" open={myEntries.length === 0}>
                  <summary>
                    {myEntries.length > 0 ? 'Start another project' : 'Start a project'}
                  </summary>

                  <form method="POST" data-leaves-page class="startp">
                    <input type="hidden" name="action" value="start_project" />

                    <label>
                      <span>Working title <i class="req">*</i></span>
                      <input class="in" name="title" required />
                    </label>

                    {/* Where a person is in a cohort, the project can belong
                        to it from the start, which also decides its research
                        process (22.4). Absent, it belongs to nobody, which is
                        the solo case and is allowed.

                        **The class leads and the solo case sits at the
                        bottom.** A student who has just been admitted and has
                        no project yet is, almost always, about to start that
                        class's project -- and "Nothing in particular" was
                        first and therefore selected, so the ordinary path
                        needed an act to choose and the exception was the
                        default. 22.4 says joining a cohort is the ordinary
                        route and the interface should offer it first; this is
                        that, in the one control where it decides something.

                        Marked `selected` rather than left to the browser's
                        first-option rule, because the rule holds only while
                        the first option is the intended one, and that is
                        exactly the assumption that broke here. */}
                    {/* A class this student is in and does not already have a
                        project in. One place per student is the class's rule,
                        so a cohort that already holds their work cannot take
                        a second piece of it, and offering it would present a
                        choice the server refuses. */}
                    {startableCohorts.length > 0 && (
                      <label>
                        <span>Part of</span>
                        <select name="cohort_id">
                          {startableCohorts.map((m: any, i: number) => (
                            <option value={m.cohort_id} selected={i === 0}>
                              {programTitle(m.programs)}
                            </option>
                          ))}
                          <option value="">Nothing in particular</option>
                        </select>
                      </label>
                    )}

                    {/* Positive, and said only where it explains something:
                        somebody in one class who already has its project sees
                        no picker, and the reason is worth one line rather
                        than a missing control. */}
                    {startableCohorts.length === 0 && myMemberships.length > 0 && (
                      <p class="t-sm" style="max-width:var(--measure-text)">
                        This one stands on its own. Your class already holds a
                        project of yours, and it keeps one place for each
                        student; work for a fair is entered separately once it
                        has a title.
                      </p>
                    )}

                    <p><button class="btn" type="submit">Start the project</button></p>
                  </form>
                </details>

                {myEntries.length === 0 && (
                  <p style="margin-top:6px">
                    <a href="#join">Or see what you can join</a>
                  </p>
                )}
              </div>
            </section>

          </>
        )}

        {hasOwnWork && (
          <>
    {!hidden('programs') && (
    <section class="sec" id="join">
      {/* Not "Open fairs": a research class is not a fair, and "programs" is
          our word rather than a student's. The heading says what the list is
          for, and each card says what kind of thing it is. */}
      {/* **What you are in, then what you could join.** This was a join
          list only, so a student already in the class saw it named nowhere
          on their overview and had no way in from here — the one page they
          open every day. The heading is the section, and the sentence under
          it says which half is which. */}
      <div class="sec-h">
        <b><span class="sec-n">{no('join')}</span>Programs</b>
        <span>{myMemberships.length > 0 ? `in ${myMemberships.length}` : ''}</span>
      </div>

      {myMemberships.length > 0 && (
        <ul class="linklist mine-programs">
          {myMemberships.map((m: any) => (
            <li>
              <a href={`/app/program/${m.cohort_id}/`}>{programTitle(m.programs)}</a>
              <span class="t-sm"> · you are a member</span>
            </li>
          ))}
        </ul>
      )}

      <h3 class="group-h" style="margin-top:22px">Open to join</h3>

      {joinable && joinable.length > 0 ? (
        grouped().map((group: any) => (
        <div class="group">
          <h3 class="group-h">{group.title}</h3>
          {group.blurb && <p class="group-b t-sm">{group.blurb}</p>}
        <div class="progs">
          {/* A grid rather than a stack.
          
              Each program was a full width card carrying a two field form,
              so five of them ran to several screens and the one somebody
              wanted was below the fold. What a reader is doing here is
              choosing, and choosing wants everything visible at once.
          
              The form is the reason they were tall, so it folds away: a
              card is a name, a kind, a date and a way in, and the fields
              appear when somebody has decided which one they want. */}
          {group.items.map((p: any) => (
            <div
              class:list={[
                'card',
                'prog',
                p.program_role === 'cohort' ? 'k-cohort' : `k-${p.kind}`,
              ]}
            >
              <div class="about">
                <p class="season">{programKind(p)} · {p.season_year} season</p>
                {/* Into the site, not out of it. The fair's own page is
                    named among the facts on the program page, where a reader
                    can see they are about to leave. */}
                <h3><a href={`/app/program/${p.id}/`}>{p.name}</a></h3>

                {p.description && <p class="blurb">{p.description}</p>}

                <dl class="facts">
                  {/* A class has no judging day. Its calendar is its phases,
                      which the deadlines page shows. */}
                  {/* Independent research has no judging day and never will,
                      so "to be announced" was promising something that is not
                      coming. A program with no date and nothing to wait for
                      says nothing rather than an empty label. */}
                  {p.kind !== 'independent' && (
                    <>
                      <dt>
                        {p.kind === 'course' ? 'Ends' : p.kind === 'grant' ? 'Closes' : 'Judging'}
                      </dt>
                      <dd>{fmt(p.fair_date) ?? 'to be announced'}</dd>
                    </>
                  )}
                  {p.advances_to_fairs?.length > 0 && (
                    <>
                      <dt>Advances to</dt>
                      <dd>{p.advances_to_fairs.join(' and ')}</dd>
                    </>
                  )}
                </dl>
              </div>

              {enteredIn.has(p.id) ? (
                <div class="already">
                  {/* One line and a way through, rather than a paragraph
                      explaining a rule nobody is trying to break. */}
                  <a class="btn" href={`/app/entry/${entryFor.get(p.id)}/`}>
                    View {participationVerb(p).noun}
                  </a>
                </div>
              ) : gateFor.has(p.id) ? (
                /* Locked, and the sentence says by what. A state fair takes
                   the projects a regional put forward, and a club is how a
                   school enters the fair it prepares for -- neither is a
                   form to fill in. */
                <div class="already">
                  <p class="t-sm" style="max-width:var(--measure-text); margin:0">
                    {gateFor.get(p.id)}
                  </p>
                </div>
              ) : (
              <>
              {/* **A state is shown; only a form is folded away.**
              
                  These five branches sat inside one `<details>`, and three of
                  them have no `<summary>` of their own: a request pending, a
                  refusal, and being a member. A `<details>` with no summary is
                  not empty -- the browser supplies its own -- so the card read
                  **Details**, collapsed, over the one line that mattered.
                  "Request sent, pending approval" is four words and was behind
                  a click that named nothing.

                  The disclosure earns its place on the other two, where it
                  holds a form: the verb is the summary, so "Ask to join" and
                  then a title field is the same two steps as a button that
                  opens a form, without a second page or a line of script.

                  So the wrapper goes around the two branches that ask for
                  something. A state renders as itself. */}
              {p.program_role === 'cohort'
                && ['requested', 'declined', 'member'].includes(cohortState.get(p.id) ?? '') ? (
                <div class="enter shown" style={!me.isStudent ? 'display:none' : undefined}>
                {p.program_role === 'cohort' && cohortState.get(p.id) === 'requested' ? (
                  /* Already asked. Offering the form again invites somebody
                     to send a second request that does nothing, and reads as
                     though the first one was lost. */
                  <p class="waiting">Request sent, pending approval</p>
                ) : p.program_role === 'cohort' && cohortState.get(p.id) === 'declined' ? (
                  /* **A refusal is a state, and it was invisible.**
                  
                     The card fell through to "Ask to join" with nothing said,
                     so a student who had been turned down saw the same offer
                     they saw before asking -- and clicking it did nothing at
                     all, because `join_cohort` left a declined row where it
                     was. Three things were wrong and this fixes the reading
                     half: the answer, who gave it, and what they said.
                  
                     Named, because a decision with no author is a decision
                     nobody can go and talk to, and talking to them is the
                     actual next step. */
                  <div class="waiting">
                    <p style="margin:0 0 4px"><b>Not this time.</b></p>
                    <p class="t-sm" style="margin:0 0 8px; max-width:var(--measure-text)">
                      {cohortDecider.get(p.id)
                        ? `Decided by ${cohortDecider.get(p.id)}${cohortDecidedOn.get(p.id) ? ` on ${cohortDecidedOn.get(p.id)}` : ''}.`
                        : 'Decided by the people who run it.'}
                      {cohortNote.get(p.id) && ` "${cohortNote.get(p.id)}"`}
                    </p>
                    <form method="POST" data-leaves-page>
                      <input type="hidden" name="action" value="join_cohort" />
                      <input type="hidden" name="program_id" value={p.id} />
                      <button class="btn btn-2 btn-sm" type="submit">Ask again</button>
                    </form>
                  </div>
                ) : (
                  /* Being in a cohort is not the end of the errand. The card
                     said "You are in this one" as dead text, so somebody who
                     had just been admitted had nothing to click and no way
                     to put their work into the class they had joined.

                     The final branch rather than a third test: the wrapper
                     above has already established that this is a cohort and
                     that the state is one of these three. */
                  <div class="waiting">
                    {/* **The status, and then only what there is to do.**
                    
                        This read "You are in this one." and, when there was
                        nothing left to add, "Every project you have is
                        already in it." Two sentences, both of them answers
                        to questions nobody asked: the card is in the list of
                        things you can join, so being in it is the one fact
                        worth stating, and it was stated without the one
                        detail that makes it a fact -- when.
                    
                        The second line was worse than redundant. It reported
                        the absence of an action as though it were news, on a
                        card whose whole purpose is the action. */}
                    <p style="margin:0">
                      {cohortDecidedOn.get(p.id) ? 'Approved and joined' : 'Joined'}
                      {cohortJoinedOn.get(p.id) ? ` on ${cohortJoinedOn.get(p.id)}` : ''}
                    </p>

                    {/* One project per person per cohort at a time; the
                        server refuses a second, so a card for a class this
                        person already has a project in offers no picker. */}
                    {!cohortsTaken.has(p.id) && myProjectsForCohort(p.id).length > 0 && (
                      <form method="POST" action="#outcome" class="inline" style="margin-top:8px">
                        <input type="hidden" name="action" value="attach_cohort" />
                        <input type="hidden" name="cohort_id" value={p.id} />
                        <select name="project_id" aria-label={`Add a project to ${p.name}`}>
                          {myProjectsForCohort(p.id).map((project: any) => (
                            <option value={project.id}>{project.title}</option>
                          ))}
                        </select>
                        <button class="btn btn-sm" type="submit">Add project</button>
                      </form>
                    )}
                  </div>
                )}
                </div>
              ) : (
                <details class="enter" style={!me.isStudent ? 'display:none' : undefined}>
                  {/* A cohort is joined and asks for nothing; an opportunity
                      is entered and asks for a project (22.2). Two different
                      acts, and the form should not pretend otherwise: asking
                      a student to name a project in order to enroll in a
                      class is the conflation this model removed. */}
                  {p.program_role === 'cohort' ? (
                  <>
                    <summary>
                      {p.joining === 'approval' ? 'Ask to join' : 'Join'}
                    </summary>
                    <form method="POST" data-leaves-page>
                      <input type="hidden" name="action" value="join_cohort" />
                      <input type="hidden" name="program_id" value={p.id} />
                      {/* No explanation above the button. Who decides is not
                          the student's problem at the moment they ask, and
                          the line pushed three cards out of alignment for a
                          sentence nobody needed twice. */}
                      <button class="btn" type="submit">
                        {p.joining === 'approval' ? 'Request to join' : 'Join'}
                      </button>
                    </form>
                  </>
                ) : (
                  <>
                <summary>
                  {p.joining === 'approval'
                    ? 'Ask to enter'
                    : p.kind === 'grant'
                      ? 'Start an application'
                      : 'Enter'}
                </summary>

              {/* **What you enter with is usually work you are already doing.**
              
                  This card had one form, and it made a project. A student in
                  IRPD since August, entering the fair their club prepares
                  for, got a second project with the same title, no notebook
                  and none of the class's dates -- and no warning, because
                  making a project is what the only available path did.
              
                  So existing research leads and a new project is the second
                  offer. Which way round matters: a fair is somewhere you take
                  work, and the exception is starting something at the moment
                  you enter it, not the rule.
              
                  The list is what the server would accept and nothing more.
                  A project already entered here is absent, because entering
                  it twice is not a thing. And where one of this student's
                  projects already holds their place, the whole picker is
                  replaced by the sentence saying which -- `app.entry_conflict`
                  refuses a second, since two projects from one student
                  compete against each other for one place, and a picker that
                  cannot succeed is the failure the gates exist to prevent. */}
              {holdsPlace.has(p.id) ? (
                <p class="legend fit" style="padding:16px 20px; margin:0">
                  You have already entered <b>{holdsPlace.get(p.id)}</b> here.
                  One student enters one fair with one project.
                </p>
              ) : myProjectsForOpportunity(p.id).length > 0 ? (
                <>
                  <form method="POST" data-leaves-page>
                    <input type="hidden" name="action" value="enter_existing" />
                    <input type="hidden" name="program_id" value={p.id} />
                    <label>
                      <span>Which research are you entering?</span>
                      <select name="project_id" required>
                        {myProjectsForOpportunity(p.id).map((project: any) => (
                          <option value={project.id}>{project.title}</option>
                        ))}
                      </select>
                    </label>
                    <button class="btn" type="submit">
                      {p.joining === 'approval'
                        ? 'Send the request'
                        : p.kind === 'grant'
                          ? 'Apply with this'
                          : 'Enter this'}
                    </button>
                    {p.joining === 'approval' && (
                      <p class="legend fit">
                        {p.places ? `${p.places} places. ` : ''}You can keep working
                        while you wait for approval
                      </p>
                    )}
                  </form>

                  {/* Second, and folded, because starting a project from a
                      fair card is the rarer act and the fields are the ones
                      the student has already answered once. */}
                  <details class="also">
                    <summary>or start something new</summary>
                    <form method="POST" data-leaves-page>
                      <input type="hidden" name="action" value="join" />
                      <input type="hidden" name="program_id" value={p.id} />
                      <label>
                        <span>Working title for your project <i class="req">*</i></span>
                        <input name="title" required />
                      </label>
                      <label>
                        <span>The day you started, or plan to start, experimenting</span>
                        <input name="started_on" type="date" />
                        <small>Leave it blank if you have not started.</small>
                      </label>
                      <button class="btn" type="submit">
                        {p.joining === 'approval'
                          ? 'Send the request'
                          : p.kind === 'course'
                            ? 'Join the class'
                            : p.kind === 'grant'
                              ? 'Start an application'
                              : p.kind === 'independent'
                                ? 'Start research'
                                : 'Enter fair'}
                      </button>
                      <p class="legend"><i class="req">*</i> required</p>
                    </form>
                  </details>
                </>
              ) : (
              <>
              {/* No fragment on the action.
              
                  A browser keeps the fragment across a redirect when the
                  destination has none of its own, so posting to `#outcome`
                  and then being sent to the entry page landed somebody
                  partway down it, at an anchor belonging to a different
                  screen. Joining succeeds far more often than it fails, and
                  the failure message is at the top of this page anyway. */}
              <form method="POST" data-leaves-page>
                <input type="hidden" name="action" value="join" />
                <input type="hidden" name="program_id" value={p.id} />
                <label>
                  <span>Working title for your project <i class="req">*</i></span>
                  <input name="title" required />
                </label>
                <label>
                  <span>The day you started, or plan to start, experimenting</span>
                  <input name="started_on" type="date" />
                  <small>Leave it blank if you have not started.</small>
                </label>
                {/* You enter a fair and you join a class. The kind is on the
                    card, so there is no reason to guess. */}
                {/* Asking is not joining where a program grants places, and
                    a button that says "join" and produces a request is a
                    button that lied. */}
                {/* Every kind names its own verb. "Enter fair" was the
                    default and independent research is not a fair: nobody
                    enters it, they just begin. */}
                <button class="btn" type="submit">
                  {p.joining === 'approval'
                    ? 'Send the request'
                    : p.kind === 'course'
                      ? 'Join the class'
                      : p.kind === 'grant'
                        ? 'Start an application'
                        : p.kind === 'independent'
                          ? 'Start research'
                          : 'Enter fair'}
                </button>

                {p.joining === 'approval' && (
                  <p class="legend fit">
                    {p.places ? `${p.places} places. ` : ''}You can start work
                    while you wait for approval
                  </p>
                )}
                <p class="legend"><i class="req">*</i> required</p>
              </form>
              </>
              )}
                  </>
                  )}
                </details>
              )}
              </>
              )}
            </div>
          ))}
        </div>
        </div>
        ))
      ) : (
        <div class="note">
          <h4>Nothing is open yet</h4>
          <p>An officer or your advisor sets up the season.</p>
        </div>
      )}
    </section>
    )}

            {!hidden('past') && (
            <section class="sec" id="past">
              <div class="sec-h"><b><span class="sec-n">{no('past')}</span>Past seasons</b><span>nothing yet</span></div>
              <p class="t-sm">
                What you have done before appears here, with any placement.
              </p>
            </section>
            )}
          </>
        )}
      </>
    )}
  </div>
</Base>

<style>
  /* Room in the one box a student with nothing yet actually reads.
  
     Title, a sentence, a labelled field, a button and a link, all at the
     panel's default rhythm, put five things a uniform distance apart and the
     field ended up touching the sentence above it. What differs here is
     importance rather than kind, so the gaps differ: the sentence sits close
     to the heading it explains, the form stands apart from both, and the
     secondary route out has clear air above it rather than reading as part
     of the form. */
  .startbox { padding: 20px 22px 22px; }
  .startbox h4 { margin: 0 0 6px; }
  .startbox > .t-sm { margin: 0 0 18px; }

  /* Folded, this is one line of interface under a list of projects, so it
     has to read as something to do rather than as a heading. Open, the
     summary is the form's title and the padding above it is the list's
     rather than its own. */
  .starter > summary {
    cursor: pointer;
    font-family: var(--face-ui);
    font-size: 0.95rem;
  }
  .starter[open] > summary { margin-bottom: 16px; }
  .startbox:not(.note) { padding: 14px 0 0; }

  .startbox .startp { margin: 0; }
  .startbox .startp label { display: block; margin: 0 0 14px; }
  .startbox .startp label > span { display: block; margin: 0 0 5px; }
  .startbox .startp p { margin: 18px 0 0; }

  /* Grouped, and the groups are what a reader scans.
  
     A heading over a grid is enough on its own; a rule under it would make
     four sections compete with the section rules already on the page. */
  .group + .group { margin-top: 30px; }
  /* Larger than what it groups.
  
     This was the small uppercase mono label, which is what the section header
     above it already is — so *Classes and clubs* rendered quieter than the
     cards beneath it and the groups blurred into one long list. In the
     interface face at a heading size, it separates by size and by shape at
     once. Matched to the signed-out season list on the home page, which had
     the same fault and the same name for it.
  
     `--font-mono` was also wrong: the token is `--face-num`, and the
     misspelling meant the browser's default monospace rather than the one
     this site loads. Two faults in seven lines, both invisible unless
     somebody looked. */
  .group-h {
    margin: 0 0 4px;
    font-family: var(--face-ui);
    font-weight: 600;
    font-size: 1.18rem;
    color: var(--ink);
  }
  .group-b { margin: 0 0 14px; max-width: var(--measure-text); }

  .miss { color: var(--ink-3); font-style: italic; }
  .inline { display: flex; gap: 6px; align-items: center; }
  /* The button keeps its line; the select gives up the room.
  
     In a card a little over fifteen rems wide, a select sized to its longest
     option left the button two words on two lines and half a card tall. The
     order of preference is the fix: the label is short and fixed, so it never
     wraps, and the select shrinks below its content width and truncates a
     long project title instead — which the student can still read once the
     menu is open. */
  .inline > button { flex: 0 0 auto; white-space: nowrap; }
  .inline select {
    flex: 1 1 auto;
    min-width: 0;
    text-overflow: ellipsis;
    padding: 6px 9px;
    border: 1px solid var(--rule);
    background: var(--card);
    color: var(--ink);
    font: inherit;
    font-size: 0.86rem;
  }

  /* Three or more across wherever there is room for them.
  
     `auto-fill` with a 15.5rem floor gives three on a laptop, two on a
     tablet and one on a phone, without a breakpoint per count. The floor is
     what guarantees the three: a program name and a date fit in it, and
     anything narrower would start hyphenating titles. */
  .progs {
    display: grid;
    /* Wide enough for the widest row a card holds, which is the select and
       the button beside it rather than anything in the heading. At 15.5rem
       those two had nowhere to go; this is the smallest that leaves the
       select a readable amount of a project title. */
    grid-template-columns: repeat(auto-fill, minmax(17.5rem, 1fr));
    gap: 16px;
  }
  .prog {
    display: flex;
    flex-direction: column;
    padding: 0;
    /* **The kind, as a colored edge.**
    
       Six cards in a row, identical but for their words, made a reader parse
       every heading to find the one they wanted. The edge encodes what the
       card already says in its eyebrow — class, club, fair, grant, journal —
       so the grid can be scanned by shape before it is read. Stage colors,
       because a program's kind is the same vocabulary the lifecycle uses and
       a second palette would be a second thing to learn. */
    border-left: var(--edge) solid var(--stage-draft);
    transition: box-shadow 120ms ease, transform 120ms ease;
  }
  .prog.k-cohort { border-left-color: var(--stage-comp); }
  .prog.k-competition { border-left-color: var(--stage-work); }
  .prog.k-grant { border-left-color: var(--stage-ready); }
  .prog.k-publication { border-left-color: var(--stage-pub); }

  /* It lifts under the cursor, which is the whole of the motion budget on
     this page. */
  .prog:hover { box-shadow: var(--lift-2); }

  @media (prefers-reduced-motion: reduce) {
    .prog { transition: none; }
  }
  /* The action on the floor of every card, whatever the description above
     it says. Three cards with three different amounts of text put their
     buttons at three heights, which reads as three different kinds of
     thing. */
  .prog .enter,
  .prog .already,
  .prog .waiting { margin-top: auto; }

  .prog .waiting {
    margin-bottom: 0;
    padding: 14px 20px;
    border-top: 1px solid var(--rule-fine);
    background: var(--paper);
    font-family: var(--face-ui);
    font-size: 0.9rem;
    color: var(--ink-2);
  }
  /* The description grows and the action sits on the floor, so a row of
     cards has its buttons on one line however long the blurbs are. */
  .prog .about { padding: 18px 20px; flex: 1; }
  .prog h3 { margin: 0 0 10px; }
  .prog .season {
    margin: 0 0 4px;
    font-family: var(--face-num);
    font-size: 0.82rem;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: var(--ink-3);
  }
  .prog h3 { font-size: 1.1rem; line-height: 1.25; }
  .prog .blurb {
    margin: 0 0 14px;
    font-size: 0.92rem;
    /* Four lines. A card grid wants a predictable height and a description
       nobody wrote a limit for will otherwise set it. The full text is on
       the program's own page. */
    display: -webkit-box;
    -webkit-line-clamp: 4;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .prog .facts {
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: 4px 14px;
    margin: 0;
    padding-top: 12px;
    border-top: 1px solid var(--rule-fine);
    font-size: 0.95rem;
  }
  .prog .facts dt {
    font-family: var(--face-ui);
    font-size: 0.82rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--ink-3);
    padding-top: 3px;
  }
  .prog .facts dd { margin: 0; }
  .req { color: var(--alert); font-style: normal; }
  .legend { margin: 10px 0 0; font-size: 0.86rem; color: var(--ink-3); }

  /* One line, whatever the column width. The sentence is short enough that
     shrinking it a little beats wrapping it: a two-line caption under a
     button reads as a warning rather than a note. */
  .fit {
    white-space: nowrap;
    font-size: clamp(0.72rem, 1.6cqi, 0.86rem);
  }

  .already {
    padding: 14px 20px;
    border-top: 1px solid var(--rule-fine);
    background: var(--paper);
  }
  .already p { margin: 0 0 6px; }

  .enter {
    margin: 0;
    border-top: 1px solid var(--rule-fine);
    background: var(--paper);
    container-type: inline-size;
  }
  /* The shown state carries the card's floor itself.
  
     `.waiting` has the rule above it, the padding and the background,
     because it sat directly in the card before the disclosure existed. The
     wrapper is here only to hold `margin-top: auto` so the block still lands
     on the floor of a card whose blurb is shorter than its neighbor's, so it
     must not draw a second rule over the top of the first. */
  .enter.shown { border-top: 0; background: none; }
  /* The summary is the button. Reset the marker rather than hiding the
     control it belongs to: a disclosure with no affordance at all is a
     button somebody has to guess at. */
  .enter > summary {
    padding: 12px 20px;
    font-family: var(--face-ui);
    font-size: 0.94rem;
    cursor: pointer;
    list-style: none;
  }
  .enter > summary::-webkit-details-marker { display: none; }
  .enter > summary::after {
    content: ' +';
    font-family: var(--face-num);
    color: var(--ink-3);
  }
  .enter[open] > summary::after { content: ' \2212'; }
  .enter[open] > summary { border-bottom: 1px solid var(--rule-fine); }
  .enter > form { padding: 16px 20px; }
  .enter label { display: block; margin-bottom: 12px; }
  .enter label > span { display: block; margin-bottom: 5px; font-family: var(--face-ui); font-size: 0.9rem; }
  .enter input,
  .enter select { width: 100%; padding: 8px 10px; border: 1px solid var(--rule); background: var(--card); color: var(--ink); font: inherit; }

  /* The second offer, and it should read as one.
  
     Starting a project from a fair card is the rarer act now that existing
     research leads, so it is folded — but folded quietly: a rule above it
     rather than a second heading, and a summary in the running size rather
     than the button size the primary form uses. Scoped to `.enter`, because
     `.also` means something else further down the page. */
  .enter .also { border-top: 1px solid var(--rule-fine); }
  .enter .also > summary {
    padding: 10px 20px;
    font-family: var(--face-ui);
    font-size: 0.88rem;
    color: var(--ink-2);
    cursor: pointer;
    list-style: none;
  }
  .enter .also > summary::-webkit-details-marker { display: none; }
  .enter .also > form { padding: 0 20px 16px; }

  .plain { list-style: none; margin: 0; padding: 0; }
  .plain li {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 10px;
    padding: 10px 0;
    border-bottom: 1px solid var(--rule-fine);
  }
  .plain .late { color: var(--alert); }
  /* The two or three places a student actually goes from a project, said
     once rather than discovered by clicking. */
  .going {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    margin-top: 6px;
  }
  .going a {
    font-family: var(--face-ui);
    font-size: 0.82rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--ink-3);
  }
  .going a:hover {
    color: var(--ink);
  }
  /* The measure belongs to the prose, not to the container. With it on the
     hero, a one line row of six figures wrapped at 74 characters while two
     thirds of the page sat empty beside it. */
  .hero { padding: 44px 0 28px; }
  .hero .t-lbl, .hero h1, .hero .lede { max-width: 74ch; }
  .hero .t-lbl { margin-bottom: 14px; }
  .fixture { margin-top: 34px; padding: 18px 20px; border: 1px dashed var(--rule); max-width: 52ch; }
  .fixture .t-lbl { margin-bottom: 8px; }
  .fixrow { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 12px; }
  .fixrow input { flex: 1 1 14ch; padding: 8px 10px; border: 1px solid var(--rule); background: var(--card); color: var(--ink); font: inherit; font-size: 0.94rem; }
  .fixrow button { padding: 8px 14px; border: 1px solid var(--ink); background: var(--ink); color: var(--paper); font-family: var(--face-ui); font-size: 0.9rem; cursor: pointer; }
  /* A grid rather than a flex row. Sized to content, the fourth cell dropped
     to a line of its own as soon as one label ran long, which left a gap
     beside "disqualifying" and a stranded number underneath. Equal columns
     put all four on one line and wrap them in pairs rather than one at a
     time. */
  .countdown {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin-top: 26px;
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
  }
  .countdown > div {
    padding: 14px 22px 14px 0;
    border-right: 1px solid var(--rule-fine);
  }
  .countdown > div:last-child { border-right: 0; }

  @media (max-width: 720px) {
    .countdown { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    /* The divider belongs between columns, so it comes off the right hand
       one and the first row gains a rule underneath it. */
    .countdown > div:nth-child(2n) { border-right: 0; }
    .countdown > div:nth-child(-n + 2) { border-bottom: 1px solid var(--rule-fine); }
  }
  .countdown b { display: block; font-size: 1.05rem; line-height: 1.2; }
  .countdown span { display: block; margin-top: 3px; font-family: var(--face-ui); font-size: 0.84rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--ink-3); }
  .also { font-size: 0.95rem; }
  .sub { display: block; margin-top: 3px; font-family: var(--face-ui); font-size: 0.82rem; color: var(--ink-3); }
  /* One per line. Two reasons run together read as one long sentence, and
     the second is the one somebody has not noticed yet. */
  .sev { display: block; font-family: var(--face-ui); font-size: 0.86rem; }
  .sev.bad { color: var(--alert); font-weight: 600; }
  .assign { display: flex; flex-wrap: wrap; gap: 14px; align-items: flex-end; }
  .assign label { display: block; }
  .assign label > span { display: block; margin-bottom: 5px; font-family: var(--face-ui); font-size: 0.9rem; }
  .assign select { padding: 8px 10px; border: 1px solid var(--rule); background: var(--card); color: var(--ink); font: inherit; min-width: 22ch; }
  .assign button { padding: 9px 16px; border: 1px solid var(--ink); background: var(--ink); color: var(--paper); font-family: var(--face-ui); font-size: 1rem; font-weight: 600; cursor: pointer; }
  /* Quiet, and not part of the link's name. */
  .yet {
    margin-left: 6px;
    font-family: var(--face-num);
    font-size: 0.76rem;
    letter-spacing: 0.02em;
    text-transform: none;
    color: var(--ink-3);
  }

  .next { font-size: 0.94rem; }

  /* Narrow, so the verb does not take the width the facts need. */
  /* The one section on this page addressed *to* the reader rather than about
     other people's work. Given the alert tint so it does not read as another
     table heading in a page of table headings. */
  /* The rule is a marker, not a border on the text. Without the padding the
     first character sat against it and the section read as clipped. */
  .asked { border-left: 3px solid var(--alert); padding-left: 16px; }
  .asked-list { list-style: none; margin: 0; padding: 0; }
  .asked-list li { padding: 10px 0; border-bottom: 1px solid var(--rule-fine); }
  .asked-list li:last-child { border-bottom: 0; }
  .asked-list a { font-weight: 600; }
  .asked-ask { margin: 6px 0 0; font-family: var(--face-ui); font-size: 0.92rem; }
  .asked-do { display: flex; gap: 8px; margin-top: 8px; align-items: center; }
  .asked-do .btn { font-size: 0.86rem; padding: 5px 10px; }
  .signin-help { margin-top: 14px; }
  .signin-help summary { cursor: pointer; font-family: var(--face-ui); font-size: 0.9rem; color: var(--brand); }
  .signin-help p { margin: 8px 0 0; max-width: 52ch; }
  .plate-sec { margin-top: 0; padding-top: 12px; }
  .plate-sec .alarm { margin-top: 0; }
  .came-back { margin: 14px 0 0; font-size: 0.95rem; }
  .came-back .sub { color: var(--ink-3); }
  .sub.ack { margin: 0; }


  /* Two states worth colour, and no more.
  
     Late and close-at-hand are the rows a teacher acts on this week. Adding a
     third tone for "plenty of time" would put colour on every row, and colour
     on every row is colour on none — the screen already carries a
     disqualifying tone and a warning tone, and a fourth competes with both.
     Everything not late and not close keeps `.sub`, which is quiet on
     purpose. */
  /* `--alert` and `--ink`, which exist. The first draft reached for a
     `--bad` and a `--warn` that are not in `tokens.css`, with hex literals
     as fallbacks — two invented colours dressed as tokens.
     `tests/tokens-only.mjs` refuses a hex anywhere outside the token file
     and caught it, including the one still sitting in this comment
     explaining the mistake, which is the rule working exactly as written.
   
     There is no warning foreground token, only `--ready-bg`, so "close at
     hand" is weight on the ordinary ink rather than a colour nobody chose.
     A tone invented here would be a fifth thing to keep consistent. */
  .sub.late { color: var(--alert); font-weight: 600; }
  .sub.soon { color: var(--ink); font-weight: 600; }
  .none { color: var(--ink-3); font-size: 0.92rem; }
  /* Says an Elder is not a third author. Quieter than the names. */
  .sub .role { color: var(--ink-3); }
  .sub.yours { color: var(--brand); font-weight: 600; }
  .sub.yours .role { color: var(--brand); }


  .mine-programs { margin-bottom: 4px; }

  /* A program's own heading inside the care list: quieter than the section
     head, with its standing beside it. */
  .care-h {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
    margin: 26px 0 8px;
  }
  .care-group:first-of-type .care-h { margin-top: 8px; }

  /* On a phone (2.8): the care head and the inline forms wrap. */
  @media (max-width: 640px) {
    .care-h { flex-wrap: wrap; }
    .inline { flex-wrap: wrap; }
    .asked-do { flex-wrap: wrap; }
  }
</style>
