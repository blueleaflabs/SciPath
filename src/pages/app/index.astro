---
export const prerender = false;

import Base from '../../layouts/Base.astro';
import { formatDate, todayIn } from '../../lib/dates';
import AppShell from '../../components/AppShell.astro';
import CareCard from '../../components/CareCard.astro';
import { platform } from '../../config/site';
import { activeOrg } from '../../lib/tenant';
import { programTitle, programKind, participationVerb, staffWord } from '../../lib/program-names';
import { serverClient } from '../../lib/supabase';
import { standing, roleLabel } from '../../lib/roles';
import { checkDateOrder, worstFinding } from '../../lib/dateOrder';
import { assess, queueRank, daysUntil } from '../../lib/attention';
import { afterPost, outcomeFrom, leaveTo } from '../../lib/post-redirect';
import { hidesProgram } from '../../lib/hidden-programs';
import Plate from '../../components/Plate.astro';
import { safeNext, HOME } from '../../lib/next-path';
import { nextUpNote } from '../../lib/next-up';
import { byDueThenOrder } from '../../lib/milestone-order';
import { resolveProgram, deliverablesFor, shape } from '../../lib/templates';
import { docStanding } from '../../lib/documents';
import { stepProgress } from '../../lib/step-progress';
import { sponsorsFromPlaces } from '../../lib/sponsors';

const { configured, session, account, roles } = Astro.locals;
const org = activeOrg(Astro);

/* Where they were headed before being asked to sign in. Kept through the
   form and through Google's round trip. */
const next = safeNext(Astro.url.searchParams.get('next'));
/* Ours, not the provider's. See the comment in middleware.ts: sharing the
   `error` parameter with Supabase produced a redirect loop. */
const signin = Astro.url.searchParams.get('signin');

if (configured && session && !account) return Astro.redirect('/app/welcome/');

const me = standing(roles, account?.population);
const today = todayIn(org.timezone);

/**
 * **The teacher lands on the class.** For the person who runs one class,
 * the day is the class page: the week, the roll call, who is quiet. The
 * Workbench is the project list, and it is one tab away (the tab carries
 * `?view=workbench`, which is what keeps this from bouncing it back). A
 * bare GET only: a POST's outcome comes back with a query and is left
 * alone, and a person running two classes has no single default.
 */
const classesRun = ((Astro.locals as any).classes ?? []) as { program_id: string }[];
if (!platform.teacherWorkbench && Astro.request.method === 'GET' && account && classesRun.length === 1 && !Astro.url.search) {
  return Astro.redirect(`/app/program/${classesRun[0].program_id}/class/`);
}

/**
 * **The student lands on the project.** One project in one class and
 * nobody in their care: the day is that project's page, with the plate,
 * the calendar and the notebook one tab away, and this page would show
 * the same plate over one card. The same guard as the teacher's, so a
 * POST's outcome and `?view=workbench` are left alone. An Elder keeps
 * landing here, because their plate is other people's projects.
 */
const ownProjects = ((Astro.locals as any).projects ?? []) as { project_id: string; places: { program_id: string }[] }[];
if (
  Astro.request.method === 'GET' &&
  account &&
  !Astro.url.search &&
  classesRun.length === 0 &&
  !me.runsTheClub &&
  ownProjects.length === 1 &&
  ownProjects[0].places.length > 0
) {
  return Astro.redirect(`/app/project/${ownProjects[0].project_id}/in/${ownProjects[0].places[0].program_id}/`);
}

const supabase = account
  ? serverClient(Astro.request, Astro.cookies, (Astro.locals as any).runtime?.env)
  : null;

/* Seeded from the redirect a POST answers with. `cleared` was a count that
   could not survive one, so it became the sentence it was rendered as. See
   src/lib/post-redirect.ts. */
let { error: error2, note: attached } = outcomeFrom(Astro.url);

/** Nudges addressed to whoever is reading. Empty for a signed-out visitor. */
let myNudges: any[] = [];

/* Set by the middleware when it sends somebody from another school's address
   to their own. Compared against this tenant's slug rather than merely being
   present, so a link somebody pastes with `?at=` on the wrong tenant says
   nothing. */
const switchedHome = Astro.url.searchParams.get('at') === (Astro.locals as any).orgSlug;

/**
 * Two different people post to this page, and the guard is per action.
 *
 * Joining a program is a student's, attaching somebody to a project is the
 * club's, and the whole handler used to sit behind `me.runsTheClub` — so a
 * student's join would have been dropped without a word. The action is also
 * explicit on every branch now: attaching was the `else`, and a form that
 * forgot its action fell into it.
 */
if (Astro.request.method === 'POST' && supabase) {
  const form = await Astro.request.formData();
  const action = String(form.get('action') ?? '');

  /* Joining a cohort. A person enrolls, and no project is invented in order
     to have somewhere to put the enrolment (22.1). */
  /* Starting a project.
  
     There was no way to do this at all: `start_entry` made one as a side
     effect of entering something, and separating the two (22.1) left a
     student who had joined a class with nothing to click. A project exists
     because somebody started work, so this is its own act. */
  /* Putting an existing project into a cohort somebody has been admitted
     to. The same act as the picker on the project page, offered where a
     student is when they are told they are in (22.5). */
  if (action === 'attach_cohort') {
    const { error: e } = await supabase.rpc('set_project_cohort', {
      p_project_id: String(form.get('project_id') ?? ''),
      p_cohort_id: String(form.get('cohort_id') ?? ''),
      p_in: true,
    });

    if (e) error2 = e.message;
    else return leaveTo(`/app/project/${String(form.get('project_id') ?? '')}/`);
  } else if (action === 'start_project') {
    const title = String(form.get('title') ?? '').trim();

    if (!title) {
      error2 = 'Give the project a working title. You can change it later.';
    } else {
      const { data: projectId, error: e } = await supabase.rpc('start_project', {
        p_title: title,
        p_started_on: String(form.get('started_on') ?? '') || null,
        p_cohort_id: String(form.get('cohort_id') ?? '') || null,
      });

      if (e) error2 = e.message;
      else return leaveTo(`/app/project/${projectId}/`);
    }
  } else if (action === 'join_cohort') {
    const { error: e } = await supabase.rpc('join_cohort', {
      p_cohort_id: String(form.get('program_id') ?? ''),
    });

    if (e) error2 = e.message;
    else {
      /* What happens next, in the order it happens. A request that says "you
         are in" when a teacher has not decided is telling somebody something
         untrue. */
      /* Named, because a student asking to join three things in a row gets
         three identical confirmations otherwise and cannot tell which one
         this was. */
      const { data: program } = await supabase
        .from('programs')
        .select('joining, name')
        .eq('id', String(form.get('program_id') ?? ''))
        .maybeSingle();

      const what = program?.name ?? 'it';

      attached =
        program?.joining === 'approval'
          ? `Request to join ${what} sent. You can start a project while you wait for approval.`
          : `You are in ${what}. Start a project when you are ready.`;
    }
  } else if (action === 'join') {
    const title = String(form.get('title') ?? '').trim();

    if (!title) {
      error2 = 'Give the project a working title. You can change it later.';
    } else {
      const { data: entryId, error: e } = await supabase.rpc('start_entry', {
        p_program_id: String(form.get('program_id') ?? ''),
        p_title: title,
        p_started_on: String(form.get('started_on') ?? '') || null,
      });

      if (e) error2 = e.message;
      /* The top of their new project, not wherever the last outcome was.
         See leaveTo. */
      else return leaveTo(`/app/entry/${entryId}/`);
    }
  } else if (action === 'enter_existing') {
    /* **Research you are already doing, taken somewhere.**
    
       The card had one form and it called `start_entry`, which makes a
       project — so a student entering the fair with the work they had been
       doing since August got a second, empty project with the same title and
       none of the notebook. Nothing prevented it and nothing said so.
    
       No new function was needed for this. `enter_program` is the one path
       that attaches a project to an opportunity, and `start_entry` calls it
       too, having made the project first. So the difference between the two
       routes is exactly the thing that differs: whether there is already a
       project.
    
       No title, because it has one. No start date, because it has one or has
       deliberately been left without one, and a fair entry form is not where
       that gets rewritten: `checkDateOrder` reads that date against the
       sponsor's signature, and "work began before a sponsor agreed" ends
       seasons. */
    const projectId = String(form.get('project_id') ?? '');

    if (!projectId) {
      error2 = 'Choose which research you are entering.';
    } else {
      const { data: entryId, error: e } = await supabase.rpc('enter_program', {
        p_project_id: projectId,
        p_program_id: String(form.get('program_id') ?? ''),
      });

      if (e) error2 = e.message;
      else return leaveTo(`/app/entry/${entryId}/`);
    }
  } else if (action === 'deliverable') {
    /* From the plate: the student's own row, recorded here rather than
       on the project page. The function refuses anybody who is not an
       author on the project, so the participation id off the form is
       checked where it matters. */
    const participationId = String(form.get('participation_id') ?? '');
    const { error: e } = await supabase.rpc('record_deliverable', {
      p_participation_id: participationId,
      p_milestone_id: String(form.get('milestone') ?? '') || null,
      p_type: String(form.get('deliverable') ?? 'other'),
      p_label: String(form.get('label') ?? 'Deliverable'),
      p_signed_on: String(form.get('signed_on') ?? '') || today,
      p_external_url: String(form.get('external_url') ?? '').trim() || null,
      p_storage_path: null,
    });
    if (e) error2 = e.message;
    else attached = await nextUpNote(supabase, participationId);
  } else if (action === 'status') {
    /* A step with nothing to hand in, marked done from the plate. The
       project page's own form for this has an Open choice as well; the
       plate only ever completes. */
    const participationId = String(form.get('participation_id') ?? '');
    const { error: e } = await supabase.rpc('record_deliverable', {
      p_participation_id: participationId,
      p_milestone_id: String(form.get('milestone_id') ?? ''),
      p_type: String(form.get('kind') ?? 'other'),
      p_label: String(form.get('name') ?? 'Deliverable'),
      p_signed_on: String(form.get('on') ?? '') || today,
      p_external_url: null,
      p_storage_path: null,
    });
    if (e) error2 = e.message;
    else attached = await nextUpNote(supabase, participationId, 'Done');
  } else if (action === 'feedback') {
    /* From the plate. The function decides who may: the Elder on the
       place, the advisor only where there is none (app.looks_after). */
    const { error: e } = await supabase.rpc('give_feedback', {
      p_deliverable_id: String(form.get('deliverable_id') ?? ''),
      p_body_md: String(form.get('body') ?? ''),
      p_needs_revision: String(form.get('needs_revision') ?? '') === '1',
    });
    if (e) error2 = e.message;
    else attached = 'Feedback sent. The task is done.';
  } else if (action === 'task') {
    const { error: e } = await supabase.rpc('complete_staff_task', {
      p_milestone_id: String(form.get('milestone_id') ?? ''),
      p_body_md: String(form.get('body') ?? '') || null,
    });
    if (e) error2 = e.message;
    else attached = 'Done.';
  } else if (action === 'ack') {
    /**
     * **ABOVE THE STAFF GATE, BECAUSE THIS IS THE ONE ACTION ONLY A STUDENT
     * TAKES.**
     *
     * This sat below `!me.runsTheClub`, which refuses anybody who is not an
     * officer or the advisor. The card offers "I have this" only where there
     * is nobody to pass the ask on to, which is exactly a student — an Elder
     * closes the card by relaying instead. So the button was reachable only
     * by the people it is never shown to, and every student who pressed it
     * was told that only an officer or their advisor can do that, about a
     * request addressed to them.
     *
     * The gate is right about everything under it and this was simply filed
     * on the wrong side of it, left there from a draft where a nudge went to
     * the Elder and the student was not a recipient at all.
     *
     * **Authorisation was never this handler's to give.**
     * `acknowledge_nudge` hard-codes `recipient_id = auth.uid()`, so whoever
     * was written to may answer and nobody may answer for somebody else. That
     * is the rule, it is in the database where a second tab cannot get around
     * it, and it has been right the whole time.
     *
     * Saying you have it is not saying it is done. The obligation stays
     * outstanding and the row stays on the list; what changes is that whoever
     * asked can now tell waiting from chasing.
     */
    const { error: e } = await supabase.rpc('acknowledge_nudge', {
      p_milestone_id: String(form.get('milestone_id') ?? ''),
    });

    if (e) error2 = e.message;
    else attached = 'Noted. Whoever asked can see you have it.';
  } else if (action === 'reply') {
    /* A written answer to whoever asked. `nudge_reply` addresses it to the
       people who nudged this recipient about this obligation and to nobody
       else, and marks the ask seen on the way. */
    const { data, error: e } = await supabase.rpc('nudge_reply', {
      p_milestone_id: String(form.get('milestone_id') ?? ''),
      p_note: String(form.get('note') ?? ''),
    });
    if (e) error2 = e.message;
    else if (data === 'empty') error2 = 'Write a line first.';
    else if (data === 'nobody') error2 = 'Nobody has asked you about this one.';
    else attached = 'Sent to whoever asked.';
  } else if (action === 'nudge') {
    /**
     * **The function decides who may be reached, not this handler.**
     *
     * `public.nudge` checks that the recipient is on the project and that the
     * caller runs the program or was attached to the participation. A second
     * copy of that reasoning here is a second thing to get wrong, and the one
     * in the database is the one that holds when somebody posts to this
     * address without the screen.
     *
     * **Which is why it sits above the staff gate rather than below it.** It
     * was below, and that was a second copy of the rule wearing an ordering
     * instead of an `if`: harmless while the only relay was an Elder passing
     * an ask to a student, since an Elder runs the club and cleared it — and
     * exactly the arrangement that hid the same mistake in `ack` until a
     * student pressed a button meant for them. A branch whose comment says
     * the database decides should not be standing behind a role check.
     */
    const { data, error: e } = await supabase.rpc('nudge', {
      p_milestone_id: String(form.get('milestone_id') ?? ''),
      p_recipient_id: String(form.get('recipient_id') ?? ''),
    });

    if (e) {
      error2 = e.message;
    } else {
      /* Four outcomes, and three of them are not errors: pressing the button
         twice, or pressing it on a row somebody met a minute ago, is
         ordinary. A red message would teach somebody the button is broken. */
      /* **Only where the row cannot say it itself.**
      
         `sent` needs no notice: the button comes back reading `Nudged 1×`,
         which is the same news said in the place it happened. The other three
         are outcomes the row has no way to show, so they still surface at the
         top. */
      attached =
        data === 'already'
          ? 'Already nudged about this one this week. It will send again next week.'
          : data === 'done'
            ? 'That one has been met, so nothing was sent.'
            : data === 'early'
              ? 'Not due yet, so nothing was sent. A nudge goes once the task is late.'
              : data === 'sent'
                ? null
                : 'Nothing to send.';
    }
  } else if (!me.runsTheClub) {
    error2 = 'Only an officer or your advisor can do that.';
    /* A `detach` branch stood here and no form on this page posted to it —
       left behind when removing somebody moved to the team page, where the
       row being removed is visible. It called `detach_from_project` with a
       project, which no longer exists as a signature: oversight names a
       place now. Dead code that would not compile against its own function
       is worse than dead code, so it is gone rather than updated. */
  } else if (action === 'select') {
    /* Which projects a school puts forward. The advisor's, and the function
       says so too; this only decides whether the control is offered. */
    if (!me.isAdvisor) {
      error2 = 'Only your advisor decides which projects go forward.';
    } else {
      const { error: e } = await supabase.rpc('set_selection', {
        p_participation_id: String(form.get('participation_id') ?? ''),
        p_state: String(form.get('state') ?? 'candidate'),
        p_note: String(form.get('note') ?? '') || null,
      });
      if (e) error2 = e.message;
    }
  } else if (action === 'attach') {
    const { data, error: e } = await supabase.rpc('attach_to_project', {
      p_project_id: String(form.get('project_id') ?? ''),
      p_user_id: String(form.get('user_id') ?? ''),
      p_role: String(form.get('role') ?? 'mentor'),
      p_dated: String(form.get('dated') ?? '') || null,
    });
    if (e) {
      error2 = e.message;
    } else {
      const n = data ?? 0;
      attached = `Attached. ${n} approval obligation${n === 1 ? '' : 's'} cleared.`;
    }
  }

  /* A refresh should re-read this page, not send the form again. */
  return afterPost(Astro.url, { error: error2, note: attached });
}

/* --- What a student sees: their own entries -------------------------- */
let myEntries: any[] = [];
let myReviews: any[] = [];
let myManuscripts = new Set<string>();

/** Every dated obligation this person owes, late first. See below. */
let dueNow: any[] = [];
const myDocState = new Map<string, any>();
/* The verb and the standing of a document on the plate, the same words the
   project's deliverables table uses (2.8): Start, Continue, Open, and how
   many answered. */
const docStandingOn = (projectId: string, deliverableId: string, shapeId: string | null) =>
  docStanding(myDocState.get(`${projectId}:${deliverableId}`) ?? null, shapeId ? shape(shapeId) : null, (iso) => formatDate(String(iso).slice(0, 10), 'short'));

/** Released grades per project: how many, and the running total. */
const gradesFor = new Map<string, { n: number; score: number; outOf: number }>();
let myNotes = 0;
let myLastNote: string | null = null;

/* --- What everyone else sees: the projects they are responsible for --- */
let watched: any[] = [];
let staffPeople: any[] = [];

if (supabase && account) {
  if (me.isStudent || !me.runsTheClub) {
    /* Scoped by authorship. The policy lets an officer read every entry at
       the school, which is right for the club table below and wrong for a
       section headed "this season". */
    /* From the middleware's one read (2.9): the unarchived projects this
       person authors, which is what the read below filtered to anyway. */
    const myProjectIds = (((Astro.locals as any).projects ?? []) as { project_id: string }[]).map((p) => p.project_id);

    /**
     * The projects, and where each of them went.
     *
     * **Read from projects, not from entries.** This listed entries, so a
     * project that had not been submitted anywhere did not exist to it: a
     * student who started work and joined a class saw *nothing yet this
     * season* while looking at their own project's page in another tab.
     *
     * That was the conflation surviving in a query. Work exists because
     * somebody started it, and entering it somewhere is a later and optional
     * thing (22.1). A project with no entry is the ordinary state of every
     * project for its first month.
     */
    const { data: mineProjects } = myProjectIds.length
      ? await supabase
          .from('projects')
          .select('id, title, created_at, facts')
          .in('id', myProjectIds)
          .is('archived_at', null)
          .order('created_at', { ascending: false })
      : { data: [] as any[] };

    /* Which documents exist, for the verb on the plate: Start for one not
       begun, Continue for one under way, Open for one submitted (2.8). */
    const { data: myDocs } = myProjectIds.length
      ? await supabase.from('documents').select('project_id, deliverable, status, version_no, opened_at, submitted_at, document_fields(field_id, value)').in('project_id', myProjectIds)
      : { data: [] as any[] };
    for (const d of myDocs ?? []) myDocState.set(`${d.project_id}:${d.deliverable}`, d);

    const { data: theirEntries } = myProjectIds.length
      ? await supabase
          .from('opportunity_participations')
          .select('id, status, placement, program_id, project_id, programs:program_id(name, season_year, fair_date, kind, roles)')
          .in('project_id', myProjectIds)
          .order('entered_at', { ascending: false })
      : { data: [] as any[] };

    /* The classes and clubs these projects are in, which is a separate
       question from what they have been entered in. Before the merge a
       cohort had no participation row to read, so this line could not be
       written and the list below said "not entered anywhere yet" to a
       student whose project was sitting in IRPD. */
    const { data: theirCohorts } = myProjectIds.length
      ? await supabase
          .from('cohort_participations')
          .select('id, program_id, project_id, programs:program_id(name, season_year, kind, roles, showcase)')
          .in('project_id', myProjectIds)
      : { data: [] as any[] };

    const entriesFor = new Map<string, any[]>();
    for (const e of theirEntries ?? []) {
      entriesFor.set(e.project_id, [...(entriesFor.get(e.project_id) ?? []), e]);
    }

    const cohortsFor = new Map<string, any[]>();
    for (const c of theirCohorts ?? []) {
      cohortsFor.set(c.project_id, [...(cohortsFor.get(c.project_id) ?? []), c]);
    }

    /* **What each of these wants next**, so the card can say it.

       The overview could name where a project lived and not whether it was
       asking for anything, so the only way to find out was to open all of
       them — on the page whose job is to say which one to open. One query
       across every project of this person's, rather than one per card. */
    /* **By participation id, not through the embed (2.9).** This filtered
       on `participations.project_id` inside the `!inner` embed, which
       PostgREST answers by scanning `entry_milestones` itself — every row
       of every tenant's, each one offered to the policy and each policy
       call asking `can_see_project` — and only then joining the places
       that match. The load test named it: 896 ms of the Workbench's 1.2
       seconds, on every student's landing and every Elder's. The places
       are already in hand from the two reads above, so the filter is on
       the indexed column and the policy judges a dozen rows. */
    const ownPartIds = [...new Set([...(theirEntries ?? []), ...(theirCohorts ?? [])].map((e: any) => e.id).filter(Boolean))];
    const { data: mineDueRows } = ownPartIds.length
      ? await supabase
          .rpc('milestones_of', { p_participation_ids: ownPartIds })
          .select('id, name, due_on, completed_on, kind, sort_order, step_id, requires_step, requires_steps, participations!inner(id, project_id, program_id, programs(name, season_year, kind, roles, template_id))')
          .is('completed_on', null)
          .not('due_on', 'is', null)
          .neq('kind', 'event')
          /* The student's own obligations. An Elder's task on the project
             is on the project's calendar and on the Elder's list, never
             here as something the student owes. */
          .eq('owner', 'student')
          .order('due_on', { ascending: true })
          .order('sort_order', { ascending: true })
          .order('id')
      : { data: [] as any[] };
    /* An rpc's rows are typed as row-or-rows; these are rows. */
    const mineDue = (mineDueRows ?? []) as any[];

    /* The gate (2.8): the names of the steps an open row waits on that
       are not met, from one read of the same places' rows. */
    const partIds = [...new Set((mineDue ?? []).map((r: any) => (r.participations as any)?.id).filter(Boolean))];
    const { data: gateRowsRaw } = partIds.length
      ? await supabase.rpc('milestones_of', { p_participation_ids: partIds }).select('participation_id, step_id, name, kind, completed_on, due_on, sort_order').order('due_on', { ascending: true, nullsFirst: false }).order('sort_order')
      : { data: [] as any[] };
    const gateRows = (gateRowsRaw ?? []) as any[];
    const gateOf = (row: any): string[] => {
      const ids = new Set<string>([...(row.requires_steps ?? []), ...(row.requires_step ? [row.requires_step] : [])]);
      if (ids.size === 0) return [];
      const pid = (row.participations as any)?.id;
      return (gateRows ?? []).filter((g: any) => g.participation_id === pid && ids.has(g.step_id) && !g.completed_on).map((g: any) => g.name);
    };

    const nextFor = new Map<string, any>();
    for (const row of mineDue ?? []) {
      const key = (row.participations as any)?.project_id;
      if (key && !nextFor.has(key)) nextFor.set(key, row);
    }

    /**
     * **THE WORKING LIST.**
     *
     * Everything this person owes, across every project, in date order with
     * the late ones first — and for each, how to meet it and where to record
     * it. This is the page a student and an Elder live in for the fortnight
     * before a deadline, and the question it answers is not *where does my
     * project stand* but *what do I do next, and how fast can I do it*.
     *
     * The *how* comes from the template the program was seeded from: what
     * the step hands in (a form, a link, a line of text), and the one
     * sentence of guidance the class wrote against it where there is one.
     * Resolved once per program rather than once per row. A template that
     * fails to resolve costs the row its guidance and nothing else.
     */
    const templateOf = new Map<string, any>();
    const templateFor = (program: any) => {
      const id = program?.template_id;
      if (!id) return null;
      if (!templateOf.has(id)) {
        try {
          templateOf.set(id, resolveProgram(id, null));
        } catch {
          templateOf.set(id, null);
        }
      }
      return templateOf.get(id);
    };

    const factsOf = new Map<string, Record<string, boolean>>(
      (mineProjects ?? []).map((p: any) => [p.id, p.facts ?? {}])
    );
    const titleOf = new Map<string, string>((mineProjects ?? []).map((p: any) => [p.id, p.title]));

    const KINDS: Record<string, string> = {
      form: 'A signed form',
      link: 'A link to the document',
      text: 'A few lines, typed in',
      file: 'A file',
    };

    dueNow = (mineDue ?? [])
      .map((row: any) => {
        const part = row.participations ?? {};
        const template = templateFor(part.programs);
        const step = template?.steps?.find((st: any) => st.name === row.name) ?? null;
        const wants = step && template ? deliverablesFor(template, step, factsOf.get(part.project_id) ?? {}) : [];
        const needed = wants.filter((d: any) => d.requirement !== 'optional');
        const guidance =
          needed.map((d: any) => d.guidance).find(Boolean) ?? step?.note ?? step?.risk ?? null;
        const days = daysUntil(row.due_on, today);

        return {
          id: row.id,
          name: row.name,
          kind: row.kind,
          dueOn: row.due_on,
          sortOrder: row.sort_order ?? 0,
          waitsOn: gateOf(row),
          days,
          late: days !== null && days < 0,
          participationId: part.id,
          /* What the plate's form asks for: each deliverable the step
             wants, whether or not it is optional, as the ledger row
             offers them. Already-recorded ones are not on this list
             because the row would not be open. */
          items: wants.map((d: any) => ({ id: d.id, name: d.name, templateUrl: d.template_url ?? null })),
          /* Written in SciPath: the plate opens the document instead of
             folding a form (6.16). */
          docs: wants.filter((d: any) => d.shape).map((d: any) => ({ id: d.id, name: d.name, shape: d.shape, href: `/app/project/${part.project_id}/doc/${d.id}/` })),
          projectId: part.project_id,
          projectTitle: titleOf.get(part.project_id) ?? 'A project',
          programId: part.program_id,
          program: part.programs ?? null,
          /* What to hand in, said as the kind of thing it is, and named as the
             class names it, so the student can find it in their own folder. */
          hands: needed.map((d: any) => `${KINDS[d.kind] ?? 'Something'}: ${d.name}`),
          templateUrl: needed.map((d: any) => d.template_url).find(Boolean) ?? null,
          guidance: guidance ? String(guidance).replace(/\*\*/g, '') : null,
          href: `/app/project/${part.project_id}/in/${part.program_id}/#m-${row.id}`,
        };
      })
      .sort((a: any, b: any) => byDueThenOrder({ due_on: a.dueOn, sort_order: a.sortOrder, id: a.id }, { due_on: b.dueOn, sort_order: b.sortOrder, id: b.id }));

    /* Released grades, rolled up per project for the card. The policy
       returns only this person's own released rows. */
    /* Off for the pilot (`platform.gradesToStudents`): no figure, no read. */
    const { data: gradeRows } = ownPartIds.length && platform.gradesToStudents
      ? await supabase
          .from('assessments')
          .select('score, out_of, participations!inner(project_id)')
          .in('participation_id', ownPartIds)
          .is('superseded_by', null)
          .not('released_at', 'is', null)
      : { data: [] as any[] };

    for (const g of gradeRows ?? []) {
      const key = (g.participations as any)?.project_id;
      if (!key) continue;
      const held = gradesFor.get(key) ?? { n: 0, score: 0, outOf: 0 };
      held.n += 1;
      held.score += Number(g.score ?? 0);
      held.outOf += Number(g.out_of ?? 0);
      gradesFor.set(key, held);
    }

    /* When this person last wrote in any notebook of theirs, by the day the
       work happened. The one number they can change today. */
    const { data: myNoteRows } = myProjectIds.length
      ? await supabase
          .from('field_notes')
          .select('project_id, occurred_on')
          .in('project_id', myProjectIds)
      : { data: [] as any[] };

    for (const n of myNoteRows ?? []) {
      myNotes += 1;
      if (!myLastNote || n.occurred_on > myLastNote) myLastNote = n.occurred_on;
    }

    /* One row per project, carrying whatever it has been entered in. A
       project entered nowhere still gets a row, which is the fix. */
    myEntries = (mineProjects ?? []).map((project: any) => {
      const due = nextFor.get(project.id) ?? null;
      const days = due ? daysUntil(due.due_on, today) : null;
      return {
        project,
        entries: entriesFor.get(project.id) ?? [],
        cohorts: cohortsFor.get(project.id) ?? [],
        next: due?.name ?? null,
        days,
        late: days !== null && days < 0,
      };
    });

    /* Which of these already have a manuscript, so the link can say "start"
       or "open" rather than making somebody click to find out. */
    const { data: started } = myProjectIds.length
      ? await supabase.from('manuscripts').select('project_id').in('project_id', myProjectIds)
      : { data: [] as any[] };

    myManuscripts = new Set((started ?? []).map((m: any) => m.project_id));

    /* Reviewing is an attachment rather than a standing role, so it appears
       nowhere in the nav. If it did not appear here it would appear nowhere
       at all, which is exactly how an assignment sits untouched until the
       week of the fair. */
    const { data: assigned } = await supabase
      .from('reviews')
      .select('id, due_at, submitted_at, submissions(manuscripts(title))')
      .is('submitted_at', null)
      .order('due_at', { ascending: true });

    myReviews = assigned ?? [];
  }
}

/* --- What is open to join ------------------------------------------------
 *
 * This was its own page, listing the same entries as the section above it
 * with a different row. Two pages holding one list is the sprawl this pass
 * exists to remove, so the joining half moved here and the page it came
 * from redirects.
 */
let joinable: any[] = [];
let enteredIn = new Set<string>();

/**
 * Why a program cannot be entered yet, if it cannot.
 *
 * The same function `enter_program` and `start_entry` call, so a form drawn
 * here is a form that will be accepted. Drawing the door and refusing at it
 * is worse than not drawing it: the student has already decided to go
 * through by the time anybody tells them.
 */
let gateFor = new Map<string, string>();
let entryFor = new Map<string, string>();

/* Cohorts this person is in or waiting on, so a card can say which. Asking
   twice does nothing and reads as though the first request vanished. */
let cohortState = new Map<string, string>();

/* And who decided it, when, and what they said. A refusal that names nobody
   is a refusal nobody can respond to. */
let cohortDecider = new Map<string, string>();
let cohortDecidedOn = new Map<string, string>();
let cohortJoinedOn = new Map<string, string>();
let cohortNote = new Map<string, string>();

/* Cohorts this person is actually in, for the picker when starting a
   project. A pending request is not one of them. */
let myMemberships: any[] = [];

/* This person's projects, and which cohorts each is already in, so a card
   can offer the ones that are not. */
let myProjects: any[] = [];
let projectCohorts = new Map<string, Set<string>>();

/* And which opportunities each is already entered in, plus, per opportunity,
   the title of the project already holding this student's place. */
let projectEntries = new Map<string, Set<string>>();
let holdsPlace = new Map<string, string>();

const myProjectsForCohort = (cohortId: string) =>
  myProjects.filter((p: any) => !(projectCohorts.get(p.id) ?? new Set()).has(cohortId));

/**
 * The projects this person could enter in an opportunity, right now.
 *
 * Empty for two different reasons, and the card distinguishes them: nothing
 * to offer because everything is already in, and nothing offerable because
 * one of their projects is already competing here. `holdsPlace` answers the
 * second, and a card with an answer there says so instead of drawing a
 * picker the server would refuse.
 */
const myProjectsForOpportunity = (programId: string) =>
  holdsPlace.has(programId)
    ? []
    : myProjects.filter((p: any) => !(projectEntries.get(p.id) ?? new Set()).has(programId));

if (supabase && account) {
  const { data: open } = await supabase
    .from('programs')
    .select('id, name, season_year, fair_date, description, website_url, advances_to_fairs, status, kind, level, joining, places, program_role, template_id')
    .eq('status', 'open')
    .order('fair_date', { ascending: true });

  /* A shared fair is one row for every school; this school may still be
     keeping it out of sight (src/lib/hidden-programs.ts). */
  joinable = (open ?? []).filter((p: any) => !hidesProgram(org, p.template_id));


  /* One read of this person's memberships (2.9): the states for the cards
     here, and the classes joined — which was a second read of the same
     rows, ordered — derived from it below. */
  const { data: mine } = await supabase
    .from('memberships')
    .select('cohort_id, state, note, joined_at, decided_at, decided:decided_by(display_name), programs:cohort_id(name, season_year, kind, program_role)')
    .eq('user_id', account.id);

  for (const m of mine ?? []) {
    cohortState.set(m.cohort_id, m.state);
    /* Who decided, so a refusal names somebody a student can go and ask.
       The column has been recorded since the table was written; nothing had
       ever read it back. */
    const who = (m as any).decided?.display_name;
    if (who) cohortDecider.set(m.cohort_id, who);

    /* When they got in. `decided_at` is the day somebody approved it and is
       null for a cohort anybody may join, so `joined_at` is the fallback and
       the sentence below says which of the two happened. */
    const on = (m as any).decided_at ?? (m as any).joined_at;
    if (on) cohortJoinedOn.set(m.cohort_id, formatDate(on, 'long'));
    if ((m as any).decided_at) {
      cohortDecidedOn.set(m.cohort_id, formatDate((m as any).decided_at, 'short'));
    }
    if ((m as any).note) cohortNote.set(m.cohort_id, (m as any).note);
  }

  /* Newest first, because the picker below defaults to the first of these.
  
     A student who has just been let into a class and has no project yet is,
     almost always, about to start that class's project -- so the answer they
     were about to give is the one that should already be selected. Where
     somebody is in two, the one they were most recently admitted to is the
     better guess than whichever the database happened to return first.
  
     `decided_at` is null for a cohort that admits without approval, so
     `joined_at` is the fallback and the sort is stable either way. */
  const later = (v: any) => (v ? String(v) : '');
  const joined = (mine ?? [])
    .filter((m: any) => m.state === 'member')
    .map((m: any) => ({ cohort_id: m.cohort_id, decided_at: m.decided_at, joined_at: m.joined_at, programs: m.programs }))
    /* Most recently admitted first; `decided_at` is null for a cohort that
       admits without approval, so `joined_at` is the fallback. */
    .sort((a: any, b: any) => later(b.decided_at).localeCompare(later(a.decided_at)) || later(b.joined_at).localeCompare(later(a.joined_at)));

  myMemberships = joined;

  /* The person's own projects, from the middleware's one read (2.9): the
     unarchived ones, which are the only ones a fair would take. */
  myProjects = (((Astro.locals as any).projects ?? []) as { project_id: string; title: string }[]).map((p) => ({ id: p.project_id, title: p.title }));

  if (myProjects.length > 0) {
    const { data: attached } = await supabase
      .from('cohort_participations')
      .select('project_id, program_id')
      .in('project_id', myProjects.map((p: any) => p.id));

    for (const row of attached ?? []) {
      const held = projectCohorts.get(row.project_id) ?? new Set<string>();
      held.add(row.program_id);
      projectCohorts.set(row.project_id, held);
    }

    /* **Where this person's work already is, so a card offers only what the
       server would accept.**
    
       Two different refusals live in here and they need different sentences.
       A project already entered in this fair is simply not offered again. A
       project entered in this fair by *this student* means no other project
       of theirs may be entered at all -- `app.entry_conflict` refuses a
       second one, because two projects from one student compete against each
       other for one place -- and the card has to say which project holds it
       rather than presenting a picker that cannot succeed.
    
       `withdrawn` is excluded on purpose: withdrawing is how a place is given
       back, and the trigger reads it the same way. */
    const { data: entered } = await supabase
      .from('opportunity_participations')
      .select('project_id, program_id, status, projects:project_id(title)')
      .in('project_id', myProjects.map((p: any) => p.id))
      .neq('status', 'withdrawn');

    for (const row of entered ?? []) {
      const held = projectEntries.get(row.project_id) ?? new Set<string>();
      held.add(row.program_id);
      projectEntries.set(row.project_id, held);
      holdsPlace.set(row.program_id, (row as any).projects?.title ?? 'another project');
    }
  }

  const { data: gates } = await supabase.rpc('entry_gates');
  for (const g of gates ?? []) gateFor.set(g.program_id, g.reason);

  /* A program already entered shows the way in rather than the form.
   *
   * `myEntries` is one row per *project*, each carrying its entries -- so
   * `e.program_id` was undefined on every pass and `enteredIn` only ever
   * collected `undefined`. Every program therefore kept offering its entry
   * form to somebody who had already entered it. This predates the merge;
   * it is fixed here because the loop had to be read anyway.
   */
  for (const group of myEntries) {
    for (const entry of group.entries) {
      enteredIn.add(entry.program_id);
      entryFor.set(entry.program_id, entry.id);
    }
  }
}

/**
 * WHAT HAS BEEN ASKED OF WHOEVER IS READING.
 *
 * **Outside every role branch, because a nudge is addressed to a person and
 * not to a rank.** This sat inside `if (me.runsTheClub)`, so the one group
 * most likely to be nudged — students, who hold no role at all — never loaded
 * it and never saw the section. The half of the loop written for them was
 * unreachable by them.
 *
 * Read through a function because `notifications` has row level security on
 * and no policies: the outbox is closed to sessions by design, and
 * `my_nudges()` hard-codes `recipient_id = auth.uid()`.
 */
if (supabase && account) {
  const { data: nudgeRows, error: nudgeError } = await supabase.rpc('my_nudges');
  myNudges = nudgeRows ?? [];


  /* **Logged, not swallowed silently.**
  
     The first version discarded the error, on the reasoning that a page
     should not fail to render over a notice. That reasoning is right and the
     silence was not: when the section showed nothing there was no way to
     tell an empty outbox from a function that does not exist yet, and the
     answer to "why do I see no nudges" was unavailable to anybody. The page
     still renders; the terminal now says why. */
  if (nudgeError) console.error(`my_nudges: ${nudgeError.message}`);
}

/**
 * THE ELDER'S OWN TASKS.
 *
 * Read the interview questions, read the literature review, help with the
 * pitches: obligations the class puts on the Elder, on a project, with a
 * date. Nothing on a student's surface counts them; this is where they
 * count. `my_staff_tasks()` returns every one on a place this person is
 * attached to, done or not, and whether each is ready, meaning the student
 * step it waits on is met.
 */
let staffTasks: any[] = [];
if (supabase && account && me.runsTheClub) {
  const { data: taskRows, error: taskError } = await supabase.rpc('my_staff_tasks');
  if (taskError) console.error(`my_staff_tasks: ${taskError.message}`);
  staffTasks = (taskRows ?? []).map((t: any) => {
    const days = daysUntil(t.due_on, today);
    return {
      ...t,
      days,
      late: !t.completed_on && t.ready && days !== null && days < 0,
      href: `/app/project/${t.project_id}/in/${t.program_id}/#m-${t.milestone_id}`,
    };
  });
}
/* Which of these tasks is feedback on a document written in SciPath
   (6.16): the Elder reads it on its own page, with the comment boxes
   live, rather than in a Drive tab. One template per program. */
if (staffTasks.length > 0 && supabase) {
  const programIds = [...new Set(staffTasks.map((t) => t.program_id).filter(Boolean))];
  const { data: programRows } = await supabase.from('programs').select('id, template_id, process_id').in('id', programIds);
  const shaped = new Map<string, (deliverable: string) => boolean>();
  for (const g of programRows ?? []) {
    try {
      const resolved = resolveProgram(g.template_id, g.process_id ?? null);
      shaped.set(g.id, (d: string) => Boolean(resolved.deliverables.get(d)?.shape));
    } catch {
      shaped.set(g.id, () => false);
    }
  }
  for (const t of staffTasks) {
    t.docHref = t.feedback_on && shaped.get(t.program_id)?.(t.feedback_on) ? `/app/project/${t.project_id}/doc/${t.feedback_on}/` : null;
  }
}
const openTasks = staffTasks.filter((t) => !t.completed_on);
/* The next task per place, for the row in the care table: the earliest
   open one by date, whether or not the student step it waits on is met.
   This used to be the earliest *ready* one, so a row read "Help the
   family prepare their pitches" while the project's own page showed
   "Read the interview questions" a week before it, waiting on the
   student. The Workbench and the project have to name the same next
   thing; the row says when the next thing is waiting, and names the first
   ready one beside it where there is one. */
const nextTaskFor = new Map<string, any>();
const readyTaskFor = new Map<string, any>();
for (const t of [...openTasks].sort((a, b) => (a.due_on ?? '9999').localeCompare(b.due_on ?? '9999'))) {
  if (!nextTaskFor.has(t.participation_id)) nextTaskFor.set(t.participation_id, t);
  if (t.ready && !readyTaskFor.has(t.participation_id)) readyTaskFor.set(t.participation_id, t);
}
const readyTasks = [...openTasks.filter((t) => t.ready)].sort(
  (a, b) => Number(b.late) - Number(a.late) || (a.due_on ?? '9999').localeCompare(b.due_on ?? '9999')
);
const lateTasks = readyTasks.filter((t) => t.late);

/* --- What everyone else sees: the projects they are responsible for --- */
let careData: Record<string, any> | null = null;
if (supabase && account) {
  if (me.runsTheClub) {
    /* Every project at the school. Row level security decides who may run
       this at all; the heading says so, unlike the section above. */
    /* Through care_list (2.9): the six reads behind the cards — the
       projects with their authors, their places with their programs, the
       sponsors, the notebook dates, the documents under way and the
       students' obligations — as one definer read scoped by the rule once
       per project. The Elder's /app/ was 28 calls and 750 ms on the
       school's network when this was six of them. The error is logged,
       never dropped: an empty list with no reason was how the hosted
       site's first fault hid (the projects_i_see order). */
    const { data: careAnswer, error: careError } = await supabase.rpc('care_list');
    if (careError) console.error(JSON.stringify({ care_list: careError.message, path: Astro.url.pathname }));
    careData = (careAnswer ?? null) as Record<string, any> | null;
    const care = (careData ?? {}) as Record<string, any>;
    const projects = (care.projects ?? []) as any[];

    const ids = (projects ?? []).map((p: any) => p.id);

    /**
     * Per participation, not per project — and every kind of place.
     *
     * This picked one entry per project with `.find`, which is arbitrary the
     * moment a project is in two programs, and it is the reason the table
     * could not be grouped by program or carry a selection state.
     *
     * **It also read `opportunity_participations`**, which is the view that
     * excludes classes and clubs. So a project whose only place is the
     * Research Club matched nothing and rendered under *in no program* — a
     * heading that means nobody has entered it anywhere, said about a project
     * sitting in a club with an officer assigned to it. The same blind spot
     * as the notebook export (22.25) and the seed guard, in a third place.
     *
     * `participations` rather than either view, because the question is
     * everywhere this work is answerable. `programs(...)` resolves without
     * naming the key because this is a table; on a view it would have to be
     * spelled `programs:program_id` (19.9).
     */
    const entries = (care.entries ?? []) as any[];

    const sponsorRows = sponsorsFromPlaces(care.sponsor_places ?? []);

    /**
     * HOW BIG THE NOTEBOOK IS AND WHEN IT WAS LAST WRITTEN IN.
     *
     * The one fact an elder is actually looking for. "Who is behind" on a
     * notebook means "who has not written in three weeks", and the table
     * could not answer it: the link said `notebook` and gave no reason to
     * click, so the only way to find a stalled record was to open twenty of
     * them.
     *
     * A date rather than a count of days or a state, because 7.8 asks for
     * facts with dates and no computed standing. A reader who wants to know
     * whether three weeks is bad for this project in this week of the term
     * is better at that judgment than any rule we could write here.
     *
     * `occurred_on` rather than `created_at`: the notebook is ordered by the
     * day the work happened everywhere else, and two orderings of one record
     * is how a row disagrees with the page it links to.
     */
    const notebookOf = new Map<string, { count: number; last: string | null }>(
      ((care.notes ?? []) as any[]).map((n: any) => [n.project_id, { count: Number(n.count), last: n.last ?? null }])
    );

    /* Documents under way, per project: one read for the whole list
       (2.8), so the row can say "2 of 25 in progress" beside "5 of 30 met"
       without a query per project. Submitted ones are met already. */
    const inProgressOf = new Map<string, number>(((care.documents_open ?? []) as any[]).map((d: any) => [d.project_id, Number(d.count)]));


    /* Paged, because this is thirty-eight projects times thirty-two
       obligations and the API answers a thousand rows at a time. Read
       plainly, the projects past the cut had no obligations as far as the
       page could see and were reported in order (see src/lib/all-rows.ts). */
    /* The students' obligations, by date. The Elder's tasks are read
       separately, below, as the Elder's own list. */
    const milestones = (care.milestones ?? []) as any[];

    /**
     * The places this person is responsible for, and no others.
     *
     * This listed one row per participation across the whole school, which is
     * right for an unscoped advisor and wrong for an officer of one club: the
     * club's officer saw the class's projects, with the class's Elder in the
     * officer column, under a heading saying they were at their school and a
     * count saying how many needed attention. None of it was theirs to act on.
     *
     * A project in no program is kept only for somebody unscoped. It is the
     * project an advisor most needs to see — nobody has entered it anywhere,
     * so no program's officer has any claim on it — and showing it to every
     * officer of every club is how one unattached project appears in five
     * queues at once.
     */
    const runsAnywhere = me.anywhere;
    const runs = (programId?: string | null) =>
      runsAnywhere || (programId ? me.scopes.includes(programId) : false);

    const pairs = (projects ?? []).flatMap((p: any) => {
      const its = (entries ?? [])
        .filter((e: any) => e.project_id === p.id)
        .filter((e: any) => runs((e.programs as any)?.id));

      if (its.length) return its.map((entry: any) => ({ p, entry }));
      return runsAnywhere ? [{ p, entry: null }] : [];
    });

    watched = pairs.map(({ p, entry }: any) => {
      const mine = (milestones ?? []).filter((m: any) => m.participation_id === entry?.id);

      const findings = checkDateOrder({
        startedOn: p.started_on,
        today,
        obligations: mine.map((m: any) => ({
          id: m.id,
          name: m.name,
          dueOn: m.due_on,
          completedOn: m.completed_on,
          blocksExperimentation: m.blocks_experimentation,
          required: m.required,
        })),
      });

      const officers = (p.project_authors ?? []).filter((a: any) => a.role === 'officer');
      const projectAuthors = (p.project_authors ?? []).filter((a: any) => a.role === 'author');
      const selfManaged = (p.project_authors ?? []).filter(
        (a: any) => a.role === 'officer' && a.self_managed_at
      );
      const sponsor = sponsorRows.find((s) => s.project_id === p.id) ?? null;
      const worst = worstFinding(findings);

      return {
        ...p,
        entry,
        authors: projectAuthors,
        officers,
        selfManaged,
        sponsor,
        notebook: notebookOf.get(p.id) ?? { count: 0, last: null },
        done: stepProgress(mine).done,
        total: stepProgress(mine).total,
        inProgress: inProgressOf.get(p.id) ?? 0,

        /* Where the project is: the next thing not done, by date. Undated
           steps sort last, because a step nobody has scheduled is not the
           next thing to worry about.
         
           Events are skipped. "Applications open" is a day on the fair's
           calendar rather than something anybody does, and a column of forty
           projects all reading "Applications open" says nothing about any of
           them. */
        next:
          mine
            .filter((m: any) => !m.completed_on && m.kind !== 'event')
            .sort(byDueThenOrder)[0] ??
          mine
            .filter((m: any) => !m.completed_on)
            .sort(byDueThenOrder)[0] ??
          null,
        worst,

        /* **Who the nudge goes to, decided rather than asked.**
        
           The Elder where one is assigned, the student where none is. That
           preserves the hierarchy without a dropdown: a teacher chasing a
           project that has somebody looking after it should be chasing that
           person, and a project with nobody is exactly the case `assess()`
           already reports as "No club officer". So the verdict that flags an
           unattended project is also the routing rule, and neither had to be
           written twice.
        
           A self-managed author holds the oversight row for their own work,
           which would address the nudge to the person it is about. The
           function returns `self` rather than sending, and this skips them so
           the button does not appear in the first place.
        
           First name only. The full name is already in the Students column
           two cells to the left, and a button reading "Nudge Priya
           Raghunathan" is a button that sets the width of the table. */
        nudgeTos: ((): { id: string; first: string }[] => {
          /**
           * **WHO MAY BE NUDGED DEPENDS ON WHO IS ASKING.**
           *
           * This picked the Elder wherever one existed, whoever was looking.
           * An Elder reading the class therefore got *Nudge dm_officer2* on
           * a project another Elder oversees — officer nudging officer, which
           * is not one of the two arrangements that exist:
           *
           *   A teacher nudges the Elder, or the student.
           *   An Elder nudges the students on the participations they oversee.
           *
           * `public.nudge` already refused it — the caller must be the
           * advisor or the officer attached to that participation — so the
           * button was offering an action guaranteed to fail. A control that
           * cannot succeed is worse than no control: it reads as a permission
           * somebody has, right up until they use it.
           *
           * A self-managed officer row is the author wearing the oversight
           * hat, so it is skipped rather than preferred: addressing the
           * nudge there sends it to the person it is about.
           */
          /* **Every Elder on the place, not the first one found.** A class
             pairs two Elders with a project, and a teacher's nudge went to
             whichever the query listed first, with no way to reach the
             other. Each gets their own button and their own track, because
             the state is per recipient (7.14) and one button for two people
             would report one person's answer as both. */
          const elders = officers.filter(
            (o: any) => !o.self_managed_at && o.users?.id && o.users.id !== account?.id
          );
          const student = projectAuthors.find(
            (a: any) => a.users?.id && a.users.id !== account?.id
          );
          const named = (who: any) => ({
            id: who.users.id as string,
            first: String(who.users.display_name ?? '').split(' ')[0] || 'them',
          });

          /* An advisor reaches the whole program, so the Elders are the
             right default: chasing through whoever looks after the project
             is the point of having assigned them. */
          if (me.isAdvisor || me.anywhere) {
            if (elders.length > 0) return elders.map(named);
            return student?.users?.id ? [named(student)] : [];
          }

          /* An officer, and only for what they oversee. Attachment is a row
             on this participation, not a role over the program — which is
             the same distinction `reachesProgram` draws, and the reason an
             Elder sees a colleague's project without being able to act on
             it. */
          const attached = officers.some(
            (o: any) => o.users?.id && o.users.id === account?.id
          );

          if (!attached) return [];

          return student?.users?.id ? [named(student)] : [];
        })(),

        /* **The one fact the table never showed.**
        
           `next` names the obligation and said nothing about when it is due,
           so "Form 1" read identically sixty days out and six days late. This
           is what `queueRank` sorts on and what the row now says. */
        daysToNext: daysUntil(
          mine
            .filter((m: any) => !m.completed_on && m.kind !== 'event' && m.due_on)
            .sort(byDueThenOrder)[0]?.due_on ?? null,
          today
        ),

        verdict: assess({
          worst,
          hasOfficer: officers.length > 0 || selfManaged.length > 0,
          hasSponsor: Boolean(sponsor),
          startedOn: p.started_on,
          obligationsDone: stepProgress(mine).done,
          obligationsTotal: stepProgress(mine).total,
        }),
      };
    });

    /* **What has already been asked for, and whether it worked.**
    
       One call per participation rather than one per row, and only for the
       rows that have an entry: a project in no program has no participation
       to read against. Without this the button is a message into the dark —
       a teacher sees no evidence that she nudged yesterday, sends the same
       one again, and learns nothing about whether nudging does anything.
    
       Failures are ignored on purpose. A screen that will not render because
       the nudge history could not be read is a screen that loses the
       disqualification counter over a decoration. */
    const nudgeByMilestone = new Map<string, any>();

    /* One call for every place at once (2.9): this was one `nudge_state`
       per place, forty round trips for the advisor. */
    const watchedIds = [...new Set(watched.map((w: any) => w.entry?.id).filter(Boolean))];
    if (watchedIds.length > 0) {
      const { data, error: stateError } = await supabase.rpc('nudge_states', { p_participation_ids: watchedIds });
      if (stateError) console.error(`nudge_states: ${stateError.message}`);
      /* Keyed on both, because a track is per obligation *and* per
         recipient. Keyed on the milestone alone, an Elder's own row
         showed the count of a nudge her teacher had sent to her, labelled
         as one she had sent to the student. */
      for (const row of ((data ?? []) as any[])) {
        nudgeByMilestone.set(`${row.milestone_id}:${row.recipient_id}`, row);
      }
    }

    for (const w of watched) {
      w.nudges = new Map<string, any>();
      if (!w.next) continue;
      for (const to of w.nudgeTos) {
        const row = nudgeByMilestone.get(`${w.next.id}:${to.id}`);
        if (row) w.nudges.set(to.id, row);
      }
    }

    const { data: rows } = await supabase
      .from('user_roles')
      .select('user_id, role, users:user_id(id, display_name)')
      .is('revoked_at', null)
      .in('role', ['mentor', 'officer']);

    const seen = new Set<string>();
    staffPeople = (rows ?? []).filter((r: any) => {
      if (!r.users?.id || seen.has(r.users.id)) return false;
      seen.add(r.users.id);
      return true;
    });
  }
}

const fmt = (d: string | null) => formatDate(d, 'long', 'To be announced');

/* There was a stageLabel map here, five literals describing a competition's
   lifecycle. Where a project is comes from its steps now: the next one that
   is not done, which is both more accurate and more useful than a bucket
   name, because it says what to do rather than roughly where you are. */

/* An officer sees every project by role and looks after the ones assigned to
   them. Counting the first as "in my care" told Marchetti she was
   responsible for a project nobody had given her. */
/* And never the reader's own project. An Elder with a project of their own
   in the class holds the oversight row for it (self managed), which put it
   in their care list beside the students they look after; it is in *My
   research*, which is where they work on it. */
const mine = watched.filter((w) =>
  !w.authors.some((a: any) => a.users?.id === account?.id) &&
  (w.officers.some((o: any) => o.users?.id === account?.id) ||
    w.selfManaged.some((o: any) => o.users?.id === account?.id))
);

/**
 * **The remainder: what nobody has taken.**
 *
 * 6.9 gives an officer exactly `mine ∪ unattached`, and decision 67 records
 * the agreed split. One list of both put the project somebody is
 * responsible for beside the project nobody is, under a heading that
 * suggested they were the same job. They are opposite jobs: one is work to
 * chase and the other is work to claim, and the second list is the only one
 * on the page whose purpose is that it should be empty.
 *
 * For an advisor, who reaches every project in the program, `mine` is what
 * they were assigned and the remainder is *no officer attached* rather than
 * *everybody else's* — the same rule, and the sentence under the heading
 * says which reading applies.
 */
const unattached = (w: any) => w.officers.length === 0 && w.selfManaged.length === 0;


/**
 * WHICH CLASSES A NEW PROJECT COULD STILL BELONG TO.
 *
 * A class holds one place per student, so a cohort that already has this
 * student's project in it cannot take a second. Offering it anyway produces a
 * picker whose ordinary choice is refused by the server, which is the failure
 * mode `holdsPlace` was written to avoid one screen further down.
 *
 * Read off `myEntries` rather than queried again: it already carries every
 * cohort each of this person's projects sits in, and a second query would be
 * a second thing to keep true.
 */
const cohortsTaken = new Set(
  myEntries.flatMap((e: any) => (e.cohorts ?? []).map((c: any) => c.program_id))
);

const startableCohorts = myMemberships.filter((m: any) => !cohortsTaken.has(m.cohort_id));

/**
 * **Whether this person has work of their own.**
 *
 * Decision 67: the personal half was gated on `me.isStudent ||
 * !me.runsTheClub`, a role question standing in for a data question. An
 * officer recorded with `population: staff` is a student who runs the club,
 * and that gate removed their own projects from their own overview with
 * nothing said. Ask what it means instead: has this person a project, a
 * class, or no oversight duty at all — the last so that somebody brand new
 * still meets the place where work begins.
 */
const hasOwnWork = myEntries.length > 0 || myMemberships.length > 0 || !me.runsTheClub;

/**
 * **THE FIGURES ON THE COVER, AND WHAT EACH ONE LEADS TO.**
 *
 * Two rows at most: the reader's own work, and the work in their care. A
 * student has the first, a teacher the second, an Elder both. Every figure
 * is paired with the one verb that acts on it, because a number with
 * nothing to do about it is a number somebody reads and closes the tab.
 */
const myOverdue = dueNow.filter((d: any) => d.late);
const myNext = dueNow[0] ?? null;
const myNotebookAge = myLastNote ? daysUntil(myLastNote, today) : null;

/* The project a notebook link opens: the one with the nearest obligation,
   else the newest. An Elder with one project and a student with two both
   land somewhere sensible. */
const notebookProject = myNext?.projectId ?? myEntries[0]?.project?.id ?? null;

/* What the care figures count. Assigned work where there is any; otherwise
   everything this person can see, which is a teacher's ordinary case. */
const careRows = mine.length > 0 ? mine : watched;

/**
 * **Questions waiting on the projects in this person's care.**
 *
 * A student's line on a field of a document (a question, a note) with no
 * staff reply after it. The thread lives on the document page; this is
 * the row that says one is waiting, because a question nobody sees is a
 * question nobody answers (2.8). Last fourteen days, newest first.
 */
type Waiting = { id: string; projectId: string; projectTitle: string; who: string; deliverable: string; label: string; field: string | null; body: string; when: string };
let waiting: Waiting[] = [];
const answered: { who: string; asker: string; label: string; body: string; when: string; href: string }[] = [];
if (supabase && careRows.length > 0) {
  /* From care_list (2.9): the documents of the projects in care and the
     last fortnight's lines on them came with the cards' read. */
  const careIds = new Set<string>(careRows.map((w: any) => w.id));
  const docs = ((careData as any)?.documents ?? []).filter((d: any) => careIds.has(d.project_id)) as any[];
  const docOf = new Map<string, any>(docs.map((d: any) => [d.id, d]));
  if (docOf.size > 0) {
    const lines = (((careData as any)?.lines ?? []) as any[]).filter((c: any) => docOf.has(c.document_id));
    const authorIds = new Map<string, Set<string>>();
    for (const w of careRows) authorIds.set(w.id, new Set((w.authors ?? []).map((a: any) => a.users?.id).filter(Boolean)));
    const last = new Map<string, any>();
    for (const c of lines ?? []) last.set(`${c.document_id}:${c.field_id ?? ''}`, c);
    const titleOfProject = new Map<string, string>(careRows.map((w: any) => [w.id, w.title]));
    /* Answered (2.8): a question a student asked that somebody else has
       since answered, last seven days. The row left the plate when the
       answer was the last line; this is how the other Elder on the same
       project learns it was handled, and by whom, with the way back to
       the thread. The reader's own answers are not news to them. */
    const byThread = new Map<string, any[]>();
    for (const c of lines ?? []) { const k = `${c.document_id}:${c.field_id ?? ''}`; if (!byThread.has(k)) byThread.set(k, []); byThread.get(k)!.push(c); }
    const weekAgo = new Date(Date.now() - 7 * 86400000).toISOString();
    for (const thread of byThread.values()) {
      const lastLine = thread[thread.length - 1];
      const d = docOf.get(lastLine.document_id);
      const authors = authorIds.get(d?.project_id);
      if (!d || !authors || authors.has(lastLine.author_id) || lastLine.author_id === account?.id || lastLine.created_at < weekAgo) continue;
      const question = [...thread].reverse().find((c: any) => authors.has(c.author_id));
      if (!question) continue;
      answered.push({
        who: String(lastLine.author?.display_name ?? 'Somebody').split(' ')[0],
        asker: String(question.author?.display_name ?? 'a student').split(' ')[0],
        label: d.deliverable.replace(/_/g, ' '),
        body: String(question.body_md ?? '').slice(0, 90),
        when: String(lastLine.created_at).slice(0, 10),
        href: `/app/project/${d.project_id}/doc/${d.deliverable}/#c-${lastLine.id}`,
      });
    }
    answered.sort((a, b) => b.when.localeCompare(a.when));
    waiting = [...last.values()]
      .filter((c: any) => !c.seen_at && authorIds.get(docOf.get(c.document_id)?.project_id)?.has(c.author_id))
      .map((c: any) => {
        const d = docOf.get(c.document_id);
        return {
          id: c.id, projectId: d.project_id, projectTitle: titleOfProject.get(d.project_id) ?? 'A project',
          who: String(c.author?.display_name ?? 'A student').split(' ')[0], deliverable: d.deliverable, label: d.deliverable.replace(/_/g, ' '),
          field: c.field_id ?? null, body: String(c.body_md ?? '').slice(0, 140), when: String(c.created_at).slice(0, 10),
        };
      })
      .sort((a, b) => b.when.localeCompare(a.when));
  }
}
const careOverdue = careRows.filter((w: any) => w.daysToNext !== null && w.daysToNext < 0);
const careQuiet = careRows.filter((w: any) => {
  const age = w.notebook.last ? daysUntil(w.notebook.last, today) : null;
  return age === null || age <= -14;
});

const showWork = hasOwnWork && myEntries.length > 0;

/* The reader's own lines on the plate: everything late, then everything
   due inside a week, at most three, the same rule the project page keeps. */
/* One row per project (2.8): the latest of the late, else the nearest
   due, in the template's order when the dates tie. Three rows for one
   project read as a list of chores, not a next step. */
const askFor = (milestoneId: string) => {
  const n = myNudges.find((x: any) => x.milestone_id === milestoneId && !x.relay_to_id);
  if (!n) return undefined;
  return { milestoneId, askedBy: n.asked_by ?? null, askedOn: n.asked_at ? formatDate(String(n.asked_at).slice(0, 10), 'short') : null, times: Number(n.times ?? 1), acknowledged: Boolean(n.acknowledged_at) };
};
const myPlate = (() => {
  const seen = new Set<string>();
  const out: any[] = [];
  /* What an Elder asked for comes first, whatever its date: the ask sits
     on the row it is about, so the nudged step is the project's row. */
  const asked = dueNow.filter((d: any) => askFor(d.id)).sort((a: any, b: any) => String(myNudges.find((x: any) => x.milestone_id === b.id)?.asked_at ?? '').localeCompare(String(myNudges.find((x: any) => x.milestone_id === a.id)?.asked_at ?? '')));
  for (const d of [...asked, ...dueNow.filter((d: any) => d.late), ...dueNow.filter((d: any) => !d.late && d.days !== null && d.days <= 7)]) {
    if (seen.has(d.projectId)) continue;
    seen.add(d.projectId);
    out.push(d);
  }
  return out;
})();
/* And the notebook line only when it is a week quiet. */
const myNotebookQuietWeek = myNotebookAge === null || myNotebookAge <= -7;

/* What came back on the projects in the reader's care, last seven days:
   replies to their nudges, and obligations met after one. One line each. */
const cameBack: { who: string; what: string; when: string | null }[] = [];
for (const w of mine) {
  for (const to of w.nudgeTos ?? []) {
    const n = w.nudges?.get(to.id);
    if (!n) continue;
    if (n.reply && n.replied_at && (daysUntil(String(n.replied_at).slice(0, 10), today) ?? -99) >= -7) {
      cameBack.push({ who: to.first, what: `replied on ${w.next?.name ?? 'a nudge'}: "${n.reply}"`, when: formatDate(String(n.replied_at).slice(0, 10), 'short') });
    } else if (n.met_after) {
      cameBack.push({ who: to.first, what: `met ${w.next?.name ?? 'the obligation'} after your nudge`, when: null });
    }
  }
}
const dayUnit = (days: number | null, late: boolean) =>
  days === null ? 'no date' : late ? 'days late' : days === 0 ? 'due today' : 'days left';

/* The other Elders on a project, by project, for a task both hold (2.9):
   the row says "also Rohan's", so two Elders do not both read the same
   literature review, or both leave it to the other. */
const otherElders = new Map<string, string[]>();
for (const w of careRows) {
  otherElders.set(w.id, (w.officers ?? []).filter((o: any) => o.users && o.users.id !== account?.id).map((o: any) => String(o.users.display_name).split(' ')[0]));
}
const alsoLine = (projectId: string) => {
  const others = otherElders.get(projectId) ?? [];
  return others.length ? ` · also ${others.join(' and ')}'s` : '';
};

/* The rows, in the order to do them: one rule for the whole plate (2.9),
   late first, then the nearest date, with a question counted as due
   today because it is somebody stuck. The kicker says what kind of row
   it is; the position says only how urgent. Before this the rows came
   by kind, questions then tasks then the reader's own work, and an
   Elder with a project of her own saw her task at eight days wearing
   the gold above her own deliverable due in two. */
const plateRows = [
  ...waiting.map((q) => ({
    id: `q-${q.id}`,
    n: daysUntil(q.when, today),
    unit: daysUntil(q.when, today) === 0 ? 'today' : daysUntil(q.when, today) === -1 ? 'day ago' : 'days ago',
    kick: 'Question',
    title: `${q.who} on ${q.label}`,
    group: q.projectTitle,
    sub: q.body,
    /* A question wants an answer (2.8): the row leaves when the Elder's
       reply is the last line on that field. No other way to close it. */
    actions: [{ href: `/app/project/${q.projectId}/doc/${q.deliverable}/${q.field ? `#f-${q.field}` : ''}`, label: 'Answer', accent: true }],
  })),
  ...readyTasks.map((t) => ({
    id: `task-${t.milestone_id}`,
    n: t.days,
    unit: dayUnit(t.days, t.late),
    late: t.late,
    kick: 'Yours to do',
    title: t.name,
    group: t.project_title,
    sub: `${t.authors.join(', ') || 'the student'}${t.due_on ? ` · due ${formatDate(t.due_on, 'short')}` : ''}${alsoLine(t.project_id)}`,
    /* A task on a document written in SciPath has one verb: read it. The
       feedback is given at the foot of the document, where the rubric and
       the Elder's part are, not in a box on the plate (2.8). */
    actions: t.docHref ? [{ href: t.docHref, label: 'Read it', accent: true }] : [{ href: t.href, label: 'Open' }],
    form: t.docHref
      ? undefined
      : t.feedback_on && t.deliverable_id
        ? { kind: 'feedback' as const, deliverableId: t.deliverable_id }
        : { kind: 'task' as const, milestoneId: t.milestone_id },
  })),
  ...(showWork
    ? myPlate.flatMap((d: any) => {
        const base = {
          n: d.days,
          unit: dayUnit(d.days, d.late),
          late: d.late,
          kick: d.late ? 'Overdue' : 'Next up',
          group: d.projectTitle,
          /* "Your project" (2.9): on a plate that also carries other
             people's projects, whose this one is has to be said. A
             student who is nobody's Elder has only their own rows, and
             the words would be noise there. */
          sub: [me.runsTheClub ? 'Your project' : '', d.dueOn ? `due ${formatDate(d.dueOn, 'short')}` : ''].filter(Boolean).join(' · ') || undefined,
          ask: askFor(d.id),
        };
        /* A step written in SciPath is a row per document, each with the
           one verb, so a step that wants two documents never puts two
           long buttons on one row (2.8). */
        if (d.docs.length > 0) {
          return d.docs.map((doc: any) => {
            const st = docStandingOn(d.projectId, doc.id, doc.shape ?? null);
            const waits: string[] = d.waitsOn ?? [];
            return {
              ...base,
              title: d.docs.length > 1 ? doc.name : d.name,
              sub: `${base.sub ? `${base.sub} · ` : ''}${waits.length ? `Waits on ${waits.join(', ')}` : st.label}`,
              actions: [{ href: doc.href, label: waits.length ? 'Start' : st.verb, accent: true, waitsOn: waits.length ? waits.join(', ') : undefined }],
            };
          });
        }
        /* Recorded here, on the row, the same form the project page's
           plate folds open; the link goes to the ledger row for the
           record itself. */
        return [{
          ...base,
          title: d.name,
          form: d.items.length > 0
            ? { kind: 'record' as const, participationId: d.participationId, milestoneId: d.id, today, items: d.items }
            : { kind: 'done' as const, participationId: d.participationId, milestoneId: d.id, name: d.name, milestoneKind: d.kind ?? 'other', today },
          actions: [{ href: d.href, label: 'In the ledger' }],
        }];
      })
    : []),
  /* No notebook row (2.8): the notebook has its page and its button. */
].sort((a: any, b: any) => {
  /* Late before not late, the later the earlier; then by days left, a
     question at zero; a row with no date last. Ties keep the order the
     rows were assembled in, which is the template's. */
  const key = (r: any) => (r.kick === 'Question' ? 0 : r.n === null || r.n === undefined ? 1e9 : r.late ? r.n : Math.max(0, r.n));
  return key(a) - key(b);
});
const showCare = me.runsTheClub && watched.length > 0;

/* The sections this person has, in the order they appear. Built from the
   same conditions that render them, so a link can never point at a heading
   that is not on the page. The count beside each is what the section holds,
   so the row says which ones have anything in them before anybody scrolls.

   *Unclaimed* is gone from here: a project nobody has taken is the assign
   queue's business, and this page is where the work gets done. One line
   under the care list says how many there are and points at the queue. */
/* The nudges that ask this person to chase somebody else; their own are on the plate. */
const relayedNudges = myNudges.filter((n: any) => n.relay_to_id);
/* A section the org file keeps off for the pilot (`hidden_until`), the
   same rule the bars use; the page still answers for the rest. */
const hidden = (key: string) => Boolean(org.hiddenUntil && org.hiddenUntil.surfaces.includes(key) && new Date().toISOString().slice(0, 10) < org.hiddenUntil.date);
const jumps = [
  relayedNudges.length > 0 && { id: 'asked', label: 'Asked of you', n: relayedNudges.length, late: true },
  showCare && { id: 'care', label: 'In my care', n: mine.length || watched.length, late: careOverdue.length > 0 },
  hasOwnWork && { id: 'research', label: 'My research', n: myEntries.length || null },
  hasOwnWork && myReviews.length > 0 && { id: 'review', label: 'To review', n: myReviews.length },
  hasOwnWork && !hidden('programs') && { id: 'join', label: 'Programs', n: null },
  hasOwnWork && !hidden('past') && { id: 'past', label: 'Past seasons', n: null },
].filter(Boolean) as { id: string; label: string; n: number | null; late?: boolean }[];

/* The number a section head shows, read off the jump row so the two agree
   and a section that is absent never leaves a gap in the count. */
const no = (id: string) => String(jumps.findIndex((j) => j.id === id) + 1).padStart(2, '0');

/* How many days, said the way a person says it. */
const daysWord = (days: number | null) =>
  days === null
    ? 'no date'
    : days < 0
      ? `${Math.abs(days)} ${Math.abs(days) === 1 ? 'day' : 'days'} late`
      : days === 0
        ? 'due today'
        : `${days} ${days === 1 ? 'day' : 'days'} left`;

/**
 * The oversight table, grouped by program.
 *
 * This and the selection screen were the same list of the same projects with
 * six of seven columns in common, and the seventh — the selection state —
 * is a column rather than a page. So selection moved here and that route
 * redirects.
 *
 * Grouped because the club and the class are not one decision: an advisor
 * putting projects forward to a fair is not choosing which class projects
 * are good, and a cap belongs to a program. Grouping also lets the staff
 * column say the program's own word, which one table could not.
 */
/* The Everything / Selected / No sponsor / Disqualifying bar is gone.
   Selected and Disqualifying were the research club's questions asked of a
   class, and "No sponsor" answered with a zero that read as nothing in
   anybody's care. What replaces it is a filter on the state of the work,
   and that is designed on its own rather than dropped in here. */
const shown = watched;

const groupsOf = (rows: any[]) => {
  const by = new Map<string, { program: any; rows: any[] }>();

  for (const row of rows) {
    const program = row.entry?.programs ?? null;
    /* A project in no program is still somebody's to look after, and it
       groups under its own heading rather than vanishing. */
    const key = program?.id ?? 'none';
    const held = by.get(key) ?? { program, rows: [] };
    held.rows.push(row);
    by.set(key, held);
  }

  /* **Rows in the order somebody should act on them.**

     They arrived in whatever order the query returned, which is neither
     alphabetical nor useful, and the verdict that says which ones matter was
     rendered as the eighth column. `queueRank` turns that verdict into the
     sort: lost first, then by how little time is left, then the ones in
     order. Title breaks a tie so the sequence is stable between renders and
     a teacher can find a row where she last saw it. */
  /* **The reader's own task first.** The list is the Elder's work as much
     as the students', and a row with something the Elder can do today
     belongs above one where they are waiting on a student: late ready
     tasks, then ready by date, then everything else in the order the
     verdict gives. A teacher has no tasks and sees the verdict order. */
  const myTaskRank = (w: any): number => {
    const t = w.entry ? readyTaskFor.get(w.entry.id) : null;
    if (!t) return 1_000_000;
    return (t.days ?? 9999) + (t.late ? -100_000 : 0);
  };
  /* The reader's own project last (2.8): the list is what is in their
     care; their own is on the plate and the project page already. */
  const ownIds = new Set(myEntries.map((e: any) => e.project?.id).filter(Boolean));
  const ownLast = (w: any) => (ownIds.has(w.id) ? 1 : 0);
  for (const held of by.values()) {
    held.rows.sort(
      (a: any, b: any) =>
        ownLast(a) - ownLast(b) ||
        myTaskRank(a) - myTaskRank(b) ||
        queueRank({ verdict: a.verdict, daysToNext: a.daysToNext }) -
          queueRank({ verdict: b.verdict, daysToNext: b.daysToNext }) ||
        (a.title ?? '').localeCompare(b.title ?? '')
    );
  }

  return [...by.values()].sort((a, b) => {
    if (!a.program) return 1;
    if (!b.program) return -1;
    return (a.program.name ?? '').localeCompare(b.program.name ?? '');
  });
};

/* The same grouping, over what this person looks after. Somebody with
   nothing assigned sees everything they can reach, which is a teacher's
   ordinary case; an Elder sees their own. What nobody has taken is counted
   here and listed on the assign page, where taking it is one click. */
/* The teacher's cards, by family (2.9): the Elders work in pairs and the
   teacher reads the class as families, the way the tracker names them
   ("Elders: Aanya Padhi, Yutong Chen"). A project's family is the set of
   its Elders, so a project with two is under the pair once, a project
   with one under that name, and one with nobody last, under its own
   heading, since that is the list to act on. An Elder keeps the grouping
   by program. */
const byElder = (rows: any[]): { program: any; elder: string | null; rows: any[] }[] => {
  const out = new Map<string, { program: any; elder: string | null; rows: any[] }>();
  for (const w of rows) {
    const elders = (w.officers ?? []).filter((o: any) => o.users?.display_name).map((o: any) => String(o.users.display_name)).sort((a: string, b: string) => a.localeCompare(b));
    const name = elders.length ? elders.join(', ') : null;
    const key = name ?? '\u0000';
    if (!out.has(key)) out.set(key, { program: w.entry?.programs ?? null, elder: name, rows: [] });
    out.get(key)!.rows.push(w);
  }
  return [...out.values()].sort((a, b) => (a.elder === null ? 1 : b.elder === null ? -1 : a.elder.localeCompare(b.elder)));
};
const careGroups = me.isAdvisor && platform.teacherWorkbench
  ? byElder(shown.filter((w: any) => !unattached(w)))
  : groupsOf(shown.filter((w: any) => !unattached(w)));
const groups = groupsOf(shown);

/* What `watched` is a list of, said in the words of whoever is reading it.
   One phrase, derived once, because the count appears twice and two copies
   of a noun are two chances to disagree about what was counted.
 
   After `groups`, not beside `counts`: it reads the grouping to name a
   single program, and a const that reads a const declared below it is a
   reference error at request time rather than a build failure. */
const where = me.anywhere
  ? 'at the school'
  : groups.length === 1 && groups[0].program
    ? `in ${programTitle(groups[0].program)}`
    : 'in your programs';

/* Selected against the cap, per program. Only a competition selects: a class
   has nowhere to put projects forward to, so the column is absent rather
   than empty. */
const selects = (program: any) => program?.kind === 'competition';

function standingOf(group: { program: any; rows: any[] }) {
  const chosen = group.rows.filter((r) => r.entry?.selection_state === 'selected').length;
  const cap = group.program?.selection_cap ?? null;
  if (!selects(group.program)) return `${group.rows.length} in progress`;
  return cap ? `${chosen} of ${cap} selected` : `${chosen} selected`;
}

/* --- Grouped, because a mixed list is read as a mixed list ---------------
 *
 * Six cards in one grid put a class between two fairs and a grant beside a
 * journal, and a reader deciding what to do had to sort them by eye first.
 * They are different acts -- you join a class, you enter a fair, you apply
 * for a grant -- so the grouping is by act rather than by date.
 *
 * Classes and clubs first: joining one is the ordinary path and the one that
 * decides a project's process, and 22.4 says the interface should offer it
 * before the solo route. Fairs next, because that is what most of them are
 * preparing for. Grants and the journal last, since both are things you do
 * with work that already exists.
 */
const GROUPS: { id: string; title: string; blurb: string; holds: (p: any) => boolean }[] = [
  {
    id: 'cohorts',
    title: 'Classes and clubs',
    blurb: 'A group you belong to, with its own calendar and its own teacher.',
    holds: (p) => p.program_role === 'cohort',
  },
  {
    id: 'fairs',
    title: 'Fairs',
    blurb: 'Where a project is judged. You enter one with a project.',
    holds: (p) => p.program_role !== 'cohort' && p.kind === 'competition',
  },
  {
    id: 'grants',
    title: 'Grants',
    blurb: 'Money for research you are doing. You apply with a project.',
    holds: (p) => p.program_role !== 'cohort' && p.kind === 'grant',
  },
  {
    id: 'publishing',
    title: 'Publishing',
    blurb: 'Where finished work is read.',
    holds: (p) => p.program_role !== 'cohort' && ['publication', 'showcase'].includes(p.kind),
  },
];

/* Anything a group does not claim still appears, rather than vanishing
   because somebody added a kind and not a group. */
const grouped = () => {
  const seen = new Set<string>();
  const out = GROUPS.map((g) => {
    const items = joinable.filter((p: any) => g.holds(p));
    for (const p of items) seen.add(p.id);
    return { ...g, items };
  }).filter((g) => g.items.length > 0);

  const rest = joinable.filter((p: any) => !seen.has(p.id));
  if (rest.length > 0) {
    out.push({
      id: 'other',
      title: 'Everything else',
      blurb: '',
      holds: () => true,
      items: rest,
    } as any);
  }
  return out;
};

/* Who fell back to polling in the last day, for the advisor's one line
   (2.8). The policy answers with nothing for anybody else. */
const fellBack: string[] = [];
if (supabase && me.isAdvisor) {
  const { data: inc } = await supabase
    .from('transport_incidents')
    .select('state, created_at, users:user_id(display_name)')
    .eq('state', 'fallback')
    .gt('created_at', new Date(Date.now() - 24 * 3600 * 1000).toISOString())
    .order('created_at', { ascending: false })
    .limit(200);
  for (const r of inc ?? []) { const n = (r as any).users?.display_name ?? '?'; if (!fellBack.includes(n)) fellBack.push(n); }
}

/* Which arrangement the care list takes (2.8): `grid` (three across) for
   an Elder's family, `wide` (one column) for a teacher's class, which is
   longer and reads down the page. `?care=grid|wide` overrides and is kept
   in a cookie, so the switch exists before any control for it does. */
const careChoice = (() => {
  const q = Astro.url.searchParams.get('care');
  if (q === 'grid' || q === 'wide') { Astro.cookies.set('sp_care', q, { path: '/app/', sameSite: 'lax', maxAge: 60 * 60 * 24 * 365 }); return q; }
  const c = Astro.cookies.get('sp_care')?.value;
  return c === 'grid' || c === 'wide' ? c : null;
})();
const careLayout = (group: any): 'grid' | 'wide' => {
  if (careChoice) return careChoice;
  const runsIt = group.program?.id ? classesRun.some((c) => c.program_id === group.program.id) : false;
  /* The same cards as the Elder's, three across, when the teacher works
     from the Workbench (2.9); the one wide column was the class page's. */
  if (platform.teacherWorkbench && me.isAdvisor) return 'grid';
  return runsIt || me.isAdvisor ? 'wide' : 'grid';
};

