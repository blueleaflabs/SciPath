---
export const prerender = false;

import Base from '../../layouts/Base.astro';
import { formatDate } from '../../lib/dates';
import AppShell from '../../components/AppShell.astro';
import { activeOrg } from '../../lib/tenant';
import { serverClient } from '../../lib/supabase';
import { standing, roleLabel } from '../../lib/roles';
import { checkDateOrder, worstFinding } from '../../lib/dateOrder';
import { assess, tally } from '../../lib/attention';

const { configured, session, account, roles } = Astro.locals;
const org = activeOrg(Astro);
/* Ours, not the provider's. See the comment in middleware.ts: sharing the
   `error` parameter with Supabase produced a redirect loop. */
const signin = Astro.url.searchParams.get('signin');

if (configured && session && !account) return Astro.redirect('/app/welcome/');

const me = standing(roles, account?.population);
const today = new Date().toISOString().slice(0, 10);

const supabase = account
  ? serverClient(Astro.request, Astro.cookies, (Astro.locals as any).runtime?.env)
  : null;

let error2: string | null = null;

let cleared: number | null = null;

/* Attaching someone to a project. Either club role may do it. */
if (Astro.request.method === 'POST' && supabase && me.runsTheClub) {
  const form = await Astro.request.formData();

  if (String(form.get('action')) === 'detach') {
    const { error: e } = await supabase.rpc('detach_from_project', {
      p_project_id: String(form.get('project_id') ?? ''),
      p_user_id: String(form.get('user_id') ?? ''),
    });
    if (e) error2 = e.message;
  } else {
    const { data, error: e } = await supabase.rpc('attach_to_project', {
      p_project_id: String(form.get('project_id') ?? ''),
      p_user_id: String(form.get('user_id') ?? ''),
      p_role: String(form.get('role') ?? 'mentor'),
      p_dated: String(form.get('dated') ?? '') || null,
    });
    if (e) error2 = e.message;
    else cleared = data ?? 0;
  }
}

/* --- What a student sees: their own entries -------------------------- */
let myEntries: any[] = [];
let myReviews: any[] = [];
let myManuscripts = new Set<string>();

/* --- What everyone else sees: the projects they are responsible for --- */
let watched: any[] = [];
let staffPeople: any[] = [];

if (supabase && account) {
  if (me.isStudent || !me.runsTheClub) {
    /* Scoped by authorship. The policy lets an officer read every entry at
       the school, which is right for the club table below and wrong for a
       section headed "this season". */
    const { data: authored } = await supabase
      .from('project_authors')
      .select('project_id')
      .eq('user_id', account.id)
      .eq('role', 'author');

    const myProjectIds = (authored ?? []).map((a: any) => a.project_id);

    const { data } = myProjectIds.length
      ? await supabase
          .from('entries')
          .select('id, status, placement, project_id, programs(name, season_year, fair_date), projects(title, stage)')
          .in('project_id', myProjectIds)
          .order('entered_at', { ascending: false })
      : { data: [] as any[] };

    myEntries = data ?? [];

    /* Which of these already have a manuscript, so the link can say "start"
       or "open" rather than making somebody click to find out. */
    const { data: started } = myProjectIds.length
      ? await supabase.from('manuscripts').select('project_id').in('project_id', myProjectIds)
      : { data: [] as any[] };

    myManuscripts = new Set((started ?? []).map((m: any) => m.project_id));

    /* Reviewing is an attachment rather than a standing role, so it appears
       nowhere in the nav. If it did not appear here it would appear nowhere
       at all, which is exactly how an assignment sits untouched until the
       week of the fair. */
    const { data: assigned } = await supabase
      .from('reviews')
      .select('id, due_at, submitted_at, submissions(manuscripts(title))')
      .is('submitted_at', null)
      .order('due_at', { ascending: true });

    myReviews = assigned ?? [];
  }

  if (me.runsTheClub) {
    /* Every project at the school. Row level security decides who may run
       this at all; the heading says so, unlike the section above. */
    const { data: projects } = await supabase
      .from('projects')
      .select('id, title, stage, started_on, project_authors(role, self_managed_at, users(id, display_name, grad_year))')
      .is('archived_at', null)
      .order('created_at', { ascending: false });

    const ids = (projects ?? []).map((p: any) => p.id);

    const { data: entries } = ids.length
      ? await supabase
          .from('entries')
          .select('id, project_id, status, programs(name, season_year, fair_date)')
          .in('project_id', ids)
      : { data: [] as any[] };

    const { data: sponsorRows } = ids.length
      ? await supabase
          .from('project_sponsors')
          .select('project_id, teacher_name')
          .in('project_id', ids)
          .is('superseded_at', null)
      : { data: [] as any[] };

    const entryIds = (entries ?? []).map((e: any) => e.id);

    const { data: milestones } = entryIds.length
      ? await supabase
          .from('entry_milestones')
          .select('id, entry_id, name, due_on, required, blocks_experimentation, completed_on')
          .in('entry_id', entryIds)
      : { data: [] as any[] };

    watched = (projects ?? []).map((p: any) => {
      const entry = (entries ?? []).find((e: any) => e.project_id === p.id);
      const mine = (milestones ?? []).filter((m: any) => m.entry_id === entry?.id);

      const findings = checkDateOrder({
        startedOn: p.started_on,
        today,
        obligations: mine.map((m: any) => ({
          id: m.id,
          name: m.name,
          dueOn: m.due_on,
          completedOn: m.completed_on,
          blocksExperimentation: m.blocks_experimentation,
          required: m.required,
        })),
      });

      const officers = (p.project_authors ?? []).filter((a: any) => a.role === 'officer');
      const selfManaged = (p.project_authors ?? []).filter(
        (a: any) => a.role === 'author' && a.self_managed_at
      );
      const sponsor = (sponsorRows ?? []).find((s: any) => s.project_id === p.id) ?? null;
      const worst = worstFinding(findings);

      return {
        ...p,
        entry,
        authors: (p.project_authors ?? []).filter((a: any) => a.role === 'author'),
        officers,
        selfManaged,
        sponsor,
        done: mine.filter((m: any) => m.completed_on).length,
        total: mine.length,
        worst,
        verdict: assess({
          worst,
          hasOfficer: officers.length > 0 || selfManaged.length > 0,
          hasSponsor: Boolean(sponsor),
          startedOn: p.started_on,
          obligationsDone: mine.filter((m: any) => m.completed_on).length,
          obligationsTotal: mine.length,
        }),
      };
    });

    const { data: rows } = await supabase
      .from('user_roles')
      .select('user_id, role, users:user_id(id, display_name)')
      .is('revoked_at', null)
      .in('role', ['mentor', 'officer']);

    const seen = new Set<string>();
    staffPeople = (rows ?? []).filter((r: any) => {
      if (!r.users?.id || seen.has(r.users.id)) return false;
      seen.add(r.users.id);
      return true;
    });
  }
}

const fmt = (d: string | null) => formatDate(d, 'long', 'To be announced');

const stageLabel: Record<string, string> = {
  registered: 'Registered',
  in_progress: 'In progress',
  fair_ready: 'Fair ready',
  competed: 'Competed',
  published: 'Published',
};

/* An officer sees every project by role and looks after the ones assigned to
   them. Counting the first as "in your care" told Marchetti she was
   responsible for a project nobody had given her. */
const mine = watched.filter((w) =>
  w.officers.some((o: any) => o.users?.id === account?.id) ||
  w.selfManaged.some((o: any) => o.users?.id === account?.id)
);

const counts = tally(watched.map((w) => w.verdict));
---

<Base title="Overview" noindex={true}>
  <div class="wrap">
    {!configured && (
      <p class="note">
        This deployment has no database configured. Everything published stays
        available; only the working surface is unavailable.
      </p>
    )}

    {signin === 'cancelled' && (
      <p class="note" role="status">
        Sign in was cancelled, or the sign-in link expired. Nothing happened.
        Start again when you are ready.
      </p>
    )}
    {signin === 'password' && (
      <p class="note" role="alert">That email and password did not match.</p>
    )}
    {signin === 'oauth' && <p class="note" role="alert">Sign in could not start. Try again.</p>}
    {signin === 'exchange' && <p class="note" role="alert">Sign in did not complete. Try again.</p>}
    {signin === 'no_code' && <p class="note" role="alert">Sign in did not complete. Try again.</p>}
    {error2 && <p class="note" role="alert">{error2}</p>}
    {cleared !== null && (
      <p class="note" role="status">
        Attached. {cleared} approval obligation{cleared === 1 ? '' : 's'} cleared.
      </p>
    )}

    {configured && !session && (
      <section class="hero">
        <p class="t-lbl">{org.name}</p>
        <h1 class="t-big">Sign in to work on a project</h1>
        <p class="lede">
          Use your school Google account. Reading anything published here never
          needs an account.
        </p>
        <div class="row" style="margin-top:24px">
          <a class="btn" href="/auth/signin/">Sign in with Google</a>
        </div>

        <div class="fixture">
          <p class="t-lbl">Or with an email and password</p>
          <form method="POST" action="/auth/password/" class="fixrow">
            <input name="email" type="email" required placeholder="Email" />
            <input name="password" type="password" required placeholder="Password" />
            <button type="submit">Sign in</button>
          </form>
        </div>
      </section>
    )}

    {account && (
      <>
        <AppShell org={org} account={account} roles={roles} here="/app/" />

        <section class="hero" style="padding-top:0">
          <p class="t-lbl">
            {me.names.length ? me.names.map((n) => roleLabel[n]).join(' · ') : org.name}
          </p>
          <h1 class="t-big">{account.display_name}</h1>
          <p class="lede">
            {me.runsTheClub
              ? mine.length
                ? `${mine.length} project${mine.length === 1 ? '' : 's'} in your care, ${watched.length} at the school.`
                : watched.length
                  ? `Nothing assigned to you yet. ${watched.length} project${watched.length === 1 ? '' : 's'} at the school.`
                  : 'No projects have been registered at this school yet.'
              : me.isStudent
                ? ''
                : 'You are signed in. A club role is granted by an officer or the club advisor.'}
          </p>

          {me.runsTheClub && watched.length > 0 && (
            <div class="countdown">
              <div><b>{mine.length}</b><span>in your care</span></div>
              <div><b>{watched.length}</b><span>at the school</span></div>
              <div><b>{counts.disqualifying}</b><span>disqualifying</span></div>
              <div><b>{counts.attention}</b><span>need attention</span></div>
            </div>
          )}
        </section>

        {/* ---------------- OVERSIGHT ---------------- */}
        {me.runsTheClub && (
          <section class="sec">
            <div class="sec-h">
              <b>{me.runsTheClub ? 'All projects' : 'Projects you look after'}</b>
              <span>{watched.length}</span>
            </div>

            {watched.length > 0 ? (
              <table class="tbl">
                <thead>
                  <tr>
                    <th scope="col">Project</th>
                    <th scope="col">Students</th>
                    <th scope="col">Fair</th>
                    <th scope="col">Stage</th>
                    <th scope="col">Obligations</th>
                    <th scope="col">Standing</th>
                  </tr>
                </thead>
                <tbody>
                  {watched.map((w) => (
                    <tr class={w.worst?.severity === 'disqualifying' ? 'row-bad' : w.worst?.severity === 'planned' ? 'row-warn' : ''}>
                      <td>
                        <a href={`/app/project/${w.id}/`}>{w.title}</a>
                        <span class="sub">
                          {w.entry && <><a href={`/app/entry/${w.entry.id}/`}>deadlines</a> · </>}
                          <a href={`/app/project/${w.id}/team/`}>who is on it</a>
                        </span>
                        {w.officers.length > 0 ? (
                          <span class="sub">
                            officer: {w.officers.map((m: any) => m.users?.display_name).join(', ')}
                          </span>
                        ) : w.selfManaged.length > 0 ? (
                          <span class="sub">
                            self-managed by {w.selfManaged.map((m: any) => m.users?.display_name).join(', ')}
                          </span>
                        ) : null}
                      </td>
                      <td>
                        {w.authors.map((a: any) => a.users?.display_name).join(', ') || '—'}
                      </td>
                      <td>
                        {w.entry?.programs
                          ? `${w.entry.programs.name} ${w.entry.programs.season_year}`
                          : 'Not entered'}
                      </td>
                      <td>{stageLabel[w.stage] ?? w.stage}</td>
                      <td>{w.total ? `${w.done} of ${w.total}` : '—'}</td>
                      <td>
                        {w.verdict.reason
                          ? <span class={w.verdict.level === 'disqualifying' ? 'sev bad' : 'sev warn'}>{w.verdict.reason}</span>
                          : 'In order'}
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            ) : (
              <div class="note">
                <h4>No projects yet</h4>
                <p>
                  Projects appear here as students register them.
                </p>

              </div>
            )}
          </section>
        )}

        {/* ---------------- STUDENT ---------------- */}
        {(me.isStudent || !me.runsTheClub) && (
          <>
            {myReviews.length > 0 && (
              <section class="sec">
                <div class="sec-h">
                  <b>To review</b>
                  <span>{myReviews.length} waiting</span>
                </div>
                <ul class="plain">
                  {myReviews.map((r) => {
                    const late = new Date(r.due_at) < new Date();
                    return (
                      <li>
                        <a href={`/app/review/${r.id}/`}>
                          {r.submissions?.manuscripts?.title ?? 'A submission'}
                        </a>
                        <span class:list={['t-sm', late && 'late']}>
                          {late ? 'overdue, was due ' : 'due '}{fmt(r.due_at)}
                        </span>
                      </li>
                    );
                  })}
                </ul>
              </section>
            )}

            <section class="sec">
              <div class="sec-h">
                <b>This season</b>
                <span>{myEntries.length ? `${myEntries.length} entered` : 'nothing entered'}</span>
              </div>
              {myEntries.length ? (
                <ul class="linklist">
                  {myEntries.map((e) => (
                    <li>
                      {/* The project, not the entry. A student's own front page
                          linking only to a deadlines view buried the work
                          itself two clicks down. */}
                      <a href={`/app/project/${e.project_id}/`}>{e.projects?.title}</a>
                      <span class="t-sm"> · {e.programs?.name} {e.programs?.season_year} · judging {fmt(e.programs?.fair_date)}</span>
                      <span class="going">
                        <a href={`/app/project/${e.project_id}/manuscript/`}>
                          {myManuscripts.has(e.project_id) ? 'Manuscript' : 'Start the manuscript'}
                        </a>
                        <a href={`/app/entry/${e.id}/`}>Deadlines</a>
                        <a href={`/app/project/${e.project_id}/team/`}>Who is on it</a>
                      </span>
                    </li>
                  ))}
                </ul>
              ) : (
                <div class="note">
                  <h4>No fair entered</h4>
                  <p style="margin-top:12px">
                    <a class="btn btn-2" href="/app/fairs/">See open fairs</a>
                  </p>
                </div>
              )}
            </section>

            <section class="sec">
              <div class="sec-h"><b>Past fairs</b><span>nothing yet</span></div>
              <p class="t-sm">Fairs you have competed in appear here with what you placed.</p>
            </section>
          </>
        )}
      </>
    )}
  </div>
</Base>

<style>
  .plain { list-style: none; margin: 0; padding: 0; }
  .plain li {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 10px;
    padding: 10px 0;
    border-bottom: 1px solid var(--rule-fine);
  }
  .plain .late { color: var(--alert); }
  /* The two or three places a student actually goes from a project, said
     once rather than discovered by clicking. */
  .going {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    margin-top: 6px;
  }
  .going a {
    font-family: var(--face-ui);
    font-size: 0.82rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--ink-3);
  }
  .going a:hover {
    color: var(--ink);
  }
  .hero { padding: 44px 0 28px; max-width: 74ch; }
  .hero .t-lbl { margin-bottom: 14px; }
  .fixture { margin-top: 34px; padding: 18px 20px; border: 1px dashed var(--rule); max-width: 52ch; }
  .fixture .t-lbl { margin-bottom: 8px; }
  .fixrow { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 12px; }
  .fixrow input { flex: 1 1 14ch; padding: 8px 10px; border: 1px solid var(--rule); background: var(--card); color: var(--ink); font: inherit; font-size: 0.94rem; }
  .fixrow button { padding: 8px 14px; border: 1px solid var(--ink); background: var(--ink); color: var(--paper); font-family: var(--face-ui); font-size: 0.9rem; cursor: pointer; }
  /* A grid rather than a flex row. Sized to content, the fourth cell dropped
     to a line of its own as soon as one label ran long, which left a gap
     beside "disqualifying" and a stranded number underneath. Equal columns
     put all four on one line and wrap them in pairs rather than one at a
     time. */
  .countdown {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin-top: 26px;
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
  }
  .countdown > div {
    padding: 14px 22px 14px 0;
    border-right: 1px solid var(--rule-fine);
  }
  .countdown > div:last-child { border-right: 0; }

  @media (max-width: 720px) {
    .countdown { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    /* The divider belongs between columns, so it comes off the right hand
       one and the first row gains a rule underneath it. */
    .countdown > div:nth-child(2n) { border-right: 0; }
    .countdown > div:nth-child(-n + 2) { border-bottom: 1px solid var(--rule-fine); }
  }
  .countdown b { display: block; font-size: 1.05rem; line-height: 1.2; }
  .countdown span { display: block; margin-top: 3px; font-family: var(--face-ui); font-size: 0.84rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--ink-3); }
  .also { font-size: 0.95rem; }
  .sub { display: block; margin-top: 3px; font-family: var(--face-ui); font-size: 0.82rem; color: var(--ink-3); }
  .sev { font-family: var(--face-ui); font-size: 0.86rem; }
  .sev.bad { color: var(--alert); font-weight: 600; }
  .row-bad td { background: var(--alert-bg); }
  .row-warn td { background: var(--ready-bg); }
  .assign { display: flex; flex-wrap: wrap; gap: 14px; align-items: flex-end; }
  .assign label { display: block; }
  .assign label > span { display: block; margin-bottom: 5px; font-family: var(--face-ui); font-size: 0.9rem; }
  .assign select { padding: 8px 10px; border: 1px solid var(--rule); background: var(--card); color: var(--ink); font: inherit; min-width: 22ch; }
  .assign button { padding: 9px 16px; border: 1px solid var(--ink); background: var(--ink); color: var(--paper); font-family: var(--face-ui); font-size: 1rem; font-weight: 600; cursor: pointer; }
</style>
