<Base title="Overview" noindex={true}>
  <div class="wrap">
    {!configured && (
      <p class="note">
        This deployment has no database configured. Everything published stays
        available; only the working surface is unavailable.
      </p>
    )}

    {signin === 'cancelled' && (
      <p class="note" role="status">
        Sign in was cancelled, or the sign-in link expired. Nothing happened.
        Start again when you are ready.
      </p>
    )}
    {signin === 'password' && (
      <p class="note" role="alert">That email and password did not match.</p>
    )}
    {signin === 'oauth' && <p class="note" role="alert">Sign in could not start. Try again.</p>}
    {signin === 'exchange' && <p class="note" role="alert">Sign in did not complete. Try again.</p>}
    {signin === 'no_code' && <p class="note" role="alert">Sign in did not complete. Try again.</p>}
    {/* Anchored, and the forms on this page post to it. Attaching or
        detaching happens far down a long list of projects, and the failure
        message renders here. */}
    <div id="outcome" tabindex="-1">
      {error2 && <p class="note flash" role="alert">{error2}</p>}
