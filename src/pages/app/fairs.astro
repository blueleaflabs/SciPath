---
export const prerender = false;

import Base from '../../layouts/Base.astro';
import { formatDate } from '../../lib/dates';
import AppShell from '../../components/AppShell.astro';
import { activeOrg } from '../../lib/tenant';
import { serverClient } from '../../lib/supabase';
import { standing } from '../../lib/roles';

const { session, account, roles } = Astro.locals;
const org = activeOrg(Astro);

if (!session) return Astro.redirect('/app/');
if (!account) return Astro.redirect('/app/welcome/');

const me = standing(roles, account?.population);

const supabase = serverClient(
  Astro.request,
  Astro.cookies,
  (Astro.locals as any).runtime?.env
);

let error: string | null = null;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const programId = String(form.get('program_id') ?? '');
  const title = String(form.get('title') ?? '').trim();
  const startedOn = String(form.get('started_on') ?? '');

  if (!title) {
    error = 'Give the project a working title. You can change it later.';
  } else {
    const { data: entryId, error: startError } = await supabase.rpc('start_entry', {
      p_program_id: programId,
      p_title: title,
      p_started_on: startedOn || null,
    });

    if (startError) error = startError.message;
    else return Astro.redirect(`/app/entry/${entryId}/`);
  }
}

const { data: programs } = await supabase
  .from('programs')
  .select('id, name, season_year, fair_date, description, website_url, advances_to_fairs, status')
  .eq('status', 'open')
  .order('fair_date', { ascending: true });

/* Row level security lets an officer read every entry at the school, which
   is correct for oversight and wrong for a heading that says "yours". Scope
   this one by authorship rather than by what the policy permits. */
const { data: authored } = await supabase
  .from('project_authors')
  .select('project_id')
  .eq('user_id', account.id)
  .eq('role', 'author');

const myProjectIds = (authored ?? []).map((a: any) => a.project_id);

const { data: mine } = myProjectIds.length
  ? await supabase
      .from('entries')
      .select('id, status, placement, program_id, programs(name, season_year, fair_date), projects(title)')
      .in('project_id', myProjectIds)
      .order('entered_at', { ascending: false })
  : { data: [] as any[] };

const entered = new Set((mine ?? []).map((e: any) => e.program_id));

const fmt = (d: string | null) =>
  d ? formatDate(d, 'long') : null;
---

<Base title="Fairs and entries" noindex={true}>
  <div class="wrap">
    <AppShell org={org} account={account} roles={roles} here="/app/fairs/" />

    <section class="hero" style="padding-top:0">
      <p class="t-lbl">Fairs and entries</p>
      <h1 class="t-big">Manage your entry</h1>

    </section>

    {error && <p class="note" role="alert">{error}</p>}

    {mine && mine.length > 0 && (
      <section class="sec">
        <div class="sec-h" id="yours"><b>Your entries</b><span>{mine.length}</span></div>
        <ul class="linklist">
          {mine.map((e: any) => (
            <li>
              <a href={`/app/entry/${e.id}/`}>
                {e.projects?.title} · {e.programs?.name} {e.programs?.season_year}
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    <section class="sec">
      <div class="sec-h"><b>Open fairs</b></div>

      {programs && programs.length > 0 ? (
        <div class="stack">
          {programs.map((p: any) => (
            <div class="card prog">
              <div class="about">
                <p class="season">{p.season_year} season</p>
                <h3>
                  {p.website_url
                    ? <a href={p.website_url} rel="noopener">{p.name}</a>
                    : p.name}
                </h3>

                {p.description && <p class="blurb">{p.description}</p>}

                <dl class="facts">
                  <dt>Judging</dt>
                  <dd>{fmt(p.fair_date) ?? 'to be announced'}</dd>
                  {p.advances_to_fairs?.length > 0 && (
                    <>
                      <dt>Advances to</dt>
                      <dd>{p.advances_to_fairs.join(' and ')}</dd>
                    </>
                  )}
                </dl>
              </div>

              {entered.has(p.id) ? (
                <div class="already">
                  <p><b>You are already entered in this fair.</b></p>
                  <p class="t-sm">
                    A student enters one project per fair each season. Your
                    entry is under <a href="#yours">your entries</a> above.
                  </p>
                </div>
              ) : (
              <form method="POST" class="enter" style={!me.isStudent ? 'display:none' : undefined}>
                <input type="hidden" name="program_id" value={p.id} />
                <label>
                  <span>Working title for your project <i class="req">*</i></span>
                  <input name="title" required placeholder="Something you can change later" />
                </label>
                <label>
                  <span>The day you started, or plan to start, experimenting</span>
                  <input name="started_on" type="date" />
                  <small>Leave it blank if you have not started.</small>
                </label>
                <button type="submit">Enter fair</button>
                <p class="legend"><i class="req">*</i> required</p>
              </form>
              )}
            </div>
          ))}
        </div>
      ) : (
        <div class="note">
          <h4>No fairs are open yet</h4>
          <p>Programs are loaded by an officer or your advisor.</p>
        </div>
      )}
    </section>
  </div>
</Base>

<style>
  .hero { padding: 44px 0 28px; max-width: 74ch; }
  .hero .t-lbl { margin-bottom: 14px; }
  /* Two columns: what the fair is on the left, what you do about it on the
     right. One column of text running the full width of a laptop left the
     form stranded under half a page of nothing. */
  .prog {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(20rem, 0.9fr);
    gap: 0;
    padding: 0;
    align-items: start;
  }
  .prog .about { padding: 24px 28px; }
  .prog h3 { margin: 0 0 10px; }
  .prog .season {
    margin: 0 0 4px;
    font-family: var(--face-num);
    font-size: 0.82rem;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: var(--ink-3);
  }
  .prog .blurb { margin: 0 0 16px; max-width: 46ch; }
  .prog .facts {
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: 4px 14px;
    margin: 0;
    padding-top: 12px;
    border-top: 1px solid var(--rule-fine);
    font-size: 0.95rem;
  }
  .prog .facts dt {
    font-family: var(--face-ui);
    font-size: 0.82rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--ink-3);
    padding-top: 3px;
  }
  .prog .facts dd { margin: 0; }
  .req { color: var(--alert); font-style: normal; }
  .legend { margin: 10px 0 0; font-size: 0.86rem; color: var(--ink-3); }
  .already {
    padding: 24px 28px;
    border-left: 1px solid var(--rule-fine);
    background: var(--paper);
  }
  .already p { margin: 0 0 6px; }

  .enter {
    margin: 0;
    padding: 24px 28px;
    border-left: 1px solid var(--rule-fine);
    background: var(--paper);
    align-self: stretch;
  }

  @media (max-width: 860px) {
    .prog { grid-template-columns: 1fr; }
    .enter { border-left: 0; border-top: 1px solid var(--rule-fine); }
  }
  .enter label { display: block; margin-bottom: 14px; }
  .enter label > span { display: block; margin-bottom: 5px; font-family: var(--face-ui); font-size: 0.9rem; }
  .enter input { width: 100%; padding: 8px 10px; border: 1px solid var(--rule); background: var(--card); color: var(--ink); font: inherit; }
  .enter small { display: block; margin-top: 4px; color: var(--ink-3); font-size: 0.86rem; }
  .enter button {
    padding: 11px 20px;
    border: 1px solid var(--ink);
    background: var(--ink);
    color: var(--paper);
    font-family: var(--face-ui);
    font-size: 1rem;
    font-weight: 600;
    cursor: pointer;
  }
</style>
