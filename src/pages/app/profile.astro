---
export const prerender = false;

import Base from '../../layouts/Base.astro';
import AppShell from '../../components/AppShell.astro';
import { activeOrg } from '../../lib/tenant';
import { serverClient } from '../../lib/supabase';
import { afterPost, outcomeFrom } from '../../lib/post-redirect';
import { signInWith } from '../../lib/next-path';

const { session, account, roles } = Astro.locals;
const org = activeOrg(Astro);

/* Remembering where they were headed, so a link from a notification
   survives the sign in it triggers (20.10). */
if (!session) return Astro.redirect(signInWith(Astro.url));
if (!account) return Astro.redirect('/app/welcome/');

const supabase = serverClient(
  Astro.request,
  Astro.cookies,
  (Astro.locals as any).runtime?.env
);

/* Seeded from the redirect a POST answers with. `saved` was a boolean that
   could not survive one, so it became the sentence it always printed. */
let { error, note: saved } = outcomeFrom(Astro.url);

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const action = String(form.get('action') ?? 'details');

  /* Two forms on one page, so each says which it is. Without that the
     notification form would fall into the details branch and blank a
     display name it never carried. */
  if (action === 'notifications') {
    const digest = String(form.get('digest') ?? 'weekly');

    const { error: prefError } = await supabase.from('notification_settings').upsert(
      {
        user_id: account.id,
        category: 'reminders',
        channel: 'email',
        /* Off is the absence of a digest rather than a third cadence, so
           that "how often" and "at all" stay separate questions. */
        enabled: digest !== 'off',
        cadence: digest === 'off' ? 'weekly' : digest,
        urgent: form.get('urgent') === 'on',
      },
      { onConflict: 'user_id,category,channel' }
    );

    if (prefError) error = prefError.message;
    else saved = 'Saved.';

    return afterPost(Astro.url, { error, note: saved });
  }

  const gradYear = String(form.get('grad_year') ?? '');

  const { error: updateError } = await supabase
    .from('users')
    .update({
      display_name: String(form.get('display_name') ?? '').trim(),
      grad_year: gradYear ? Number(gradYear) : null,
      orcid: String(form.get('orcid') ?? '').trim() || null,
      outbound_url: String(form.get('outbound_url') ?? '').trim() || null,
      photo_consent: form.get('photo_consent') === 'on',
    })
    .eq('id', account.id);

  if (updateError) error = updateError.message;
  else saved = 'Saved.';

  /* A refresh should re-read this page, not send the form again. */
  return afterPost(Astro.url, { error, note: saved });
}

/* Re-read so the form shows what is actually stored, not what was posted. */
const { data: current } = await supabase
  .from('users')
  .select('display_name, grad_year, orcid, outbound_url, photo_consent, author_slug, affiliation_state, consent_state, population, status')
  .eq('id', account.id)
  .single();

const person = current ?? account;

/* How often the digest arrives, and whether anything urgent arrives on its
   own. Absent means the default, which is weekly with urgent items on: a
   person who has never opened this screen should hear about a deadline, and
   should not hear daily about nothing. */
const { data: reminders } = await supabase
  .from('notification_settings')
  .select('enabled, cadence, urgent')
  .eq('user_id', account.id)
  .eq('category', 'reminders')
  .eq('channel', 'email')
  .maybeSingle();

const digest = reminders && !reminders.enabled ? 'off' : (reminders?.cadence ?? 'weekly');
const urgent = reminders?.urgent ?? true;

const { data: guardian } = await supabase
  .from('guardian_consents')
  .select('guardian_name, guardian_email, confirmed_at, requested_at')
  .eq('user_id', account.id)
  .is('revoked_at', null)
  .order('requested_at', { ascending: false })
  .limit(1)
  .maybeSingle();

/* Who is attached to the projects this person authors. The mentor is the
   sponsor, so this is also the answer to "has anyone signed off on me". */
const { data: myProjects } = await supabase
  .from('project_authors')
  .select('project_id')
  .eq('user_id', account.id)
  .eq('role', 'author');

const projectIds = (myProjects ?? []).map((r: any) => r.project_id);

const { data: overseers } = projectIds.length
  ? await supabase
      .from('project_authors')
      .select('role, projects(title), users(display_name)')
      .in('project_id', projectIds)
      .in('role', ['mentor', 'officer'])
  : { data: [] as any[] };

const mentors = (overseers ?? []).filter((o: any) => o.role === 'mentor');

const year = new Date().getFullYear();
const gradYears = [year, year + 1, year + 2, year + 3, year + 4];

const affiliationLabel: Record<string, string> = {
  domain_verified: `Verified by your ${org.name} account`,
  mentor_verified: 'Verified by your club mentor',
  unverified: 'Waiting on a club mentor',
  lapsed: 'Lapsed. Sign in with your school account to renew',
};

const consentLabel: Record<string, string> = {
  not_required: 'Not required. You told us you are 18 or older',
  active: 'Confirmed',
  pending: 'Waiting on your parent or guardian',
  paused: 'Paused until confirmed',
  closed: 'Closed',
};
---

<Base title="Profile" noindex={true}>
  <div class="wrap">
    <AppShell org={org} account={account} roles={roles} here="/app/profile/" />

    <section class="hero">
      <p class="t-lbl">Profile</p>
      <h1 class="t-big">{person.display_name}</h1>
      <p class="lede">
        What appears on a byline, and who has confirmed you. Everything here is
        yours to edit except the confirmations.
      </p>
    </section>

    {saved && <p class="note" role="status">{saved}</p>}
    {/* Anchored, and every form on this page posts to it. These pages
        run to several screens, and an outcome rendered at the top after
        a click three screens down reads as nothing having happened. */}
    <div id="outcome" tabindex="-1">
    {error && <p class="note" role="alert">{error}</p>}
    </div>

    <section class="sec">
      <div class="sec-h"><b>Your details</b><span>Editable</span></div>
      <form method="POST" action="#outcome" class="stack">
        <label>
          <span>Name, as it should appear on a byline</span>
          <input name="display_name" required value={person.display_name} autocomplete="name" />
        </label>

        <label>
          <span>Graduation year</span>
          <select name="grad_year">
            <option value="">Not a student</option>
            {gradYears.map((y) => (
              <option value={y} selected={person.grad_year === y}>{y}</option>
            ))}
          </select>
        </label>

        <label>
          <span>ORCID</span>
          <input name="orcid" value={person.orcid ?? ''} />
          <small>Optional. A permanent identifier that follows you to university.</small>
        </label>

        <label>
          <span>A link of your own</span>
          <input name="outbound_url" type="url" value={person.outbound_url ?? ''} />
          <small>Optional. Shown on your author page once you have published.</small>
        </label>

        <label class="check">
          <input type="checkbox" name="photo_consent" checked={person.photo_consent} />
          <span>Show my photo on my author page</span>
        </label>



        <button class="btn" type="submit">Save</button>
      </form>
    </section>

    <section class="sec" id="notifications">
      <div class="sec-h"><b>What reaches you</b><span>By email</span></div>

      <p class="t-sm" style="max-width:var(--measure-text)">
        One message, listing where your projects stand: what is late, what is
        coming, and what is missing. Nothing is sent when there is nothing to
        say.
      </p>

      <form method="POST" action="#outcome" class="stack">
        <input type="hidden" name="action" value="notifications" />

        <label>
          <span>How often</span>
          <select name="digest">
            <option value="weekly" selected={digest === 'weekly'}>Weekly</option>
            <option value="daily" selected={digest === 'daily'}>Daily</option>
            <option value="off" selected={digest === 'off'}>Never</option>
          </select>
        </label>

        <label class="check">
          <input type="checkbox" name="urgent" checked={urgent} />
          <span>
            Tell me about something urgent as soon as it happens, rather than
            waiting for the next one
          </span>
        </label>

        {/* Said rather than hidden. A list of switches that pretends to be
            complete is lying about what it controls: a decision on your own
            paper, a place granted or refused, a consent request are the
            substance of the thing and not news about it (20.4). */}
        <p class="t-sm">
          A decision on your work, a place granted or refused, and anything
          about your account are always sent.
        </p>

        <p><button class="btn" type="submit">Save</button></p>
      </form>
    </section>

    <section class="sec">
      <div class="sec-h"><b>Confirmations</b><span>Not editable here</span></div>

      {/* Four facts about an account, which is a different thing from the
          panels `.record` styles — that class carries a stage color on its
          left edge, and none of these has a stage. Borrowing it left a `dl`
          at browser defaults: the label and the answer in the same face at
          the same size, the answer indented under it, and eight lines where
          there are four facts.

          Two columns, and the label is set apart by face and size rather
          than by indentation, so a reader scans the left edge for the thing
          they came to check and reads across once. No measure on the
          container: one of these values is a link. */}
      <dl class="confirm">
        <div>
          <dt>School affiliation</dt>
          <dd>{affiliationLabel[person.affiliation_state] ?? person.affiliation_state}</dd>
        </div>

        <div>
          <dt>Parent or guardian</dt>
          <dd>
            {consentLabel[person.consent_state] ?? person.consent_state}
            {guardian && person.consent_state !== 'not_required' && (
              <> · {guardian.guardian_email}</>
            )}
          </dd>
        </div>

        <div>
          <dt>Club mentor</dt>
          <dd>
            {mentors.length
              ? mentors.map((m: any) => `${m.users?.display_name} · ${m.projects?.title}`).join(', ')
              : 'None attached yet. A club officer or the mentor attaches one to your project.'}
          </dd>
        </div>

        <div>
          <dt>Author page</dt>
          <dd>{person.author_slug ? <a href={`/authors/${person.author_slug}/`}>View</a> : 'Created when you first publish'}</dd>
        </div>
      </dl>
    </section>
  </div>
</Base>

<style>
  .confirm {
    margin: 0;
    border: 1px solid var(--rule);
    background: var(--card);
  }
  .confirm > div {
    display: grid;
    grid-template-columns: 13rem 1fr;
    gap: 4px 24px;
    padding: 13px 18px;
  }
  /* Between the rows rather than around each, so four facts read as one
     panel and not as four cards. */
  .confirm > div + div { border-top: 1px solid var(--rule-fine); }
  .confirm dt {
    font-family: var(--face-ui);
    font-size: 0.78rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-3);
    /* The label sits on the same line as the first line of the answer, which
       is what makes the left edge scannable when one answer runs to two
       lines and its neighbor to one. */
    align-self: baseline;
  }
  .confirm dd {
    margin: 0;
    max-width: var(--measure-text);
  }

  /* One column when there is no room for two. A 13rem label column next to a
     wrapped answer is worse than a label above it. */
  @media (max-width: 44rem) {
    .confirm > div { grid-template-columns: 1fr; gap: 3px; }
  }

  .hero { padding: 44px 0 28px; max-width: 74ch; }
  .hero .t-lbl { margin-bottom: 14px; }
  form.stack { max-width: 52ch; }
  form label { display: block; margin-bottom: 18px; }
  form label > span { display: block; margin-bottom: 6px; font-family: var(--face-ui); font-size: 0.92rem; }
  form small { display: block; margin-top: 5px; color: var(--ink-3); font-size: 0.88rem; }
  form input[type='text'], form input, form select { width: 100%; padding: 9px 11px; border: 1px solid var(--rule); background: var(--card); color: var(--ink); font: inherit; }
  form label.check { display: flex; gap: 9px; align-items: center; }
  form label.check input { width: auto; }
  form button { padding: 10px 18px; border: 1px solid var(--ink); background: var(--ink); color: var(--paper); font-family: var(--face-ui); font-size: 1rem; font-weight: 600; cursor: pointer; }
</style>
