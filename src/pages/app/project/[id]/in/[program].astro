<style>
  /* ── The route through the page ────────────────────────────────────────
  
     A numbered sequence rather than a menu, because that is what a season
     is: set a date, look after the work, meet the dates, hand things over,
     record what happened. The rule running through it is the thread, and
     each step sits on it.
  
     The same number appears above the heading it points at, in the same
     face and the same weight, so arriving somewhere shows where it sits in
     the whole rather than only what it is called. That repetition is the
     tie: the rail and the headings are one system read twice.
  
     It wraps rather than scrolls. A horizontal scroller hides its own last
     item, which on this page is the result. */
  .rail {
    margin: 0 0 34px;
    padding: 18px 0 0;
    border-top: 1px solid var(--rule);
  }
  .rail ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0;
  }
  .rail li { position: relative; }
  /* The thread between the steps. On the item rather than between them, so
     a wrapped row does not trail a rule into empty space. */
  .rail li + li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 1.05rem;
    width: 14px;
    border-top: 1px solid var(--rule);
  }
  .rail a {
    display: flex;
    flex-direction: column;
    gap: 3px;
    padding: 4px 20px 8px 20px;
    text-decoration: none;
    color: var(--ink-2);
    border-bottom: 2px solid transparent;
  }
  .rail li:first-child a { padding-left: 0; }
  .rail a:hover,
  .rail a:focus-visible { color: var(--ink); border-bottom-color: var(--ink); }
  .rail-n {
    font-family: var(--face-num);
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    color: var(--ink-3);
  }
  .rail-l { font-family: var(--face-ui); font-size: 0.94rem; }

  /* The number above its heading, matching the rail exactly. */
  .sec-n {
    /* In line with the label rather than above it, at the weight of a folio
       in the margin of a printed page. The one loud thing in the head. */
    font-family: var(--face-num);
    font-size: 1.05rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    /* The school's hue, not the mark. The mark is 3.2:1 on a card, which is
       under this project's AA floor for text at this size — it is an edge
       colour, and edges are exempt because nobody reads them. */
    color: var(--brand);
    margin: 0;
  }

  /* A section landed on sits under the masthead otherwise, with its own
     heading off the top of the window. */
  .sec[id] { scroll-margin-top: 22px; }

  @media (max-width: 640px) {
    .rail a { padding: 4px 14px 8px 14px; }
    .rail li + li::before { width: 10px; }
  }

  /* The project's own facts, as a list of rows rather than a row of buttons.
     Four buttons say "here are four places to go"; this says what each one
     holds and offers the way in beside it. */
  /* ── The project's facts ───────────────────────────────────────────────
  
     Three rows, each: a label, what it says, and what you can do about it.
  
     **No reading measure on it.** This carried `max-width: var(--measure-text)`
     — 66ch — which is right for prose and wrong for a row that also holds
     two eleven-rem buttons. There was not enough width left for the value,
     so "0 entries, append only and attributed" wrapped to one word per line
     and the actions overflowed on top of it. Same mistake as a row of
     figures wrapping inside a hero capped at 74ch: **a measure belongs to
     text, not to a container that holds controls** (15.6a).
  
     Flex rather than grid, and that is the second half of the fix. Each row
     was its own grid, so the three tracks were negotiated separately per
     row and a `max-content` action track could take whatever it liked from
     the value beside it. With flex the actions take their natural width,
     the value takes what is left, and `min-width: 0` lets it shrink instead
     of pushing. */
  .facts { list-style: none; margin: 0; padding: 0; }

  .facts li {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 18px;
    align-items: center;
    padding: 14px 0;
    border-bottom: 1px solid var(--rule-fine);
  }

  .facts .f-lbl {
    flex: 0 0 7.5rem;
    font-family: var(--face-ui);
    font-size: 0.82rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--ink-3);
