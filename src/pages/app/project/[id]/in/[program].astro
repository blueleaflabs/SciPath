  .linkf {
    display: flex;
    flex-direction: column;
    gap: 14px;
    align-items: flex-start;
    max-width: 48rem;
  }
  .linkf label { display: block; width: 100%; }
  .linkf label > span {
    display: block;
    margin-bottom: 6px;
    font-family: var(--face-ui);
    font-size: 0.86rem;
