---
export const prerender = false;

import { identify } from '../../../../../lib/filetype';
import Base from '../../../../../layouts/Base.astro';
import { formatDate, daysFrom, todayIn } from '../../../../../lib/dates';
import AppShell from '../../../../../components/AppShell.astro';
import ProjectCover from '../../../../../components/ProjectCover.astro';
import Plate from '../../../../../components/Plate.astro';
import { activeOrg } from '../../../../../lib/tenant';
import { resolveProgram, deliverablesFor, stepApplies, shape, scoreRubric } from '../../../../../lib/templates';
import { byDueThenOrder } from '../../../../../lib/milestone-order';
import { stepProgress, remainingWords, doneWords } from '../../../../../lib/step-progress';
import { monthWord } from '../../../../../lib/dates';
import { programTitle, staffWord } from '../../../../../lib/program-names';
import { one, serverClient } from '../../../../../lib/supabase';
import { checkDateOrder, worstFinding } from '../../../../../lib/dateOrder';
import { standing, isAuthorOf, reachesProgram } from '../../../../../lib/roles';
import { afterPost, outcomeFrom } from '../../../../../lib/post-redirect';
import { nextUpNote } from '../../../../../lib/next-up';
import { scoreBand } from '../../../../../lib/score-band';
import { platform } from '../../../../../config/site';
import { documentPath, docStanding } from '../../../../../lib/documents';
import { linkDomain, renderNote } from '../../../../../lib/notes';
import { blobStore, projectImagePath, MAX_UPLOAD_BYTES } from '../../../../../lib/blob';
import { signInWith } from '../../../../../lib/next-path';
import { shapeParticipation } from '../../../../../lib/participation';
import { sponsorsFromPlaces } from '../../../../../lib/sponsors';

const { session, account, roles } = Astro.locals;
const org = activeOrg(Astro);

/**
 * THE PARTICIPATION PAGE. One page, both kinds. 22.5.
 *
 * This was `/app/entry/{id}/`, and there was a second, far thinner page at
 * `/app/project/{id}/cohort/{cohort}/` that could show a list of milestones
 * and nothing else. That was not a page built badly: while a class and a fair
 * lived in different tables, the four tables holding deliverables, sponsors
 * and deadline state could only be keyed to one of them, so the class page
 * had nothing to show.
 *
 * One table means one page. What differs between a class and a fair is what
 * the template declares it *has* -- IRPD has no categories, no awards and
 * nothing to place in -- and the sections below already read that.
 *
 * **Keyed on the pair rather than on the row id**, so the project is always
 * in the address. A way back to the work is then structural rather than a
 * link somebody later removes.
 */
const { id: projectId, program: programId } = Astro.params;

/* Remembering where they were headed, so a link from a notification
   survives the sign in it triggers (20.10). */
if (!session) return Astro.redirect(signInWith(Astro.url));
if (!account) return Astro.redirect('/app/welcome/');

const me = standing(roles, account?.population);

const supabase = serverClient(
  Astro.request,
  Astro.cookies,
  (Astro.locals as any).runtime?.env
);

/* Resolved before anything else, including the POST handler, because every
   action below is addressed to this participation. `src/lib/participation.ts`
   is the one place page code reads the merged table directly; the reasoning
   is written out there. */
/* One read for the place and everything about it the page renders except
   the obligations and the grades (place_page, 2.9): nine reads through the
   same policy became one. Null when the place is not there or not the
   reader's to see, which the redirect below handles as before. */
const { data: pageData, error: pageError } = projectId && programId
  ? await supabase.rpc('place_page', { p_project_id: projectId, p_program_id: programId })
  : { data: null, error: null };
if (pageError) console.error(JSON.stringify({ place_page: pageError.message, path: Astro.url.pathname }));
const page = (pageData ?? null) as Record<string, any> | null;
const participation = page?.entry ? shapeParticipation(page.entry) : null;

/* Not in it. Back to the project, which is the hub and always exists.
   Rendering a class's deadlines against a project that never joined would be
   showing somebody an obligation nobody agreed to. */
if (!participation) return Astro.redirect(`/app/project/${projectId}/`);

/**
 * **AND IN A PROGRAM THIS PERSON REACHES.**
 *
 * The check above asks whether the project is in the program. It does not
 * ask whether the reader has any standing in it, and for a long time nothing
 * did: a teacher scoped to the class could open the fair's page for a project
 * that is in both, and every control below that reads `me.runsTheClub` came
 * with it — recording deliverables, verifying somebody else's, editing the
 * warnings, setting an awarded amount, on a program they do not run.
 *
 * The Open button on the project page is hidden for the same case, and this
 * is why hiding it was never the fix: the button is a link to an address, and
 * the address was the hole. Both ask `reachesProgram`.
 *
 * **Before the POST handler**, which is the half that matters. A guard placed
 * after it refuses the page and accepts the writes.
 *
 * Sent back to the project rather than shown a refusal. The project page
 * still lists this program and still says the project is entered in it, which
 * is true and worth knowing; what stops here is acting on the entry. A 404
 * would be a lie about a row they can already see.
 */
if (
  !reachesProgram(me, programId, {
    /* `participation.row.projects`, which `PARTICIPATION_COLUMNS` already
       selects. Read here rather than from `entry`, which is bound three
       hundred lines below and would put this guard after the POST handler. */
    isAuthor: isAuthorOf(
      (participation as any)?.row?.projects?.project_authors ?? [],
      account.id
    ),
    attachedTo: (roles ?? []).some(
      (r: any) => r.scope_id === programId && (r.role === 'officer' || r.role === 'advisor')
    ),
  })
) {
  return Astro.redirect(`/app/project/${projectId}/`);
}

/* The rest of this page was written when the route was keyed on the
   participation row, and `id` means that row throughout. Bound here rather
   than renamed through eighty-odd references, which would be a large diff
   saying nothing. */
const id = participation.id;

/* A class or a club, rather than something entered. Read from
   `program_role`, never inferred from which columns are null: a course has
   no money and a grant has no placement, so null proves nothing. */
const isCohort = participation.isCohort;

/* Seeded from the redirect that a POST answers with, not from the POST
   itself. See src/lib/post-redirect.ts. */
let { error, note: recordedNote } = outcomeFrom(Astro.url);

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const action = String(form.get('action') ?? '');

  if (action === 'warn') {
    const { data: row } = await supabase
      .from('participations')
      .select('org_id, program_id, project_id')
      .eq('id', id)
      .maybeSingle();

    const { error: e } = await supabase.from('step_warnings').insert({
      org_id: row?.org_id,
      program_id: row?.program_id,
      step_id: String(form.get('step_id') ?? ''),
      body: String(form.get('body') ?? '').trim(),
      /* The project that prompted it, kept as evidence. "This happened" is a
         better argument than "be careful". */
      from_project: row?.project_id ?? null,
      written_by: account.id,
      /* Written this season by somebody who is here, so it counts as
         confirmed until the next handover asks again. */
      confirmed_at: new Date().toISOString(),
      confirmed_by: account.id,
    });

    if (e) error = e.message;
    else recordedNote = 'Written. Everybody in this program sees it on that step.';
  }

  /* Keeping a warning honest, on the step it belongs to.
  
     These two lived on `/app/warnings/`, a page listing every warning the
     program had ever collected. That page is gone: a raw list is read by
     nobody before they need it and is the wrong shape for finding the one
     line that matters once they do. But retiring and confirming are not the
     list -- they are how the advice stops being stale, and losing them with
     the page would have left a club unable to withdraw a warning that had
     stopped being true.
  
     So they moved to where the warning is already shown. Retiring is not
     deleting: the row is kept and marked, because "we used to warn about
     this and it no longer applies" is itself worth knowing at handover. */
  if (action === 'warning_state' && me.runsTheClub) {
    const what = String(form.get('what') ?? '');
    const warningId = String(form.get('warning_id') ?? '');

    const patch =
      what === 'retire'
        ? { retired_at: new Date().toISOString(), retired_by: account.id }
        : { confirmed_at: new Date().toISOString(), confirmed_by: account.id };

    const { error: e } = await supabase
      .from('step_warnings')
      .update(patch)
      .eq('id', warningId);

    if (e) error = e.message;
    else {
      recordedNote =
        what === 'retire'
          ? 'Retired. It is kept, not deleted.'
          : 'Confirmed for this season.';
    }
  }

  if (action === 'money') {
    const asNumber = (name: string) => {
      const raw = String(form.get(name) ?? '').trim();
      return raw === '' ? null : Number(raw);
    };

    const patch: Record<string, number | null> = {
      requested_amount: asNumber('requested_amount'),
    };

    /* Only a reviewer records what was given. An applicant writing their own
       award in is not a threat so much as a number nobody can trust. */
    if (me.runsTheClub) patch.awarded_amount = asNumber('awarded_amount');

    const { error: e } = await supabase.from('participations').update(patch).eq('id', id);
    if (e) error = e.message;
    else recordedNote = 'Saved.';
  }

  if (action === 'deliverable') {
    const { error: e } = await supabase.rpc('record_deliverable', {
      p_participation_id: id,
      p_milestone_id: String(form.get('milestone') ?? '') || null,
      p_type: String(form.get('deliverable') ?? 'other'),
      p_label: String(form.get('label') ?? 'Deliverable'),
      p_signed_on: String(form.get('signed_on') ?? '') || todayIn(org.timezone),
      p_external_url: String(form.get('external_url') ?? '').trim() || null,
      p_storage_path: null,
    });
    if (e) error = e.message;
    else recordedNote = await nextUpNote(supabase, id);
  }

  if (action === 'status') {
    const milestoneId = String(form.get('milestone_id') ?? '');
    const status = String(form.get('status') ?? 'open');
    const on = String(form.get('on') ?? '') || todayIn(org.timezone);
    const url = String(form.get('external_url') ?? '').trim();

    if (status === 'complete') {
      /* The obligation's own name is the label. Asking a student to retype
         "General research idea due" into a box that already said it was a
         question with one answer. */
      const { error: e } = await supabase.rpc('record_deliverable', {
        p_participation_id: id,
        p_milestone_id: milestoneId,
        p_type: String(form.get('kind') ?? 'other'),
        p_label: String(form.get('name') ?? 'Deliverable'),
        p_signed_on: on,
        p_external_url: url || null,
        p_storage_path: null,
      });
      if (e) error = e.message;
      else recordedNote = await nextUpNote(supabase, id, 'Done');
    } else {
      const { error: e } = await supabase.rpc('set_milestone_done', {
        p_milestone_id: milestoneId,
        p_completed_on: null,
      });
      if (e) error = e.message;
    }
  }

  /* The two answers to a nudge, from the plate. `acknowledge_nudge` and
     `nudge_reply` both hard-code the recipient to the caller, so whoever
     was asked may answer and nobody may answer for them; the Workbench
     posts the same two. */
  if (action === 'ack') {
    const { error: e } = await supabase.rpc('acknowledge_nudge', {
      p_milestone_id: String(form.get('milestone_id') ?? ''),
    });
    if (e) error = e.message;
    else recordedNote = 'Noted. Whoever asked can see you have it.';
  }

  if (action === 'reply') {
    const { data, error: e } = await supabase.rpc('nudge_reply', {
      p_milestone_id: String(form.get('milestone_id') ?? ''),
      p_note: String(form.get('note') ?? ''),
    });
    if (e) error = e.message;
    else if (data === 'empty') error = 'Write a line first.';
    else if (data === 'nobody') error = 'Nobody has asked you about this one.';
    else recordedNote = 'Sent to whoever asked.';
  }

  /* A notebook entry, written here (2.8): the notebook is a section of
     the project page for the pilot, so a line about the week is one box on
     the page a student already has open. The same function the notebook
     page calls; the notebook page keeps images and the export. */
  if (action === 'note') {
    const { error: e } = await supabase.rpc('add_field_note', {
      p_project_id: participation.projectId,
      p_body_md: String(form.get('body_md') ?? ''),
      p_occurred_on: String(form.get('occurred_on') ?? '') || null,
      p_corrects_id: null,
    });
    if (e) error = e.message;
    else recordedNote = 'Written in the notebook.';
  }

  if (action === 'verify') {
    const { error: e } = await supabase.rpc('verify_deliverable', {
      p_id: String(form.get('deliverable_id') ?? ''),
    });
    if (e) error = e.message;
  }

  /* An Elder's feedback on a deliverable. The function checks that the
     caller looks after this place, completes the task that was waiting to
     give it, and writes the notebook's line. */
  if (action === 'feedback') {
    const { error: e } = await supabase.rpc('give_feedback', {
      p_deliverable_id: String(form.get('deliverable_id') ?? ''),
      p_body_md: String(form.get('body') ?? ''),
      p_needs_revision: String(form.get('needs_revision') ?? '') === '1',
    });
    if (e) error = e.message;
    else recordedNote = 'Feedback given. The student sees it on the row, and the notebook has the line.';
  }

  /* An Elder's task with nothing to write on, completed with a note. */
  if (action === 'task') {
    const { error: e } = await supabase.rpc('complete_staff_task', {
      p_milestone_id: String(form.get('milestone_id') ?? ''),
      p_body_md: String(form.get('body') ?? '') || null,
    });
    if (e) error = e.message;
    else recordedNote = 'Done.';
  }

  /* A grade, with feedback, for one student on one obligation. The function
     checks that the caller is an advisor and that the student is an author
     here; the page only carries the fields. */
  if (action === 'grade') {
    const scoreRaw = String(form.get('score') ?? '').trim();
    const outOfRaw = String(form.get('out_of') ?? '').trim();

    /* A rubric grade arrives as one choice per criterion, `rubric:<criterion>`
       = level id. The score is the sum of the points chosen and the out-of
       the sum of each criterion's best, both read from the template rather
       than from the form, so a form field cannot claim points the rubric
       does not offer. */
    const stepName = String(form.get('step_name') ?? '');
    /* Resolved here rather than read from `template`, which is declared
       further down with the process it depends on; the rubric does not
       vary by process, so the program's own resolution is the right one. */
    const rubric = (() => {
      try {
        const templateId = (participation.row?.programs as any)?.template_id;
        return templateId ? resolveProgram(templateId, null).steps.find((st) => st.name === stepName)?.rubric ?? null : null;
      } catch {
        return null;
      }
    })();
    let score: number | null = scoreRaw === '' ? null : Number(scoreRaw);
    let outOf: number | null = outOfRaw === '' ? null : Number(outOfRaw);
    let chosen: any = null;

    if (rubric) {
      /* The score is the rubric's: a sum, or for a class rubric out of 4,
         the mean of the rows chosen (scoreRubric). Read from the template,
         never from the form. */
      const scored = scoreRubric(rubric, rubric.criteria.map((c: any) => ({ id: c.id, level: String(form.get(`rubric:${c.id}`) ?? '') })));
      chosen = { criteria: scored.picks };
      score = scored.score;
      outOf = scored.outOf;
    }

    const { error: e } = await supabase.rpc('grade_milestone', {
      p_milestone_id: String(form.get('milestone_id') ?? ''),
      p_student_id: String(form.get('student_id') ?? ''),
      p_score: score,
      p_out_of: outOf,
      p_feedback_md: String(form.get('feedback') ?? ''),
      p_rubric: chosen,
      p_release: String(form.get('release') ?? '') === '1',
    });
    if (e) error = e.message;
    else recordedNote = String(form.get('release') ?? '') === '1' ? 'Graded and released.' : 'Graded. Not released yet.';
  }

  if (action === 'result') {
    const { error: e } = await supabase.rpc('record_entry_result', {
      p_participation_id: id,
      p_category: String(form.get('category') ?? ''),
      p_entry_code: String(form.get('entry_code') ?? ''),
      p_placement: String(form.get('placement') ?? ''),
      p_awards: String(form.get('awards') ?? '')
        .split(/\r?\n/)
        .map((a) => a.trim())
        .filter(Boolean),
      p_advanced_to: String(form.get('advanced_to') ?? ''),
    });
    if (e) error = e.message;
  }

  if (action === 'started') {
    const { error: e } = await supabase.rpc('set_project_start', {
      p_project_id: String(form.get('project_id') ?? ''),
      p_started_on: String(form.get('started_on') ?? '') || null,
    });
    if (e) error = e.message;
  }

  /* ── What the published record shows ─────────────────────────────────────
  
     Images, a video, and links to work kept elsewhere. These are facts about
     the project rather than about this participation, and they were on the
     notebook page, where they had nothing to do with a notebook. They belong
     with the deliverables, because that is what they are: the things a
     project hands over.
  
     The project id comes off the entry rather than from the URL, since this
     route is keyed on a participation. */
  const projectOf = async () => {
    /* The project is already resolved; this survives as a function because
       several actions call it. */
    return participation.projectId;
  };

  if (action === 'image') {
    const file = form.get('image') as File | null;
    const pid = await projectOf();

    if (!pid) error = 'That entry has no project.';
    else if (!file || file.size === 0) error = 'Choose an image first.';
    else if (file.size > MAX_UPLOAD_BYTES) error = 'That file is too large.';
    else {
      const blob = blobStore(Astro.locals);
      if (!blob.available()) error = 'File storage is not configured here.';
      else {
        /* What it is, from the bytes. `file.type` and the name are both
           whatever the person posting chose to put in the multipart body. */
        const kind = await identify(file);

        if (!kind || !kind.mime.startsWith('image/')) {
          error = 'That is not an image we can show. Use a JPEG, PNG, WebP or GIF.';
        } else {
        const path = projectImagePath(pid, file.name, kind.ext);
        try {
          await blob.put(path, await file.arrayBuffer(), kind.mime);
          const { error: e } = await supabase.rpc('add_project_image', {
            p_project_id: pid,
            p_storage_path: path,
            p_alt: String(form.get('alt') ?? ''),
            p_caption: String(form.get('caption') ?? ''),
          });
          if (e) error = e.message;
          else recordedNote = 'Image added.';
        } catch (e: any) {
          error = e.message;
        }
        }
      }
    }
  }

  if (action === 'image_remove') {
    const { error: e } = await supabase.rpc('remove_project_image', {
      p_image_id: String(form.get('image_id') ?? ''),
    });
    if (e) error = e.message;
    else recordedNote = 'Image removed.';
  }

  if (action === 'video') {
    const pid = await projectOf();
    const { error: e } = await supabase.rpc('save_project_video', {
      p_project_id: pid,
      p_url: String(form.get('video_url') ?? ''),
    });
    if (e) error = e.message;
    else recordedNote = 'Video saved.';
  }

  if (action === 'link') {
    const pid = await projectOf();
    const { error: e } = await supabase.rpc('add_project_link', {
      p_project_id: pid,
      p_label: String(form.get('label') ?? ''),
      p_url: String(form.get('url') ?? ''),
    });
    if (e) error = e.message;
    else recordedNote = 'Link added.';
  }

  /* A refresh should re-read this page, not send the form again. */
  return afterPost(Astro.url, { error, note: recordedNote });
}

/* Already fetched by the resolver above, which read the columns this page
   needs. Named `entry` because the rest of the file calls it that; it is a
   participation, and on this page it may be a class. */
const entry: any = participation.row;

/**
 * THE PROCESS THIS PARTICIPATION IS READ AGAINST. 22.4.
 *
 * A precedence, not a field:
 *
 *     the program's process, where it has one, else the project's
 *
 * An opportunity may not prescribe one -- a check on `programs` refuses it,
 * and `app.process_for` filters on the same rule -- so for a fair this
 * resolves to the project's own process, which is what it did before.
 *
 * **An entry made through a cohort resolves against that cohort's process**,
 * because the framework the work was done under is a fact about the work
 * rather than about the venue. An entry sent to a regional fair through the
 * research class is design-thinking work being judged at a fair, and the
 * fair's steps should read that way.
 */
const processFor =
  (entry.programs as any)?.process_id ??
  (page?.via_process_id ?? null) ??
  (entry.projects as any)?.process_id ??
  null;

/* Through milestones_of (2.9): the same rows, the visibility rule asked
   once for the project rather than once per row. */
const { data: allMilestoneRows } = await supabase
  .rpc('milestones_of', { p_participation_ids: [id] })
  .select('id, name, kind, due_on, required, blocks_experimentation, completed_on, completed_by, satisfied_by, sort_order, source, phase, owner, step_id, requires_step, requires_steps, feedback_on')
  /* By date, not by the template's sequence.
   
     A sequence says what depends on what; a student looking at a list of
     deadlines wants to know what is next. Those differ: the fair's
     applications open in September and sit late in the sequence because they
     belong to the approval phase, which reads as an error on a page headed
     "deadlines".
   
     Anything with no date sorts last rather than first, which is what
     Postgres does by default for ascending order and is the right answer
     here: a step nobody has scheduled is not the next thing to worry about. */
  .order('due_on', { ascending: true, nullsFirst: false })
  .order('sort_order', { ascending: true });
/* An rpc's rows are typed as row-or-rows; these are rows. */
const allMilestones = (allMilestoneRows ?? []) as any[];

/**
 * **The student's obligations, and the Elder's tasks, told apart.**
 *
 * `owner` says whose a row is. Everything the page counts, sorts and warns
 * about reads the student's rows: what is next, what is late, the phase
 * counts, the date-order findings. The Elder's tasks are shown on the same
 * calendar so the student can see feedback is coming, and are counted
 * against nobody but the Elder.
 */
const milestones = (allMilestones ?? []).filter((m: any) => m.owner !== 'staff');
const staffTasks = (allMilestones ?? []).filter((m: any) => m.owner === 'staff');

/* The gate (2.8): the steps this one waits on that are not yet met, by
   name, on this place. Empty when it may be started. */
const gateOf = (m: any): string[] => {
  const ids = new Set<string>([...(m.requires_steps ?? []), ...(m.requires_step ? [m.requires_step] : [])]);
  if (ids.size === 0) return [];
  return (allMilestones ?? []).filter((x: any) => ids.has(x.step_id) && !x.completed_on).sort((a: any, b: any) => (a.sort_order ?? 0) - (b.sort_order ?? 0)).map((x: any) => x.name);
};

/* Whether a staff task may be done yet: the student step it requires is
   met. Resolved here by step id, the same way the function does. */
const taskReady = (t: any) => gateOf(t).length === 0;

/* Feedback on this place: on a deliverable, or on a task with none. */
const feedbackRows = (page?.feedback ?? []) as any[];

const feedbackOnDeliverable = (deliverableId: string) => (feedbackRows ?? []).filter((f: any) => f.deliverable_id === deliverableId);
const feedbackOnTask = (milestoneId: string) => (feedbackRows ?? []).filter((f: any) => f.milestone_id === milestoneId && !f.deliverable_id);
const openRevision = (deliverableId: string) => feedbackOnDeliverable(deliverableId).some((f: any) => f.needs_revision && !f.resolved_at);

/* Current ones only. A superseded row is the version somebody replaced, and
   reading it back would answer "what has been recorded" with a document that
   is no longer the one. */
const deliverables = (page?.deliverables ?? []) as any[];

/* This participation's sponsors, not the project's. A teacher who signed
   for the class did not thereby sign for the fair, and the approval
   obligation this satisfies is on this calendar.

   **A list, and `maybeSingle` is why.** A class taught by two teachers has
   two current sponsors, and `maybeSingle` answers more than one row with an
   error and no data — so the page read *no sponsor named* on a project that
   had two, and offered *Name one* beside them. A read that cannot survive
   the second row is a read that reports the opposite of what is there. */
/* From the one project-side read (2.9): this place's sponsors, and the
   other places' below, out of the same rows. */
const sponsorsAll = sponsorsFromPlaces(page?.sponsor_places ?? []);
const sponsorRows = sponsorsAll.filter((x) => x.participation_id === id);
const sponsors = sponsorRows ?? [];
const sponsor = sponsors[0] ?? null;

/**
 * Whoever sponsors this project **somewhere else**.
 *
 * A student in a class, a club and a fair has three sponsors and they are
 * three different teachers. Without this the page said "Name one" while two
 * teachers were already named on the same project, and gave no hint that
 * the missing one was the third.
 *
 * Shown, never assumed: agreeing to run the class is not agreeing to sponsor
 * a fair entry, and filling the name in here would claim it was.
 *
 * Read from the project's side through `sponsorsOf` (2.9): the embed-filtered
 * read this replaced was the slowest call on the page, and its result had
 * stopped being rendered when the sponsor line was redrawn. It is rendered
 * now, beside "No sponsor named", so the hint the comment above promises is
 * actually on the page.
 */
const elsewhere = sponsorsAll.filter((x) => x.participation_id !== id);
const elsewhereSays = elsewhere.length
  ? ' · ' + elsewhere.map((x) => `${x.teacher_name} sponsors it in ${x.program_name ?? 'another place'}`).join('; ')
  : '';

/* Everything the published record shows, read once the project is known.
   These belong to the project rather than to this participation, which is
   the tension recorded in Future Work: a project in two programs shows them
   on both hubs. Nothing breaks; the facts are simply the same facts. */
/* `projectId` is the URL's, resolved at the top. It used to be read back off
   the row here, which was the only way when the route was keyed on the
   participation. */

/* Linked documents and the manuscript in one read off the project (2.9);
   the images read that sat here was never rendered — the notebook page
   keeps the images — and is gone. */
const links = ((page?.links ?? []) as any[]).slice().sort((a: any, b: any) => String(a.created_at).localeCompare(String(b.created_at)));
const manuscript = (page?.manuscript ?? null) as any;

/* When it was last written in: the one fact about the notebook this page
   renders (2.9). Two counts and the ten latest entries were read here and
   never shown — the notebook is its own page — and are gone. */
const lastNote = (page?.last_note ?? null) as any;



/* `users.id` is on every row: two readers below key on it (an Elder could
   not complete a task and a grade row never found its grade without it). */
const overseers = (page?.overseers ?? []) as any[];

/**
 * **The officer of *this* place.**
 *
 * A project in the class and the club has an Elder and a club officer, and
 * they are two different students — the same way it has two sponsors
 * (22.18). Oversight names the participation now, so this is a lookup rather
 * than a guess: it used to take the first officer row on the project and
 * show that person on every participation page, and briefly inferred
 * coverage from the officer's standing role, which could not tell "assigned
 * here" from "runs this program".
 *
 * An author looking after their own work is an oversight row like any other,
 * marked self managed.
 */
const officer = (overseers ?? []).find(
  (a: any) => a.role === 'officer' && a.participation_id === entry.id
);

/* Accepted authors only. An invitation nobody answered is not a byline, and
   showing one here would name somebody who has not agreed to be named. */
/* Grades on this place: the current row per obligation and student. An
   advisor sees all of them; a student sees their own once released; the
   policy decides and the page only keys what it gets. */
const { data: assessmentRows } = await supabase
  .from('assessments')
  .select('id, milestone_id, student_id, score, out_of, rubric, feedback_md, released_at, created_at, kind, grader:grader_id(display_name)')
  .eq('participation_id', entry.id)
  .is('superseded_by', null);

/* Two judgments per student per obligation: the teacher's grade and the
   family's score (the Elder's, out of 4 with a comment, the class tracker
   brought in). Keyed apart. */
const gradeFor = new Map<string, any>((assessmentRows ?? []).filter((a: any) => a.kind !== 'elder').map((a: any) => [`${a.milestone_id}:${a.student_id}`, a]));
const scoreFor = new Map<string, any>((assessmentRows ?? []).filter((a: any) => a.kind === 'elder').map((a: any) => [`${a.milestone_id}:${a.student_id}`, a]));

/* The reader's own released grades, for the roll-up. The policy returns
   only these to a student; an advisor sees everything and has the Class
   page for the roll-up, so theirs is empty here on purpose. */
const myGrades = me.isAdvisor || !platform.gradesToStudents
  ? []
  : (assessmentRows ?? []).filter((a: any) => a.student_id === account.id && a.released_at && a.kind !== 'elder');
const gradeTotal = myGrades.reduce((n: number, a: any) => n + Number(a.score ?? 0), 0);
const gradeOutOf = myGrades.reduce((n: number, a: any) => n + Number(a.out_of ?? 0), 0);
const milestoneName = (milestoneId: string) => (allMilestones ?? []).find((m: any) => m.id === milestoneId)?.name ?? 'An obligation';

/* Whether the reader looks after this place: attached as an officer to it,
   or an advisor. The same rule the functions apply. */
/* The Elders of this place: officer rows on it that are not the author
   looking after their own work. */
const eldersHere = (overseers ?? []).filter(
  (a: any) => a.role === 'officer' && a.participation_id === entry.id && !a.self_managed_at
);
/* `user_id` off the row. This compared `users.id` off a join that selects
   only `display_name`, so it was undefined for everybody and no Elder
   could ever complete a task: the row read *Open* with nothing to press.
   The advisor stands in only where the place has no Elder, which is the
   rule `app.looks_after` applies to the verbs below. */
const oversees =
  eldersHere.some((a: any) => a.user_id === account.id) ||
  (me.isAdvisor && eldersHere.length === 0);

/* Names for the people who completed things, read off the overseers and
   the sponsor rather than another query. */
const nameOf = (userId: string | null | undefined): string | null =>
  userId ? ((overseers ?? []).find((a: any) => a.user_id === userId)?.users as any)?.display_name ?? null : null;

const authors = (overseers ?? []).filter(
  (a: any) => a.role === 'author' && a.accepted_at
);

const deliverableFor = new Map<string, any>();
for (const d of deliverables ?? []) {
  if (d.milestone_id) deliverableFor.set(d.milestone_id, d);
}

const project: any = entry.projects;
const program: any = entry.programs;

/* Does the work, or watches it. */
const iAuthor = isAuthorOf(project?.project_authors ?? [], account.id);

const findings = checkDateOrder({
  startedOn: project?.started_on ?? null,
  today: todayIn(org.timezone),
  obligations: (milestones ?? []).map((m: any) => ({
    id: m.id,
    name: m.name,
    dueOn: m.due_on,
    completedOn: m.completed_on,
    /* The signature on the deliverable, where one exists. It is the date the
       fair actually cares about. */
    signedOn: deliverableFor.get(m.id)?.signed_on ?? null,
    blocksExperimentation: m.blocks_experimentation,
    required: m.required,
  })),
});

const worst = worstFinding(findings);
const byId = new Map(findings.map((f) => [f.id, f]));

/**
 * What to call each layer, in front of a student.
 *
 * The program's own name rather than the word "program": "SCVSEFA" tells you
 * who will refuse the work, and "program" does not.
 */
/* A course rather than a competition, which changes a handful of words. The
   kind is on the program, so nothing here has to guess.

   `isCohort` above is the wider question -- a club is a cohort and is not a
   course -- and the two are not interchangeable. `isCourse` decides
   vocabulary; `isCohort` decides whether a thing is a venue at all. */
const isCourse = program?.kind === 'course';
const isGrant = program?.kind === 'grant';

/**
 * What this program asks for, from the template rather than the database.
 *
 * The expected list is computed at render rather than materialised when an
 * entry is created, because a conditional deliverable depends on facts the
 * project can change: answer "yes, a survey" in November and Form 4 has to
 * appear. A materialised list would need re-syncing every time, and the one
 * that failed to sync would be the one nobody noticed.
 *
 * The database stores only what was actually recorded.
 *
 * Declared here, above everything that reads it, and that position is
 * load bearing rather than tidy. `has()` closes over it and `hasResult`
 * calls `has()` on the next line, so with the declaration further down the
 * page threw `Cannot access 'template' before initialization` on every
 * entry. A closure over a later binding is legal; calling it before the
 * binding is initialised is not, and nothing that only compiles the page
 * can tell the two apart.
 */
const template = (entry?.programs as any)?.template_id
  ? (() => {
      try {
        /* Resolved against `processFor` above: the program's own process
           where it has one, else the cohort this went through, else the
           project's. The same fair reads differently for a scientific
           project and an engineering one (22.4). */
        return resolveProgram((entry.programs as any).template_id, processFor);
      } catch {
        return null;
      }
    })()
  : null;

/**
 * What this program has, from its template.
 *
 * The result section is a competition's: a category, an entry code, a
 * placement, somewhere it advanced to. A research class has none of those
 * and was being shown all of them, asking a student what they placed in a
 * category that does not exist.
 *
 * Absent means yes. A competition declares nothing because it has
 * everything, and a program that lacks something says so.
 */
const has = (what: string) => template?.has?.[what] !== false;

/* Whether there is a result to record at all. A grant's outcome is the
   money, which has its own section; a class's outcome is the work. */
const hasResult = !isGrant && (has('categories') || has('awards') || has('advancement'));



/**
 * Who set a deadline, in words the reader would use.
 *
 * `school` means the school's own layer on top of an institution's calendar.
 * For a fair that layer is the club, which is where "The club" came from —
 * and IRPD is a class, so every one of its deadlines read as set by a club
 * that does not exist.
 *
 * The kind is on the program, so there is no reason to guess. `program`
 * falls through to the program's own name, which says more than either word.
 */
/**
 * The deadlines, in phases.
 *
 * Every step names a phase and the program carries the list, so this is a
 * grouping rather than a lookup. Anything whose phase the program does not
 * declare falls into a final group rather than disappearing: a milestone that
 * silently vanishes because a template was edited is worse than an untidy
 * heading.
 */
const facts: Record<string, boolean> = (project as any)?.facts ?? {};

/**
 * Every deliverable this project owes, once each.
 *
 * Several steps can ask for the same artifact — the process says write a
 * research plan, the club says have one read, the fair says submit it — and
 * a list showing it three times is a list that looks like three jobs. One
 * row, naming the steps that want it, in the order the first one comes.
 */
const expected = (() => {
  if (!template) return [] as any[];

  const byId = new Map<string, any>();

  for (const step of template.steps) {
    if (!stepApplies(step, facts)) continue;

    for (const d of deliverablesFor(template, step, facts)) {
      const already = byId.get(d.id);
      if (already) {
        already.steps.push(step);
        continue;
      }
      byId.set(d.id, { ...d, steps: [step], step });
    }
  }

  return [...byId.values()];
})();

/**
 * Whether a deliverable belongs on its deadline row or in a section of its
 * own.
 *
 * One rule, applied to what the program actually asks for: **an artifact is
 * shown where it is owed, and an artifact owed in several places gets one
 * home so it cannot be recorded twice.**
 *
 * A class asks for twenty-two things across twenty-nine steps and shares
 * none of them, so *record it below* sent a student away from the row they
 * were reading to a list where the same words appeared again. A fair shares
 * three — one research plan satisfies the process, the club's reading and
 * the fair's submission (6.8) — and folding those into rows would put the
 * same form under three deadlines.
 *
 * So the question is asked of the program rather than settled once. It is
 * also the honest reading of 11.8b either way: doneness is derived from the
 * artifact existing, and only one form writes it.
 */
/* One list (2.8): the row carries the form whether or not the deliverable
   is shared between steps. Recording on either step records the one
   artifact, and `satisfied()` reads it on both. The separate Deliverables
   section is gone; the branch below that sent a reader there is unreachable
   and kept only until the next pass through this file. */
const inline = true as boolean;

/**
 * What this deadline owes, resolved through the step it came from.
 *
 * Through `expected` rather than through the template again, so the row and
 * the section below are answering out of one list — including the fact that
 * a conditional deliverable this project does not need is not in it.
 */
const wantedBy = (m: any): any[] => {
  const step = stepFor(m.name);
  if (!step) return [];
  return expected.filter((d: any) => d.steps.some((s: any) => s.id === step.id));
};


/* The milestone row a template step became. Recording a deliverable marks
   the deadline it belongs to, which is the whole point of moving the
   controls out of the deadlines table. */
/* The template step a milestone row came from, matched on the name it was
   seeded with. */
const stepFor = (name: string) => template?.steps.find((st) => st.name === name);
/* Whether a student sees the family's score on this step: the platform
   switch, or the step's own say-so in the template (2.8). */
const scoreShown = (m: any) => platform.familyScoresToStudents || Boolean((m.step_id ? template?.steps.find((st) => st.id === m.step_id) : stepFor(m.name))?.tracker?.students);

const milestoneIdFor = (stepId: string) => {
  const step = template?.steps.find((s) => s.id === stepId);
  if (!step) return null;
  return (milestones ?? []).find((m: any) => m.name === step.name)?.id ?? null;
};

/**
 * What this club knows goes wrong, by step.
 *
 * The third layer. The process templates carry the universal warnings and
 * the institution's templates carry its own; these are written by officers
 * against a step, and they are the only layer a school can author for
 * itself.
 *
 * Retired ones are excluded and not deleted: a warning that stopped being
 * true is a record of something that used to be.
 */
const warnings = (page?.warnings ?? []) as any[];

const warningsFor = (stepId: string) =>
  (warnings ?? []).filter((w: any) => w.step_id === stepId);


/* What has been recorded, keyed by the deliverable's id. */
const recorded = new Map<string, any>();
for (const d of deliverables ?? []) recorded.set(d.type, d);

/* The documents written in SciPath for this project (6.16), keyed by the
   deliverable's id, with how far along each is. A deliverable with a
   shape is written on its own page; the row here says where it stands
   and opens it. */
const docRows = (page?.documents ?? []) as any[];
const docFor = (deliverableId: string) => (docRows ?? []).find((d: any) => d.deliverable === deliverableId) ?? null;
/* One sentence for where a document stands (documents.ts), the same on
   every page. */
const docState = (d: any, open = false) => docStanding(docFor(d.id), shape(d.shape), (iso) => fmt(String(iso).slice(0, 10)), { open });

/**
 * The phases, from the resolved template rather than from the seeded row.
 *
 * **`programs.phases` is empty for every fair.** `seed-programs.mjs` resolves
 * each template with no process argument, and the fair templates declare no
 * phases of their own — they tag their steps with `process-science`'s ids and
 * have always borrowed that vocabulary (23.3). Resolved with no floor there
 * is nothing to borrow, so the column is written as `[]`, every milestone
 * falls into the unnamed bucket, and the club's calendar renders as sixteen
 * rows under *Everything else*: the flattest possible version of the one
 * table a student reads most (15.9).
 *
 * The column cannot be right, and not because the seed is careless. A
 * program row is seeded before any project exists, and the process is a fact
 * about the project (22.4) — so the same fair genuinely has different phases
 * for a scientific project and an engineering one, and no single snapshot
 * taken at seed time can hold both. This page already resolves `template`
 * against `processFor`, which is the precedence that knows. Read it from
 * there.
 *
 * The seeded column stays as the fallback for the window a teacher published
 * on a phase, which travels with the row and is not in the resolved chain.
 */
const phaseList: any[] = (() => {
  const resolved = template?.phases ?? [];
  const seeded: any[] = (entry?.programs as any)?.phases ?? [];

  if (resolved.length === 0) return seeded;

  const windowOf = new Map(seeded.map((p: any) => [p.id, p.window ?? null]));

  return resolved.map((p: any) => ({
    id: p.id,
    name: p.name ?? p.id,
    window: p.window ?? windowOf.get(p.id) ?? null,
  }));
})();

/**
 * Whether a deadline has been met.
 *
 * Derived from the deliverables rather than read off the row, and that is
 * the fix for a real failure: a student recorded the research question
 * against "Settle the question with an officer" and the row went on saying
 * *Record it below*, with the phase still reading 0 of 1.
 *
 * Two causes, one answer.
 *
 * **A deliverable is shared between steps.** 6.8 is explicit that a shared
 * id is how one research plan satisfies IRPD's October step and the fair's
 * November one. The form carried the id of the *first* step wanting it, so
 * recording marked one row and left the others open — the shared artifact
 * satisfied one calendar and not the other.
 *
 * **And that first step may have no row at all.** Only steps with a date
 * are seeded as milestones, so a process step with no date resolves to no
 * milestone, the form posts an empty id, and `record_deliverable` marks
 * nothing anywhere.
 *
 * Both disappear if nobody stores the answer. 11.8b already says it about
 * obligations: where the interface asks somebody to assert what the database
 * knows, the question is decoration and the answer is a second version of
 * the truth. A step's doneness *is* what it asked for being there.
 *
 * `completed_on` still answers for a step that hands over nothing — a board
 * measured, judging practised — because there is nothing else to read.
 */
/* One deliverable, two steps (2.8): the journey map is uploaded on the
   draft's deadline and submitted again on the final's. A record counts
   for a step when the step is met, when the record is that step's own
   (`milestone_id`), when it carries no step (a seeded row), or when no
   other step wants the same deliverable. Otherwise the draft's record
   would satisfy the final a week early. */
const stepsWanting = (deliverableId: string) =>
  (template?.steps ?? []).filter((st: any) => (st.deliverables ?? []).some((d: any) => (d.ref ?? d.id) === deliverableId)).length;
const countsFor = (m: any, rec: any): boolean =>
  Boolean(rec) && (Boolean(m.completed_on) || rec.milestone_id == null || rec.milestone_id === m.id || stepsWanting(rec.type) <= 1);
const recFor = (m: any): Map<string, any> => {
  const out = new Map<string, any>();
  for (const [id, rec] of recorded) if (countsFor(m, rec)) out.set(id, rec);
  return out;
};

const satisfied = (m: any): boolean => {
  const step = stepFor(m.name);
  const wants = step ? deliverablesFor(template!, step, facts) : [];

  if (!step || wants.length === 0) return Boolean(m.completed_on);

  /* Optional and inapplicable ones do not hold a step open. A project at
     twelve of fourteen with two inapplicable reads as complete (6.8). */
  const needed = wants.filter((d) => d.requirement !== 'optional');
  if (needed.length === 0) return Boolean(m.completed_on);

  return needed.every((d) => recFor(m).has(d.id));
};

const grouped = (() => {
  const order = new Map(phaseList.map((p: any, i: number) => [p.id, i]));
  const buckets = new Map<string, any[]>();

  for (const m of allMilestones ?? []) {
    const key = m.phase && order.has(m.phase) ? m.phase : '';
    const list = buckets.get(key) ?? [];
    list.push(m);
    buckets.set(key, list);
  }

  const out = [...buckets.entries()]
    .map(([id, rows]) => {
      const phase = phaseList.find((p: any) => p.id === id);
      const students = rows.filter((m: any) => m.owner !== 'staff');
      return {
        id,
        name: phase?.name ?? 'Everything else',
        window: phase?.window ?? null,
        /* Every row, for the table; the student's rows, for the counts. */
        rows: rows.sort((a: any, b: any) => (a.due_on ?? '9999').localeCompare(b.due_on ?? '9999') || a.sort_order - b.sort_order),
        students,
        ...(({ done: metCount, total: countedSteps }) => ({ done: metCount, counted: countedSteps }))(stepProgress(students, satisfied)),
      };
    })
    /* In the program's own order, with the leftovers last. */
    .sort((a, b) => (order.get(a.id) ?? 999) - (order.get(b.id) ?? 999));

  return out;
})();

const whose: Record<string, string> = {
  process: 'Research',

  /* The institution's own deadlines. Not the program's name: the row in the
     database is the school's edition, so the fair's own deadlines read as
     set by the school's club, which is exactly backwards. The fair's name
     lives in the template rather than the database, and the distinction a
     student needs is which of the two set it. */
  program: isCourse ? 'The class' : isGrant ? 'The funder' : 'The fair',

  /* The school's own layer on top. For a fair that layer is the club, which
     is where "The club" came from — and IRPD is a class, so every one of its
     deadlines read as set by a club that does not exist. */
  school: isCourse ? 'The class' : isGrant ? 'The funder' : 'The club',
};

const fmt = (d: string | null) =>
  formatDate(d, 'short');

/* Whole dollars unless the cents matter, which for a few hundred they
   usually do: a budget of 387.40 is a budget somebody costed. */
const money = (amount: number | string) =>
  new Intl.NumberFormat('en-US', {
    style: 'currency',
    currency: (entry as any)?.currency ?? 'USD',
    minimumFractionDigits: Number(amount) % 1 === 0 ? 0 : 2,
  }).format(Number(amount));

/* What a derived obligation reports, and where to go and change it. */
const derived = (m: any) => {
  if (m.satisfied_by === 'sponsor') {
    return {
      met: sponsors.length > 0,
      says: sponsors.map((x: any) => x.teacher_name).join(', ') || `No sponsor named${elsewhereSays}`,
      /* Scoped, so naming a sponsor from the class's page records the
         class's teacher rather than asking again which place was meant. */
      href: `/app/project/${project?.id}/team/?in=${programId}`,
      verb: sponsors.length > 0 ? 'Change' : 'Name one',
    };
  }
  if (m.satisfied_by === 'officer') {
    /* An officer is assigned by another officer or by the advisor, never by
       the author. Offering an author the link sends them somewhere they
       cannot act, and implies the gap is theirs to close. */
    return {
      met: Boolean(officer),
      says: officer
        ? one(officer.users)?.display_name
        : `No ${staffWord(program).toLowerCase()} assigned`,
      href: me.runsTheClub ? `/app/project/${project?.id}/team/` : null,
      verb: officer ? 'Change' : 'Assign one',
      instead: `Another ${staffWord(program).toLowerCase()} or your advisor assigns one.`,
    };
  }
  if (m.satisfied_by === 'start_date') {
    return {
      met: Boolean(project?.started_on),
      says: project?.started_on ? fmt(project.started_on) : 'Not set',
      href: '#start',
      verb: 'Set it',
    };
  }
  return null;
};

/* Derived, like every other count of doneness on this page. Reading
   `completed_on` here would have disagreed with the phase headings the
   moment a shared deliverable satisfied a step. */
/* One count for the whole app (src/lib/step-progress.ts): the student's
   own steps that are things to do, done when dated. */
const progressAll = stepProgress(allMilestones ?? [], satisfied);
const done = progressAll.done;
const total = progressAll.total;
const openCount = progressAll.open;

const now = new Date();
const todayIso = todayIn(org.timezone, now);

/* On the school's calendar (dev-153): the Worker's clock is UTC. */
const daysUntil = (iso: string | null) =>
  iso ? daysFrom(iso, org.timezone, now) : null;


/**
 * The next thing that needs doing.
 *
 * Not the next thing listed: a deadline already met should not be what the
 * page counts down to. And not an **event** either — applications opening is
 * a day on the fair's calendar, not something a student does, and a card
 * reading "52 days to applications open" gives them nothing to act on while
 * their sponsor is unasked.
 *
 * If every remaining obligation is complete and only events are left, the
 * card falls back to the next event rather than showing a dash: something is
 * still coming and saying so is better than saying nothing.
 */
const outstanding = (milestones ?? []).filter((m: any) => !m.completed_on && m.due_on);

/* The date, then the template's order when dates tie (2.8), so this page
   and the Workbench name the same next step. */
const byDate = byDueThenOrder;

const nextOpen =
  outstanding.filter((m: any) => m.kind !== 'event').sort(byDate)[0] ??
  outstanding.sort(byDate)[0];
const toNext = daysUntil(nextOpen?.due_on ?? null);

/**
 * **How much is late, not only what is next.**
 *
 * The row said one obligation was fifteen days overdue and gave no way to
 * know whether it was the only one or the first of five. That is the
 * difference between being a little behind and having lost the thread, and
 * it is what somebody looking after this project is chasing.
 *
 * Read off the same list the table below prints, and `satisfied` rather
 * than `completed_on`, so a step met by a shared deliverable is not counted
 * as late (the phase headings already learned that lesson).
 */
const overdue = (milestones ?? [])
  .filter((m: any) => !satisfied(m) && m.due_on && m.kind !== 'event' && m.due_on < todayIso)
  .sort(byDate);
const oldestLate = overdue[0] ?? null;

/**
 * **The plate: what is on it today, at most three lines.**
 *
 * Everything late, then everything due inside a week, by date; and the
 * notebook when it has gone a week quiet, because that is the obligation a
 * class chases weekly and the one a student can meet in two minutes. One
 * line is a bar; two or three are a short list. Never more than three, so
 * the top of the page says what to do and not what the season holds. The
 * rest of what is late is in the ledger.
 */
const notebookAge = lastNote
  ? daysUntil(String(lastNote.occurred_on ?? lastNote.created_at).slice(0, 10))
  : null;
const notebookQuiet = notebookAge === null || notebookAge <= -7;

/**
 * What has been asked of the reader about this project. `my_nudges()` is
 * the recipient's own list (the outbox is closed to sessions), one row per
 * open obligation somebody nudged them about; here it is the rows on this
 * project, keyed by obligation, so the plate can put the ask on the row
 * it is about. A student who lands here rather than on the Workbench
 * still meets every nudge addressed to them.
 */
const asksFor = new Map<string, any>();
if (iAuthor) {
  const { data: nudgeRows, error: nudgeError } = await supabase.rpc('my_nudges');
  if (nudgeError) console.error(`my_nudges: ${nudgeError.message}`);
  for (const n of nudgeRows ?? []) {
    if (n.project_id === project?.id && n.milestone_id) asksFor.set(n.milestone_id, n);
  }
}
const askOn = (milestoneId: string) => {
  const n = asksFor.get(milestoneId);
  if (!n) return undefined;
  return { milestoneId, askedBy: n.asked_by ?? null, askedOn: n.asked_at ? formatDate(String(n.asked_at).slice(0, 10), 'short') : null, times: Number(n.times ?? 1), acknowledged: Boolean(n.acknowledged_at) };
};

const plate = (() => {
  const soon = (milestones ?? [])
    .filter((m: any) => !satisfied(m) && m.due_on && m.kind !== 'event' && m.due_on >= todayIso)
    .sort(byDate)
    .filter((m: any) => (daysUntil(m.due_on) ?? 99) <= 7);
  /* One thing next (2.8): what an Elder asked for, else the latest of
     the late, else the nearest due. Three rows of "next up" read as a
     list of chores, not a next step; and the ask sits on the row it is
     about, so a nudged step is the row. */
  const asked = (milestones ?? [])
    .filter((m: any) => !satisfied(m) && asksFor.has(m.id))
    .sort((a: any, b: any) => String(asksFor.get(b.id)?.asked_at ?? '').localeCompare(String(asksFor.get(a.id)?.asked_at ?? '')));
  const rows = [...asked, ...overdue, ...soon].slice(0, 1).map((m: any) => {
    const days = daysUntil(m.due_on);
    return { kind: 'step' as const, m, days, late: days !== null && days < 0 };
  });
  if (rows.length === 0 && nextOpen) {
    rows.push({ kind: 'step' as const, m: nextOpen, days: toNext, late: false });
  }
  return rows;
})();
const alarm = plate[0] ?? null;

/**
 * The form a plate row folds open, so the student records the thing where
 * they read that it is due rather than being sent down to the ledger for
 * it. A step with deliverables gets one short form per deliverable still
 * missing (the ledger's own fields); a step with nothing to hand in gets
 * *Done* with a date. The same two actions the ledger posts.
 */
const recordFormFor = (m: any) => {
  const wants = wantedBy(m).filter((d: any) => !recFor(m).has(d.id));
  if (wantedBy(m).length > 0) {
    if (wants.length === 0) return undefined;
    /* Written in SciPath: the plate opens the document rather than
       folding a form, and the row's action says so. */
    if (wants.some((d: any) => d.shape)) return undefined;
    return {
      kind: 'record' as const,
      participationId: entry.id as string,
      milestoneId: m.id as string,
      today: todayIso,
      items: wants.map((d: any) => ({ id: d.id as string, name: d.name as string, templateUrl: (d.template_url as string | null) ?? null })),
    };
  }
  return {
    kind: 'done' as const,
    participationId: entry.id as string,
    milestoneId: m.id as string,
    name: m.name as string,
    milestoneKind: (m.kind as string) ?? 'other',
    today: todayIso,
  };
};

/**
 * The phase this program is in, and how much of it is done.
 *
 * *0 of 29* across a year is discouraging and says nothing about what this
 * month asks for. A class runs in phases and the template declares them, so
 * the useful figure is the phase and the count inside it. Which phase is
 * current: the first with anything open, since a class works forward and
 * the thing not yet done is where somebody is.
 */
const herePhase =
  grouped.find((g: any) => g.students.some((m: any) => !satisfied(m))) ?? grouped[grouped.length - 1] ?? null;

/**
 * The warnings for the step somebody is on right now.
 *
 * Timing is the whole difficulty with this: advice about scoping a
 * literature review is worth a season in October and worthless in March.
 * The next undone obligation is the best available answer to "where are
 * they", and it is already computed for the countdown card.
 */
const nowWarnings = (() => {
  if (!nextOpen || !template) return [] as any[];

  const step = template.steps.find((st) => st.name === nextOpen.name);
  if (!step) return [];

  return [
    ...(step.risk ? [{ body: step.risk, who: null }] : []),
    ...warningsFor(step.id).map((w: any) => ({
      body: w.body,
      who: `${w.users?.display_name ?? `A ${staffWord(program).toLowerCase()}`}, ${fmt(w.created_at)}`,
    })),
  ];
})();

/**
 * The sections of this page, in the order a season runs.
 *
 * Named `sections` rather than `steps` because a step is already a thing
 * here: the unit a template is built from (6.8). Two meanings for one word
 * in a file that reads `template.steps` four lines away is a word nobody
 * can trust.
 *
 * The page is long now that it is the hub, and a long page with eight
 * headings is a page somebody scrolls twice looking for the one they came
 * for. This is a route through it rather than a table of contents: set a
 * date, look after the work, meet the dates, hand things over, show what it
 * looked like, record what happened.
 *
 * Only what is actually rendered. A step that jumps to a heading which is
 * not there is worse than no step, and four of these sections are
 * conditional: a class has no money and no result, a program that asks for
 * nothing has no deliverables.
 */
const sections = [
  /* A class has no approvals to check a start date against; a fair does
     (2.8). The date still exists on the project for the fair's page. */
  { id: 'start', label: 'Project Start Date', show: !isCourse },
  { id: 'deadlines', label: 'Deadlines', show: true },
  { id: 'documents', label: 'Documents', show: platform.linkedDocuments },
  { id: 'money', label: 'The money', show: isGrant },
  { id: 'result', label: 'Result', show: hasResult },
  { id: 'grades', label: 'Grades', show: myGrades.length > 0 },
  /* A class publishes through the showcase; the manuscript is the fair's
     write-up and stays on a fair's page (2.8). Not read from the template:
     it follows the program's kind, as the start date does. */
  { id: 'manuscript', label: 'Manuscript', show: !isCourse },
].filter((section) => section.show);

/* The number a heading shows, looked up rather than written out. Four of
   these sections are conditional, so a number typed into a heading would be
   right on a fair and wrong on a class the moment one of them was absent. */
const sectionNo = new Map(sections.map((section, i) => [section.id, String(i + 1).padStart(2, '0')]));

---

<Base title={project?.title ?? 'Entry'} noindex={true}>
  <div class="wrap">
    <AppShell org={org} account={account} roles={roles} here={`/app/project/${project?.id}/in/${programId}/`} />

    {/* **The cover.** The program and the title on one block in the
        school's hue, and nothing else: the one bar under it says what to
        do today, and the track says where the season is. */}
    <ProjectCover
      kick={programTitle(program)}
      title={project?.title ?? ''}
      nav={{ projectId: project?.id ?? '', programId, showcase: Boolean(program?.showcase && program.showcase !== 'none'), here: 'deliverables' }}
      rename={iAuthor && project ? { projectId: project.id, title: project.title ?? '' } : undefined}
      people={[
        { label: authors.length === 1 ? 'Author' : 'Authors', value: authors.length > 0 ? authors.map((a: any) => a.users?.display_name).join(', ') : 'None yet' },
        /* Every Elder on the place. This read `officer`, the first
           oversight row found, and a class pairs two Elders with a
           project: the second was on the notebook's cover and the roll
           call and missing here. */
        {
          label: eldersHere.length > 1 ? staffWord(program, 'plural') : staffWord(program),
          value: eldersHere.length > 0
            ? eldersHere.map((a: any) => one(a.users)?.display_name ?? '').filter(Boolean).join(', ')
            : officer?.self_managed_at
              ? `${one(officer.users)?.display_name ?? ''}`
              : 'None assigned',
        },
        { label: sponsors.length > 1 ? 'Sponsors' : 'Sponsor', value: sponsors.length ? sponsors.map((x: any) => x.teacher_name).join(', ') : 'None named' },
      ]}
    >
      {/* A class whose template says `people: staff` sets the sponsor and
          the roster itself; the students see the names and have nothing to
          update. Staff always can. */}
      {/* The team page is locked for the pilot (2.8): the roster came
          from the class list and changes go through the teachers. The page
          still answers at its address. */}
      {template?.program?.people !== 'staff' && !me.runsTheClub && (
        <a class="btn btn-sm ghost" href={`/app/project/${project?.id}/team/?in=${programId}`}>Update</a>
      )}
    </ProjectCover>
    {/* Anchored, and every form on this page posts to it. These pages
        run to several screens, and an outcome rendered at the top after
        a click three screens down reads as nothing having happened. */}
    <div id="outcome" tabindex="-1">
      {error && <p class="note" role="alert">{error}</p>}
      {recordedNote && !error && <p class="note" role="status">{recordedNote}</p>}
    </div>

    {/* **The plate.** What is on it today, under the cover and before the
        season's track: the one thing, or two or three, each with its verb.
        The same component the Workbench uses; the track is the map of the
        year, this is today. */}
    <Plate
      rows={[
        ...plate.flatMap((row: any, i: number) => {
          const docs = wantedBy(row.m).filter((d: any) => d.shape && !recFor(row.m).has(d.id));
          const one = {
          id: `p-${row.m.id}`,
          n: row.days,
          unit: row.days === null ? 'no date' : row.late ? 'days late' : row.days === 0 ? 'due today' : 'days left',
          late: row.late,
          kick: row.late ? 'Overdue' : 'Next up',
          ask: askOn(row.m.id),
          title: row.m.name,
          /* The same standing the deliverables table shows (2.8): not
             started, in progress and how many answered. */
          sub:
            (row.m.due_on ? `Due ${fmt(row.m.due_on)}.` : '') +
            (docs.length === 1 ? ` ${gateOf(row.m).length ? `Waits on ${gateOf(row.m).join(', ')}` : docState(docs[0], true).label}.` : '') +
            (i === 0 && overdue.length > plate.filter((r: any) => r.late).length
              ? ` ${overdue.length - plate.filter((r: any) => r.late).length} more late in the ledger.`
              : ''),
          /* The author records it here, on the row, and the page comes
             back with the next thing on top. Anybody else is sent to the
             ledger row, which is where the record is read. */
          form: iAuthor ? recordFormFor(row.m) : undefined,
          actions: docs.length === 1
            ? [{ href: documentPath(project?.id ?? '', docs[0].id), label: iAuthor ? (gateOf(row.m).length ? 'Start' : docState(docs[0], true).verb) : 'Read', accent: iAuthor, waitsOn: iAuthor && gateOf(row.m).length ? gateOf(row.m).join(', ') : undefined }]
            : iAuthor ? [{ href: `#m-${row.m.id}`, label: 'In the ledger' }] : [{ href: `#m-${row.m.id}`, label: 'See the row', accent: row.late }],
          };
          /* A step that wants two documents is two rows, one verb each,
             titled by the document (2.8). The ask, if any, stays on the
             first. */
          if (docs.length > 1) {
            /* A step that wants two documents shows the first not yet
               submitted; the next appears when that one is in. */
            const d = docs[0];
            return [{
              ...one,
              title: d.name,
              actions: [{ href: documentPath(project?.id ?? '', d.id), label: iAuthor ? (gateOf(row.m).length ? 'Start' : docState(d, true).verb) : 'Read', accent: iAuthor, waitsOn: iAuthor && gateOf(row.m).length ? gateOf(row.m).join(', ') : undefined }],
            }];
          }
          return [one];
        }),
        /* No notebook row (2.8): the cover's Notebook button is the way in,
           and a chore on the plate read as a deadline. */
      ]}
    />

    {/* **The season as a track.** A program's phases as stops on a line:
        the ones behind filled in the hue, the one somebody is on in the
        accent with a halo, the ones ahead hollow. Where a project is, in
        one glance, which *0 of 29* never said. Only where the program
        declares phases; a fair with none has a calendar instead. */}
    {grouped.length > 1 && (
      <ol class="track" style={`--stops:${grouped.length}`}>
        {grouped.map((g: any, i: number) => {
          const at = herePhase ? grouped.indexOf(herePhase) : -1;
          const state = i < at ? 'done' : i === at ? 'now' : '';
          return (
            <li class={state}>
              <a href={`#phase-${g.id || 'rest'}`}>
                <span class="n">Phase {i + 1}{state === 'now' ? ' · now' : ''}</span>
                <span class="t">{g.name}</span>
                {g.window && <span class="w">{monthWord(g.window.from)} to {monthWord(g.window.to)}</span>}
                <span class="c">{g.done} of {g.counted}</span>
              </a>
            </li>
          );
        })}
      </ol>
    )}

    {/* Where the place stands.
     
        The page was identical whether a request had been granted, refused,
        or never decided: a student who had been turned down saw their
        deadlines, their deliverables, and no indication that none of it
        counted for this program. The work is still theirs, which is why the
        rest of the page stays; what changes is that the page says so. */}
    {entry.status === 'declined' && (
      <div class="place refused" role="status">
        <h4>Not approved</h4>
        <p>
          {entry.decided_note
            ? entry.decided_note
            : 'Follow up directly for further feedback.'}
        </p>
        <p class="t-sm">
          The project is still yours. Everything below is yours to keep working
          on, and it can be entered somewhere else without being started again.
        </p>
      </div>
    )}

    {entry.status === 'requested' && (
      <div class="place waiting" role="status">
        <h4>Waiting on a decision</h4>
        <p>You can start work anytime; the deadlines below are the real ones</p>
      </div>
    )}

    {/* Only a finding the plate does not already say: a disqualifying
        date order, a missing approval. "X is due in 5 days" under a bar
        reading "Next up: X · 5 days left" was the bar again in prose. */}
    {worst && !['due', 'urgent'].includes(worst.severity) && (
      <div class={worst.severity === 'disqualifying' ? 'flag bad' : 'flag warn'} role="alert">
        <h4>{worst.severity === 'disqualifying' ? 'This will disqualify the entry' : 'Needs attention'}</h4>
        <p>{worst.message}</p>
      </div>
    )}

    {/* What goes wrong at the step you are on now.
     
        The same sentence is worthless in March and worth a season in
        October, so it rises here only while its step is the next one due and
        not yet done. Everything else waits on the deliverable it belongs
        to. */}
    {nowWarnings.length > 0 && (
      <div class="flag now">
        <h4>Where this usually goes wrong</h4>
        {nowWarnings.map((w: any) => (
          <p>
            {w.body}
            {w.who && <span class="dl-who">{w.who}</span>}
          </p>
        ))}
        <p class="t-sm">
          <a href="#deadlines">Every deliverable is submitted on its row below</a>.
        </p>
      </div>
    )}

    {!iAuthor && (
      <p class="note watching">
        You are watching this project rather than working on it. You can read
        everything, add observations, nudge your students and complete
        supervisory tasks.
      </p>
    )}

    {/* Where a link asked to land.
    
        A fragment never reaches a server: the browser keeps `#deliverables`
        to itself. So a link that has to survive a sign in carries the anchor
        as a query parameter instead, and the page scrolls to it once. That
        depends on nothing about how browsers treat fragments across
        redirects, which is inconsistent (20.10). */}
    {sections.some((section) => section.id === Astro.url.searchParams.get('at')) && (
      <script
        is:inline
        define:vars={{ at: Astro.url.searchParams.get('at') }}
      >
        document.getElementById(at)?.scrollIntoView();
      </script>
    )}

    {/* The route through the page.
    
        Numbered and joined by a rule so it reads as a sequence rather than
        as a menu, which is what the season is. The numbers repeat above
        each heading, so arriving somewhere shows where it sits in the
        whole. */}
    {/* The numbered rail that stood here is off (2.8): the plate says what
        is next, the cover's buttons reach the notebook and the showcase,
        and the deadlines are the first thing under the track. */}

    {!isCourse && (
    <section class="sec" id="start">
      <div class="sec-h"><b><span class="sec-n">{sectionNo.get('start')}</span>Project Start Date</b><span>Checked against all approvals</span></div>
      {iAuthor ? (
        <form method="POST" action="#outcome" class="inline">
          <input type="hidden" name="action" value="started" />
          <input type="hidden" name="project_id" value={project?.id} />
          <input class="in" type="date" name="started_on" aria-label="The day you started, or plan to start" value={project?.started_on ?? ''} />
          <button class="btn btn-sm" type="submit">Save</button>
        </form>
      ) : (
        <p><b>{project?.started_on ? fmt(project.started_on) : 'Not set'}</b></p>
      )}
    </section>
    )}

    {/* *The project* section that stood here (people, notebook,
        manuscript) is gone: the people are on the cover, the notebook is a
        button there and on the bar, and the manuscript is the last
        section. */}

    <section class="sec" id="deadlines" data-live="deadlines">
      <div class="sec-h"><b><span class="sec-n">{sectionNo.get('deadlines')}</span>Deadlines</b><span>{remainingWords(progressAll)}{' '}
        {/* Every document written in SciPath, as it stands, on one paper (2.8). */}
        <a class="btn btn-sm btn-2 sec-act" href={`/app/project/${project?.id}/documents/print/?go=1`} target="_blank" rel="noopener noreferrer">Export All Deliverables</a></span></div>

      {/* Grouped by phase, which is what the phases were for: a list of
          nineteen rows is a list, and five named stretches with two or three
          things in each is a plan. The window comes from the template where a
          teacher set one. */}
      <table class="tbl phased">
        <thead>
          <tr>
            {/* Four, and there were five.
            
                The header declared Status and Action; the body has one cell
                that does both — it says what was recorded and offers the way
                to record it — so every row was a cell short and the table
                carried a column that never held anything. Invisible on a
                wide screen, where an empty track costs nothing, and part of
                why this would not fit on a narrow one. */}
            <th scope="col">Due</th>
            <th scope="col">Deliverable</th>
            <th scope="col">Status</th>
          </tr>
        </thead>
        <tbody>
          {grouped.map((group) => (
            <>
              <tr class="phase-row" id={`phase-${group.id || 'rest'}`}>
                <th colspan="3" scope="colgroup">
                  <span class="phase-name">{group.name}</span>
                  {group.window && (
                    <span class="phase-when">{monthWord(group.window.from)} to {monthWord(group.window.to)}</span>
                  )}
                  <span class="phase-count">
                    {/* The same sentence whether or not it is finished.
                        "All done" makes somebody scanning five phases read
                        two different shapes to compare them. */}
                    {doneWords({ done: group.done, total: group.counted, open: group.counted - group.done })}
                  </span>
                </th>
              </tr>

          {group.rows.map((m: any) => {
            /* **An Elder's task, on the calendar and nobody's debt but the
               Elder's.** Shown to everyone so the student can see feedback
               is coming; completed only by an Elder on the place or the
               advisor, and only once the student step it waits on is met. */
            if (m.owner === 'staff') {
              const ready = taskReady(m);
              const target = m.feedback_on ? recorded.get(m.feedback_on) ?? null : null;
              const requiredName = gateOf(m).length ? gateOf(m).join(', ') : null;
              const notes = feedbackOnTask(m.id);
              const canDo = oversees && ready && !m.completed_on;
              return (
                <tr id={`m-${m.id}`} class:list={['staff-row', m.completed_on && 'is-done', !ready && 'is-waiting']}>
                  <td data-label="Due">
                    {fmt(m.due_on)}
                    {!m.completed_on && ready && m.due_on && m.due_on < todayIso && (
                      <span class="pill late">{Math.abs(daysUntil(m.due_on) ?? 0)} late</span>
                    )}
                  </td>
                  <td data-label="Deliverable">
                    <span class="staff-tag">{staffWord(program)}'s task</span>
                    {m.name}
                    {!ready && requiredName && <span class="staff-wait">waiting on {requiredName}</span>}
                    {notes.length > 0 && (
                      <ul class="fb-list">
                        {notes.map((n: any) => (
                          <li><b>{n.author?.display_name ?? staffWord(program)}</b> {n.body_md}</li>
                        ))}
                      </ul>
                    )}
                  </td>
                  <td class="act" data-label="Status">
                    {m.completed_on ? (
                      <span class="rec-ok">Done {fmt(m.completed_on)}{nameOf(m.completed_by) ? ` by ${nameOf(m.completed_by)}` : ''}</span>
                    ) : canDo ? (
                      m.feedback_on && target ? (
                        <details class="rec">
                          <summary class="btn btn-sm accent">Give feedback</summary>
                          <form method="POST" action="#outcome" class="recf fbf">
                            <input type="hidden" name="action" value="feedback" />
                            <input type="hidden" name="deliverable_id" value={target.id} />
                            <p class="recf-n">
                              On <a href={target.external_url ?? `#d-${m.feedback_on}`} target="_blank" rel="noopener noreferrer">{target.label}</a>
                              {target.signed_on ? `, dated ${fmt(target.signed_on)}` : ''}
                            </p>
                            <label><span>What to change, or what was good</span><textarea class="ta" name="body" rows="4" required></textarea></label>
                            <label class="fb-rev"><input type="checkbox" name="needs_revision" value="1" /> <span>Ask for a revision</span></label>
                            <button class="btn btn-sm" type="submit">Send feedback</button>
                          </form>
                        </details>
                      ) : (
                        <details class="rec">
                          <summary class="btn btn-sm accent">{m.feedback_on ? 'Nothing recorded yet · mark done' : 'Mark done'}</summary>
                          <form method="POST" action="#outcome" class="recf fbf">
                            <input type="hidden" name="action" value="task" />
                            <input type="hidden" name="milestone_id" value={m.id} />
                            <label><span>A line of feedback, if there is one</span><textarea class="ta" name="body" rows="3"></textarea></label>
                            <button class="btn btn-sm" type="submit">Done</button>
                          </form>
                        </details>
                      )
                    ) : !ready ? (
                      <span class="p-none">Waiting</span>
                    ) : (
                      <span class="p-none">Open</span>
                    )}
                  </td>
                </tr>
              );
            }

            const f = byId.get(m.id);
            /* The grade rows under this obligation: one per author for an
               advisor, and the reader's own released one for an author. */
            /* Who sees what under the row: the advisor every student with
               the grade form and the family's score; the Elder on the
               place every student with the score form; the author their
               own released grade and their own score. */
            const gradeRows = me.isAdvisor || oversees
              ? authors.map((a: any) => ({ student: one(a.users), grade: gradeFor.get(`${m.id}:${one(a.users)?.id}`) ?? null, score: scoreFor.get(`${m.id}:${one(a.users)?.id}`) ?? null }))
              : iAuthor && ((platform.gradesToStudents && gradeFor.get(`${m.id}:${account.id}`)) || (scoreShown(m) && scoreFor.get(`${m.id}:${account.id}`)))
                /* The author's own row, only for what the pilot shows them
                   (`platform.gradesToStudents`; `platform.familyScoresToStudents`
                   or the step's own `tracker.students`). */
                ? [{ student: { id: account.id, display_name: account.display_name }, grade: platform.gradesToStudents ? gradeFor.get(`${m.id}:${account.id}`) ?? null : null, score: scoreShown(m) ? scoreFor.get(`${m.id}:${account.id}`) ?? null : null }]
                : [];
            return (
              <>
              <tr
                id={`m-${m.id}`}
                class={f?.severity === 'disqualifying' ? 'row-bad' : f?.severity === 'urgent' ? 'row-warn' : ''}
              >
                {/* `data-label` is what the narrow layout prints in place of
                    the heading it can no longer show. On the cell rather
                    than in the stylesheet so one place says what a column
                    is called. */}
                <td data-label="Due">
                  {fmt(m.due_on)}
                  {/* How late, on a fill, where the date is. A date alone
                      reads the same six days out and six days late. */}
                  {m.due_on && !satisfied(m) && m.kind !== 'event' && m.due_on < todayIso && (
                    <span class="pill late">{Math.abs(daysUntil(m.due_on) ?? 0)} late</span>
                  )}
                </td>
                <td data-label="Deliverable">
                  {m.name}
                  {m.blocks_experimentation && <span class="gate">must precede work</span>}
                  {/* What the row owes, folded in from the section that
                      listed it separately: the artifact's name where it
                      differs from the step's, whether it is optional, the
                      class's one line of guidance, the form itself, and the
                      common mistakes written against the step. */}
                  {wantedBy(m).map((d: any) => (
                    <div class="owe">
                      {d.name !== m.name && <span class="owe-name">{d.name}</span>}
                      {d.requirement !== 'required' && (
                        <span class:list={['dl-need', d.requirement]}>{d.requirement === 'conditional' ? 'required for this project' : 'optional'}</span>
                      )}
                      {d.guidance && <p class="owe-guide">{d.guidance}</p>}
                      {d.url && <p class="owe-guide"><a href={d.url} target="_blank" rel="noopener noreferrer">The form itself</a></p>}
                    </div>
                  ))}
                  {(() => {
                    const st = stepFor(m.name);
                    const risks = [st?.risk, ...(st ? warningsFor(st.id).map((w: any) => w.body) : [])].filter(Boolean);
                    return risks.length > 0 ? (
                      <details class="owe-wrong">
                        <summary>Where this usually goes wrong</summary>
                        {risks.map((r: any) => <p class="dl-risk">{r}</p>)}
                      </details>
                    ) : null;
                  })()}
                </td>
                <td class="act" data-label="Status">
                  {m.satisfied_by ? (
                    derived(m)?.href ? (
                      <a class="linkish" href={derived(m)?.href}>{derived(m)?.verb}</a>
                    ) : (
                      <span class="p-none">{derived(m)?.instead ?? derived(m)?.says}</span>
                    )
                  ) : !iAuthor ? (
                    /* **What was recorded, for whoever is looking after it.**
                       The cell used to offer *Verify* and otherwise stay
                       blank, so an Elder opening a project could not see
                       the date anything was done. The record itself, read
                       only, and the verb where there is one. */
                    <div class="rec-done">
                      {wantedBy(m).filter((d: any) => recFor(m).has(d.id)).map((d: any) => {
                        const have = recFor(m).get(d.id);
                        return (
                          <p class="rec-one">
                            {wantedBy(m).length > 1 && <span class="rec-n">{d.name}</span>}
                            {/* A document written in SciPath opens; a paper form has
                                nowhere to go, so it is a plain word (2.8: the anchor it
                                pointed at had left with the ledger). */}
                            {d.shape ? (
                              <a class="linkish" href={documentPath(project?.id ?? '', d.id)}>Submitted {have?.signed_on ? fmt(have.signed_on) : ''}</a>
                            ) : (
                              <span>Submitted {have?.signed_on ? fmt(have.signed_on) : ''}</span>
                            )}
                            {have?.external_url && (
                              <a class="rec-at" href={have.external_url} target="_blank" rel="noopener noreferrer">{linkDomain(have.external_url)}</a>
                            )}
                            {have?.verified_at ? (
                              <span class="rec-ok">Checked{nameOf(have.verified_by) ? ` by ${nameOf(have.verified_by)}` : ''}</span>
                            ) : oversees ? (
                              <form method="POST" action="#outcome" class="inline">
                                <input type="hidden" name="action" value="verify" />
                                <input type="hidden" name="deliverable_id" value={have.id} />
                                <button type="submit" class="linkish">Verify</button>
                              </form>
                            ) : null}
                            {have && openRevision(have.id) && <span class="pill late">Revision asked</span>}
                          </p>
                        );
                      })}
                      {wantedBy(m).every((d: any) => !recFor(m).has(d.id)) && m.completed_on && (
                        <span class="rec-ok">Done {fmt(m.completed_on)}</span>
                      )}
                    </div>
                  ) : (stepFor(m.name)?.deliverables ?? []).length > 0 ? (
                    inline ? (
                      /* **Where it is owed.**
                      
                         The row said *record it below* and sent somebody to a
                         section listing the same obligation again, which for
                         a class is twenty-two round trips through one page.
                         The form is small — a date and an address — so it
                         fits where the deadline is.
                      
                         Still one form, and still no status control: the row
                         does not offer to be ticked, it offers to be
                         satisfied, and doneness is read back from the
                         artifact existing (11.8b). Closed by default, because
                         twenty-nine open forms is not a table anybody can
                         scan. */
                      wantedBy(m).every((d: any) => recFor(m).has(d.id)) ? (
                        /* **What was recorded, not that something was.**
                        
                           This said *Recorded* and nothing else, so the one
                           question a student actually has at this row — what
                           date is on it and where did I put it — took a jump
                           to another section and a scan for the right line.
                           The date is the fact the fair cares about
                           (`checkDateOrder` reads signatures, not ticks), and
                           the address is the thing they would otherwise go
                           hunting for.
                        
                           Same words as the section below, deliberately:
                           *Recorded {date}* and *Where it lives* are already
                           this page's vocabulary and a second phrasing for
                           one fact reads as a second fact. */
                        <div class="rec-done">
                          {wantedBy(m).map((d: any) => {
                            const have = recFor(m).get(d.id);
                            return (
                              <p class="rec-one">
                                {wantedBy(m).length > 1 && <span class="rec-n">{d.name}</span>}
                                <a class="linkish" href={`#d-${d.id}`}>
                                  Submitted {have?.signed_on ? fmt(have.signed_on) : ''}
                                </a>
                                {have?.document_version_id && (
                                  <a class="rec-at" href={documentPath(project?.id ?? '', d.id)}>Open the document</a>
                                )}
                                {have?.external_url && (
                                  <a
                                    class="rec-at"
                                    href={have.external_url}
                                    target="_blank"
                                    rel="noopener noreferrer"
                                  >{linkDomain(have.external_url)}</a>
                                )}
                                {have?.verified_at && <span class="rec-ok">Checked{nameOf(have.verified_by) ? ` by ${nameOf(have.verified_by)}` : ''}</span>}
                                {have && openRevision(have.id) && <span class="pill late">Revision asked</span>}
                              </p>
                            );
                          })}
                          {/* **Feedback, beside the artifact.** What an Elder
                              said about what was recorded, newest first,
                              with the way to answer it: a new version, which
                              supersedes the old row and resolves the ask. */}
                          {wantedBy(m).flatMap((d: any) => feedbackOnDeliverable(recFor(m).get(d.id)?.id ?? '')).length > 0 && (
                            <ul class="fb-list">
                              {wantedBy(m).flatMap((d: any) => feedbackOnDeliverable(recFor(m).get(d.id)?.id ?? '')).map((n: any) => (
                                <li class:list={[n.needs_revision && !n.resolved_at && 'asks']}>
                                  <b>{n.author?.display_name ?? staffWord(program)}</b> {n.body_md}
                                  <span class="fb-when">{fmt(String(n.created_at).slice(0, 10))}{n.resolved_at ? ' · answered' : n.needs_revision ? ' · revision asked' : ''}</span>
                                </li>
                              ))}
                            </ul>
                          )}
                          {iAuthor && wantedBy(m).some((d: any) => recFor(m).get(d.id) && openRevision(recFor(m).get(d.id).id)) && (
                            <details class="rec">
                              <summary class="btn btn-sm accent">Submit a new version</summary>
                              {wantedBy(m)
                                .filter((d: any) => recFor(m).get(d.id) && openRevision(recFor(m).get(d.id).id))
                                .map((d: any) => d.shape ? (
                                  <p class="rec-doc"><a class="btn btn-sm btn-2" href={documentPath(project?.id ?? '', d.id)}>Revise the document{wantedBy(m).length > 1 ? `: ${d.name}` : ''}</a></p>
                                ) : (
                                  <form method="POST" action="#outcome" class="recf">
                                    <input type="hidden" name="action" value="deliverable" />
                                    <input type="hidden" name="deliverable" value={d.id} />
                                    <input type="hidden" name="label" value={d.name} />
                                    <input type="hidden" name="milestone" value={m.id} />
                                    {wantedBy(m).length > 1 && <p class="recf-n">{d.name}</p>}
                                    <label><span>Date on it</span><input class="in" type="date" name="signed_on" value={todayIso} /></label>
                                    <label><span>Google Drive or other URL</span><input class="in" type="url" name="external_url" /></label>
                                    <button class="btn btn-sm" type="submit">Save the new version</button>
                                  </form>
                                ))}
                            </details>
                          )}
                        </div>
                      ) : (
                        wantedBy(m).filter((d: any) => !recFor(m).has(d.id)).every((d: any) => d.shape) ? (
                          /* Written in SciPath (6.16): the row opens the
                             document and says where it stands; Submit is
                             on the document itself. */
                          <div class="rec-docs">
                            {wantedBy(m).filter((d: any) => !recFor(m).has(d.id)).map((d: any) => (
                              <p class="rec-doc">
                                {gateOf(m).length > 0 && !m.completed_on ? (
                                  <span class="btn btn-sm btn-2 is-off" aria-disabled="true" title={`Waits on ${gateOf(m).join(', ')}`}>Start{wantedBy(m).length > 1 ? `: ${d.name}` : ''}</span>
                                ) : (
                                  <a class="btn btn-sm btn-2" href={documentPath(project?.id ?? '', d.id)}>{docState(d, true).verb}{wantedBy(m).length > 1 ? `: ${d.name}` : ''}</a>
                                )}
                                <span class:list={['rec-docstate', gateOf(m).length > 0 && !m.completed_on ? 'waits' : docState(d, true).state]}>{gateOf(m).length > 0 && !m.completed_on ? `Waits on ${gateOf(m).join(', ')}` : docState(d, true).label}</span>
                              </p>
                            ))}
                          </div>
                        ) : (
                        <details class="rec">
                          {/* A button rather than a quiet link, because it
                              is the one action on the row. Opening it shows
                              the two fields and a *Save*, so the verb is not
                              said twice: the row asks, the form saves. */}
                          <summary class="btn btn-sm btn-2">Submit</summary>
                          {wantedBy(m)
                            .filter((d: any) => !recFor(m).has(d.id))
                            .map((d: any) => d.shape ? (
                              <p class="rec-doc">
                                {gateOf(m).length > 0 && !m.completed_on ? (
                                  <span class="btn btn-sm btn-2 is-off" aria-disabled="true" title={`Waits on ${gateOf(m).join(', ')}`}>Start: {d.name}</span>
                                ) : (
                                  <a class="btn btn-sm btn-2" href={documentPath(project?.id ?? '', d.id)}>{docState(d, true).verb}: {d.name}</a>
                                )}
                                <span class:list={['rec-docstate', gateOf(m).length > 0 && !m.completed_on ? 'waits' : docState(d, true).state]}>{gateOf(m).length > 0 && !m.completed_on ? `Waits on ${gateOf(m).join(', ')}` : docState(d, true).label}</span>
                              </p>
                            ) : (
                              <form method="POST" action="#outcome" class="recf">
                                <input type="hidden" name="action" value="deliverable" />
                                <input type="hidden" name="deliverable" value={d.id} />
                                <input type="hidden" name="label" value={d.name} />
                                <input type="hidden" name="milestone" value={m.id} />

                                {wantedBy(m).length > 1 && <p class="recf-n">{d.name}</p>}

                                {/* The class's own template, as a copy
                                    link. Start there, and the address of
                                    the copy is what gets recorded below. */}
                                {d.template_url && (
                                  <p class="recf-tpl">
                                    <a class="btn btn-sm accent" href={d.template_url} target="_blank" rel="noopener noreferrer">Start from the class template</a>
                                    <span class="t-sm">Makes your own copy in your Drive. Paste its address below when you are done.</span>
                                  </p>
                                )}

                                <label>
                                  <span>Date on it</span>
                                  <input class="in" type="date" name="signed_on" value={todayIso} />
                                </label>
                                <label>
                                  <span>Google Drive or other URL</span>
                                  <input class="in" type="url" name="external_url" />
                                </label>
                                <button class="btn btn-sm" type="submit">Save</button>
                              </form>
                            ))}
                        </details>
                        )
                      )
                    ) : (
                      /* Shared between steps, so it has one home below. Two
                         forms for one obligation meant a deadline could be
                         ticked complete with nothing behind it, and a
                         deliverable could exist against a deadline still
                         reading open.
                         
                         The date and the address still show here, because
                         where the artifact is recorded and where a student
                         reads what happened are different questions: the
                         first has one answer per obligation, the second is
                         asked at every row. */
                      satisfied(m) ? (
                        <div class="rec-done">
                          {wantedBy(m)
                            .filter((d: any) => recFor(m).has(d.id))
                            .map((d: any) => {
                              const have = recFor(m).get(d.id);
                              return (
                                <p class="rec-one">
                                  <a class="linkish" href={`#d-${d.id}`}>
                                    Submitted {have?.signed_on ? fmt(have.signed_on) : ''}
                                  </a>
                                  {have?.external_url && (
                                    <a
                                      class="rec-at"
                                      href={have.external_url}
                                      target="_blank"
                                      rel="noopener noreferrer"
                                    >{linkDomain(have.external_url)}</a>
                                  )}
                                </p>
                              );
                            })}
                        </div>
                      ) : (
                        <a
                          class="linkish"
                          href={
                            /* **`#d-` is not an anchor.**
                            
                               This read `#d-${wantedBy(m)[0]?.id ?? ''}`, and
                               the fallback made a link to nowhere rather than
                               no link: `wantedBy` filters `expected`, so a
                               step whose deliverables are all excluded by
                               `applies_when` leaves it empty and the href
                               collapses to a bare prefix. Clicking moved
                               nothing, which reads as a broken page.
                            
                               The section is the honest destination when the
                               row cannot name one document. It always exists
                               here, because this branch only runs when the
                               step has deliverables. */
                            '#deadlines'
                          }
                        >
                          Submit it below
                        </a>
                      )
                    )
                  ) : (
                    /* A step with nothing to hand in still has to be
                       markable: practice judging, a board measured. */
                    <form method="POST" action="#outcome" class="statusf simple">
                      <input type="hidden" name="action" value="status" />
                      <input type="hidden" name="milestone_id" value={m.id} />
                      <input type="hidden" name="name" value={m.name} />
                      <input type="hidden" name="kind" value={m.kind} />

                      <select name="status" aria-label={`Status of ${m.name}`}>
                        <option value="open" selected={!m.completed_on}>Open</option>
                        <option value="complete" selected={Boolean(m.completed_on)}>Done</option>
                      </select>

                      <input
                        type="date"
                        name="on"
                        value={m.completed_on ?? todayIso}
                        aria-label="Date completed"
                      />

                      <button class="btn btn-sm" type="submit">Save</button>
                    </form>
                  )}
                </td>
              </tr>
              {gradeRows.length > 0 && m.kind !== 'event' && (
                <tr class="grade-row">
                  <td colspan="3">
                    {gradeRows.map(({ student, grade, score }: any) => (
                      <div class="g-student">
                      {/* The family's score: written by the Elder on the
                          place, read by every Elder of the class, the
                          teachers and the student. */}
                      {oversees && !me.isAdvisor && !m.completed_on ? (
                        /* Nothing handed in: nothing to score yet (2.8). */
                        <div class="grade shown family quiet">
                          {gradeRows.length > 1 && <span class="g-who">{student?.display_name}</span>}
                          <span class="pill quiet">{score ? `Elder score ${score.score ?? '—'} / ${score.out_of ?? 4}` : 'Elder score: not scored'}</span>
                          <span class="g-by">Waiting for deliverable to be submitted</span>
                        </div>
                      ) : oversees && !me.isAdvisor ? (
                        <details class="grade" open={false}>
                          <summary>
                            {/* The name only where a project has more than one author:
                                on one student's page it said the obvious four times. */}
                            {gradeRows.length > 1 && <span class="g-who">{student?.display_name}</span>}
                            {score ? (
                              <span class:list={['pill', scoreBand(score.score) || 'ok']}>Elder score {score.score ?? '—'}{score.out_of ? ` / ${score.out_of}` : ''}</span>
                            ) : (
                              <span class="pill quiet">Elder score: not scored</span>
                            )}
                          </summary>
                          <form method="POST" action="#outcome" class="gform">
                            <input type="hidden" name="action" value="grade" />
                            <input type="hidden" name="milestone_id" value={m.id} />
                            <input type="hidden" name="student_id" value={student?.id} />
                            <input type="hidden" name="step_name" value="" />
                            <label class="g-score"><span>Score, out of 4</span><input class="in" type="number" step="0.1" min="0" max="4" name="score" value={score?.score ?? ''} /></label>
                            <input type="hidden" name="out_of" value="4" />
                            <label class="g-fb"><span>Comment</span><textarea class="ta" name="feedback" rows="3">{score?.feedback_md ?? ''}</textarea></label>
                            <button class="btn btn-sm" type="submit">{score ? 'Save score' : 'Score'}</button>
                          </form>
                        </details>
                      ) : score && (me.isAdvisor || (iAuthor && scoreShown(m))) ? (
                        /* The student's view of it waits on the class's say
                           (`platform.familyScoresToStudents`, or the step's
                           own `tracker.students`, 2.8). */
                        <div class="grade shown family">
                          <span class="g-who">Elder score</span>
                          <span class:list={['pill', scoreBand(score.score) || 'ok']}>{score.score ?? '—'}{score.out_of ? ` / ${score.out_of}` : ''}</span>
                          {score.feedback_md && <p class="g-text">{score.feedback_md}</p>}
                          <span class="g-by">{score.grader?.display_name ? `${score.grader.display_name}, ` : ''}{fmt(String(score.created_at).slice(0, 10))}</span>
                        </div>
                      ) : null}
                      {me.isAdvisor ? (
                        /* Open where nothing has been given yet (2.9): the
                           teacher came to this row to score it. */
                        <details class="grade" open={!grade}>
                          <summary>
                            <span class="g-who">{student?.display_name}</span>
                            {grade ? (
                              <span class:list={['pill', grade.released_at ? 'ok' : 'soon']}>
                                Teacher score {grade.score !== null && grade.score !== undefined ? `${grade.score}${grade.out_of ? ` / ${grade.out_of}` : ''}` : '(feedback only)'}
                                {grade.released_at ? ' · released' : ' · not released'}
                              </span>
                            ) : (
                              <span class="pill quiet">Teacher score: not graded</span>
                            )}
                          </summary>
                          <form method="POST" action="#outcome" class="gform">
                            <input type="hidden" name="action" value="grade" />
                            <input type="hidden" name="milestone_id" value={m.id} />
                            <input type="hidden" name="student_id" value={student?.id} />
                            <input type="hidden" name="step_name" value={m.name} />
                            {/* Out of 4, the Elders' scale (2.9), decimals allowed: the
                                teacher's score sits beside the Elder's and reads the same. */}
                            {stepFor(m.name)?.rubric ? (
                              <div class="g-rubric">
                                {stepFor(m.name)!.rubric!.criteria.map((c: any) => {
                                  const picked = grade?.rubric?.criteria?.find((x: any) => x.id === c.id)?.level ?? '';
                                  return (
                                    <label class="g-crit">
                                      <span>{c.name}{c.guidance ? <small> · {c.guidance}</small> : null}</span>
                                      <select class="se" name={`rubric:${c.id}`}>
                                        <option value="" selected={!picked}>Not judged</option>
                                        {c.levels.map((l: any) => (
                                          <option value={l.id} selected={picked === l.id}>{l.label} · {l.points}</option>
                                        ))}
                                      </select>
                                    </label>
                                  );
                                })}
                                <p class="t-sm g-sum">
                                  {grade?.score !== null && grade?.score !== undefined ? `Current: ${grade.score} of ${grade.out_of}` : `Out of ${scoreRubric(stepFor(m.name)!.rubric!, []).outOf}`}. {stepFor(m.name)!.rubric!.scoring === 'average' ? 'The score is the average of the rows you choose.' : 'The score is the sum of what you choose.'}
                                </p>
                              </div>
                            ) : (
                              <>
                                <label class="g-score"><span>Score, out of 4</span><input class="in" type="number" step="0.1" min="0" max="4" name="score" value={grade?.score ?? ''} /></label>
                                <input type="hidden" name="out_of" value="4" />
                              </>
                            )}
                            <label class="g-fb"><span>Feedback</span><textarea class="ta" name="feedback" rows="3">{grade?.feedback_md ?? ''}</textarea></label>
                            <label class="g-rel"><input type="checkbox" name="release" value="1" checked={Boolean(grade?.released_at)} /> <span>Visible to {String(student?.display_name ?? '').split(' ')[0]}</span></label>
                            <button class="btn btn-sm" type="submit">Save grade</button>
                          </form>
                        </details>
                      ) : grade && grade.released_at && iAuthor ? (
                        <div class="grade shown">
                          <span class="g-who">Teacher score</span>
                          <span class="pill ok">{grade.score !== null && grade.score !== undefined ? `${grade.score}${grade.out_of ? ` / ${grade.out_of}` : ''}` : 'feedback'}</span>
                          {grade.rubric?.criteria?.length > 0 && stepFor(m.name)?.rubric && (
                            <ul class="g-levels">
                              {stepFor(m.name)!.rubric!.criteria.map((c: any) => {
                                const pick = grade.rubric.criteria.find((x: any) => x.id === c.id);
                                const level = pick ? c.levels.find((l: any) => l.id === pick.level) : null;
                                return level ? <li><b>{c.name}</b> {level.label} · {level.points}</li> : null;
                              })}
                            </ul>
                          )}
                          {grade.feedback_md && <p class="g-text">{grade.feedback_md}</p>}
                          <span class="g-by">{grade.grader?.display_name ? `${grade.grader.display_name}, ` : ''}{fmt(String(grade.created_at).slice(0, 10))}</span>
                        </div>
                      ) : null}
                      </div>
                    ))}
                  </td>
                </tr>
              )}
              </>
            );
          })}
            </>
          ))}
        </tbody>
      </table>
    </section>


    {/* The Deliverables section that stood here is folded into the list
        above (2.8): a deliverable has a deadline, and the row is where it
        is submitted, read and commented on. */}

    {/* ── The notebook, on the project page (2.8) ───────────────────
        For the pilot the project is one page: what is owed, the notebook,
        the showcase. An entry is one box here; the full notebook, with
        images and the export, is one link away and unchanged. */}
    {/* The notebook and the showcase have pages of their own (the cover's
        buttons); the sections that stood here duplicated them (2.8). */}

    {/* Off for the pilot (`platform.linkedDocuments`): each deliverable
        carries its own Drive link now. The section stays for later. */}
    {platform.linkedDocuments && (
    <section class="sec" id="documents">
      <div class="sec-h"><b><span class="sec-n">{sectionNo.get('documents')}</span>Linked documents</b><span>{links?.length ?? 0}</span></div>

      {iAuthor && (
        <form method="POST" action="#outcome" class="linkf">
          <input type="hidden" name="action" value="link" />
          {/* Stacked rather than side by side. A URL is long and a label is
              short, and putting them in one row gave both a box too narrow
              to read what had been pasted into it. */}
          <label>
            <span>What it is</span>
            <input name="label" required autocomplete="off" />
          </label>
          <label>
            <span>Google Drive or other URL</span>
            <input name="url" type="url" required autocomplete="off" />
          </label>
          <button class="btn" type="submit">Add</button>
        </form>
      )}

      {links && links.length > 0 && (
        <ul class="linklist" style="margin-top:18px">
          {links.map((l: any) => (
            <li>
              {/* Somebody else's document, so it opens in its own tab: a
                  student following a link to their own Drive and losing the
                  entry they were part way through filling in is a small
                  disaster with no upside. */}
              <a href={l.url} target="_blank" rel="noopener noreferrer">{l.label}</a>
              <span class="t-sm"> · {linkDomain(l.url)}</span>
            </li>
          ))}
        </ul>
      )}

      {!iAuthor && (!links || links.length === 0) && (
        <p class="t-sm">No documents linked yet.</p>
      )}

    </section>
    )}

    {/* ── The money, where the program is a grant ─────────────────────────
     
        Two numbers and no budget. Asked and given, because they differ more
        often than not: a partial award is the ordinary outcome and what a
        student needs to see is what they have to cut. */}
    {isGrant && (
      <section class="sec" id="money">
        <div class="sec-h">
          <b><span class="sec-n">{sectionNo.get('money')}</span>The money</b>
          <span>{entry.awarded_amount != null ? 'Decided' : 'Not yet decided'}</span>
        </div>

        {iAuthor ? (
          <form method="POST" action="#outcome" class="mform">
            <input type="hidden" name="action" value="money" />
            <div class="row-2">
              <label>
                <span>What you asked for</span>
                <input
                  class="in"
                  type="number"
                  name="requested_amount"
                  min="0"
                  step="0.01"
                  value={entry.requested_amount ?? ''}
                />
                <small>Match the budget exactly. A round number invites the question.</small>
              </label>
              <label>
                <span>What you were given</span>
                <input
                  class="in"
                  type="number"
                  name="awarded_amount"
                  min="0"
                  step="0.01"
                  value={entry.awarded_amount ?? ''}
                  disabled={!me.runsTheClub}
                />
                <small>
                  {me.runsTheClub
                    ? 'Recorded once the decision arrives.'
                    : 'A reviewer records this.'}
                </small>
              </label>
            </div>
            <button class="btn" type="submit">Save</button>
          </form>
        ) : (
          <p class="prose">
            {entry.requested_amount != null
              ? `Asked for ${money(entry.requested_amount)}`
              : 'Nothing recorded yet'}
            {entry.awarded_amount != null && ` · awarded ${money(entry.awarded_amount)}`}
          </p>
        )}

        {entry.awarded_amount != null &&
          entry.requested_amount != null &&
          Number(entry.awarded_amount) > 0 &&
          Number(entry.awarded_amount) < Number(entry.requested_amount) && (
            <p class="note">
              A partial award. Say what you will drop rather than spreading the
              shortfall across everything: a reviewer who funded most of it
              would rather see three of four items done properly.
            </p>
          )}
      </section>
    )}

    <!-- ── What the fair decided ────────────────────────────────────────── -->
    {hasResult && (
    <section class="sec" id="result">
      <div class="sec-h">
        <b><span class="sec-n">{sectionNo.get('result')}</span>Result</b>
        <span>
          {entry.result_recorded_at ? 'Recorded' : isCourse ? 'At the end' : 'After the fair'}
        </span>
      </div>

      <p class="aside">
        What a published record quotes. Facts with names, and no adjectives
        doing work the evidence should do.
      </p>

      <form method="POST" action="#outcome" class="resultf">
        <input type="hidden" name="action" value="result" />

        <div class="rgrid">
          {has('categories') && (
          <label>
            <span>Category</span>
            <input class="in" name="category" value={entry.category ?? ''} />
            <small>The fair's own, which need not match your discipline.</small>
          </label>
          )}
          <label>
            <span>Entry code</span>
            <input class="in" name="entry_code" value={entry.entry_code ?? ''} />
            <small>Displayed, never used as an identifier: the fair reassigns it next season.</small>
          </label>
          <label>
            <span>Placement</span>
            <input class="in" name="placement" value={entry.placement ?? ''} />
            <small>What you placed in your category, if anything.</small>
          </label>
          {has('advancement') && (
          <label>
            <span>Advanced to</span>
            <input class="in" name="advanced_to" value={entry.advanced_to ?? ''} />
            <small>Where this project actually went, not where placing could send it.</small>
          </label>
          )}
        </div>

        {has('awards') && (
        <label>
          <span>Awards, one per line</span>
          <textarea class="ta" name="awards" rows="3">{(entry.awards ?? []).join('\n')}</textarea>
          <small>Special awards and sponsored prizes. Facts with names, no adjectives.</small>
        </label>
        )}

        <button class="btn" type="submit">Record the result</button>
      </form>
    </section>
    )}

    {/* ── Grades, rolled up ─────────────────────────────────────────
        Everything released to this reader, newest first, with the total.
        Each row is also under its obligation in the deadlines table; this
        is the place to read them together. */}
    {myGrades.length > 0 && (
      <section class="sec" id="grades" data-live="grades">
        <div class="sec-h">
          <b><span class="sec-n">{sectionNo.get('grades')}</span>Grades</b>
          <span>{myGrades.length} released · {gradeTotal} of {gradeOutOf}</span>
        </div>
        <ul class="ledger">
          {[...myGrades]
            .sort((a: any, b: any) => String(b.created_at).localeCompare(String(a.created_at)))
            .map((g: any) => (
              <li>
                <span class:list={['verdict', g.out_of && g.score !== null && Number(g.score) / Number(g.out_of) >= 0.7 ? 'ok' : 'soon']}>
                  {g.score ?? '—'}
                  <small>{g.out_of ? `of ${g.out_of}` : 'feedback'}</small>
                </span>
                <span class="what">
                  <span class="t"><a href={`#m-${g.milestone_id}`}>{milestoneName(g.milestone_id)}</a></span>
                  <span class="s"><b>By</b>{g.grader?.display_name ?? 'your advisor'} · {fmt(String(g.created_at).slice(0, 10))}</span>
                  {g.feedback_md && <span class="how">{g.feedback_md}</span>}
                </span>
                <span class="do"></span>
              </li>
            ))}
        </ul>
      </section>
    )}

    {/* Last, because it is last: the write-up comes after everything above
        it has happened. It used to sit with the people and the notebook as
        a third fact about the work, where a student in September read
        "Not started" as one more thing owed. */}
    {!isCourse && (
    <section class="sec" id="manuscript">
      <div class="sec-h">
        <b><span class="sec-n">{sectionNo.get('manuscript')}</span>Manuscript</b>
        <span>{manuscript ? manuscript.title || 'Started' : 'Not Started'}</span>
      </div>
      <p>
        <a class="btn btn-sm" href={`/app/project/${project?.id}/manuscript/`}>
          {manuscript ? 'Open' : 'Start'}
        </a>
      </p>
    </section>
    )}
  </div>
</Base>

<style>
  /* **The hero is the page's width, not a reading measure.**

     `74ch` is right for prose and wrong for a title: a project named
     *Acoustic aversions and impact on oral care* broke across three lines
     at half the width of a laptop, with the rest of the row empty beside
     it. A title is scanned rather than read, and the measure that keeps a
     paragraph legible is the thing making this one hard to take in.

     The line under it keeps a measure of its own, because the sponsor,
     the Elder and the facts beside them are a sentence. */
  /* Wider than the ordinary cover title: a project title is the page's
     subject and it may run to fourteen words. */
  /* A project title is a subject line, not a poster: fourteen words at
     poster size was a screen of purple before anything to do appeared. */
  .resultf {
    display: grid;
    gap: 18px;
    max-width: var(--measure-form);
  }
  .resultf label {
    display: grid;
    gap: 6px;
    /* Without this a cell with shorter help text stretches and its input
       floats away from the one beside it. */
    align-content: start;
  }
  .resultf button,
  .resultf .btn {
    justify-self: start;
    width: auto;
  }
  .aside {
    max-width: var(--measure-form);
    margin: 0 0 22px;
    color: var(--ink-3);
    font-size: 0.9rem;
    line-height: 1.55;
  }
  .resultf label > span {
    font-family: var(--face-ui);
    font-size: 0.78rem;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--ink-2);
  }
  .resultf small {
    color: var(--ink-3);
    font-size: 0.86rem;
    line-height: 1.5;
  }
  .rgrid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px;
  }
  @media (max-width: 700px) {
    .rgrid { grid-template-columns: 1fr; }
  }



  .under { color: var(--ink-3); font-size: 0.95rem; line-height: 1.35; }
  .under.late { color: var(--alert); }

  .flag { border-left: 3px solid var(--alert); padding: 16px 20px; background: var(--alert-bg); margin-bottom: 26px; }
  .flag.warn { border-left-color: var(--stage-ready); background: var(--ready-bg); }
  .flag h4 { margin: 0 0 6px; }
  .flag p { margin: 0; }
  .nbform { display: grid; gap: 8px; max-width: var(--measure-text); margin-bottom: 16px; }
  .nbform label { display: grid; gap: 4px; font-family: var(--face-ui); font-size: 0.86rem; color: var(--ink-3); }
  .nbform .ta { width: 100%; box-sizing: border-box; }
  .nb-row { display: flex; flex-wrap: wrap; gap: 12px; align-items: end; }
  .nblist { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; max-width: var(--measure-text); }
  .nblist li { padding: 8px 12px; background: var(--card); border-left: 3px solid var(--rule); }
  .nb-when { display: block; font-family: var(--face-ui); font-size: 0.8rem; color: var(--ink-3); margin-bottom: 2px; }
  .nb-text :global(p) { margin: 0 0 6px; }
  .nb-text :global(img) { max-width: 100%; }
  .nb-more { border-left-color: transparent !important; background: transparent !important; }
  .owe { margin-top: 4px; }
  .owe-name { display: block; font-size: 0.9rem; color: var(--ink-2); }
  .owe-guide { margin: 2px 0 0; font-size: 0.86rem; color: var(--ink-3); }
  .owe-wrong { margin-top: 4px; }
  .owe-wrong summary { cursor: pointer; font-family: var(--face-ui); font-size: 0.8rem; color: var(--ink-3); }
  .gate { display: inline-block; margin-left: 8px; font-family: var(--face-ui); font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--ink-3); }
  .row-bad td { background: var(--alert-bg); }
  .row-warn td { background: var(--ready-bg); }
  .inline { display: flex; gap: 8px; align-items: center; }
  .inline input[type='date'] { padding: 6px 9px; border: 1px solid var(--rule); background: var(--card); color: var(--ink); font: inherit; font-size: 0.9rem; }
  /* Not every button in an inline form: `.linkish` sits in one of these and
     had to carry `!important` to escape. */
  .inline button:not(.linkish):not(.btn) {
    padding: 7px 14px;
    border: 1px solid var(--ink);
    background: var(--ink);
    color: var(--paper);
    font-family: var(--face-ui);
    font-size: 0.86rem;
    cursor: pointer;
  }
  .sub { display: block; margin-top: 2px; font-family: var(--face-ui); font-size: 0.82rem; color: var(--ink-3); }
  .recf { margin-top: 10px; min-width: 24ch; }
  .recf label { display: block; margin-bottom: 8px; }
  .recf label > span { display: block; margin-bottom: 3px; font-family: var(--face-ui); font-size: 0.82rem; }
  .recf input { width: 100%; padding: 5px 7px; border: 1px solid var(--rule); background: var(--card); color: var(--ink); font: inherit; font-size: 0.9rem; }
  .recf button { padding: 7px 14px; border: 1px solid var(--ink); background: var(--ink); color: var(--paper); font-family: var(--face-ui); font-size: 0.86rem; cursor: pointer; }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
  /* One row, on one line.
   
     The status, the date, the address, and the button are one action, and
     the button wrapping underneath made it read as two. `auto` on the
     address column lets it take whatever is left rather than pushing the
     button out. */
  /* Whose deadline it is. Quiet by default; the institution's is the one
     that carries a consequence, so it is the one with weight. */
  .note.watching { max-width: none; }
  .p-none { color: var(--ink-3); }

  .whose {
    font-family: var(--face-ui);
    font-size: 0.78rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--ink-3);
  }

  .whose.program {
    color: var(--ink);
    font-weight: 600;
  }

  /* A phase heading, inside the table.
   
     A row that looks like the rows around it is another row. This one sits
     on the wash, is set in the interface face, and carries the phase's own
     window and progress — so the eye lands on five headings rather than
     reading nineteen lines to find where it is. */
  .phased .phase-row th {
    /* A band rather than a heavier line. Twenty-nine rows in one table need
       the phase divisions to be visible from the corner of the eye, and a
       rule under a bold line still reads as a row: the wash and the mark
       coloured left edge are what make it a division. */
    padding: 16px 14px 14px;
    background: var(--brand-deep);
    color: var(--brand-contrast);
    border-top: 0;
    border-bottom: 0;
    border-left: 8px solid var(--accent);
    text-align: left;
    font-family: var(--face-ui);
    font-weight: 700;
  }

  .phased .phase-row .phase-when,
  .phased .phase-row .phase-count { color: var(--cover-ink-2); }
  .phased .phase-row .phase-count { color: var(--accent); font-weight: 700; }

  /* The row a link landed on. */
  .phased tr:target td { background: var(--accent-pale); }

  /* Its own line, always. Inline, it followed a short date and wrapped
     under a long one, so two rows apart read as two different layouts. */
  td .pill { display: block; width: max-content; margin: 6px 0 0; }

  /* The zebra in ui.css counts every row, phase headings included, which put
     a wash on half the data rows out of step with their own group. Each
     phase starts its own count. */
  .phased tbody tr td { background: var(--card); }
  .phased tbody tr:hover td { background: var(--ready-bg); }

  .phased tbody .phase-row:first-child th { padding-top: 10px; border-top: 0; }

  /* The three tracks on a wide screen (2.8). The date on one line, never
     wrapped under itself; the deliverable takes the room; the status
     column holds a button and a short standing and no more. Set on the
     head, which sizes a fixed table's tracks; the body cells follow. */
  @media (min-width: 641px) {
    .phased { table-layout: fixed; }
    .phased thead th:nth-child(1) { width: 18%; white-space: nowrap; }
    .phased thead th:nth-child(2) { width: 52%; }
    .phased thead th:nth-child(3) { width: 30%; }
    .phased tbody td[data-label='Due'] { white-space: nowrap; }
    .phased tbody td[data-label='Deliverable'],
    .phased tbody td[data-label='Status'] { overflow-wrap: anywhere; }
  }

  /* ── The deadlines table on a phone ───────────────────────────────────
  
     Four columns, one of which holds a date, one a sentence, and one a form
     with a select and a button in it. On a 390px screen that is wider than
     the screen, and a table that overflows does not clip: it widens the
     page, so every other section on it scrolls sideways too. That is what
     was happening — the whole page moved, not the table.
  
     Not a horizontal scroller. This file already says why, of a different
     table: a horizontal scroller hides its own last column, and here that
     column is the one with the controls in it.
  
     So the row stops being a row. Each becomes a small block with its cells
     stacked, each cell labelled by the heading it no longer sits under —
     the pattern `.queue` and `.facts` already use one breakpoint above.
     `display: block` on the parts of a table takes the table semantics away
     from the layout and leaves them in the markup, where a screen reader
     still finds them.
  
     The phase headings stay full width and keep their rule, because they
     are what makes nineteen obligations five stretches of three. */
  @media (max-width: 640px) {
    .phased,
    .phased tbody,
    .phased tr,
    .phased td {
      display: block;
      width: auto;
    }

    /* Off the layout, not out of the document. */
    .phased thead {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
    }

    .phased tbody tr:not(.phase-row) {
      padding: 4px 0 12px;
      border-bottom: 1px solid var(--rule-fine);
    }

    .phased tbody tr td {
      padding: 6px 14px;
      border: 0;
    }

    /* The heading, printed where the heading used to be. */
    .phased tbody td::before {
      content: attr(data-label);
      display: block;
      margin-bottom: 2px;
      font-family: var(--face-ui);
      font-size: 0.72rem;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      color: var(--ink-3);
    }

    /* The obligation is what somebody is looking for, so it reads as the
       title of the block rather than as its second field. */
    .phased tbody td[data-label='Obligation'] {
      font-size: 1.02rem;
      padding-top: 2px;
    }
    .phased tbody td[data-label='Obligation']::before { display: none; }

    /* The date belongs with it, above it, small. */
    .phased tbody td[data-label='Due'] { padding-bottom: 0; }
    /* The control cell wraps like any other block (2.8). */
    .phased tbody td.act { white-space: normal; }

    .phased .phase-row,
    .phased .phase-row th {
      display: block;
      width: auto;
    }
  }

  .phase-name {
    font-size: 1.12rem;
    letter-spacing: -0.01em;
  }

  .phase-when,
  .phase-count {
    font-family: var(--face-num);
    font-size: 0.8rem;
    font-weight: 400;
    color: var(--ink-3);
    letter-spacing: 0.02em;
  }

  .phase-when::before { content: ' · '; }

  /* Pushed to the right, where a count belongs and where it does not
     compete with the name for the start of the line. */
  .phase-count { float: right; }

  /* ── Deliverables ─────────────────────────────────────────────────────── */

  /* Grades under an obligation. Folded for the advisor, who has forty of
     them; open for the student, who has one. */
  .phased tbody tr.grade-row td { background: var(--sunk); padding: 4px 12px 4px 20px; }
  .g-student { display: grid; gap: 6px; }
  .g-student + .g-student { margin-top: 8px; padding-top: 8px; border-top: 1px dashed var(--rule-fine); }
  .grade.shown.family { border-left: 3px solid var(--accent); padding-left: 8px; }
  .grade { margin: 0; }
  .grade + .grade { margin-top: 6px; }
  .grade summary { cursor: pointer; display: flex; align-items: center; gap: 10px; list-style: none; font-family: var(--face-ui); font-size: 0.9rem; }
  .grade summary::-webkit-details-marker { display: none; }
  .grade summary::before { content: '\25B8'; color: var(--ink-3); }
  .grade[open] summary::before { content: '\25BE'; }
  .g-who { font-weight: 600; }
  /* One row where it fits (2.8): the score, the comment wide, the button. */
  /* One box for the score, the feedback taking the rest of the row, the
     release and the button on the line below (2.9). */
  .gform { display: grid; grid-template-columns: 8rem minmax(16rem, 1fr); gap: 6px 14px; align-items: start; margin: 8px 0 2px; max-width: none; }
  .gform .g-score .in { width: 100%; max-width: 8rem; }
  .gform > .btn { grid-column: 1 / -1; justify-self: start; }
  .gform label > span { display: block; font-family: var(--face-ui); font-size: 0.8rem; color: var(--ink-3); margin-bottom: 2px; }
  .gform .g-fb { grid-column: auto; }
  .gform .g-fb .ta { width: 100%; resize: vertical; min-height: 2.4em; }
  .gform .in, .gform .ta { padding: 6px 8px; }
  @media (max-width: 720px) { .gform { grid-template-columns: 1fr; } .gform .g-fb { grid-column: 1 / -1; } }
  .gform .g-rel { grid-column: 1 / -1; display: flex; align-items: center; gap: 8px; }
  .gform .g-rel span { display: inline; margin: 0; font-size: 0.9rem; color: var(--ink); }
  .grade.shown { display: flex; flex-wrap: wrap; align-items: center; gap: 2px 12px; font-family: var(--face-ui); font-size: 0.9rem; }
  /* The comment on the same line as the score where it fits (2.8). */
  .grade.shown .g-text { flex: 1 1 24ch; margin: 0; font-family: var(--face-ed); font-size: 0.95rem; }
  .grade.shown .g-by { color: var(--ink-3); font-size: 0.82rem; }
  .g-rubric { grid-column: 1 / -1; display: grid; gap: 8px; }
  .g-crit > span { display: block; font-family: var(--face-ui); font-size: 0.86rem; margin-bottom: 4px; }
  .g-crit > span small { color: var(--ink-3); }
  .g-crit .se { width: 100%; max-width: 32rem; padding: 6px 9px; }
  .g-sum { margin: 2px 0 0; }
  .g-levels { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 4px 16px; flex-basis: 100%; font-size: 0.88rem; }
  .g-levels b { font-family: var(--face-ui); font-weight: 600; margin-right: 4px; }

  /* An Elder's task on the student's calendar: the school's hue on the
     edge, the tag, and quiet while it waits. */
  .phased tbody tr.staff-row td { background: var(--sunk); }
  .phased tbody tr.staff-row.is-waiting td { color: var(--ink-3); }
  .staff-tag { display: block; font-family: var(--face-num); font-size: 0.66rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--brand); margin-bottom: 2px; }
  .staff-wait { display: block; margin-top: 3px; font-family: var(--face-ui); font-size: 0.82rem; color: var(--ink-3); font-style: italic; }
  .fb-list { list-style: none; margin: 8px 0 0; padding: 8px 0 0 12px; border-left: 3px solid var(--accent); font-size: 0.92rem; }
  .fb-list li + li { margin-top: 6px; }
  .fb-list li.asks { color: var(--ink); }
  .fb-list b { font-family: var(--face-ui); font-weight: 600; margin-right: 4px; }
  .fb-when { display: block; font-family: var(--face-num); font-size: 0.72rem; color: var(--ink-3); }
  .fbf label { display: block; margin-bottom: 10px; }
  .fbf label > span { display: block; font-family: var(--face-ui); font-size: 0.86rem; margin-bottom: 4px; }
  .fbf .ta { width: 100%; max-width: 40rem; resize: vertical; }
  .fbf .fb-rev { display: flex; align-items: center; gap: 8px; }
  .fbf .fb-rev span { display: inline; margin: 0; }

  .recf-tpl { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 14px; margin: 0 0 12px; }

  .dlist { list-style: none; margin: 0; padding: 0; }

  .dl {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(15rem, 22rem);
    gap: 14px 32px;
    padding: 20px 0;
    border-top: 1px solid var(--rule-fine);
  }
  .dl:first-child { border-top: 0; }

  /* Recorded ones recede: what a student needs is the list of what is not
     done yet, and hiding the rest would lose the record. */
  .dl.have .dl-what { opacity: 0.72; }

  .dl-name { margin: 0; font-size: 1.02rem; font-weight: 600; }

  .dl-need {
    margin-left: 10px;
    font-family: var(--face-num);
    font-size: 0.74rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    font-weight: 400;
    color: var(--ink-3);
  }
  .dl-need.required,
  .dl-need.conditional { color: var(--alert); }

  .dl-where {
    margin: 3px 0 0;
    font-family: var(--face-ui);
    font-size: 0.82rem;
    color: var(--ink-3);
  }

  /* Quieter than the two above it. This is not a problem, it is a thing
     worth knowing before starting, and dressing it as an alarm would spend
     the alarm. */
  /* Above the attention band, and quieter than it. A refusal is a fact
     about the participation rather than a problem with the work, and
     dressing it as an alarm would tell a student their project is broken
     when it is not. */
  /* The cell holding a row's control, which is a link for a derived
     obligation and a form for everything else. */
  .act { white-space: nowrap; }
  /* The button stays on one line; the standing beside it ("Waits on
     Elder Feedback: Journey Map - First Draft") wraps within the fixed
     status track (2.8) rather than running past the table's edge. */
  .act .rec-docstate { white-space: normal; }

  .place {
    padding: 16px 20px;
    margin-bottom: 18px;
    border-left: 3px solid var(--ink);
    background: var(--wash);
  }
  .place h4 {
    margin: 0 0 6px;
    font-family: var(--face-ui);
    font-size: 1rem;
  }
  .place p { margin: 0 0 6px; max-width: 62ch; }
  .place p:last-child { margin-bottom: 0; }

  .place.refused { border-left-color: var(--alert); }
  .place.refused h4 { color: var(--alert); }

  .flag.now {
    border-left: 3px solid var(--rule);
    background: var(--wash);
  }
  .flag.now h4 { color: var(--ink); }

  .dl-wrong {
    margin: 10px 0 0;
    padding: 10px 0 0;
    border-top: 1px solid var(--rule-fine);
    max-width: 60ch;
  }
  .dl-wrong-h {
    margin: 0 0 6px;
    font-family: var(--face-ui);
    font-size: 0.78rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--alert);
  }
  .dl-risk {
    margin: 0 0 8px;
    font-size: 0.92rem;
    line-height: 1.5;
  }
  /* A club's own reads differently from the process's, because a student
     should be able to tell who is telling them. */
  .dl-risk.local {
    padding-left: 12px;
    border-left: 2px solid var(--rule);
  }
  .dl-who {
    display: block;
    margin-top: 3px;
    font-family: var(--face-num);
    font-size: 0.76rem;
    color: var(--ink-3);
  }
  /* Present without competing. Keeping the advice honest is an occasional
     act by two or three people, and the warning is what everybody else is
     here to read. */
  .dl-keep {
    display: flex;
    gap: 6px;
    margin-top: 6px;
  }
  .dl-add { margin-top: 10px; }
  .dl-add summary {
    cursor: pointer;
    font-family: var(--face-ui);
    font-size: 0.84rem;
    color: var(--ink-3);
  }
  .dl-add label > span {
    display: block;
    margin: 8px 0 4px;
    font-family: var(--face-ui);
    font-size: 0.84rem;
  }
  .dl-add .ta { width: 100%; }

  .dl-guide {
    margin: 8px 0 0;
    font-size: 0.94rem;
    line-height: 1.5;
    max-width: 60ch;
  }

  .dl-limit {
    margin: 6px 0 0;
    font-family: var(--face-num);
    font-size: 0.8rem;
    color: var(--ink-2);
  }
  .dl-limit span + span::before { content: ' · '; }

  .dl-shape { margin-top: 8px; }
  .dl-shape summary {
    cursor: pointer;
    font-family: var(--face-ui);
    font-size: 0.86rem;
    color: var(--ink-3);
  }
  .dl-shape ol { margin: 8px 0 0 18px; font-size: 0.92rem; line-height: 1.5; }
  .dl-shape li { margin-bottom: 4px; }

  .dl-form { margin: 8px 0 0; font-size: 0.88rem; }

  .dl-form-in label { display: block; margin-bottom: 8px; }
  .dl-form-in label > span {
    display: block;
    margin-bottom: 4px;
    font-family: var(--face-ui);
    font-size: 0.82rem;
    color: var(--ink-3);
  }
  .dl-form-in .in { width: 100%; }

  .dl-done { margin: 0; font-family: var(--face-ui); font-size: 0.9rem; }
  .dl-ver { margin: 4px 0 0; font-size: 0.84rem; color: var(--ink-3); }
  .dl-none { margin: 0; font-size: 0.9rem; color: var(--ink-3); }

  @media (max-width: 760px) {
    .dl { grid-template-columns: minmax(0, 1fr); }
  }

  .statusf.simple { grid-template-columns: auto auto auto; }

  /* Recording, on the row that asked for it.
  
     A disclosure rather than an open form, because the table has twenty-nine
     rows and a table you can scan is the point of a table. The summary sits at
     the size of the other controls in this column, so the row reads as one
     thing rather than as a link with a widget stuck to it. */
  .rec > summary {
    list-style: none;
    /* Sized like the *Save* beside the status controls on the same table,
       so the two read as the same kind of thing. */
    display: inline-flex;
    padding: 5px 12px;
    font-size: 0.86rem;
  }
  .rec > summary::-webkit-details-marker { display: none; }
  .rec[open] > summary { background: var(--sunk); }

  .recf { margin-top: 10px; max-width: 26rem; }

  /* What was recorded, on the row that owed it. Stacked rather than run on
     one line, because the status column is the narrowest in the table and a
     date plus an address wrapping mid-word reads as damage. */
  .rec-done { display: flex; flex-direction: column; gap: 4px; }
  .rec-docs { display: flex; flex-direction: column; gap: 6px; }
  .rec-doc { margin: 0; display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }
  .sec-h .sec-act { margin-left: 12px; vertical-align: middle; }
  /* One width for every verb on this column: Submit, Continue, Revise,
     "Submit a new version" all sit on the same left edge and end on the
     same right edge, so the rows read as a column of the same control. */
  .rec-doc > .btn, .rec > summary.btn { min-width: var(--row-btn); box-sizing: border-box; justify-content: center; text-align: center; }
  .rec-docstate { font-family: var(--face-ui); font-size: 0.8rem; color: var(--ink-3); }
  .rec-docstate.in_progress, .rec-docstate.revising { color: var(--accent-deep); }
  .rec-docstate.submitted { color: var(--stage-comp); }
  .rec-docstate.waits { color: var(--ink-3); }
  .rec-one { margin: 0; display: flex; flex-direction: column; gap: 2px; }
  .rec-n {
    font-family: var(--face-ui);
    font-size: 0.76rem;
    color: var(--ink-3);
  }
  .rec-at {
    font-family: var(--face-num);
    font-size: 0.78rem;
    color: var(--ink-3);
    word-break: break-all;
  }
  .rec-ok {
    font-family: var(--face-ui);
    font-size: 0.76rem;
    color: var(--ink-3);
  }
  .recf-n { margin: 0 0 6px; font-weight: 600; font-size: 0.92rem; }
  .recf label { display: block; margin-bottom: 8px; }
  .recf label > span {
    display: block;
    margin-bottom: 3px;
    font-family: var(--face-ui);
    font-size: 0.82rem;
    color: var(--ink-2);
  }
  .recf .in {
    width: 100%;
    padding: 6px 8px;
    border: 1px solid var(--rule);
    background: var(--card);
    color: var(--ink);
    font: inherit;
    font-size: 0.9rem;
  }
  /* Two forms under one deadline happens where a step asks for two things.
     Ruled apart so they do not read as one form with four fields. */
  .recf + .recf { border-top: 1px solid var(--rule-fine); padding-top: 10px; }

  .statusf {
    display: grid;
    grid-template-columns: auto auto minmax(9ch, 1fr) auto;
    align-items: center;
    gap: 8px;
  }

  .statusf select,
  .statusf input {
    font-family: inherit;
    font-size: 0.92rem;
    padding: 7px 9px;
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    background: var(--card);
    color: var(--ink);
    min-width: 0;
  }

  .statusf select { font-family: var(--face-ui); }

  @media (max-width: 900px) {
    /* Two lines is right when there is no room for one, but by choice
       rather than because the button fell off the end. */
    .statusf { grid-template-columns: auto 1fr; }
    .statusf input[type='url'] { grid-column: 1 / -1; }
    .statusf button { grid-column: 1 / -1; justify-self: start; }
  }
</style>

<style>
  /* ── The route through the page ────────────────────────────────────────
  
     A numbered sequence rather than a menu, because that is what a season
     is: set a date, look after the work, meet the dates, hand things over,
     record what happened. The rule running through it is the thread, and
     each step sits on it.
  
     The same number appears above the heading it points at, in the same
     face and the same weight, so arriving somewhere shows where it sits in
     the whole rather than only what it is called. That repetition is the
     tie: the rail and the headings are one system read twice.
  
     It wraps rather than scrolls. A horizontal scroller hides its own last
     item, which on this page is the result. */
  .rail {
    margin: 0 0 34px;
    padding: 18px 0 0;
    border-top: 1px solid var(--rule);
  }
  .rail ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0;
  }
  .rail li { position: relative; }
  /* The thread between the steps. On the item rather than between them, so
     a wrapped row does not trail a rule into empty space. */
  .rail li + li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 1.05rem;
    width: 14px;
    border-top: 1px solid var(--rule);
  }
  .rail a {
    display: flex;
    flex-direction: column;
    gap: 3px;
    padding: 4px 20px 8px 20px;
    text-decoration: none;
    color: var(--ink-2);
    border-bottom: 2px solid transparent;
  }
  .rail li:first-child a { padding-left: 0; }
  .rail a:hover,
  .rail a:focus-visible { color: var(--ink); border-bottom-color: var(--ink); }
  .rail-n {
    font-family: var(--face-num);
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    color: var(--ink-3);
  }
  .rail-l { font-family: var(--face-ui); font-size: 0.94rem; }

  /* The number above its heading, matching the rail exactly. */
  .sec-n {
    /* In line with the label rather than above it, at the weight of a folio
       in the margin of a printed page. The one loud thing in the head. */
    font-family: var(--face-num);
    font-size: 1.05rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    /* The school's hue, not the mark. The mark is 3.2:1 on a card, which is
       under this project's AA floor for text at this size — it is an edge
       colour, and edges are exempt because nobody reads them. */
    color: var(--brand);
    margin: 0;
  }

  /* A section landed on sits under the masthead otherwise, with its own
     heading off the top of the window. */
  .sec[id] { scroll-margin-top: 22px; }

  @media (max-width: 640px) {
    .rail a { padding: 4px 14px 8px 14px; }
    .rail li + li::before { width: 10px; }
  }

  /* The project's own facts, as a list of rows rather than a row of buttons.
     Four buttons say "here are four places to go"; this says what each one
     holds and offers the way in beside it. */
  /* ── The project's facts ───────────────────────────────────────────────
  
     Three rows, each: a label, what it says, and what you can do about it.
  
     **No reading measure on it.** This carried `max-width: var(--measure-text)`
     — 66ch — which is right for prose and wrong for a row that also holds
     two eleven-rem buttons. There was not enough width left for the value,
     so "0 entries, append only and attributed" wrapped to one word per line
     and the actions overflowed on top of it. Same mistake as a row of
     figures wrapping inside a hero capped at 74ch: **a measure belongs to
     text, not to a container that holds controls** (15.6a).
  
     Flex rather than grid, and that is the second half of the fix. Each row
     was its own grid, so the three tracks were negotiated separately per
     row and a `max-content` action track could take whatever it liked from
     the value beside it. With flex the actions take their natural width,
     the value takes what is left, and `min-width: 0` lets it shrink instead
     of pushing. */
  .facts { list-style: none; margin: 0; padding: 0; }

  .facts li {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 18px;
    align-items: center;
    padding: 14px 0;
    border-bottom: 1px solid var(--rule-fine);
  }

  .facts .f-lbl {
    flex: 0 0 7.5rem;
    font-family: var(--face-ui);
    font-size: 0.82rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--ink-3);
  }

  /* Whatever the row says about itself. Grows into the space the actions do
     not need, and shrinks rather than shoving them. */
  .facts .f-val {
    flex: 1 1 14rem;
    min-width: 0;
  }

  /* Left aligned, so the eye reads label, fact, action along one line
     rather than jumping to the right margin and back. */
  .f-do {
    flex: 0 0 auto;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  /* Every action here is the same size, whatever its word. Four buttons of
     four widths reads as four different kinds of thing, and the shortest
     looks like an afterthought. */
  .f-do .btn { min-width: 11rem; justify-content: center; }

  /* Three names against a one line button: centring puts the button beside
     the middle name, which reads as belonging to it. */
  .facts li:has(.f-people) { align-items: flex-start; }
  .facts li:has(.f-people) .f-do { padding-top: 2px; }

  /* ── Linking a document ────────────────────────────────────────────────
  
     Stacked and wide. A label and a URL side by side gave each half a
     column, and a Drive address is long enough that half a column showed
     the first thirty characters of something that is almost all the same
     for the first thirty characters.
  
     Taller boxes too. These are pasted into rather than typed into, and a
     shallow box makes checking what landed there harder than it needs to
     be. */
  .linkf {
    display: flex;
    flex-direction: column;
    gap: 14px;
    align-items: flex-start;
    max-width: 48rem;
  }
  .linkf label { display: block; width: 100%; }
  .linkf label > span {
    display: block;
    margin-bottom: 6px;
    font-family: var(--face-ui);
    font-size: 0.86rem;
    color: var(--ink-2);
  }
  .linkf input {
    width: 100%;
    padding: 12px 14px;
    border: 1px solid var(--rule);
    background: var(--card);
    color: var(--ink);
    font: inherit;
    font-size: 1rem;
  }
  .linkf input:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: -2px;
  }

  /* Three names under one label, each on **one** line. The caption used to
     sit above its value, which turned three facts into six lines and pushed
     the manuscript row below the fold on a laptop. A caption is a label,
     not a heading: it belongs beside the thing it names. */
  .f-people { display: flex; flex-direction: column; gap: 6px; }
  .f-people > span { display: flex; gap: 12px; align-items: baseline; }
  .f-people i {
    flex: 0 0 5.5rem;
    font-family: var(--face-ui);
    font-style: normal;
    font-size: 0.74rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--ink-3);
  }
  .f-people em { font-style: normal; }

  /* A phone has room for a label and a value, and not for both plus two
     buttons. The actions drop to their own line and share it. */
  @media (max-width: 640px) {
    .facts .f-lbl { flex: 0 0 100%; }
    .facts .f-val { flex: 1 1 100%; }
    .f-do { flex: 1 1 100%; }
    .f-do .btn { min-width: 0; flex: 1; }
  }
</style>
