  .fwords.over { color: var(--alert); font-weight: 600; }
  .fby { color: var(--ink-3); }
  .fdrafts { flex-basis: 100%; }
  .fdrafts > summary { cursor: pointer; color: var(--ink-3); font-family: var(--face-ui); font-size: 0.8rem; list-style: none; }
  .fdrafts > summary::-webkit-details-marker { display: none; }
  .fdrafts > summary::before { content: '▸ '; }
  .fdrafts[open] > summary::before { content: '▾ '; }
  .fdraft-list { list-style: none; margin: 6px 0 0; padding: 0; display: grid; gap: 4px; max-width: var(--measure-form); }
  .fdraft-list li { display: grid; grid-template-columns: max-content minmax(0, 1fr) max-content; gap: 10px; align-items: center; padding: 4px 8px; background: var(--sunk); font-size: 0.84rem; }
  .fdraft-when { font-family: var(--face-num); font-size: 0.72rem; color: var(--ink-3); white-space: nowrap; }
  .fdraft-text { color: var(--ink-2); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; min-width: 0; }
  @media (max-width: 640px) { .fdraft-list li { grid-template-columns: minmax(0, 1fr); } .fdraft-text { white-space: normal; } }
  /* The room (2.8): who is in a box, the box held for them, and a box
     that just changed under the reader. */
  .fwho { margin-left: 10px; font-family: var(--face-ui); font-size: 0.78rem; font-weight: 600; color: var(--accent); }
  .field.is-held .mdx-edit, .field.is-held .in, .field.is-held .ta { background: var(--sunk); color: var(--ink-2); cursor: not-allowed; }
  .field.is-fresh { outline: 2px solid var(--accent-pale); outline-offset: 4px; transition: outline-color 1.2s ease; }
  .fby-live { margin-top: 6px; }
  .fstate.saving { color: var(--ink-3); }
  .fstate.saved { color: var(--stage-comp); }
  .fstate.kept { color: var(--alert); }
  .fread .fprose :global(img) { max-width: 100%; }
  .fempty { color: var(--ink-3); font-style: italic; margin: 0; }
  .thread { margin-top: 10px; }
  .tlist { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
  .tc { padding: 8px 12px; background: var(--card); border-left: 3px solid var(--rule); font-size: 0.94rem; }
  .tc.asks { border-left-color: var(--alert); }
  .tc.reply { margin-left: 18px; }
  .tc.mine { border-left-color: var(--accent); }
  .tc-who { font-weight: 600; margin-right: 8px; }
  .tc-when { font-family: var(--face-ui); font-size: 0.78rem; color: var(--ink-3); margin-right: 8px; }
  .tc-body :global(p) { margin: 4px 0 0; }
  .fgive { display: flex; flex-wrap: wrap; align-items: center; gap: 12px; margin: 14px 0 4px; padding: 14px 16px; background: var(--card); border: 1px solid var(--rule); border-left: 6px solid var(--accent); }
  .fgive-done { margin: 0; }
  .fgive .t-sm { flex: 1 1 24ch; margin: 0; }
  .tadd { margin-top: 6px; }
  .tadd summary { cursor: pointer; font-family: var(--face-ui); font-size: 0.86rem; }
  .tform { display: grid; gap: 8px; margin-top: 8px; justify-items: start; }
  .tform .ta { width: 100%; box-sizing: border-box; }
  .tform.whole { max-width: var(--measure-form); }
  .task { display: flex; gap: 8px; align-items: center; font-family: var(--face-ui); font-size: 0.86rem; }
  .docsave { display: flex; gap: 12px; align-items: center; margin: 18px 0; }
