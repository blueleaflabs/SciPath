---
export const prerender = false;

/**
 * THE DOCUMENT PAGE (6.16).
 *
 * A deliverable written in SciPath: the shape's sections and fields as a
 * document, saved a field at a time as it is written, read and commented
 * on by the Elders and the teacher while it is in progress, and submitted
 * with one button, which records the deliverable on the class's step and
 * fixes a version.
 *
 * Belongs to the project, not to a place (one literature review meets the
 * class's step and a fair's), so the address is the project's and the
 * places that want it are looked up. The author writes; whoever may see
 * the project reads and, if they are an Elder on it or the advisor,
 * comments. Nothing here needs JavaScript to work: every form posts; the
 * script on top of it saves as you type, keeps a copy in the browser until
 * the server confirms it, and shows another author's newer text instead
 * of overwriting it.
 */

import Base from '../../../../../layouts/Base.astro';
import AppShell from '../../../../../components/AppShell.astro';
import ProjectCover from '../../../../../components/ProjectCover.astro';
import MarkdownEditor from '../../../../../components/MarkdownEditor.astro';
import MarkdownBar from '../../../../../components/MarkdownBar.astro';
import { programSlug, safePart } from '../../../../../lib/export-names';
import { activeOrg } from '../../../../../lib/tenant';
import { serverClient } from '../../../../../lib/supabase';
import { standing, isAuthorOf } from '../../../../../lib/roles';
import { formatDate, todayIn, dayOf } from '../../../../../lib/dates';
import { daysUntil } from '../../../../../lib/attention';
import { afterPost, outcomeFrom } from '../../../../../lib/post-redirect';
import { signInWith } from '../../../../../lib/next-path';
import { shape as shapeOf, staffFieldsOf, feedbackFieldsOf } from '../../../../../lib/templates';
import { renderMarkdown } from '../../../../../lib/notes';
import { staffWord } from '../../../../../lib/program-names';
import { placesWanting, sectionsOf, progressOf, wordCount, textOf, isFilled, stateLabel, type DocState } from '../../../../../lib/documents';

const { session, account, roles } = Astro.locals;
const org = activeOrg(Astro);
const { id: projectId, deliverable: deliverableId } = Astro.params;

if (!session) return Astro.redirect(signInWith(Astro.url));
if (!account) return Astro.redirect('/app/welcome/');
if (!projectId || !deliverableId) return Astro.redirect('/app/');

const me = standing(roles, account?.population);
const supabase = serverClient(Astro.request, Astro.cookies, (Astro.locals as any).runtime?.env);
const today = todayIn(org.timezone);

const { data: project } = await supabase
  .from('projects')
  .select('id, title, facts, process_id, project_authors(role, participation_id, self_managed_at, users(id, display_name))')
  .eq('id', projectId)
  .maybeSingle();
if (!project) return Astro.redirect('/app/');

const iAuthor = isAuthorOf(project.project_authors ?? [], account.id);
const authors = (project.project_authors ?? []).filter((a: any) => a.role === 'author' && a.users);
const elders = (project.project_authors ?? []).filter((a: any) => a.role === 'officer' && !a.self_managed_at && a.users);
const isElderHere = elders.some((e: any) => e.users?.id === account.id);
const mayComment = iAuthor || isElderHere || me.isAdvisor;
/* Whose field: the author's, or the Elder's part of the handout, which an
   Elder on the project or the advisor writes and the author never does. */
const canWrite = (f: { owner?: string }) => (f.owner === 'staff' ? isElderHere || me.isAdvisor : iAuthor && !gated);

/* The places that want this deliverable, the class first. The shape and
   the name come from the first; a document has one shape whichever
   program reads it. */
const places = await placesWanting(supabase, projectId, deliverableId, project.facts ?? {}, project.process_id ?? null);
/* The step this page submits for: the first still open, so a document two
   steps want (the journey map's draft and final) submits for the draft,
   then for the final (2.8); with every step met, the last. */
const wanted = places.find((p) => !p.completedOn) ?? places[places.length - 1] ?? null;
const shape = wanted?.deliverable.shape ? shapeOf(wanted.deliverable.shape) : null;
/* The gate (2.8): the step this page submits for still waits on another.
   The page shows the reason; nothing is opened, written or submitted. */
const gated = Boolean(wanted && !wanted.completedOn && wanted.waitsOn.length > 0);
const label = wanted?.deliverable.name ?? deliverableId;

let { error, note } = outcomeFrom(Astro.url);

/* ── Actions ────────────────────────────────────────────────────────── */

let docRow: any = null;
const loadDoc = async () => {
  const { data } = await supabase
    .from('documents')
    .select('id, status, version_no, opened_at, submitted_at, submitted_by, updated_at, shape_id, shape_version, opened_by')
    .eq('project_id', projectId)
    .eq('deliverable', deliverableId)
    .maybeSingle();
  docRow = data ?? null;
};
await loadDoc();

/* The author opens it by arriving. Idempotent, authors only, and the one
   write a GET makes: a document exists from the moment somebody looks at
   it, which is what lets the teacher tell "not started" from "opened and
   blank". */
/* The gate (2.8): every open step wanting this document still waits on
   another. The page shows the reason and nothing is opened or written. */
if (!docRow && iAuthor && shape && wanted && !gated && Astro.request.method === 'GET') {
  const { data: opened, error: e } = await supabase.rpc('open_document', {
    p_project_id: projectId,
    p_deliverable: deliverableId,
    p_shape_id: shape.id,
    p_shape_version: shape.version ?? 1,
    p_staff_fields: staffFieldsOf(shape),
  });
  if (e) error = e.message;
  else if (opened) await loadDoc();
}

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const action = String(form.get('action') ?? '');

  if (action === 'save' && docRow && shape) {
    /* The no-JavaScript path: every field on the page, saved in turn, each
       against the version the page rendered with. A conflict on one field
       is reported and the rest still save. */
    const conflicts: string[] = [];
    const fieldsToSave: any[] = sectionsOf(shape).flatMap((s) => s.fields);
    for (const f of fieldsToSave) {
      if (f.kind === 'note' || !canWrite(f)) continue;
      if (!form.has(`f:${f.id}`) && f.kind !== 'choices' && f.kind !== 'table' && f.kind !== 'rubric') continue;
      let value: any;
      if (f.kind === 'choices') value = form.getAll(`f:${f.id}`).map(String);
      else if (f.kind === 'number') value = String(form.get(`f:${f.id}`) ?? '').trim() === '' ? null : Number(form.get(`f:${f.id}`));
      else if (f.kind === 'table') {
        value = (f.rows ?? []).map((_: string, r: number) => (f.columns ?? []).map((__: string, c: number) => String(form.get(`f:${f.id}:${r}:${c}`) ?? '')));
        if (!(f.rows ?? []).some((_: string, r: number) => form.has(`f:${f.id}:${r}:0`))) continue;
      } else if (f.kind === 'rubric') {
        const picks: Record<string, string> = {};
        for (const c of wanted?.step?.rubric?.criteria ?? []) {
          const level = String(form.get(`f:${f.id}:${c.id}`) ?? '');
          if (level) picks[c.id] = level;
        }
        if (!(wanted?.step?.rubric?.criteria ?? []).some((c: any) => form.has(`f:${f.id}:${c.id}`)) && Object.keys(picks).length === 0) continue;
        value = picks;
      } else value = String(form.get(`f:${f.id}`) ?? '');
      const version = Number(form.get(`v:${f.id}`) ?? 0);
      const { data, error: e } = await supabase.rpc('save_field', {
        p_document_id: docRow.id,
        p_field_id: f.id,
        p_value: value,
        p_version: version,
      });
      if (e) {
        error = e.message;
        break;
      }
      if (data && data.ok === false) conflicts.push(f.prompt ?? f.id);
    }
    if (!error) {
      note = conflicts.length
        ? `Saved, except ${conflicts.join(', ')}: somebody else wrote there first. Their text is on the page now.`
        : 'Saved.';
    }
  } else if (action === 'submit' && docRow) {
    const { error: e } = await supabase.rpc('submit_document', {
      p_document_id: docRow.id,
      p_participation_id: String(form.get('participation_id') ?? ''),
      p_milestone_id: String(form.get('milestone_id') ?? '') || null,
      p_label: label,
    });
    if (e) error = e.message;
    else note = docRow.version_no > 0 ? 'Submitted again. The new version stands; whoever commented has been told.' : 'Submitted. It is on the calendar as done, and your Elder can read it.';
  } else if (action === 'give_feedback' && docRow && shape) {
    /* The Elder's part, given (2.9): the score and the rationale as they
       stand in the document (autosaved as typed), handed to the one call
       that completes the task, scores the step and tells the authors. */
    const { data: current } = await supabase.from('document_fields').select('field_id, value').eq('document_id', docRow.id);
    const cur = Object.fromEntries((current ?? []).map((r: any) => [r.field_id, r.value]));
    const parts = feedbackFieldsOf(shape);
    const scoreRaw = parts.score ? cur[parts.score] : null;
    const score = scoreRaw == null || String(scoreRaw).trim() === '' ? null : Number(scoreRaw);
    const body = parts.body ? textOf(sectionsOf(shape).flatMap((s) => s.fields).find((f) => f.id === parts.body)!, cur[parts.body]) : '';
    if (parts.score && score === null) error = 'Choose the rating first.';
    else if (!body.trim()) error = 'Write the rationale first; it is what the researcher reads.';
    else {
      const { error: e } = await supabase.rpc('give_document_feedback', { p_document_id: docRow.id, p_score: score, p_body_md: body });
      if (e) error = e.message;
      else note = 'Feedback given. The task is done, the score is on the tracker, and the researcher has been told.';
    }
  } else if (action === 'comment' && docRow) {
    const { error: e } = await supabase.rpc('comment_on_document', {
      p_document_id: docRow.id,
      p_field_id: String(form.get('field_id') ?? '') || null,
      p_body_md: String(form.get('body') ?? ''),
      p_needs_revision: String(form.get('needs_revision') ?? '') === '1',
      p_reply_to: String(form.get('reply_to') ?? '') || null,
    });
    if (e) error = e.message;
    else note = 'Sent.';
  } else if (action === 'resolve') {
    const { error: e } = await supabase.rpc('resolve_ask', { p_feedback_id: String(form.get('feedback_id') ?? '') });
    if (e) error = e.message;
    else note = 'Ask withdrawn.';
  }

  return afterPost(Astro.url, { error, note });
}

/* ── What is on the page ─────────────────────────────────────────────── */

const { data: fieldRows } = docRow
  ? await supabase.from('document_fields').select('field_id, value, version, updated_at, updated_by, by:updated_by(display_name)').eq('document_id', docRow.id)
  : { data: [] as any[] };
const values: Record<string, any> = {};
const versions: Record<string, number> = {};
const editedBy: Record<string, { name: string; at: string }> = {};
for (const r of fieldRows ?? []) {
  values[r.field_id] = r.value;
  versions[r.field_id] = r.version;
  editedBy[r.field_id] = { name: (r as any).by?.display_name ?? '', at: r.updated_at };
}

/* The history (2.8): every submitted version, with which fields changed
   from the one before, and whether the current text differs from the
   latest submission. Each submission already kept a snapshot
   (`document_versions`); this reads them, nothing new is written. */
const { data: versionRows } = docRow && docRow.version_no > 0
  ? await supabase.from('document_versions').select('version_no, content, submitted_at, by:submitted_by(display_name)').eq('document_id', docRow.id).order('version_no', { ascending: true })
  : { data: [] as any[] };
const promptOf = (fieldId: string) => (shape ? sectionsOf(shape).flatMap((sec) => sec.fields).find((f) => f.id === fieldId)?.prompt : null) ?? fieldId;
const changedBetween = (before: Record<string, any>, after: Record<string, any>) =>
  [...new Set([...Object.keys(before ?? {}), ...Object.keys(after ?? {})])].filter((k) => !k.startsWith('_') && JSON.stringify(before?.[k] ?? null) !== JSON.stringify(after?.[k] ?? null));
const history = (versionRows ?? []).map((v: any, i: number) => ({
  no: v.version_no,
  at: v.submitted_at,
  by: v.by?.display_name ?? '',
  changed: i === 0 ? [] : changedBetween((versionRows ?? [])[i - 1].content ?? {}, v.content ?? {}).map(promptOf),
}));
const latest = (versionRows ?? [])[(versionRows ?? []).length - 1] ?? null;
const changedSinceLatest = latest ? changedBetween(latest.content ?? {}, values).map(promptOf) : [];

/* The drafts between submissions (2.8): every changed save of a field,
   newest first, the last forty per field, so a paragraph can be put back
   to any earlier draft from the box itself. */
const { data: draftRows } = docRow
  ? await supabase
      .from('document_field_history')
      .select('field_id, value, version, saved_at, by:saved_by(display_name)')
      .eq('document_id', docRow.id)
      .order('saved_at', { ascending: false })
      .limit(600)
  : { data: [] as any[] };
const draftsOf = (fieldId: string) => (draftRows ?? []).filter((d: any) => d.field_id === fieldId).slice(0, 40);
const draftPreview = (v: any) => { const t = typeof v === 'string' ? v : v == null ? '' : JSON.stringify(v); return t.replace(/\s+/g, ' ').trim().slice(0, 90); };

const { data: comments } = docRow
  ? await supabase
      .from('deliverable_feedback')
      .select('id, field_id, field_version, reply_to, body_md, needs_revision, created_at, resolved_at, author_id, author:author_id(display_name)')
      .eq('document_id', docRow.id)
      .order('created_at', { ascending: true })
  : { data: [] as any[] };

const threadOn = (fieldId: string | null) =>
  (comments ?? []).filter((c: any) => (fieldId ? c.field_id === fieldId : !c.field_id));
const openAsks = (comments ?? []).filter((c: any) => c.needs_revision && !c.resolved_at);
const openAskOn = (fieldId: string) => openAsks.some((c: any) => c.field_id === fieldId);

const progress = shape ? progressOf(shape, values) : { asked: 0, filled: 0, missing: [], over: [] };
const state: DocState = !docRow
  ? 'not_started'
  : docRow.status === 'submitted'
    ? 'submitted'
    : docRow.status === 'revising'
      ? 'revising'
      : 'in_progress';

const fmt = (d: string | null | undefined) => (d ? formatDate(dayOf(d, org.timezone), 'short') : '');
const when = (iso: string | null | undefined) => {
  if (!iso) return '';
  const d = new Date(iso);
  return `${formatDate(dayOf(iso, org.timezone), 'short')} ${d.toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit', timeZone: org.timezone })}`;
};
const days = wanted?.dueOn ? daysUntil(wanted.dueOn, today) : null;
const dueWord =
  days === null ? '' : days < 0 ? `${Math.abs(days)} ${Math.abs(days) === 1 ? 'day' : 'days'} late` : days === 0 ? 'due today' : `${days} ${days === 1 ? 'day' : 'days'} left`;

/* Submit waits on every required field. The Google Doc slot that once
   stood in for them left in the pilot's friction pass (2.8): the class
   writes here. */
const canSubmit = iAuthor && docRow && wanted && !gated && progress.missing.length === 0;

/* The Elder's task on this document (2.9): the staff step whose
   `feedback_on` names this deliverable, on any of the project's places.
   Read once, for the button at the foot of the Elder's part: given (with
   the date and by whom), waiting on the work, or ready to give. */
const staffParts = shape ? feedbackFieldsOf(shape) : { score: null, body: null };
const iGiveFeedback = Boolean(shape && (staffParts.score || staffParts.body) && (isElderHere || me.isAdvisor) && !iAuthor);
let staffTask: { completedOn: string | null; by: string | null; ready: boolean; dueOn: string | null } | null = null;
if (iGiveFeedback && places.length > 0) {
  const { data: taskRows } = await supabase
    .from('entry_milestones')
    .select('id, completed_on, due_on, by:completed_by(display_name)')
    .in('participation_id', places.map((p) => p.participationId))
    .eq('owner', 'staff')
    .eq('feedback_on', deliverableId)
    .order('due_on', { ascending: true, nullsFirst: false });
  const open = (taskRows ?? []).find((t: any) => !t.completed_on) ?? null;
  const done = (taskRows ?? []).find((t: any) => t.completed_on) ?? null;
  const row: any = open ?? done;
  if (row) staffTask = { completedOn: row.completed_on ?? null, by: row.by?.display_name ?? null, ready: Boolean(open) && Boolean(docRow && docRow.version_no > 0), dueOn: row.due_on ?? null };
}
const fieldById = (fid: string | null) => (fid && shape ? sectionsOf(shape).flatMap((s) => s.fields).find((f) => f.id === fid) ?? null : null);
const staffFilled = [staffParts.score, staffParts.body].every((fid) => { const f = fieldById(fid); return !f || isFilled(f, values[f.id]); });
const rubric = wanted?.step?.rubric ?? null;
const submitLabel = docRow?.version_no > 0 ? 'Submit again' : 'Submit';
const elderWord = wanted ? staffWord(wanted.program as any) : 'Elder';
/* What a file made here is called: program, who, which deliverable; the
   browser adds the date and time when it makes one. */
const exportBase = `${programSlug(wanted?.program as any)}-${safePart(account.display_name ?? '')}-${safePart(label)}`;
const sections = shape ? sectionsOf(shape) : [];
const changedSince = (c: any) => c.field_id && c.field_version != null && (versions[c.field_id] ?? 0) > c.field_version;
---

<Base title={`${label} · ${project.title}`} noindex={true}>
  <div class="wrap doc-wrap">
    <AppShell org={org} account={account} roles={roles} here={wanted ? `/app/project/${project.id}/in/${wanted.programId}/` : `/app/project/${project.id}/`} />

    <ProjectCover
      kick={project.title}
      title={label}
      nav={{ projectId: project.id, programId: wanted?.programId ?? null, showcase: Boolean((wanted?.program as any)?.showcase && (wanted?.program as any).showcase !== 'none'), here: 'document' }}
      people={[
        { label: authors.length === 1 ? 'Author' : 'Authors', value: authors.map((a: any) => a.users?.display_name).join(', ') || 'None yet' },
        ...(elders.length > 0 ? [{ label: elders.length === 1 ? elderWord : staffWord(wanted?.program as any, 'plural'), value: elders.map((e: any) => e.users?.display_name).join(', ') }] : []),
      ]}
    >
      <a class="btn btn-sm accent noprint" href={`/app/project/${project.id}/doc/${deliverableId}/print/?go=1`} target="_blank" rel="noopener noreferrer">Save as PDF</a>
    </ProjectCover>

    <div id="outcome" tabindex="-1">
      {error && <p class="note flash" role="alert">{error}</p>}
      {note && !error && <p class="note flash" role="status">{note}</p>}
    </div>

    {!shape || !wanted ? (
      <div class="allclear"><b>Nothing to write here</b>This deliverable is not written in SciPath, or this project is not in a program that asks for it.</div>
    ) : (
      <>
        {gated && (
          <div class="note flash gate" role="status">
            <b>Not yet.</b> This step waits on {wanted!.waitsOn.join(', ')}. It opens when {wanted!.waitsOn.length === 1 ? 'that is' : 'those are'} done.
          </div>
        )}
        {/* The strip: where it stands, in one line, and the verb. */}
        <div class:list={['docstrip', state]} id="docstrip">
          <div class="ds-state">
            <span class:list={['pill', state === 'submitted' ? 'ok' : state === 'revising' || openAsks.length ? 'late' : days !== null && days < 0 ? 'late' : 'soon']}>{stateLabel(state)}</span>
            {docRow?.opened_at && <span class="ds-v">started {when(docRow.opened_at)}</span>}
            {docRow?.version_no > 0 && <span class="ds-v">version {docRow.version_no} · submitted {when(docRow.submitted_at)}</span>}
          </div>
          <div class="ds-facts">
            <span><b id="ds-filled">{progress.filled}</b> of {progress.asked} required answered</span>
            {wanted.dueOn && <span class:list={[days !== null && days < 0 && !docRow?.submitted_at && 'late']}>due {fmt(wanted.dueOn)}{dueWord ? ` · ${dueWord}` : ''}</span>}
            {openAsks.length > 0 && <span class="late"><b>{openAsks.length}</b> {openAsks.length === 1 ? 'revision asked' : 'revisions asked'}</span>}
            <span class="ds-saved" id="ds-saved" aria-live="polite">{docRow?.updated_at ? `last saved ${when(docRow.updated_at)}` : ''}</span>
            {/* Who else has this document open, from the room (2.8). */}
            <span class="ds-room" id="ds-room" aria-live="polite"></span>
          </div>
          {iAuthor && (
            <form method="POST" action="#outcome" class="ds-submit">
              <input type="hidden" name="action" value="submit" />
              <input type="hidden" name="participation_id" value={wanted.participationId} />
              <input type="hidden" name="milestone_id" value={wanted.milestoneId ?? ''} />
              <button class="btn accent" type="submit" id="ds-submit" disabled={!canSubmit} title={progress.missing.length ? `Still needed: ${progress.missing.map((f) => f.prompt).join('; ')}` : ''}>{submitLabel}</button>
            </form>
          )}
        </div>

        <form method="POST" action="#outcome" id="docform" class="docform" data-doc={docRow?.id ?? ''} data-author={iAuthor ? '1' : '0'} data-project={project.id} data-me={account.display_name ?? ''}>
          <input type="hidden" name="action" value="save" />

          {sections.map((section, si) => (
            <section class="sec doc-sec" id={`s-${section.id}`}>
              {section.name && (
                <div class="sec-h"><b><span class="sec-n">{String(si + 1).padStart(2, '0')}</span>{section.name}</b><span></span></div>
              )}
              {section.fields.map((f) => {
                const v = values[f.id];
                const ver = versions[f.id] ?? 0;
                const thread = threadOn(f.id);
                const words = f.kind === 'long' || f.kind === 'text' ? wordCount(textOf(f, v)) : null;
                return (
                  <div class:list={['field', `k-${f.kind}`, openAskOn(f.id) && 'has-ask', f.owner === 'staff' && 'is-staff', f.extra && 'is-extra']} id={`f-${f.id}`} data-field={f.id} data-version={ver} data-kind={f.kind} data-writable={canWrite(f) ? '1' : '0'} data-asked={f.kind !== 'note' && (f.owner ?? 'student') === 'student' ? '1' : '0'} data-required={f.required ? '1' : '0'} hidden={f.extra && !isFilled(f, v) && threadOn(f.id).length === 0}>
                    {f.kind === 'note' ? (
                      <div class="fnote" set:html={renderMarkdown(f.text ?? '').replace(/<a href="http/g, '<a target="_blank" rel="noopener noreferrer" href="http')} />
                    ) : (
                      <>
                        <p class="fprompt">
                          {f.prompt}
                          {f.owner === 'staff' && <span class="fowner">{elderWord}'s part</span>}
                          {f.required && <span class="req" title="Required">*</span>}
                          {f.kind === 'long' && (f.min_words || f.max_words) && (
                            <span class="flimit">{f.min_words ? `at least ${f.min_words}` : ''}{f.min_words && f.max_words ? ', ' : ''}{f.max_words ? `up to ${f.max_words}` : ''} words</span>
                          )}
                        </p>
                        {f.tip && <p class="ftip" set:html={renderMarkdown(f.tip).replace(/^<p>|<\/p>\s*$/g, '').replace(/<a href="http/g, '<a target="_blank" rel="noopener noreferrer" href="http')} />}

                        {canWrite(f) ? (
                          <div class="fin">
                            <input type="hidden" name={`v:${f.id}`} value={ver} class="fver" />
                            {f.kind === 'table' && (
                              /* One card per column (a source), the rows as wide fields
                                 down it (2.8). Five narrow columns of boxes were a grid
                                 nobody could write in. The first card is open; the rest
                                 wait behind "Add a source", except any that already
                                 have something in them. The stored shape is unchanged:
                                 rows by columns. */
                              <div class="fcards" id={`in-${f.id}`} data-rows={(f.rows ?? []).length} data-cols={(f.columns ?? []).length}>
                                {(f.columns ?? []).map((c, ci) => {
                                  const filled = (f.rows ?? []).some((_, ri) => Array.isArray(v) && Array.isArray(v[ri]) && String(v[ri][ci] ?? '').trim());
                                  const later = ci > 0 && !filled && !(f.rows ?? []).some((_, ri) => Array.isArray(v) && Array.isArray(v[ri]) && String(v[ri][ci - 1] ?? '').trim());
                                  return (
                                    <div class="fcard" data-col={ci} hidden={later} data-shared-scope>
                                      <p class="fcard-h">{c}</p>
                                      {/* One bar for the card's boxes: it works on whichever box the caret is in. */}
                                      <MarkdownBar shared />
                                      {(f.rows ?? []).map((r, ri) => (
                                        <div class="fcard-row">
                                          <span id={`in-${f.id}-${ri}-${ci}-label`}>{r}</span>
                                          <MarkdownEditor id={`in-${f.id}-${ri}-${ci}`} name={`f:${f.id}:${ri}:${ci}`} value={Array.isArray(v) && Array.isArray(v[ri]) ? String(v[ri][ci] ?? '') : ''} rows={2} shared data={{ r: ri, c: ci }} />
                                        </div>
                                      ))}
                                    </div>
                                  );
                                })}
                                {(f.columns ?? []).length > 1 && <button class="btn btn-sm btn-2 fcard-add" type="button">Add a source</button>}
                              </div>
                            )}
                            {f.kind === 'rubric' && (
                              rubric ? (
                                <div class="frubric-wrap">
                                  <table class="frubric" id={`in-${f.id}`}>
                                    <thead><tr><th></th>{[...new Map(rubric.criteria.flatMap((c: any) => c.levels.map((l: any) => [l.id, l]))).values()].sort((a: any, b: any) => b.points - a.points).map((l: any) => <th scope="col">{l.label}<small>{l.points}</small></th>)}</tr></thead>
                                    <tbody>
                                      {rubric.criteria.map((c: any) => {
                                        const cols = [...new Map(rubric.criteria.flatMap((x: any) => x.levels.map((l: any) => [l.id, l]))).values()].sort((a: any, b: any) => b.points - a.points);
                                        const picked = v && typeof v === 'object' ? v[c.id] : '';
                                        return (
                                          <tr>
                                            <th scope="row">{c.name}{c.guidance && <small>{c.guidance}</small>}</th>
                                            {cols.map((col: any) => {
                                              const level = c.levels.find((l: any) => l.id === col.id);
                                              return (
                                                <td class:list={[!level && 'none']}>
                                                  {level ? (
                                                    <label class="fcell-pick"><input type="radio" name={`f:${f.id}:${c.id}`} value={level.id} checked={picked === level.id} /><span>{level.description ?? level.label}</span></label>
                                                  ) : null}
                                                </td>
                                              );
                                            })}
                                          </tr>
                                        );
                                      })}
                                    </tbody>
                                  </table>
                                </div>
                              ) : (
                                <p class="fempty">This step carries no rubric to evaluate against.</p>
                              )
                            )}
                            {f.kind === 'long' && (
                              /* The notebook's editor (2.8): bold, headings, lists and links
                                 the way Docs does them, Markdown underneath. The textarea it
                                 writes is the field the autosave reads. */
                              <MarkdownEditor id={`in-${f.id}`} name={`f:${f.id}`} value={textOf(f, v)} rows={6} />
                            )}
                            {f.kind === 'text' && <label class="fwrap"><span class="sr">{f.prompt}</span><input id={`in-${f.id}`} name={`f:${f.id}`} class="in" value={textOf(f, v)} /></label>}
                            {f.kind === 'number' && <label class="fwrap"><span class="sr">{f.prompt}</span><input id={`in-${f.id}`} name={`f:${f.id}`} class="in fnum" type="number" value={v ?? ''} min={f.min} max={f.max} step={f.step ?? 'any'} /></label>}
                            {f.kind === 'date' && <label class="fwrap"><span class="sr">{f.prompt}</span><input id={`in-${f.id}`} name={`f:${f.id}`} class="in" type="date" value={v ?? ''} /></label>}
                            {f.kind === 'link' && <label class="fwrap"><span class="sr">{f.prompt}</span><input id={`in-${f.id}`} name={`f:${f.id}`} class="in" type="url" value={v ?? ''} /></label>}
                            {f.kind === 'choice' && (
                              <div class="fopts" id={`in-${f.id}`}>
                                {(f.options ?? []).map((o) => (
                                  <label class="fopt"><input type="radio" name={`f:${f.id}`} value={o} checked={v === o} /> <span>{o}</span></label>
                                ))}
                              </div>
                            )}
                            {f.kind === 'choices' && (
                              <div class="fopts" id={`in-${f.id}`}>
                                {(f.options ?? []).map((o) => (
                                  <label class="fopt"><input type="checkbox" name={`f:${f.id}`} value={o} checked={Array.isArray(v) && v.includes(o)} /> <span>{o}</span></label>
                                ))}
                              </div>
                            )}
                            {f.kind === 'file' && (
                              <div class="ffile" id={`in-${f.id}`}>
                                {v?.path ? (
                                  <p class="fhave">
                                    {String(v.path).match(/\.(png|jpe?g|gif|webp)$/i) ? <img src={`/app/media/${v.path}`} alt={v.name ?? ''} /> : null}
                                    <a href={`/app/media/${v.path}`} target="_blank" rel="noopener noreferrer">{v.name ?? 'the file'}</a>
                                  </p>
                                ) : null}
                                <label class="fwrap"><span class="sr">{f.prompt}</span><input type="file" class="ffile-in" accept={f.accept === 'image' ? 'image/*' : undefined} data-field={f.id} /></label>
                                <span class="t-sm">Uploads as soon as you choose it.</span>
                              </div>
                            )}
                            {/* The downloads are off until there is a picture: the one
                                saved on the document, or the one just drawn. The note
                                under the buttons says when the boxes have changed since
                                the picture was drawn (`drawn_from`, a hash of the
                                sources, kept with the picture). */}
                            {f.kind === 'graphic' && (
                              <div class="fgraphic" id={`in-${f.id}`} data-graphic={f.graphic} data-sources={(f.sources ?? []).join(' ')} data-authors={authors.map((a: any) => a.users.display_name).join(', ')} data-name={exportBase} data-tz={org.timezone} data-drawn-from={v?.drawn_from ?? ''} data-path={v?.path ?? ''}>
                                <p class="fgraphic-act noprint">
                                  <button class="btn btn-sm fgen" type="button">Generate</button>
                                  <a class="btn btn-sm btn-2 fgraphic-dl is-off" aria-disabled="true">Download PNG</a>
                                </p>
                                <p class="t-sm fgraphic-note noprint">Drawn from the boxes above. Generate again after any changes.</p>
                                <canvas class="fcanvas" hidden></canvas>
                                {v?.path ? (
                                  <p class="fhave"><img src={`/app/media/${v.path}`} alt={v.name ?? ''} /></p>
                                ) : <p class="fempty fgraphic-none">Not generated yet</p>}
                              </div>
                            )}
                            <div class="fmeta noprint">
                              {words !== null && (f.min_words != null || f.max_words != null) && <span class:list={['fwords', f.max_words != null && words > f.max_words && 'over']} data-max={f.max_words ?? ''} data-min={f.min_words ?? ''}>{words} {words === 1 ? 'word' : 'words'}</span>}
                              <span class="fstate" aria-live="polite"></span>
                              {editedBy[f.id]?.name && authors.length > 1 && <span class="fby">last by {editedBy[f.id].name}</span>}
                              {/* Earlier drafts of this box (2.8): pick one and it is
                                  back in the box, saved as a new draft on top. */}
                              {draftsOf(f.id).length > 1 && f.kind !== 'file' && f.kind !== 'graphic' && (
                                <details class="fdrafts">
                                  <summary>{draftsOf(f.id).length - 1 === 1 ? '1 earlier draft' : `${draftsOf(f.id).length - 1} earlier drafts`}</summary>
                                  <ul class="fdraft-list" data-live={`drafts-${f.id}`}>
                                    {draftsOf(f.id).slice(1).map((d: any) => (
                                      <li>
                                        <span class="fdraft-when">{when(d.saved_at)}{d.by?.display_name && authors.length > 1 ? ` · ${d.by.display_name}` : ''}</span>
                                        <span class="fdraft-text">{draftPreview(d.value) || <i>empty</i>}</span>
                                        {canWrite(f) && <button type="button" class="btn btn-sm btn-2 fdraft-use" data-value={JSON.stringify(d.value ?? null)}>Use this</button>}
                                      </li>
                                    ))}
                                  </ul>
                                </details>
                              )}
                            </div>
                          </div>
                        ) : (
                          <div class="fread">
                            {f.kind === 'table' ? (
                              Array.isArray(v) && v.some((row: any) => Array.isArray(row) && row.some((cell: any) => String(cell ?? '').trim())) ? (
                                <div class="fcards read">
                                  {(f.columns ?? []).map((c, ci) => {
                                    const filled = (f.rows ?? []).some((_, ri) => Array.isArray(v[ri]) && String(v[ri][ci] ?? '').trim());
                                    if (!filled) return null;
                                    return (
                                      <div class="fcard">
                                        <p class="fcard-h">{c}</p>
                                        {(f.rows ?? []).map((r, ri) => (
                                          <div class="fcard-line"><b>{r}</b><div class="fprose" set:html={renderMarkdown(Array.isArray(v[ri]) ? String(v[ri][ci] ?? '') : '')} /></div>
                                        ))}
                                      </div>
                                    );
                                  })}
                                </div>
                              ) : <p class="fempty">Not filled in</p>
                            ) : f.kind === 'rubric' ? (
                              rubric && v && typeof v === 'object' && Object.keys(v).length > 0 ? (
                                <ul class="g-levels">
                                  {rubric.criteria.map((c: any) => {
                                    const level = c.levels.find((l: any) => l.id === v[c.id]);
                                    return level ? <li><b>{c.name}</b> {level.label} · {level.points}</li> : <li><b>{c.name}</b> <span class="fempty">not marked</span></li>;
                                  })}
                                </ul>
                              ) : <p class="fempty">Not evaluated yet</p>
                            ) : f.kind === 'long' ? (
                              isFilled(f, v) ? <div class="fprose" set:html={renderMarkdown(String(v))} /> : <p class="fempty">Not written yet</p>
                            ) : (f.kind === 'file' || f.kind === 'graphic') && v?.path ? (
                              <p>{String(v.path).match(/\.(png|jpe?g|gif|webp)$/i) ? <img src={`/app/media/${v.path}`} alt={v.name ?? ''} /> : null}<a href={`/app/media/${v.path}`} target="_blank" rel="noopener noreferrer">{v.name ?? 'the file'}</a></p>
                            ) : f.kind === 'graphic' ? (
                              <p class="fempty">Not generated yet</p>
                            ) : f.kind === 'link' && v ? (
                              <p><a href={String(v)} target="_blank" rel="noopener noreferrer">{String(v)}</a></p>
                            ) : isFilled(f, v) ? (
                              <p>{textOf(f, v)}</p>
                            ) : (
                              <p class="fempty">Not answered yet</p>
                            )}
                            {words !== null && words > 0 && (f.min_words != null || f.max_words != null) && <p class="fmeta"><span class:list={['fwords', f.max_words != null && words > f.max_words && 'over']}>{words} words</span></p>}
                          </div>
                        )}

                        {/* The thread on this field, and the box to add to it. */}
                        {(thread.length > 0 || mayComment) && (
                          <div class="thread noprint" data-live={`thread-${f.id}`}>
                            {thread.length > 0 && (
                              <ul class="tlist">
                                {thread.map((c: any) => (
                                  <li class:list={['tc', c.needs_revision && !c.resolved_at && 'asks', c.reply_to && 'reply', c.author_id === account.id && 'mine']} id={`c-${c.id}`}>
                                    <span class="tc-who">{c.author?.display_name ?? 'Somebody'}</span>
                                    <span class="tc-when">{when(c.created_at)}</span>
                                    {c.needs_revision && <span class:list={['pill', c.resolved_at ? 'ok' : 'late']}>{c.resolved_at ? 'Revision made' : 'Revision asked'}</span>}
                                    {changedSince(c) && !c.resolved_at && <span class="pill soon">Changed since</span>}
                                    <div class="tc-body" set:html={renderMarkdown(c.body_md)} />
                                    {c.needs_revision && !c.resolved_at && (c.author_id === account.id || me.isAdvisor) && (
                                      <button class="btn btn-q" type="button" data-resolve={c.id}>Withdraw the ask</button>
                                    )}
                                  </li>
                                ))}
                              </ul>
                            )}
                            {mayComment && docRow && !(iAuthor && f.owner === 'staff' && !isFilled(f, v) && thread.length === 0) && (
                              <details class="tadd">
                                <summary class="linkish">{iAuthor ? (thread.length ? 'Reply' : 'Ask a question here') : thread.length ? 'Add to this' : 'Comment on this'}</summary>
                                <div class="tform" data-field={f.id} data-reply={thread.length ? thread[thread.length - 1].id : ''}>
                                  <textarea class="ta" rows="2" name={`c:${f.id}`} form="noform" aria-label={iAuthor ? 'A question or a note for whoever reads this' : 'What to change, or what is good'}></textarea>
                                  {!iAuthor && <label class="task"><input type="checkbox" name={`ask:${f.id}`} form="noform" value="1" /> <span>Ask for a revision</span></label>}
                                  <button class="btn btn-sm btn-2" type="button" data-send="comment">Send</button>
                                </div>
                              </details>
                            )}
                          </div>
                        )}
                      </>
                    )}
                  </div>
                );
              })}
              {/* Blanks offered on demand (2.8): the next hidden one opens
                  on the click, like the sources on the literature review. */}
              {iAuthor && section.fields.some((f) => f.extra) && (
                <p class="fextra-act noprint"><button class="btn btn-sm btn-2 fextra-add" type="button">Add more</button></p>
              )}
              {/* The verb on the Elder's part (2.9). The boxes above save
                  as they are written; this hands them over: the task is
                  done, the score goes on the tracker, the researcher is
                  told. The button belongs to a form outside the document's
                  own, since a form does not nest. */}
              {iGiveFeedback && section.fields.some((f) => f.owner === 'staff') && (
                <div class="fgive noprint" id="give">
                  {staffTask?.completedOn ? (
                    <p class="fgive-done"><b>Feedback given</b> {staffTask.by ? `by ${staffTask.by} ` : ''}on {fmt(staffTask.completedOn)}. The researcher has it; add to the thread below if there is more to say.</p>
                  ) : !docRow || docRow.version_no === 0 ? (
                    <p class="t-sm">Not handed in yet. Once the researcher submits, the rating and rationale above go to them from here.</p>
                  ) : (
                    <>
                      <button class="btn" type="submit" form="give-feedback" id="give-btn" disabled={!staffFilled}>Give the feedback</button>
                      <span class="t-sm">{staffFilled ? `Sends the rating and rationale to ${authors.map((a: any) => String(a.users.display_name).split(' ')[0]).join(' and ') || 'the researcher'}, marks your task done and puts the score on the tracker.` : `Choose the rating and write the rationale above, then send them from here.${staffTask?.dueOn ? ` Due ${fmt(staffTask.dueOn)}.` : ''}`}</span>
                    </>
                  )}
                </div>
              )}
            </section>
          ))}

          {iAuthor && (
            <div class="docsave noprint">
              <button class="btn" type="submit" id="save-all">Save</button>
              <span class="t-sm">Autosave enabled. Click here to save now.</span>
            </div>
          )}
        </form>
        {iGiveFeedback && (
          <form method="POST" action="#outcome" id="give-feedback" class="noprint" hidden>
            <input type="hidden" name="action" value="give_feedback" />
          </form>
        )}

        {/* The thread on the whole document. */}
        <section class="sec noprint" id="whole">
          <div class="sec-h"><b><span class="sec-n">{String(sections.length + 1).padStart(2, '0')}</span>On the whole document</b><span>{threadOn(null).length ? `${threadOn(null).length} ${threadOn(null).length === 1 ? 'comment' : 'comments'}` : ''}</span></div>
          <div data-live="thread-whole">
          {threadOn(null).length > 0 ? (
            <ul class="tlist">
              {threadOn(null).map((c: any) => (
                <li class:list={['tc', c.needs_revision && !c.resolved_at && 'asks', c.reply_to && 'reply', c.author_id === account.id && 'mine']} id={`c-${c.id}`}>
                  <span class="tc-who">{c.author?.display_name ?? 'Somebody'}</span>
                  <span class="tc-when">{when(c.created_at)}</span>
                  {c.needs_revision && <span class:list={['pill', c.resolved_at ? 'ok' : 'late']}>{c.resolved_at ? 'Revision made' : 'Revision asked'}</span>}
                  <div class="tc-body" set:html={renderMarkdown(c.body_md)} />
                </li>
              ))}
            </ul>
          ) : (
            <p class="t-sm">Nothing yet. A comment here is about the document as a whole; a comment on a field is beside it.</p>
          )}
          </div>
          {mayComment && docRow && (
            <form method="POST" action="#outcome" class="tform whole">
              <input type="hidden" name="action" value="comment" />
              <input type="hidden" name="field_id" value="" />
              <textarea class="ta" name="body" rows="3" required aria-label={iAuthor ? 'A note for whoever reads this' : 'What is good, what to change'}></textarea>
              {!iAuthor && <label class="task"><input type="checkbox" name="needs_revision" value="1" /> <span>Ask for a revision</span></label>}
              <button class="btn btn-sm btn-2" type="submit">Send</button>
            </form>
          )}
        </section>

        {/* The history (2.8): each submitted version as it was, with what
            changed from the one before, and what has changed since. */}
        {history.length > 0 && (
          <section class="sec noprint" id="history">
            <div class="sec-h"><b><span class="sec-n">{String(sections.length + 2).padStart(2, '0')}</span>History</b><span>{history.length} {history.length === 1 ? 'version' : 'versions'} submitted; the latest is the one on the calendar</span></div>
            <ol class="hist">
              {[...history].reverse().map((h) => (
                <li>
                  <b>Version {h.no}</b> · submitted {when(h.at)}{h.by ? ` by ${h.by}` : ''}
                  {' · '}<a href={`/app/project/${project.id}/doc/${deliverableId}/print/?version=${h.no}`} target="_blank" rel="noopener noreferrer">View as it was</a>
                  {h.no > 1 && <span class="sub">{h.changed.length ? `Changed: ${h.changed.join('; ')}` : 'No field changed'}</span>}
                </li>
              ))}
            </ol>
            {changedSinceLatest.length > 0 && (
              <p class="t-sm">Changed since version {latest.version_no}, not yet submitted: {changedSinceLatest.join('; ')}.</p>
            )}
            {(draftRows ?? []).length > 0 && (
              <p class="t-sm">{(draftRows ?? []).length} drafts kept since the last thirty days began; each box offers its own under "earlier drafts". After thirty days only the last draft before each version stays.</p>
            )}
          </section>
        )}
      </>
    )}
  </div>
</Base>

<style>
  .docstrip {
    display: flex; flex-wrap: nowrap; align-items: center; gap: 14px 22px;
    padding: 14px 18px; margin: 0 0 18px;
    background: var(--card); border: 1px solid var(--rule-fine); border-left: 4px solid var(--accent);
  }
  .docstrip.submitted { border-left-color: var(--stage-comp); }
  .docstrip.revising, .docstrip.in_progress { border-left-color: var(--accent); }
  .ds-state { display: flex; gap: 10px; align-items: center; }
  .ds-v { font-family: var(--face-ui); font-size: 0.82rem; color: var(--ink-3); }
  .ds-facts { display: flex; flex-wrap: wrap; gap: 6px 16px; min-width: 0; font-family: var(--face-ui); font-size: 0.88rem; color: var(--ink-2); margin-right: auto; }
  .ds-facts .late { color: var(--alert); }
  .ds-saved { color: var(--ink-3); }
  .ds-room { color: var(--accent); font-weight: 600; }
  /* On a phone (2.8): the strip stacks, the state wraps, and the verb
     takes the full width where a thumb finds it. */
  @media (max-width: 720px) {
    .docstrip { flex-wrap: wrap; padding: 12px 14px; }
    .ds-state { flex-wrap: wrap; }
    .ds-submit { flex: 1 1 100%; }
    .ds-submit .btn { flex: 1 1 auto; text-align: center; }
    .docsave { flex-wrap: wrap; }
    .fgraphic-act .btn { flex: 1 1 auto; text-align: center; }
  }
  .ds-submit { display: flex; align-items: center; gap: 10px; flex: 0 0 auto; }
  .doc-sec { max-width: var(--measure-text); }
  .field { padding: 14px 0 18px; border-bottom: 1px solid var(--rule-fine); }
  .field.has-ask { border-left: 3px solid var(--alert); padding-left: 12px; }
  .fnote { color: var(--ink-2); }
  .fnote :global(p) { margin: 0 0 8px; }
  .fnote :global(table) { border-collapse: collapse; width: 100%; margin: 4px 0 8px; font-size: 0.95rem; }
  .fnote :global(th), .fnote :global(td) { border: 1px solid var(--rule); padding: 6px 10px; vertical-align: top; text-align: left; }
  .fnote :global(th) { font-family: var(--face-ui); font-size: 0.86rem; background: var(--wash); }
  .fprompt { display: block; font-weight: 600; margin: 0 0 4px; }
  .fprompt .req { color: var(--alert); margin-left: 4px; }
  .flimit { margin-left: 10px; font-family: var(--face-ui); font-size: 0.8rem; font-weight: 400; color: var(--ink-3); }
  .ftip { margin: 0 0 8px; font-style: italic; color: var(--ink-3); font-size: 0.92rem; }
  .fin .ta, .fin .in { width: 100%; box-sizing: border-box; }
  .fwrap { display: block; }
  .fowner { margin-left: 10px; font-family: var(--face-ui); font-size: 0.78rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.04em; color: var(--accent-deep); }
  .field.is-staff { background: var(--accent-pale); padding-left: 12px; padding-right: 12px; }
  .hist { margin: 0; padding-left: 20px; display: grid; gap: 8px; }
  .hist .sub { display: block; color: var(--ink-3); font-size: 0.88rem; }
  .fgraphic-act { display: flex; gap: 10px; align-items: center; flex-wrap: wrap; margin: 0 0 6px; }
  .fgraphic-note { margin: 0 0 8px; }
  .fgraphic-note.stale { color: var(--alert); font-weight: 600; }
  .fcanvas, .fgraphic .fhave img { width: 100%; max-width: 900px; height: auto; border: 1px solid var(--rule); background: var(--card); }
  .fcanvas { display: block; }
  .fcanvas[hidden] { display: none; }
  .fcards { display: grid; gap: 10px; }
  .fcard { margin: 0; padding: 10px 14px 12px; border: 1px solid var(--rule); background: var(--card); min-width: 0; }
  .fcard[hidden] { display: none; }
  .fcard-h { font-family: var(--face-ui); font-weight: 700; font-size: 0.95rem; margin: 0 0 8px; }
  .fcard-row { display: grid; grid-template-columns: 14rem minmax(0, 1fr); gap: 6px 12px; align-items: start; margin: 8px 0 0; }
  .fcard-row > span { font-family: var(--face-ui); font-size: 0.86rem; color: var(--ink-2); padding-top: 6px; }
  .fcard-line { margin: 4px 0; font-size: 0.95rem; }
  .fcard-line b { font-family: var(--face-ui); font-size: 0.86rem; display: block; color: var(--ink-2); }
  .fcard-add { justify-self: start; }
  @media (max-width: 640px) { .fcard-row { grid-template-columns: 1fr; } .fcard-row > span { padding-top: 0; } }
  .ftable-wrap, .frubric-wrap { overflow-x: auto; }
