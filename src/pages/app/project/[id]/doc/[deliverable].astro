  .fcell-pick { display: flex; gap: 6px; align-items: flex-start; cursor: pointer; }
  .fcell-pick input { margin-top: 3px; }
  .fcell-pick:has(input:checked) { background: var(--accent-pale); outline: 2px solid var(--accent); }
  .g-levels { list-style: none; margin: 0; padding: 0; display: grid; gap: 2px; font-size: 0.9rem; }
