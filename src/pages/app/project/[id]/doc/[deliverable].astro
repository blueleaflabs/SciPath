  .ftable th, .ftable td { border: 1px solid var(--rule-fine); padding: 6px; vertical-align: top; text-align: left; }
  .ftable th[scope=row] { width: 160px; font-weight: 600; background: var(--sunk); }
  .ftable .fcell { width: 100%; box-sizing: border-box; min-height: 64px; font-size: 0.88rem; }
  .frubric { border-collapse: collapse; width: 100%; min-width: 760px; font-size: 0.86rem; }
  .frubric th, .frubric td { border: 1px solid var(--rule-fine); padding: 6px 8px; vertical-align: top; text-align: left; }
  .frubric th small { display: block; font-weight: 400; color: var(--ink-3); }
  .frubric th[scope=row] { width: 150px; background: var(--sunk); }
