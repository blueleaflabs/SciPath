    .noprint, .appnav, .thread, .fmeta, .docsave { display: none !important; }
    .field { border: 0; page-break-inside: avoid; }
    .fin .ta, .fin .in { border: 0; padding: 0; background: transparent; }
  }
</style>

<script>
  import { draw } from '../../../../../lib/research-graphics';
  import { stampFor } from '../../../../../lib/export-names';
  import { renderMarkdown } from '../../../../../lib/notes';
  /**
   * SAVES AS YOU TYPE.
   *
   * Per field: a short idle after the last keystroke, and on blur. Each
   * save carries the version the field was read at; the server accepts
   * it only if nothing newer is there, and otherwise answers with the
   * other author's text, which is shown beside yours rather than
   * overwritten. Until the server says saved, the text sits in this
   * browser's storage under the document and field, so a dropped
   * connection loses nothing: on the next load the page offers it back.
   * Nothing here is needed for the page to work; the Save button posts
   * every field the ordinary way.
   */
  const form = document.getElementById('docform') as HTMLFormElement | null;
  const writable = form ? form.querySelectorAll('.field[data-writable="1"]').length > 0 : false;
  if (form && writable && form.dataset.doc) {
    const docId = form.dataset.doc;
    const myName = form.dataset.me ?? '';
    const saved = document.getElementById('ds-saved');
    const key = (fieldId: string) => `sp:doc:${docId}:${fieldId}`;
    const timers = new Map<string, number>();
    const pending = new Set<string>();

    const readValue = (wrap: HTMLElement): any => {
      const kind = wrap.dataset.kind;
      const fieldId = wrap.dataset.field!;
      if (kind === 'choice') {
        const on = wrap.querySelector<HTMLInputElement>('input[type=radio]:checked');
        return on ? on.value : null;
      }
      if (kind === 'choices') {
        return [...wrap.querySelectorAll<HTMLInputElement>('input[type=checkbox]:checked')].map((c) => c.value);
      }
      if (kind === 'file' || kind === 'graphic') return undefined;
      if (kind === 'table') {
        const box = wrap.querySelector<HTMLElement>('.fcards');
        const nr = Number(box?.dataset.rows ?? 0), nc = Number(box?.dataset.cols ?? 0);
        const rows: string[][] = Array.from({ length: nr }, () => Array.from({ length: nc }, () => ''));
        wrap.querySelectorAll<HTMLTextAreaElement>('textarea[data-r]').forEach((t) => {
          const r = Number(t.dataset.r), c = Number(t.dataset.c);
          if (rows[r]) rows[r][c] = t.value;
        });
        return rows;
      }
      if (kind === 'rubric') {
        const picks: Record<string, string> = {};
        wrap.querySelectorAll<HTMLInputElement>('input[type=radio]:checked').forEach((r) => {
          const crit = r.name.split(':').pop();
          if (crit) picks[crit] = r.value;
        });
        return picks;
      }
      const el = wrap.querySelector<HTMLInputElement | HTMLTextAreaElement>(`[name="f:${fieldId}"]`);
      if (!el) return undefined;
      if (kind === 'number') {
        if (el.value.trim() === '') return null;
        const n = Number(el.value);
        const lo = (el as HTMLInputElement).min, hi = (el as HTMLInputElement).max;
        if ((lo !== '' && n < Number(lo)) || (hi !== '' && n > Number(hi))) {
          setState(wrap, `Between ${lo || '…'} and ${hi || '…'}`, 'kept');
          return undefined;
        }
        return n;
      }
      return el.value;
    };

    const writeValue = (wrap: HTMLElement, value: any) => {
      const kind = wrap.dataset.kind;
      const fieldId = wrap.dataset.field!;
      if (kind === 'table') {
        wrap.querySelectorAll<HTMLTextAreaElement>('textarea[data-r]').forEach((t) => {
          const r = Number(t.dataset.r), c = Number(t.dataset.c);
          t.value = Array.isArray(value?.[r]) ? value[r][c] ?? '' : '';
        });
      } else if (kind === 'rubric') {
        wrap.querySelectorAll<HTMLInputElement>('input[type=radio]').forEach((r) => {
          const crit = r.name.split(':').pop() ?? '';
          r.checked = Boolean(value && value[crit] === r.value);
        });
      } else if (kind === 'choice') {
        wrap.querySelectorAll<HTMLInputElement>('input[type=radio]').forEach((r) => (r.checked = r.value === value));
      } else if (kind === 'choices') {
        const set = new Set(Array.isArray(value) ? value : []);
        wrap.querySelectorAll<HTMLInputElement>('input[type=checkbox]').forEach((c) => (c.checked = set.has(c.value)));
      } else {
        const el = wrap.querySelector<HTMLInputElement | HTMLTextAreaElement>(`[name="f:${fieldId}"]`);
        if (el) el.value = value == null ? '' : String(value);
      }
      countWords(wrap);
    };

    const setState = (wrap: HTMLElement, text: string, cls: string) => {
      const el = wrap.querySelector<HTMLElement>('.fstate');
      if (!el) return;
      el.textContent = text;
      el.className = `fstate ${cls}`;
    };

    const countWords = (wrap: HTMLElement) => {
      const el = wrap.querySelector<HTMLElement>('.fwords');
      const input = wrap.querySelector<HTMLTextAreaElement | HTMLInputElement>(`[name="f:${wrap.dataset.field}"]`);
      if (!el || !input) return;
      const n = input.value.trim() ? input.value.trim().split(/\s+/).length : 0;
      el.textContent = `${n} ${n === 1 ? 'word' : 'words'}`;
      const max = Number(el.dataset.max || 0);
      el.classList.toggle('over', max > 0 && n > max);
    };

    const stash = (fieldId: string, value: any) => {
      try { localStorage.setItem(key(fieldId), JSON.stringify({ value, at: Date.now() })); } catch {}
    };
    const unstash = (fieldId: string) => {
      try { localStorage.removeItem(key(fieldId)); } catch {}
    };

    const post = async (body: any) => {
      const res = await fetch('/app/api/field/', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        credentials: 'same-origin',
        body: JSON.stringify(body),
      });
      if (!res.ok) throw new Error(`save failed (${res.status})`);
      return res.json();
    };

    /* One save in flight per field. A rubric is eight clicks on one field,
       and two saves of it racing each other meant the second carried the
       version the first was about to replace: the server answered
       "conflict", the click was kept on the device and never sent again.
       Now a save that finds one in flight waits for it, then reads the
       field again, so the last click always goes with the latest version. */
    const inFlight = new Map<string, Promise<void>>();
    const save = (wrap: HTMLElement, attempt = 0): Promise<void> => {
      const fieldId = wrap.dataset.field!;
      const prior = inFlight.get(fieldId) ?? Promise.resolve();
      const run = prior.then(() => saveNow(wrap, attempt));
      inFlight.set(fieldId, run.catch(() => {}));
      return run;
    };
    const saveNow = async (wrap: HTMLElement, attempt = 0) => {
      const fieldId = wrap.dataset.field!;
      const value = readValue(wrap);
      if (value === undefined) return;
      const version = Number(wrap.dataset.version || 0);
      stash(fieldId, value);
      pending.add(fieldId);
      setState(wrap, 'Saving…', 'saving');
      try {
        const out = await post({ document_id: docId, field_id: fieldId, value, version });
        if (out.ok) {
          wrap.dataset.version = String(out.version);
          const ver = wrap.querySelector<HTMLInputElement>('.fver');
          if (ver) ver.value = String(out.version);
          unstash(fieldId);
          pending.delete(fieldId);
          setState(wrap, 'Saved', 'saved');
          refreshProgress();
          if (saved) saved.textContent = `last saved ${new Date().toLocaleTimeString([], { hour: 'numeric', minute: '2-digit' })}`;
        } else if (out.conflict && out.by === myName && attempt < 2) {
          /* My own newer version (another tab, or a save this one did not
             wait for): take its number and send this text over it. */
          wrap.dataset.version = String(out.version);
          const ver = wrap.querySelector<HTMLInputElement>('.fver');
          if (ver) ver.value = String(out.version);
          pending.delete(fieldId);
          await saveNow(wrap, attempt + 1);
        } else if (out.conflict) {
          pending.delete(fieldId);
          showConflict(wrap, out, value);
        } else {
          throw new Error(out.error || 'refused');
        }
      } catch (e) {
        setState(wrap, navigator.onLine ? 'Could not save; kept on this device' : 'Offline; kept on this device', 'kept');
        if (attempt < 5) {
          window.setTimeout(() => save(wrap, attempt + 1), Math.min(30000, 2000 * 2 ** attempt));
        }
      }
    };

    /* A newer version on the server (another author, or another tab).
       Nothing is overwritten; the row keeps the newer text and this tab is
       told to reload for it. The three-way choice that stood here is held
       for a later drop (2.8). */
    const showConflict = (wrap: HTMLElement, out: any, _mine: any) => {
      wrap.dataset.version = String(out.version);
      const ver = wrap.querySelector<HTMLInputElement>('.fver');
      if (ver) ver.value = String(out.version);
      setState(wrap, `${out.by ?? 'Somebody else'} saved a newer version of this field. Reload the page to see it; your text is kept on this device.`, 'kept');
    };

    /* The count in the strip and the Submit button follow what is saved,
       rather than what the page was loaded with (2.8). The same rule as
       the server's `isFilled`: a table with one cell written, a rubric
       with one row marked, a choice made, or any text, counts. */
    const filledHere = (wrap: HTMLElement): boolean => {
      /* A file or a drawn picture is on the page as what it shows, not as a value. */
      if (wrap.dataset.kind === 'file' || wrap.dataset.kind === 'graphic') return wrap.dataset.have === '1' || Boolean(wrap.querySelector('.fhave'));
      const v = readValue(wrap);
      if (v == null) return false;
      if (Array.isArray(v)) return v.some((row) => Array.isArray(row) ? row.some((c) => String(c ?? '').trim()) : String(row ?? '').trim());
      if (typeof v === 'object') return Object.keys(v).length > 0;
      return String(v).trim().length > 0;
    };
    const refreshProgress = () => {
      const asked = [...form.querySelectorAll<HTMLElement>('.field[data-asked="1"][data-required="1"]')];
      const filledEl = document.getElementById('ds-filled');
      if (filledEl) filledEl.textContent = String(asked.filter(filledHere).length);
      const submit = document.getElementById('ds-submit') as HTMLButtonElement | null;
      if (submit) {
        const missing = asked.filter((w) => !filledHere(w));
        submit.disabled = missing.length > 0;
        submit.title = missing.length ? `Still needed: ${missing.map((w) => w.querySelector('.fprompt')?.firstChild?.textContent?.trim() || w.dataset.field).join('; ')}` : '';
      }
    };

    const schedule = (wrap: HTMLElement, delay = 1200) => {
      const fieldId = wrap.dataset.field!;
      stash(fieldId, readValue(wrap));
      setState(wrap, 'Typing…', 'saving');
      window.clearTimeout(timers.get(fieldId));
      /* The timer leaves the map when it fires (2.9): it never did, so a
         box once typed in read as "still typing" for the rest of the
         page's life, and Give the feedback never woke after the Elder's
         first keystroke. */
      timers.set(fieldId, window.setTimeout(() => { timers.delete(fieldId); save(wrap); }, delay));
    };

    const fields = [...form.querySelectorAll<HTMLElement>('.field[data-field]')].filter((w) => w.dataset.kind !== 'note' && w.dataset.writable === '1');

    for (const wrap of fields) {
      const inputs = wrap.querySelectorAll<HTMLElement>('input, textarea');
      inputs.forEach((el) => {
        if ((el as HTMLInputElement).type === 'file') return;
        if ((el as HTMLInputElement).type === 'hidden') return;
        el.addEventListener('input', () => { countWords(wrap); schedule(wrap); });
        el.addEventListener('change', () => { countWords(wrap); schedule(wrap, 200); });
        el.addEventListener('blur', () => { if (timers.has(wrap.dataset.field!)) schedule(wrap, 100); });
      });

      /* Whatever this browser kept from an earlier visit is dropped on
         load; the server's copy is the document. */
      try { unstash(wrap.dataset.field!); } catch {}
    }

    /* Leaving with something unsaved: one last try, and the copy stays in
       storage either way. */
    window.addEventListener('beforeunload', () => {
      for (const wrap of fields) {
        const fieldId = wrap.dataset.field!;
        if (!timers.has(fieldId) && !pending.has(fieldId)) continue;
        const value = readValue(wrap);
        if (value === undefined) continue;
        try {
          navigator.sendBeacon('/app/api/field/', new Blob([JSON.stringify({ document_id: docId, field_id: fieldId, value, version: Number(wrap.dataset.version || 0) })], { type: 'application/json' }));
        } catch {}
      }
    });

    /* Use this (2.8): an earlier draft back into its box, as a new draft
       on top; the editor's surface redrawn from it, then saved. */
    form.addEventListener('click', (ev) => {
      const btn = (ev.target as HTMLElement).closest<HTMLButtonElement>('.fdraft-use');
      if (!btn) return;
      const wrap = btn.closest<HTMLElement>('.field');
      if (!wrap) return;
      let value: any = null;
      try { value = JSON.parse(btn.dataset.value ?? 'null'); } catch { return; }
      writeValue(wrap, value);
      for (const edit of wrap.querySelectorAll<HTMLElement>('.mdx-edit')) {
        const ta = edit.parentElement?.querySelector('textarea');
        if (ta) edit.innerHTML = ta.value.trim() ? renderMarkdown(ta.value) : '';
      }
      setState(wrap, 'Earlier draft back in the box; saving…', 'saving');
      save(wrap);
      btn.closest<HTMLDetailsElement>('details')?.removeAttribute('open');
    });

    /* "Give the feedback" wakes as the Elder's part fills (2.9): the
       button follows the boxes it hands over, and waits for the save to
       land before it can be pressed, so what is sent is what was saved. */
    const giveBtn = document.getElementById('give-btn') as HTMLButtonElement | null;
    const giveWraps = giveBtn ? fields.filter((w) => w.classList.contains('is-staff')) : [];
    const refreshGive = () => {
      if (!giveBtn) return;
      const filled = giveWraps.every((w) => {
        const v = readValue(w);
        if (v === undefined) return true;
        return Array.isArray(v) ? v.length > 0 : v !== null && String(v).trim() !== '';
      });
      const saving = giveWraps.some((w) => timers.has(w.dataset.field!) || pending.has(w.dataset.field!));
      giveBtn.disabled = !filled || saving;
    };
    if (giveBtn) {
      for (const w of giveWraps) { w.addEventListener('input', refreshGive); w.addEventListener('change', refreshGive); }
      setInterval(refreshGive, 1500);
    }

    /* What the live script (below) needs from this closure: a way to put
       another author's saved text into a box and to say so. */
    (form as any).__sp = { writeValue, setState, refreshProgress, readValue, isPending: (fieldId: string) => timers.has(fieldId) || pending.has(fieldId) };

    /* Files and pasted images go up at once, and the field or the text
       gets the address back. */
    const upload = async (file: File): Promise<{ path: string; name: string } | null> => {
      const fd = new FormData();
      fd.append('document_id', docId);
      fd.append('file', file, file.name || 'pasted');
      const res = await fetch('/app/api/upload/', { method: 'POST', body: fd, credentials: 'same-origin' });
      if (!res.ok) return null;
      const out = await res.json();
      return out.ok ? { path: out.path, name: out.name } : null;
    };

    form.querySelectorAll<HTMLInputElement>('.ffile-in').forEach((input) => {
      input.addEventListener('change', async () => {
        const file = input.files?.[0];
        const wrap = input.closest<HTMLElement>('.field');
        if (!file || !wrap) return;
        setState(wrap, 'Uploading…', 'saving');
        const got = await upload(file);
        if (!got) { setState(wrap, 'Could not upload that', 'kept'); return; }
        const version = Number(wrap.dataset.version || 0);
        try {
          const out = await post({ document_id: docId, field_id: wrap.dataset.field, value: got, version });
          if (out.ok) {
            wrap.dataset.version = String(out.version);
            setState(wrap, 'Uploaded', 'saved');
            const have = wrap.querySelector('.fhave') ?? (() => { const p = document.createElement('p'); p.className = 'fhave'; wrap.querySelector('.ffile')?.prepend(p); return p; })();
            have.innerHTML = '';
            if (/\.(png|jpe?g|gif|webp)$/i.test(got.path)) {
              const img = document.createElement('img'); img.src = `/app/media/${got.path}`; img.alt = got.name; have.appendChild(img);
            }
            const a = document.createElement('a'); a.href = `/app/media/${got.path}`; a.target = '_blank'; a.rel = 'noopener noreferrer'; a.textContent = got.name; have.appendChild(a);
          } else setState(wrap, 'Uploaded, but could not save the field', 'kept');
        } catch { setState(wrap, 'Uploaded, but could not save the field', 'kept'); }
      });
    });

    /* Generate: the picture is drawn from the fields it names, shown on
       the page, offered as a download, and kept on the document like a
       file so the Elder and the PDF see it. */
    /* What the picture is drawn from, read off the page, and a short
       fingerprint of it kept with the picture: the page can then say
       whether the boxes have changed since it was drawn, now or after a
       reload. */
    const sourcesOf = (box: HTMLElement) => {
      const values: Record<string, string> = {};
      for (const id of (box.dataset.sources ?? '').split(' ').filter(Boolean)) {
        const src = form.querySelector<HTMLElement>(`.field[data-field="${id}"]`);
        const raw = src ? readValue(src) : '';
        values[id] = typeof raw === 'string' ? raw : raw == null ? '' : String(raw);
      }
      return values;
    };
    const fingerprint = (values: Record<string, string>) => {
      let h = 5381;
      /* Whitespace apart, so a saved-and-reloaded box reads as unchanged. */
      const text = JSON.stringify(Object.fromEntries(Object.entries(values).map(([k, v]) => [k, v.replace(/\s+/g, ' ').trim()])));
      for (const ch of text) h = (Math.imul(h, 33) ^ ch.charCodeAt(0)) >>> 0;
      return h.toString(36);
    };
    const NOTE_FRESH = 'Drawn from the boxes above. Generate again after any changes.';
    const NOTE_STALE = 'Content changed, please regenerate';
    const refreshNote = (box: HTMLElement) => {
      const note = box.querySelector<HTMLElement>('.fgraphic-note');
      if (!note) return;
      const drawn = box.dataset.drawnFrom ?? '';
      const stale = drawn !== '' && drawn !== fingerprint(sourcesOf(box));
      note.textContent = stale ? NOTE_STALE : NOTE_FRESH;
      note.classList.toggle('stale', stale);
    };
    /* A download, switched on: the anchor is off until it has a file. */
    const offer = (a: HTMLAnchorElement | null, data: Blob, filename: string) => {
      if (!a) return;
      if (a.href.startsWith('blob:')) URL.revokeObjectURL(a.href);
      a.href = URL.createObjectURL(data); a.download = filename;
      a.classList.remove('is-off'); a.removeAttribute('aria-disabled');
    };
    /* The PNG only (2.8): a PPTX was offered and withdrawn, since a slide
       edited in PowerPoint leaves SciPath and its record behind. */
    const offerPng = (box: HTMLElement, blob: Blob, name: string) =>
      offer(box.querySelector<HTMLAnchorElement>('.fgraphic-dl'), blob, `${name}.png`);

    form.querySelectorAll<HTMLElement>('.fgraphic').forEach((box) => {
      refreshNote(box);
      /* The picture already on the document: its downloads come on once
         the file is fetched, under the name it was saved as. */
      const path = box.dataset.path;
      if (path) {
        fetch(`/app/media/${path}`).then((r) => (r.ok ? r.blob() : null)).then((blob) => {
          if (!blob) return;
          const base = path.split('/').pop()?.replace(/\.png$/i, '') || (box.dataset.name ?? 'graphic');
          offerPng(box, blob, base);
        }).catch(() => {});
      }
      /* Typing in a source box: the note turns to "regenerate" at once. */
      for (const id of (box.dataset.sources ?? '').split(' ').filter(Boolean)) {
        const src = form.querySelector<HTMLElement>(`.field[data-field="${id}"]`);
        /* After the editor has written the box's value, not before. */
        const later = () => setTimeout(() => refreshNote(box), 80);
        src?.addEventListener('input', later);
        src?.addEventListener('change', later);
      }
    });

    form.querySelectorAll<HTMLButtonElement>('.fgen').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const box = btn.closest<HTMLElement>('.fgraphic');
        const wrap = btn.closest<HTMLElement>('.field');
        const canvas = box?.querySelector<HTMLCanvasElement>('.fcanvas');
        if (!box || !wrap || !canvas) return;
        const values = sourcesOf(box);
        draw(box.dataset.graphic as any, canvas, { values, authors: box.dataset.authors ?? '' });
        canvas.hidden = false;
        box.querySelector<HTMLElement>('.fgraphic-none')?.remove();
        box.querySelector<HTMLElement>('.fhave')?.remove();
        const blob: Blob | null = await new Promise((r) => canvas.toBlob(r, 'image/png'));
        if (!blob) { setState(wrap, 'Could not draw it', 'kept'); return; }
        /* Named as every file from here is: program, who, deliverable, when. */
        const name = `${box.dataset.name ?? 'graphic'}-${stampFor(new Date(), box.dataset.tz || undefined)}`;
        offerPng(box, blob, name);
        box.dataset.drawnFrom = fingerprint(values);
        refreshNote(box);
        setState(wrap, 'Saving the picture…', 'saving');
        const got = await upload(new File([blob], `${name}.png`, { type: 'image/png' }));
        if (!got) { setState(wrap, 'Drawn, but could not save it to the document', 'kept'); return; }
        const version = Number(wrap.dataset.version || 0);
        try {
          const out = await post({ document_id: docId, field_id: wrap.dataset.field, value: { ...got, drawn_from: box.dataset.drawnFrom }, version });
          if (out.ok) { wrap.dataset.version = String(out.version); wrap.dataset.have = '1'; setState(wrap, 'Saved', 'saved'); refreshProgress(); }
          else setState(wrap, 'Drawn, but could not save it to the document', 'kept');
        } catch { setState(wrap, 'Drawn, but could not save it to the document', 'kept'); }
      });
    });

    /* An image pasted into a paragraph: the editor announces it, this
       uploads it and hands back the picture to put at the caret. */
    form.addEventListener('mdx:image', async (ev) => {
      const { file, insert } = (ev as CustomEvent).detail as { file: File; insert: (html: string) => void };
      const wrap = (ev.target as HTMLElement).closest<HTMLElement>('.field');
      if (!wrap) return;
      setState(wrap, 'Uploading image…', 'saving');
      const got = await upload(file);
      if (!got) { setState(wrap, 'Could not upload that image', 'kept'); return; }
      const alt = got.name.replace(/[\[\]"<>]/g, '');
      insert(`<img src="/app/media/${got.path}" alt="${alt}">`);
      schedule(wrap, 200);
    });

    /* "Add more": the next blank offered on demand opens; the button goes
       when none are left. Nothing is saved until something is typed. */
    form.querySelectorAll<HTMLButtonElement>('.fextra-add').forEach((btn) => {
      const sec = btn.closest<HTMLElement>('.doc-sec');
      const refresh = () => { if (sec && !sec.querySelector('.field.is-extra[hidden]')) btn.hidden = true; };
      btn.addEventListener('click', () => {
        const next = sec?.querySelector<HTMLElement>('.field.is-extra[hidden]');
        if (next) { next.hidden = false; next.querySelector<HTMLElement>('input, textarea, [contenteditable]')?.focus(); }
        refresh();
      });
      refresh();
    });

    /* "Add a source": the next hidden card opens; the button goes when
       none are left. Nothing is saved until something is typed. */
    form.querySelectorAll<HTMLButtonElement>('.fcard-add').forEach((btn) => {
      const box = btn.closest<HTMLElement>('.fcards');
      const refresh = () => { if (box && !box.querySelector('.fcard[hidden]')) btn.hidden = true; };
      btn.addEventListener('click', () => {
        const next = box?.querySelector<HTMLElement>('.fcard[hidden]');
        if (next) { next.hidden = false; next.querySelector<HTMLTextAreaElement>('textarea')?.focus(); }
        refresh();
      });
      refresh();
    });

  }

  /* Comments on a field and withdrawn asks, sent without leaving the
     page, and without reloading it: the thread is a live region, so it
     re-reads itself once the line is in (2.8). One listener on the
     document, because a live swap replaces the buttons. */
  const sendComment = async (btn: HTMLButtonElement) => {
    const box = btn.closest<HTMLElement>('.tform');
    if (!box) return;
    const ta = box.querySelector<HTMLTextAreaElement>('textarea');
    const ask = box.querySelector<HTMLInputElement>('input[type=checkbox]');
    if (!ta || !ta.value.trim()) { ta?.focus(); return; }
    btn.disabled = true;
    const fd = new FormData();
    fd.append('action', 'comment');
    fd.append('field_id', box.dataset.field ?? '');
    fd.append('body', ta.value);
    if (ask?.checked) fd.append('needs_revision', '1');
    fd.append('reply_to', box.dataset.reply ?? '');
    const res = await fetch(location.pathname, { method: 'POST', body: fd, credentials: 'same-origin', redirect: 'follow' });
    if (res.ok) {
      ta.value = '';
      if (ask) ask.checked = false;
      btn.disabled = false;
      btn.blur();
      box.closest<HTMLDetailsElement>('details')?.removeAttribute('open');
      document.dispatchEvent(new CustomEvent('live:refresh'));
    } else { btn.disabled = false; alert('Could not send that. Try the Save button and send again.'); }
  };
  document.addEventListener('click', async (ev) => {
    const target = ev.target as HTMLElement | null;
    const send = target?.closest<HTMLButtonElement>('[data-send=comment]');
    if (send) { await sendComment(send); return; }
    const resolve = target?.closest<HTMLButtonElement>('[data-resolve]');
    if (resolve) {
      const fd = new FormData();
      fd.append('action', 'resolve');
      fd.append('feedback_id', resolve.dataset.resolve ?? '');
      const res = await fetch(location.pathname, { method: 'POST', body: fd, credentials: 'same-origin', redirect: 'follow' });
      if (res.ok) document.dispatchEvent(new CustomEvent('live:refresh'));
    }
  });

  /* Arriving at a field or a comment by its link (2.8): the question from
     the Workbench or the tracker brings the reader to the box, so the
     reply is opened and the cursor is already in it rather than behind a
     collapsed "Add to this". `preventScroll` keeps the browser's own
     jump to the hash as the scroll; the focus does not move it again. */
  const openReplyAtHash = () => {
    if (!/^#(?:f|c)-./.test(location.hash)) return;
    const target = document.getElementById(location.hash.slice(1));
    const field = target?.closest<HTMLElement>('.field') ?? (target?.classList.contains('field') ? target : null);
    const details = field?.querySelector<HTMLDetailsElement>('details.tadd');
    if (!details) return;
    details.open = true;
    const ta = details.querySelector<HTMLTextAreaElement>('textarea');
    requestAnimationFrame(() => ta?.focus({ preventScroll: true }));
  };
  openReplyAtHash();
  window.addEventListener('hashchange', openReplyAtHash);
</script>

<script>
  import { join, onMessage, onPresence, liveMe, onHealth } from '../../../../../lib/live-client';
  import { renderMarkdown } from '../../../../../lib/notes';
  /**
   * THE ROOM (2.8).
   *
   * Everybody with this document open is in its room, over the socket:
   * the authors and whoever looks after them. Three things happen there.
   *
   * WHO IS WHERE. Each person's presence names the box they are in. On
   * every other screen that box shows the name ("Priya is writing here"),
   * so two authors do not start the same paragraph and an Elder watches
   * a student work a box at a time.
   *
   * THE SOFT LOCK. A box somebody else is in is read-only on this screen
   * while they are there, with their name on it. Soft, because it is only
   * presence: a browser that vanishes releases it within the socket's
   * heartbeat, and the version on every save is still what refuses a
   * stale write. Whoever is already typing when the other arrives keeps
   * typing; the second arrival is the one that waits.
   *
   * THE TEXT ARRIVING. A field another person saved is broadcast by the
   * database and lands in the box here, without a reload: into an editor
   * the reader is not in, or into the printed text on a reader's screen.
   * Big fields (over the broadcast's ride-along size) are fetched.
   */
  const form = document.getElementById('docform') as HTMLFormElement | null;
  const docId = form?.dataset.doc;
  const me = liveMe();
  if (form && docId && me) {
    const myName = form.dataset.me ?? '';
    const hooks = () => (form as any).__sp as { writeValue: (w: HTMLElement, v: any) => void; setState: (w: HTMLElement, t: string, c: string) => void; refreshProgress: () => void; readValue: (w: HTMLElement) => any; isPending: (id: string) => boolean } | undefined;
    const fieldEl = (id: string) => form.querySelector<HTMLElement>(`.field[data-field="${CSS.escape(id)}"]`);
    const topic = `doc:${docId}`;
    const ch = join(topic, { presence: true });

    /* ── Presence: where I am ─────────────────────────────────────────── */
    let here: string | null = null;
    let trackTimer: number | undefined;
    const track = () => {
      if (!ch) return;
      window.clearTimeout(trackTimer);
      trackTimer = window.setTimeout(() => { try { ch.track({ name: myName, field: here, at: Date.now() }); } catch {} }, 120);
    };
    form.addEventListener('focusin', (ev) => {
      const w = (ev.target as HTMLElement).closest<HTMLElement>('.field[data-field]');
      const next = w?.dataset.writable === '1' ? w.dataset.field ?? null : null;
      if (next !== here) { here = next; track(); }
    });
    form.addEventListener('focusout', () => {
      window.setTimeout(() => {
        const a = document.activeElement as HTMLElement | null;
        const w = a?.closest<HTMLElement>('.field[data-field]');
        const next = w && w.dataset.writable === '1' ? w.dataset.field ?? null : null;
        if (next !== here) { here = next; track(); }
      }, 50);
    });

    /* ── Presence: where everybody else is ───────────────────────────── */
    const held = new Map<string, string>();   // field -> name of who is in it
    const applyPresence = () => {
      if (!ch) return;
      const state = ch.presenceState() as Record<string, any[]>;
      held.clear();
      const names: string[] = [];
      for (const [key, metas] of Object.entries(state)) {
        if (key === me) continue;
        const m = metas[metas.length - 1] ?? {};
        const name = String(m.name ?? 'Somebody');
        if (!names.includes(name)) names.push(name);
        if (m.field && !held.has(m.field)) held.set(m.field, name);
      }
      for (const w of form.querySelectorAll<HTMLElement>('.field[data-field]')) {
        const id = w.dataset.field!;
        const who = held.get(id);
        let chip = w.querySelector<HTMLElement>('.fwho');
        if (who) {
          if (!chip) { chip = document.createElement('span'); chip.className = 'fwho'; (w.querySelector('.fprompt') ?? w).appendChild(chip); }
          chip.textContent = `${who} is ${w.dataset.writable === '1' ? 'writing' : 'in'} here`;
          /* The soft lock: read-only while they are there, unless this
             reader is already in it. */
          const mine = here === id;
          const lock = w.dataset.writable === '1' && !mine;
          w.classList.toggle('is-held', lock);
          for (const el of w.querySelectorAll<HTMLElement>('.mdx-edit')) el.contentEditable = lock ? 'false' : 'true';
          for (const el of w.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('input:not([type=hidden]), textarea:not([hidden])')) el.readOnly = lock;
          for (const el of w.querySelectorAll<HTMLInputElement>('input[type=radio], input[type=checkbox]')) el.disabled = lock;
        } else if (chip || w.classList.contains('is-held')) {
          chip?.remove();
          w.classList.remove('is-held');
          for (const el of w.querySelectorAll<HTMLElement>('.mdx-edit')) el.contentEditable = 'true';
          for (const el of w.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('input:not([type=hidden]), textarea:not([hidden])')) el.readOnly = false;
          for (const el of w.querySelectorAll<HTMLInputElement>('input[type=radio], input[type=checkbox]')) el.disabled = false;
        }
      }
      const roster = document.getElementById('ds-room');
      if (roster) roster.textContent = names.length ? `Also here: ${names.join(', ')}` : '';
    };
    /* Through the client (onPresence): a listener put on the channel here
       came after its subscribe() and the library threw, which ended this
       script before the text-arriving section below ever ran. */
    onPresence(topic, () => applyPresence());
    /* Once the channel is up, say I am here (even in no box). */
    onHealth((h) => { if (h === 'live') track(); });
    document.addEventListener('live:reconnected', () => track());

    /* ── The text arriving ───────────────────────────────────────────── */
    const when = (iso: string) => new Date(iso).toLocaleTimeString([], { hour: 'numeric', minute: '2-digit' });
    const showRead = (w: HTMLElement, value: any) => {
      /* A reader's screen: redraw the printed text for the kinds the page
         can draw here; the rest re-read themselves from the page. */
      const read = w.querySelector<HTMLElement>('.fread');
      if (!read) return false;
      const kind = w.dataset.kind;
      const empty = (t: string) => `<p class="fempty">${t}</p>`;
      if (kind === 'long') { read.innerHTML = value && String(value).trim() ? `<div class="fprose">${renderMarkdown(String(value))}</div>` : empty('Not written yet'); return true; }
      if (kind === 'text' || kind === 'number' || kind === 'choice' || kind === 'date') { read.innerHTML = value != null && String(value).trim() ? `<p></p>` : empty('Not answered yet'); if (value != null && String(value).trim()) read.querySelector('p')!.textContent = String(value); return true; }
      if (kind === 'choices') { read.innerHTML = Array.isArray(value) && value.length ? `<p></p>` : empty('Not answered yet'); if (Array.isArray(value) && value.length) read.querySelector('p')!.textContent = value.join(', '); return true; }
      return false;
    };
    const reloadField = async (w: HTMLElement) => {
      /* The kinds drawn server-side (a table of cards, a rubric, a file):
         fetch the page and swap this field's read-only block. */
      try {
        const res = await fetch(location.pathname + location.search, { credentials: 'same-origin', cache: 'no-store', headers: { 'X-Live': '1' } });
        if (!res.ok) return;
        const fresh = new DOMParser().parseFromString(await res.text(), 'text/html');
        const next = fresh.querySelector<HTMLElement>(`#${CSS.escape(w.id)} .fread`);
        const mine = w.querySelector<HTMLElement>('.fread');
        if (next && mine) mine.innerHTML = next.innerHTML;
      } catch {}
    };
    const applyField = async (p: any) => {
      if (!p || p.document_id !== docId || !p.field_id) return;
      if (p.by_id === me) return;
      const w = fieldEl(p.field_id);
      if (!w) return;
      let value = p.value;
      if (p.big) {
        try {
          const res = await fetch(`/app/api/field/?document_id=${encodeURIComponent(docId)}&field_id=${encodeURIComponent(p.field_id)}`, { credentials: 'same-origin', cache: 'no-store' });
          if (!res.ok) return;
          value = (await res.json()).value;
        } catch { return; }
      }
      const h = hooks();
      if (w.dataset.writable === '1' && h) {
        /* My box, their text. Not while I am typing in it: the version
           refusal and the conflict note handle that moment. */
        if (here === p.field_id || h.isPending(p.field_id)) { h.setState(w, `${p.by ?? 'Somebody'} saved a newer version of this field at ${when(p.at)}. Yours is refused until you reload.`, 'kept'); return; }
        h.writeValue(w, value);
        /* The rich editor draws from its surface, not the textarea. */
        for (const edit of w.querySelectorAll<HTMLElement>('.mdx-edit')) {
          const ta = edit.parentElement?.querySelector('textarea');
          if (ta) edit.innerHTML = ta.value.trim() ? renderMarkdown(ta.value) : '';
        }
        w.dataset.version = String(p.version);
        const ver = w.querySelector<HTMLInputElement>('.fver');
        if (ver) ver.value = String(p.version);
        h.setState(w, `Updated by ${p.by ?? 'somebody'} at ${when(p.at)}`, 'saved');
        h.refreshProgress();
        if (w.hidden) w.hidden = false;
      } else {
        w.dataset.version = String(p.version);
        if (!showRead(w, value)) await reloadField(w);
        if (w.hidden) w.hidden = false;
        let by = w.querySelector<HTMLElement>('.fby-live');
        if (!by) { by = document.createElement('p'); by.className = 'fmeta fby-live'; w.querySelector('.fread')?.appendChild(by); }
        by.textContent = `${p.by ?? 'Somebody'} saved this at ${when(p.at)}`;
      }
      w.classList.add('is-fresh');
      window.setTimeout(() => w.classList.remove('is-fresh'), 1600);
    };
    onMessage((m) => { if (m.topic === topic && m.event === 'field') applyField(m.payload).catch(() => {}); });
  }
</script>
