<script>
  /**
   * SAVES AS YOU TYPE.
   *
   * Per field: a short idle after the last keystroke, and on blur. Each
   * save carries the version the field was read at; the server accepts
   * it only if nothing newer is there, and otherwise answers with the
   * other author's text, which is shown beside yours rather than
   * overwritten. Until the server says saved, the text sits in this
   * browser's storage under the document and field, so a dropped
   * connection loses nothing: on the next load the page offers it back.
   * Nothing here is needed for the page to work; the Save button posts
   * every field the ordinary way.
   */
  const form = document.getElementById('docform') as HTMLFormElement | null;
  const writable = form ? form.querySelectorAll('.field[data-writable="1"]').length > 0 : false;
  if (form && writable && form.dataset.doc) {
    const docId = form.dataset.doc;
    const saved = document.getElementById('ds-saved');
    const key = (fieldId: string) => `sp:doc:${docId}:${fieldId}`;
    const timers = new Map<string, number>();
    const pending = new Set<string>();

    const readValue = (wrap: HTMLElement): any => {
      const kind = wrap.dataset.kind;
      const fieldId = wrap.dataset.field!;
      if (kind === 'choice') {
        const on = wrap.querySelector<HTMLInputElement>('input[type=radio]:checked');
        return on ? on.value : null;
      }
      if (kind === 'choices') {
        return [...wrap.querySelectorAll<HTMLInputElement>('input[type=checkbox]:checked')].map((c) => c.value);
      }
      if (kind === 'file') return undefined;
      if (kind === 'table') {
        const rows: string[][] = [];
        wrap.querySelectorAll<HTMLTableRowElement>('tbody tr').forEach((tr) => {
          rows.push([...tr.querySelectorAll<HTMLTextAreaElement>('textarea')].map((t) => t.value));
        });
        return rows;
      }
      if (kind === 'rubric') {
        const picks: Record<string, string> = {};
        wrap.querySelectorAll<HTMLInputElement>('input[type=radio]:checked').forEach((r) => {
          const crit = r.name.split(':').pop();
          if (crit) picks[crit] = r.value;
        });
        return picks;
      }
      const el = wrap.querySelector<HTMLInputElement | HTMLTextAreaElement>(`[name="f:${fieldId}"]`);
      if (!el) return undefined;
      if (kind === 'number') return el.value.trim() === '' ? null : Number(el.value);
      return el.value;
    };

    const writeValue = (wrap: HTMLElement, value: any) => {
      const kind = wrap.dataset.kind;
      const fieldId = wrap.dataset.field!;
      if (kind === 'table') {
        wrap.querySelectorAll<HTMLTableRowElement>('tbody tr').forEach((tr, ri) => {
          tr.querySelectorAll<HTMLTextAreaElement>('textarea').forEach((t, ci) => (t.value = Array.isArray(value?.[ri]) ? value[ri][ci] ?? '' : ''));
        });
      } else if (kind === 'rubric') {
        wrap.querySelectorAll<HTMLInputElement>('input[type=radio]').forEach((r) => {
          const crit = r.name.split(':').pop() ?? '';
          r.checked = Boolean(value && value[crit] === r.value);
        });
      } else if (kind === 'choice') {
        wrap.querySelectorAll<HTMLInputElement>('input[type=radio]').forEach((r) => (r.checked = r.value === value));
      } else if (kind === 'choices') {
        const set = new Set(Array.isArray(value) ? value : []);
        wrap.querySelectorAll<HTMLInputElement>('input[type=checkbox]').forEach((c) => (c.checked = set.has(c.value)));
      } else {
        const el = wrap.querySelector<HTMLInputElement | HTMLTextAreaElement>(`[name="f:${fieldId}"]`);
        if (el) el.value = value == null ? '' : String(value);
      }
      countWords(wrap);
    };

    const setState = (wrap: HTMLElement, text: string, cls: string) => {
      const el = wrap.querySelector<HTMLElement>('.fstate');
      if (!el) return;
      el.textContent = text;
      el.className = `fstate ${cls}`;
    };

    const countWords = (wrap: HTMLElement) => {
      const el = wrap.querySelector<HTMLElement>('.fwords');
      const input = wrap.querySelector<HTMLTextAreaElement | HTMLInputElement>(`[name="f:${wrap.dataset.field}"]`);
      if (!el || !input) return;
      const n = input.value.trim() ? input.value.trim().split(/\s+/).length : 0;
      el.textContent = `${n} ${n === 1 ? 'word' : 'words'}`;
      const max = Number(el.dataset.max || 0);
      el.classList.toggle('over', max > 0 && n > max);
    };

    const stash = (fieldId: string, value: any) => {
      try { localStorage.setItem(key(fieldId), JSON.stringify({ value, at: Date.now() })); } catch {}
    };
    const unstash = (fieldId: string) => {
      try { localStorage.removeItem(key(fieldId)); } catch {}
    };

    const post = async (body: any) => {
      const res = await fetch('/app/api/field/', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        credentials: 'same-origin',
        body: JSON.stringify(body),
      });
      if (!res.ok) throw new Error(`save failed (${res.status})`);
      return res.json();
    };

    const save = async (wrap: HTMLElement, attempt = 0) => {
      const fieldId = wrap.dataset.field!;
      const value = readValue(wrap);
      if (value === undefined) return;
      const version = Number(wrap.dataset.version || 0);
      stash(fieldId, value);
      pending.add(fieldId);
      setState(wrap, 'Saving…', 'saving');
      try {
        const out = await post({ document_id: docId, field_id: fieldId, value, version });
        if (out.ok) {
          wrap.dataset.version = String(out.version);
          const ver = wrap.querySelector<HTMLInputElement>('.fver');
          if (ver) ver.value = String(out.version);
          unstash(fieldId);
          pending.delete(fieldId);
          setState(wrap, 'Saved', 'saved');
          if (saved) saved.textContent = `last saved ${new Date().toLocaleTimeString([], { hour: 'numeric', minute: '2-digit' })}`;
        } else if (out.conflict) {
          pending.delete(fieldId);
          showConflict(wrap, out, value);
        } else {
          throw new Error(out.error || 'refused');
        }
      } catch (e) {
        setState(wrap, navigator.onLine ? 'Could not save; kept on this device' : 'Offline; kept on this device', 'kept');
        if (attempt < 5) {
          window.setTimeout(() => save(wrap, attempt + 1), Math.min(30000, 2000 * 2 ** attempt));
        }
      }
    };

    /* A newer version on the server (another author, or another tab).
       Nothing is overwritten; the row keeps the newer text and this tab is
       told to reload for it. The three-way choice that stood here is held
       for a later drop (2.8). */
    const showConflict = (wrap: HTMLElement, out: any, _mine: any) => {
      wrap.dataset.version = String(out.version);
      const ver = wrap.querySelector<HTMLInputElement>('.fver');
      if (ver) ver.value = String(out.version);
      setState(wrap, `${out.by ?? 'Somebody else'} saved a newer version of this field. Reload the page to see it; your text is kept on this device.`, 'kept');
    };

    const schedule = (wrap: HTMLElement, delay = 1200) => {
      const fieldId = wrap.dataset.field!;
      stash(fieldId, readValue(wrap));
      setState(wrap, 'Typing…', 'saving');
      window.clearTimeout(timers.get(fieldId));
      timers.set(fieldId, window.setTimeout(() => save(wrap), delay));
    };

    const fields = [...form.querySelectorAll<HTMLElement>('.field[data-field]')].filter((w) => w.dataset.kind !== 'note' && w.dataset.writable === '1');

    for (const wrap of fields) {
      const inputs = wrap.querySelectorAll<HTMLElement>('input, textarea');
      inputs.forEach((el) => {
        if ((el as HTMLInputElement).type === 'file') return;
        if ((el as HTMLInputElement).type === 'hidden') return;
        el.addEventListener('input', () => { countWords(wrap); schedule(wrap); });
        el.addEventListener('change', () => { countWords(wrap); schedule(wrap, 200); });
        el.addEventListener('blur', () => { if (timers.has(wrap.dataset.field!)) schedule(wrap, 100); });
      });

      /* Whatever this browser kept from an earlier visit is dropped on
         load; the server's copy is the document. */
      try { unstash(wrap.dataset.field!); } catch {}
    }

    /* Leaving with something unsaved: one last try, and the copy stays in
       storage either way. */
    window.addEventListener('beforeunload', () => {
      for (const wrap of fields) {
        const fieldId = wrap.dataset.field!;
        if (!timers.has(fieldId) && !pending.has(fieldId)) continue;
        const value = readValue(wrap);
        if (value === undefined) continue;
        try {
          navigator.sendBeacon('/app/api/field/', new Blob([JSON.stringify({ document_id: docId, field_id: fieldId, value, version: Number(wrap.dataset.version || 0) })], { type: 'application/json' }));
        } catch {}
      }
    });

    /* Files and pasted images go up at once, and the field or the text
       gets the address back. */
    const upload = async (file: File): Promise<{ path: string; name: string } | null> => {
      const fd = new FormData();
      fd.append('document_id', docId);
      fd.append('file', file, file.name || 'pasted');
      const res = await fetch('/app/api/upload/', { method: 'POST', body: fd, credentials: 'same-origin' });
      if (!res.ok) return null;
      const out = await res.json();
      return out.ok ? { path: out.path, name: out.name } : null;
    };

    form.querySelectorAll<HTMLInputElement>('.ffile-in').forEach((input) => {
      input.addEventListener('change', async () => {
        const file = input.files?.[0];
        const wrap = input.closest<HTMLElement>('.field');
        if (!file || !wrap) return;
        setState(wrap, 'Uploading…', 'saving');
        const got = await upload(file);
        if (!got) { setState(wrap, 'Could not upload that', 'kept'); return; }
        const version = Number(wrap.dataset.version || 0);
        try {
          const out = await post({ document_id: docId, field_id: wrap.dataset.field, value: got, version });
          if (out.ok) {
            wrap.dataset.version = String(out.version);
            setState(wrap, 'Uploaded', 'saved');
            const have = wrap.querySelector('.fhave') ?? (() => { const p = document.createElement('p'); p.className = 'fhave'; wrap.querySelector('.ffile')?.prepend(p); return p; })();
            have.innerHTML = '';
            if (/\.(png|jpe?g|gif|webp)$/i.test(got.path)) {
              const img = document.createElement('img'); img.src = `/app/media/${got.path}`; img.alt = got.name; have.appendChild(img);
            }
            const a = document.createElement('a'); a.href = `/app/media/${got.path}`; a.target = '_blank'; a.rel = 'noopener noreferrer'; a.textContent = got.name; have.appendChild(a);
          } else setState(wrap, 'Uploaded, but could not save the field', 'kept');
        } catch { setState(wrap, 'Uploaded, but could not save the field', 'kept'); }
      });
    });

    form.querySelectorAll<HTMLTextAreaElement>('textarea[data-paste=image]').forEach((ta) => {
      const insert = async (file: File) => {
        const wrap = ta.closest<HTMLElement>('.field');
        if (!wrap) return;
        setState(wrap, 'Uploading image…', 'saving');
        const got = await upload(file);
        if (!got) { setState(wrap, 'Could not upload that image', 'kept'); return; }
        const at = ta.selectionStart ?? ta.value.length;
        const md = `\n![${got.name.replace(/[\[\]]/g, '')}](/app/media/${got.path})\n`;
        ta.value = ta.value.slice(0, at) + md + ta.value.slice(at);
        ta.selectionStart = ta.selectionEnd = at + md.length;
        countWords(wrap);
        schedule(wrap, 200);
      };
      ta.addEventListener('paste', (ev) => {
        const item = [...(ev.clipboardData?.items ?? [])].find((i) => i.kind === 'file' && i.type.startsWith('image/'));
        if (!item) return;
        const file = item.getAsFile();
        if (!file) return;
        ev.preventDefault();
        insert(file);
      });
      ta.addEventListener('drop', (ev) => {
        const file = [...(ev.dataTransfer?.files ?? [])].find((f) => f.type.startsWith('image/'));
        if (!file) return;
        ev.preventDefault();
        insert(file);
      });
    });

    /* Comments on a field, sent without leaving the page. */
    form.querySelectorAll<HTMLButtonElement>('[data-send=comment]').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const box = btn.closest<HTMLElement>('.tform');
        if (!box) return;
        const ta = box.querySelector<HTMLTextAreaElement>('textarea');
        const ask = box.querySelector<HTMLInputElement>('input[type=checkbox]');
        if (!ta || !ta.value.trim()) { ta?.focus(); return; }
        btn.disabled = true;
        const fd = new FormData();
        fd.append('action', 'comment');
        fd.append('field_id', box.dataset.field ?? '');
        fd.append('body', ta.value);
        if (ask?.checked) fd.append('needs_revision', '1');
        fd.append('reply_to', box.dataset.reply ?? '');
        const res = await fetch(location.pathname, { method: 'POST', body: fd, credentials: 'same-origin', redirect: 'follow' });
        if (res.ok) location.href = `${location.pathname}?m=${encodeURIComponent('Sent.')}#f-${box.dataset.field}`;
        else { btn.disabled = false; alert('Could not send that. Try the Save button and send again.'); }
      });
    });
  }

  /* Withdrawing an ask, from inside the document form (a nested form is not HTML). */
  document.querySelectorAll<HTMLButtonElement>('[data-resolve]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const fd = new FormData();
      fd.append('action', 'resolve');
      fd.append('feedback_id', btn.dataset.resolve ?? '');
      const res = await fetch(location.pathname, { method: 'POST', body: fd, credentials: 'same-origin', redirect: 'follow' });
      if (res.ok) location.href = `${location.pathname}?m=${encodeURIComponent('Ask withdrawn.')}`;
    });
  });

  /* Readers who may comment but are not authors: the same buttons, no autosave. */
  const readerForm = document.getElementById('docform') as HTMLFormElement | null;
  if (readerForm && !writable) {
    readerForm.querySelectorAll<HTMLButtonElement>('[data-send=comment]').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const box = btn.closest<HTMLElement>('.tform');
        if (!box) return;
        const ta = box.querySelector<HTMLTextAreaElement>('textarea');
        const ask = box.querySelector<HTMLInputElement>('input[type=checkbox]');
        if (!ta || !ta.value.trim()) { ta?.focus(); return; }
        btn.disabled = true;
        const fd = new FormData();
        fd.append('action', 'comment');
        fd.append('field_id', box.dataset.field ?? '');
        fd.append('body', ta.value);
        if (ask?.checked) fd.append('needs_revision', '1');
        fd.append('reply_to', box.dataset.reply ?? '');
        const res = await fetch(location.pathname, { method: 'POST', body: fd, credentials: 'same-origin', redirect: 'follow' });
        if (res.ok) location.href = `${location.pathname}?m=${encodeURIComponent('Sent.')}#f-${box.dataset.field}`;
        else { btn.disabled = false; alert('Could not send that.'); }
      });
    });
  }
</script>
