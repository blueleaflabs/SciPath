---
export const prerender = false;

/**
 * A DOCUMENT AS A PDF (6.16, 2.8).
 *
 * Every deliverable written in SciPath can leave as a PDF: this is the
 * document as a printed page, on the same paper as the notebook export
 * (`print-book.css`): the school's mark, the project, who is on it, which
 * document this is and when it was printed, then the document itself,
 * section by section. The browser's own "Save as PDF" is the export. No
 * PDF library runs at the edge.
 *
 * `?version=N` prints a submitted version as it was; without it the
 * document as it stands. `?comments=1` adds the threads under each
 * field. `?go=1` opens the print dialog on load.
 */

import { serverClient } from '../../../../../../lib/supabase';
import { activeOrg } from '../../../../../../lib/tenant';
import { formatDate } from '../../../../../../lib/dates';
import { signInWith } from '../../../../../../lib/next-path';
import { shape as shapeOf } from '../../../../../../lib/templates';
import { programTitle, staffWord } from '../../../../../../lib/program-names';
import { platform } from '../../../../../../config/site';
import { exportName } from '../../../../../../lib/export-names';
import { placesWanting, docStanding } from '../../../../../../lib/documents';
import PaperHeader from '../../../../../../components/PaperHeader.astro';
import DocumentPaper from '../../../../../../components/DocumentPaper.astro';
import { backFrom } from '../../../../../../lib/back';

const { session, account } = Astro.locals;
const org = activeOrg(Astro);
const { id: projectId, deliverable: deliverableId } = Astro.params;

if (!session) return Astro.redirect(signInWith(Astro.url));
if (!account) return Astro.redirect('/app/welcome/');
if (!projectId || !deliverableId) return Astro.redirect('/app/');

const supabase = serverClient(Astro.request, Astro.cookies, (Astro.locals as any).runtime?.env);

const { data: project } = await supabase
  .from('projects')
  .select('id, title, facts, process_id, project_authors(role, self_managed_at, users(id, display_name))')
  .eq('id', projectId)
  .maybeSingle();
if (!project) return Astro.redirect('/app/');

const authors = (project.project_authors ?? []).filter((a: any) => a.role === 'author' && a.users).map((a: any) => a.users.display_name);
const elders = (project.project_authors ?? []).filter((a: any) => a.role === 'officer' && !a.self_managed_at && a.users).map((a: any) => a.users.display_name);
const places = await placesWanting(supabase, projectId, deliverableId, project.facts ?? {}, project.process_id ?? null);
/* The step this page submits for: the first still open, so a document two
   steps want (the journey map's draft and final) submits for the draft,
   then for the final (2.8); with every step met, the last. */
const wanted = places.find((p) => !p.completedOn) ?? places[places.length - 1] ?? null;
const shape = wanted?.deliverable.shape ? shapeOf(wanted.deliverable.shape) : null;
const label = wanted?.deliverable.name ?? deliverableId;
const rubric = wanted?.step?.rubric ?? null;
const program = (wanted?.program ?? null) as any;
const elderWord = staffWord(program, elders.length === 1 ? 'singular' : 'plural');

/* The teachers standing behind the work: the sponsors on any of the
   project's participations. */
const { data: sponsors } = await supabase
  .from('project_sponsors')
  .select('teacher_name, participations!inner(project_id)')
  .eq('participations.project_id', projectId)
  .is('superseded_at', null);
const teacherNames = [...new Set((sponsors ?? []).map((s: any) => s.teacher_name).filter(Boolean))];

const { data: doc } = await supabase
  .from('documents')
  .select('id, status, version_no, opened_at, submitted_at, updated_at')
  .eq('project_id', projectId)
  .eq('deliverable', deliverableId)
  .maybeSingle();

const wantVersion = Number(Astro.url.searchParams.get('version') ?? '') || null;
let values: Record<string, any> = {};
let stamp = '';
const when = (iso: string | null | undefined) =>
  iso ? new Date(iso).toLocaleString('en-US', { year: 'numeric', month: 'long', day: 'numeric', hour: 'numeric', minute: '2-digit', timeZone: org.timezone }) : '';
if (doc && wantVersion) {
  const { data: v } = await supabase.from('document_versions').select('content, version_no, submitted_at').eq('document_id', doc.id).eq('version_no', wantVersion).maybeSingle();
  values = v?.content ?? {};
  stamp = v ? `Version ${v.version_no}, submitted ${when(v.submitted_at)}` : 'No such version';
} else if (doc) {
  const { data: fields } = await supabase.from('document_fields').select('field_id, value').eq('document_id', doc.id);
  for (const f of fields ?? []) values[f.field_id] = f.value;
  stamp = docStanding({ ...doc, document_fields: (fields ?? []) as any }, shape, when).label;
}

const withComments = Astro.url.searchParams.get('comments') === '1';
const { data: comments } = doc && withComments
  ? await supabase.from('deliverable_feedback').select('field_id, body_md, needs_revision, created_at, author:author_id(display_name)').eq('document_id', doc.id).order('created_at', { ascending: true })
  : { data: [] as any[] };

const go = Astro.url.searchParams.get('go') === '1';
const docLink = typeof values['_doc_link'] === 'string' ? values['_doc_link'] : '';
const printedOn = when(new Date().toISOString());
const back = backFrom(Astro.request, { href: `/app/project/${project.id}/doc/${deliverableId}/`, label: 'Back to the document' });
const withQuery = `?${wantVersion ? `version=${wantVersion}&` : ''}comments=1`;
const withoutQuery = wantVersion ? `?version=${wantVersion}` : '';
---

<html lang="en" data-surface="print">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{exportName(program, authors.join(', '), label, new Date(), org.timezone)}</title>
  </head>
  <body>
    <div class="toolbar">
      <a href={back.href}>{back.label}</a>
      <label class="opt">
        <input type="checkbox" checked={withComments} data-on={withQuery} data-off={withoutQuery} onchange="location.search = this.checked ? this.dataset.on : this.dataset.off" />
        Include the comments
      </label>
      <button class="btn" type="button" onclick="window.print()">Print or save as PDF</button>
    </div>

    <article class="book">
      <PaperHeader org={org} what={label} title={project.title} rows={[
        { label: `Author${authors.length === 1 ? '' : 's'}`, value: authors.join(', ') || '—' },
        ...(wanted ? [{ label: 'Class', value: programTitle(program) || wanted.programName }] : []),
        ...(elders.length > 0 ? [{ label: elderWord, value: elders.join(', ') }] : []),
        ...(teacherNames.length > 0 ? [{ label: `Teacher${teacherNames.length === 1 ? '' : 's'}`, value: teacherNames.join(', ') }] : []),
        { label: 'Document', value: `${label}${wanted?.dueOn ? `, due ${formatDate(wanted.dueOn, 'long')}` : ''}` },
        ...(stamp ? [{ label: 'Standing', value: stamp }] : []),
        ...(docLink ? [{ label: 'Linked document', value: docLink, href: docLink }] : []),
        { label: 'Printed', value: printedOn },
      ]} />

      {!shape ? (
        <p class="empty">This deliverable is not written in SciPath.</p>
      ) : (
        <DocumentPaper shape={shape} values={values} rubric={rubric} program={program} comments={withComments ? (comments ?? []) : []} when={when} />
      )}

      <p class="fine colophon">Printed from SciPath, {org.name}. {label}, {project.title}, {printedOn}.</p>
    </article>

    {go && <script is:inline>window.addEventListener('load', () => setTimeout(() => window.print(), 300));</script>}
  </body>
</html>

<style is:global>
  @import '../../../../../../styles/print-book.css';

  .colophon { margin-top: 28px; border-top: 1px solid var(--rule); padding-top: 6px; }
</style>
