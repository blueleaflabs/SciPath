---
export const prerender = false;

/**
 * MY SHOWCASE.
 *
 * The author's side of the class showcase: the card as the class sees it,
 * the summary in their own words, and the switch that takes the card off
 * the class page and puts it back. No approval stands between an edit and
 * the class seeing it; the card is live because the class is the audience
 * and the point is a living track of the work.
 *
 * The pictures and the video are the ones the participation page already
 * collects for the published record, so this page shows them and sends the
 * author there to change them rather than growing a second uploader.
 */

import Base from '../../../../layouts/Base.astro';
import AppShell from '../../../../components/AppShell.astro';
import ProjectCover from '../../../../components/ProjectCover.astro';
import { activeOrg } from '../../../../lib/tenant';
import { serverClient } from '../../../../lib/supabase';
import { afterPost, outcomeFrom } from '../../../../lib/post-redirect';
import { signInWith } from '../../../../lib/next-path';
import { programTitle, staffWord } from '../../../../lib/program-names';
import { parseVideo } from '../../../../lib/video';
import { identify } from '../../../../lib/filetype';
import { blobStore, projectImagePath, MAX_UPLOAD_BYTES } from '../../../../lib/blob';
import { resolveProgram } from '../../../../lib/templates';
import { formatDate } from '../../../../lib/dates';
import { loadShowcases } from '../../../../lib/showcase-load';
import ShowcaseSections from '../../../../components/ShowcaseSections.astro';

const { session, account, roles } = Astro.locals;
const org = activeOrg(Astro);
const { id } = Astro.params;

if (!session) return Astro.redirect(signInWith(Astro.url));
if (!account) return Astro.redirect('/app/welcome/');

const supabase = serverClient(Astro.request, Astro.cookies, (Astro.locals as any).runtime?.env);

let { error, note } = outcomeFrom(Astro.url);

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const action = String(form.get('action') ?? '');

  /* The pictures and the video, moved here from the project page (2.8):
     this is the page that shows them, so it is the page that takes them. */
  if (action === 'image') {
    const file = form.get('image') as File | null;
    if (!file || file.size === 0) error = 'Choose an image first.';
    else if (file.size > MAX_UPLOAD_BYTES) error = 'That file is too large.';
    else {
      const blob = blobStore(Astro.locals);
      if (!blob.available()) error = 'File storage is not configured here.';
      else {
        const kind = await identify(file);
        if (!kind || !kind.mime.startsWith('image/')) {
          error = 'That is not an image we can show. Use a JPEG, PNG, WebP or GIF.';
        } else {
          const path = projectImagePath(id!, file.name, kind.ext);
          try {
            await blob.put(path, await file.arrayBuffer(), kind.mime);
            const { error: e } = await supabase.rpc('add_project_image', {
              p_project_id: id,
              p_storage_path: path,
              p_alt: String(form.get('alt') ?? ''),
              p_caption: String(form.get('caption') ?? ''),
            });
            if (e) error = e.message;
            else note = 'Image added.';
          } catch (e: any) {
            error = e.message;
          }
        }
      }
    }
    return afterPost(Astro.url, { error, note });
  }

  if (action === 'image_remove') {
    const { error: e } = await supabase.rpc('remove_project_image', { p_image_id: String(form.get('image_id') ?? '') });
    if (e) error = e.message;
    else note = 'Image removed.';
    return afterPost(Astro.url, { error, note });
  }

  if (action === 'video') {
    const { error: e } = await supabase.rpc('save_project_video', { p_project_id: id, p_url: String(form.get('video_url') ?? '') });
    if (e) error = e.message;
    else note = 'Video saved.';
    return afterPost(Astro.url, { error, note });
  }

  const hidden = action === 'hide' ? true : action === 'show' ? false : String(form.get('hidden') ?? '') === '1';

  /* "Use my Research Graphic" (2.8; the Project Summary until 2.9): the
     four boxes of the submitted document, as plain text, become the
     summary in one click; the
     author edits from there. */
  let summaryText = String(form.get('summary') ?? '');
  if (action === 'from_summary') {
    const { data: doc } = await supabase
      .from('documents')
      .select('id, document_fields(field_id, value)')
      .eq('project_id', id)
      .eq('deliverable', 'project_summary')
      .maybeSingle();
    const v = Object.fromEntries(((doc as any)?.document_fields ?? []).map((f: any) => [f.field_id, f.value]));
    const plain = (t: any) => String(t ?? '').replace(/[*_#>`]/g, '').replace(/\s+\n/g, '\n').trim();
    const parts = [
      plain(v.question),
      v.impact ? `Impact: ${plain(v.impact)}` : '',
      v.users ? `Who it is for: ${plain(v.users)}` : '',
      v.data ? `The data we need: ${plain(v.data)}` : '',
    ].filter(Boolean);
    if (parts.length === 0) return afterPost(Astro.url, { error: 'The Research Graphic has nothing in it yet.', note: null });
    summaryText = parts.join('\n\n').slice(0, 1200);
  }

  const { error: e } = await supabase.rpc('set_project_showcase', {
    p_project_id: id,
    p_summary: summaryText,
    p_hidden: hidden,
  });

  if (e) error = e.message;
  else note = action === 'hide' ? 'Taken off the class page. Put it back whenever you like.' : action === 'show' ? 'Shown to the class again.' : 'Saved. The class sees it now.';

  return afterPost(Astro.url, { error, note });
}

const { data: project } = await supabase
  .from('projects')
  .select('id, title, summary, showcase_hidden, showcase_updated_at, video_url, project_authors(user_id, role, self_managed_at, users(id, display_name))')
  .eq('id', id)
  .maybeSingle();

if (!project) return Astro.redirect('/app/');

const iAuthor = (project.project_authors ?? []).some((a: any) => a.user_id === account.id && a.role === 'author');

/* Which class showcases this project is on. A project in no private
   program has nothing to show here and says so. */
const { data: places } = await supabase
  .from('participations')
  .select('id, program_id, programs(id, name, short_name, season_year, kind, program_role, showcase)')
  .eq('project_id', id);

const shows = (places ?? [])
  .map((p: any) => p.programs)
  .filter((g: any) => g && g.showcase === 'private');

const { data: images } = await supabase
  .from('project_images')
  .select('id, position, storage_path, alt, caption')
  .eq('project_id', id)
  .is('withdrawn_at', null)
  .order('position');

const { data: links } = await supabase
  .from('project_links')
  .select('id, label, url, visibility')
  .eq('project_id', id)
  .order('created_at');

const shownLinks = (links ?? []).filter((l: any) => l.visibility === 'published');
const video = parseVideo(project.video_url);
const mediaUrl = (path: string) => `/app/media/${path}`;
const firstPlace = (places ?? []).find((p: any) => p.programs?.showcase === 'private');

/* The cover's people, as the deliverables page names them. */
const coverAuthors = (project.project_authors ?? []).filter((a: any) => a.role === 'author' && a.users).map((a: any) => a.users.display_name);
const coverElders = (project.project_authors ?? []).filter((a: any) => a.role === 'officer' && !a.self_managed_at && a.users).map((a: any) => a.users.display_name);
const { data: coverSponsors } = await supabase
  .from('project_sponsors')
  .select('teacher_name, participations!inner(project_id)')
  .eq('participations.project_id', id)
  .is('superseded_at', null);
const coverSponsorNames = [...new Set((coverSponsors ?? []).map((x: any) => x.teacher_name).filter(Boolean))];
const coverProgram = ((firstPlace ?? (places ?? [])[0])?.programs ?? null) as any;

/* The part that writes itself (2.8), shown here too: the sections the
   class page assembles from this project's submitted deliverables, so
   the author sees on this page what the class sees, not just the two
   boxes they fill in by hand. Read by the same loader as the class page. */
const { data: showProgram } = firstPlace
  ? await supabase.from('programs').select('id, template_id').eq('id', firstPlace.program_id).maybeSingle()
  : { data: null };
const showTemplate = showProgram?.template_id ? (() => { try { return resolveProgram(showProgram.template_id, null); } catch { return null; } })() : null;
const assembled = showTemplate && firstPlace
  ? (await loadShowcases(supabase, showTemplate, firstPlace.program_id, [id!])).get(id!) ?? null
  : null;
const fmtDay = (d: string | null) => (d ? formatDate(String(d).slice(0, 10), 'short') : '');
/* Whether the Research Graphic has a question to start from. */
const { data: summaryRows } = await supabase
  .from('documents')
  .select('id, document_fields(field_id, value)')
  .eq('project_id', id)
  .eq('deliverable', 'project_summary')
  .limit(1);
const summaryDoc = (summaryRows ?? []).some((d: any) => (d.document_fields ?? []).some((f: any) => f.field_id === 'question' && String(f.value ?? '').trim()));
---

<Base title="My showcase" noindex={true}>
  <div class="wrap">
    <AppShell org={org} account={account} roles={roles} here="/app/" />

    <ProjectCover
      kick={coverProgram ? programTitle(coverProgram) : 'My showcase'}
      title={project.title}
      nav={{ projectId: project.id, programId: (firstPlace ?? (places ?? [])[0])?.program_id ?? null, showcase: true, here: 'showcase' }}
      rename={iAuthor ? { projectId: project.id, title: project.title } : undefined}
      people={[
        { label: coverAuthors.length === 1 ? 'Author' : 'Authors', value: coverAuthors.join(', ') || 'No authors' },
        ...(coverElders.length > 0 ? [{ label: coverElders.length === 1 ? staffWord(coverProgram) : staffWord(coverProgram, 'plural'), value: coverElders.join(', ') }] : []),
        ...(coverSponsorNames.length > 0 ? [{ label: coverSponsorNames.length === 1 ? 'Sponsor' : 'Sponsors', value: coverSponsorNames.join(', ') }] : []),
      ]}
    />
    <p class="lede-under">
      {shows.length > 0
        ? <>What the class sees on the {shows.map((g: any) => `${g.short_name ?? g.name} Showcase`).join(' and ')}. Change it as often as you like; there is nothing to approve.</>
        : 'This project is not in a class with a showcase, so there is nowhere for a card to appear yet.'}
    </p>

    <div id="outcome" tabindex="-1">
      {error && <p class="note" role="alert" style="margin-top:24px">{error}</p>}
      {note && !error && <p class="note" role="status" style="margin-top:24px">{note}</p>}
    </div>

    {shows.length > 0 && (
      <div class:list={['state', project.showcase_hidden ? 'is-hidden' : 'is-shown']}>
        <div>
          <b>{project.showcase_hidden ? 'Hidden from the class' : 'Shown to the class'}</b>
          <span>
            {project.showcase_hidden
              ? 'Your card is off the page. Everything you wrote is kept.'
              : 'Your card is on the page as it appears below.'}
          </span>
        </div>
        {iAuthor && (
          <form method="POST" action="#outcome">
            <input type="hidden" name="action" value={project.showcase_hidden ? 'show' : 'hide'} />
            <input type="hidden" name="summary" value={project.summary ?? ''} />
            <button class="btn btn-sm" type="submit">
              {project.showcase_hidden ? 'Show it again' : 'Hide it for now'}
            </button>
          </form>
        )}
        {shows.map((g: any) => (
          <a class="btn btn-sm" href={`/app/program/${g.id}/showcase/`}>Open the {g.short_name ?? g.name} Showcase</a>
        ))}
      </div>
    )}

    <div class="two">
      <section class="sec">
        <div class="sec-h"><b><span class="sec-n">01</span>In your words</b><span>up to 1200 characters</span></div>
        {iAuthor ? (
          <>
          <form method="POST" action="#outcome" class="sform">
            <input type="hidden" name="action" value="save" />
            <input type="hidden" name="hidden" value={project.showcase_hidden ? '1' : '0'} />
            <label for="summary" class="skip">Summary</label>
            <textarea class="ta" id="summary" name="summary" rows="7" maxlength="1200">{project.summary ?? ''}</textarea>
            <p class="help">
              What it is, who it is for, and where you are with it. Plain words;
              the class is reading, not a judge. You can rewrite it every week.
            </p>
            <p><button class="btn" type="submit">Save</button></p>
          </form>
          {/* Offered only once there is something to start from (2.9): the
              button used to be there from day one and answered "nothing in
              it yet", which is a click that does nothing. */}
          {iAuthor && summaryDoc && (
            <form method="POST" action="#outcome" class="sform" style="margin-top:8px">
              <input type="hidden" name="action" value="from_summary" />
              <input type="hidden" name="hidden" value={project.showcase_hidden ? '1' : '0'} />
              <p class="help">Or start from what you already wrote: <button class="btn btn-sm btn-2" type="submit">Use my Research Graphic</button></p>
            </form>
          )}
          </>
        ) : (
          <p>{project.summary ?? <i>No summary yet.</i>}</p>
        )}
      </section>

      <section class="sec">
        <div class="sec-h"><b><span class="sec-n">02</span>Pictures and video</b><span>{(images ?? []).length} of 4</span></div>
        {(images ?? []).length > 0 ? (
          <ul class="shots">
            {(images ?? []).map((img: any) => (
              <li>
                <img src={mediaUrl(img.storage_path)} alt={img.alt ?? ''} loading="lazy" />
                {img.caption && <p>{img.caption}</p>}
                {iAuthor && (
                  <form method="POST" action="#outcome">
                    <input type="hidden" name="action" value="image_remove" />
                    <input type="hidden" name="image_id" value={img.id} />
                    <button class="btn btn-q" type="submit">Remove</button>
                  </form>
                )}
              </li>
            ))}
          </ul>
        ) : (
          <p class="t-sm">No pictures yet. The first one becomes the card's picture. Four is the limit.</p>
        )}

        {iAuthor && (images ?? []).length < 4 && (
          <form method="POST" action="#outcome" enctype="multipart/form-data" class="mform" style="margin-top:18px">
            <input type="hidden" name="action" value="image" />
            <label>
              <span>Image</span>
              <input class="in" type="file" name="image" accept="image/*" required />
            </label>
            <div class="row-2">
              <label>
                <span>Caption</span>
                <input class="in" name="caption" required />
                <small>What it shows, in a line.</small>
              </label>
              <label>
                <span>Alt text</span>
                <input class="in" name="alt" required />
                <small>For somebody who cannot see it. Describe the content, not the fact that it is a photograph.</small>
              </label>
            </div>
            <button class="btn" type="submit">Add the image</button>
          </form>
        )}

        <h3 class="sub-h">Video</h3>
        {video ? (
          <p class="t-sm">
            {video.host === 'vimeo' ? 'Vimeo' : 'YouTube'}, saved. <a href={video.watch} target="_blank" rel="noopener noreferrer">Watch it there</a>.
          </p>
        ) : project.video_url ? (
          <p class="t-sm">That address is saved and is not one we can show. YouTube and Vimeo only, and it has to start with https.</p>
        ) : null}
        {iAuthor && (
          <form method="POST" action="#outcome" class="mform">
            <input type="hidden" name="action" value="video" />
            <label>
              <span>Address</span>
              <input class="in" name="video_url" value={project.video_url ?? ''} />
              <small>One, on YouTube or Vimeo. Leave it empty to remove the one that is there.</small>
            </label>
            <button class="btn" type="submit">Save the video</button>
          </form>
        )}
        {shownLinks.length > 0 && (
          <p class="t-sm">
            Links shown: {shownLinks.map((l: any) => l.label).join(', ')}
          </p>
        )}
      </section>
    </div>

    {assembled && (
      <div class="assembled">
        <p class="lede-under">
          The rest of the page writes itself. Each deliverable you submit becomes a section below, the moment you submit it, and the class sees the same sections{assembled.total > 0 ? ` (${assembled.have} of ${assembled.total} so far)` : ''}.
        </p>
        <ShowcaseSections sections={assembled.sections} coming={assembled.coming} mediaUrl={mediaUrl} fmt={fmtDay} from={3} mine={iAuthor} />
      </div>
    )}
  </div>
</Base>

<style>
  .assembled { margin-top: 36px; }
  .state {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px 20px;
    margin: 26px 0 0;
    padding: 18px 22px;
    background: var(--card);
    border: 1px solid var(--rule);
    border-left: 8px solid var(--stage-comp);
    box-shadow: var(--lift);
  }
  .state.is-hidden { border-left-color: var(--ink-3); background: var(--sunk); }
  .state > div { flex: 1 1 24ch; }
  .state b {
    display: block;
    font-family: var(--face-num);
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--stage-comp);
    margin-bottom: 3px;
  }
  .state.is-hidden b { color: var(--ink-3); }
  .state span { font-size: 0.95rem; color: var(--ink-2); }
  .state form { margin: 0; }

  .lede-under { margin: 18px 0 0; color: var(--ink-2); max-width: var(--measure-text); }
  .two { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 0 32px; }
  .sform { max-width: var(--measure-form); }
  .sform .ta { resize: vertical; }

  .shots { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, 1fr); gap: 12px; }
  .shots img { display: block; width: 100%; aspect-ratio: 4 / 3; object-fit: cover; border: 1px solid var(--rule); }
  .shots p { margin: 4px 0 0; font-size: 0.86rem; color: var(--ink-2); }
  .shots form { margin: 4px 0 0; }
  .sub-h { margin: 34px 0 10px; font-family: var(--face-ui); font-size: 0.82rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-2); }
</style>
