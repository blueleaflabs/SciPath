---
export const prerender = false;

import Base from '../../layouts/Base.astro';
import AppShell from '../../components/AppShell.astro';
import { serverClient } from '../../lib/supabase';
import { activeOrg } from '../../lib/tenant';
import { standing } from '../../lib/roles';
import { resolveProgram } from '../../lib/templates';
import { formatDate } from '../../lib/dates';
import { afterPost, outcomeFrom } from '../../lib/post-redirect';
import { signInWith } from '../../lib/next-path';

/**
 * WHAT THIS CLUB HAS LEARNED.
 *
 * Not where somebody reads this for the first time — that happens on the
 * step, at the moment they are about to do the thing. This page has two
 * narrower jobs, and they are the ones that keep the knowledge honest.
 *
 * **Reading it before a season starts.** An officer taking over in September
 * can read what the last four cohorts found out, in the order the work
 * happens.
 *
 * **The handover.** Last year's warnings are re-read and confirmed, or they
 * go quiet. Sixty percent of a club turns over every year (12.6), and
 * knowledge that is inherited without being re-read becomes folklore: true
 * once, repeated since, attached to a teacher who left.
 */

const { session, account, roles } = Astro.locals;
const org = activeOrg(Astro);

/* Remembering where they were headed, so a link from a notification
   survives the sign in it triggers (20.10). */
if (!session) return Astro.redirect(signInWith(Astro.url));
if (!account) return Astro.redirect('/app/welcome/');

const me = standing(roles, account?.population);

const supabase = serverClient(
  Astro.request,
  Astro.cookies,
  (Astro.locals as any).runtime?.env
);

/* Seeded from the redirect a POST answers with, not from the POST
   itself. See src/lib/post-redirect.ts. */
let { error: error, note: done } = outcomeFrom(Astro.url);

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const id = String(form.get('warning_id') ?? '');
  const what = String(form.get('what') ?? '');

  const patch =
    what === 'retire'
      ? { retired_at: new Date().toISOString(), retired_by: account.id }
      : { confirmed_at: new Date().toISOString(), confirmed_by: account.id };

  const { error: e } = await supabase.from('step_warnings').update(patch).eq('id', id);

  if (e) error = e.message;
  else done = what === 'retire' ? 'Retired. It is kept, not deleted.' : 'Confirmed for this season.';

  /* A refresh should re-read this page, not send the form again. */
  return afterPost(Astro.url, { error: error, note: done });
}

const { data: programs } = await supabase
  .from('programs')
  .select('id, name, season_year, kind, template_id, phases')
  .eq('status', 'open')
  .order('name');

const { data: warnings, error: readError } = await supabase
  .from('step_warnings')
  .select(
    'id, program_id, step_id, body, created_at, confirmed_at, retired_at, users:written_by(display_name)'
  )
  .order('created_at', { ascending: false });

if (readError) error = readError.message;

const live = (warnings ?? []).filter((w: any) => !w.retired_at);
const retired = (warnings ?? []).filter((w: any) => w.retired_at);

/**
 * Grouped by program, then by the phase the step belongs to.
 *
 * In the order the work happens rather than the order they were written,
 * because somebody reading this in September is reading it as a sequence.
 */
const byProgram = (programs ?? []).map((program: any) => {
  let steps: any[] = [];
  let phases: any[] = program.phases ?? [];

  try {
    if (program.template_id) steps = resolveProgram(program.template_id).steps;
  } catch {
    /* A template that has been removed. The warnings still exist and are
       shown under the phase they cannot be placed in, rather than vanishing. */
  }

  const here = live.filter((w: any) => w.program_id === program.id);
  const stepFor = (id: string) => steps.find((s) => s.id === id);

  const groups = phases
    .map((phase: any) => ({
      name: phase.name ?? phase.id,
      rows: here.filter((w: any) => stepFor(w.step_id)?.phase === phase.id),
    }))
    .filter((g: any) => g.rows.length > 0);

  const orphans = here.filter((w: any) => !stepFor(w.step_id));
  if (orphans.length > 0) {
    groups.push({ name: 'Steps that no longer exist', rows: orphans });
  }

  return { program, groups, count: here.length, stepFor };
});

const unconfirmed = live.filter((w: any) => !w.confirmed_at).length;

const fmt = (d: string | null) => formatDate(d, 'short');

---

<Base title="What this club has learned" noindex={true}>
  <div class="wrap">
    <AppShell org={org} account={account} roles={roles} here="/app/warnings/" />

    <section class="hero">
      <p class="t-lbl">Written by officers, on the step it belongs to</p>
      <h1 class="t-big">What goes wrong</h1>
      <p class="lede">
        What this club has found out, in the order the work happens. Students
        meet these one at a time, on the thing they are about to do. This page
        is for reading the lot before a season starts, and for deciding at
        handover which of them are still true.
      </p>
    </section>

    <div id="outcome" tabindex="-1">
      {error && <p class="note" role="alert">{error}</p>}
      {done && !error && <p class="note" role="status">{done}</p>}
    </div>

    {unconfirmed > 0 && me.runsTheClub && (
      <p class="note">
        {unconfirmed} {unconfirmed === 1 ? 'warning has' : 'warnings have'} not
        been confirmed this season. Confirming one means somebody who is here
        now has read it and thinks it still holds.
      </p>
    )}

    {byProgram.map(({ program, groups, count }) => (
      <section class="sec">
        <div class="sec-h">
          <b>{program.name}</b>
          <span>{count === 0 ? 'nothing written yet' : `${count} written`}</span>
        </div>

        {groups.length === 0 ? (
          <p class="t-sm">
            Nothing yet. These get written on a project's deliverables, by an
            officer who has just watched something go wrong.
          </p>
        ) : (
          groups.map((group: any) => (
            <div class="phase-block">
              <h3 class="sub-h">{group.name}</h3>

              <ul class="wlist">
                {group.rows.map((w: any) => (
                  <li class:list={['w', !w.confirmed_at && 'stale']}>
                    <p class="w-body">{w.body}</p>
                    <p class="w-who">
                      {w.users?.display_name ?? 'An officer'} · {fmt(w.created_at)}
                      {w.confirmed_at
                        ? ` · confirmed ${fmt(w.confirmed_at)}`
                        : ' · not confirmed this season'}
                    </p>

                    {me.runsTheClub && (
                      <form method="POST" action="#outcome" class="w-do">
                        <input type="hidden" name="warning_id" value={w.id} />
                        {!w.confirmed_at && (
                          <button class="btn btn-sm" name="what" value="confirm" type="submit">
                            Still true
                          </button>
                        )}
                        <button class="btn btn-q btn-sm" name="what" value="retire" type="submit">
                          Retire it
                        </button>
                      </form>
                    )}
                  </li>
                ))}
              </ul>
            </div>
          ))
        )}
      </section>
    ))}

    {retired.length > 0 && (
      <section class="sec">
        <div class="sec-h"><b>Retired</b><span>{retired.length}</span></div>
        <p class="t-sm">
          Kept rather than deleted. A warning that stopped being true is a
          record of something that used to be, and somebody will eventually
          want to know why it went.
        </p>
        <ul class="wlist quiet">
          {retired.map((w: any) => (
            <li class="w">
              <p class="w-body">{w.body}</p>
              <p class="w-who">
                {w.users?.display_name ?? 'An officer'} · written {fmt(w.created_at)} ·
                retired {fmt(w.retired_at)}
              </p>
            </li>
          ))}
        </ul>
      </section>
    )}
  </div>
</Base>

<style>
  .phase-block { margin-bottom: 26px; }
  .sub-h {
    margin: 0 0 10px;
    font-family: var(--face-ui);
    font-size: 1rem;
    font-weight: 600;
  }

  .wlist { list-style: none; margin: 0; padding: 0; max-width: 74ch; }

  .w {
    padding: 12px 0 12px 14px;
    border-left: 2px solid var(--rule);
    border-bottom: 1px solid var(--rule-fine);
  }

  /* Unconfirmed reads quieter rather than louder. It is not wrong, it is
     unreviewed, and shouting about it would spend attention on the wrong
     thing. */
  .w.stale { border-left-color: var(--rule-fine); }
  .w.stale .w-body { color: var(--ink-2); }

  .w-body { margin: 0; font-size: 0.98rem; line-height: 1.5; }

  .w-who {
    margin: 4px 0 0;
    font-family: var(--face-mono);
    font-size: 0.78rem;
    color: var(--ink-3);
  }

  .w-do { display: flex; gap: 8px; margin-top: 8px; }

  .wlist.quiet .w-body { color: var(--ink-3); }
</style>
