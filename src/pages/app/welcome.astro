---
export const prerender = false;

import Base from '../../layouts/Base.astro';
import { serverClient } from '../../lib/supabase';
import { adminClient } from '../../lib/supabase-admin';
import { activeOrg } from '../../lib/tenant';
import { afterPost, outcomeFrom, leaveTo } from '../../lib/post-redirect';
import { signInWith } from '../../lib/next-path';

const { session, account, orgSlug } = Astro.locals;
const org = activeOrg(Astro) as any;

/* Remembering where they were headed, so a link from a notification
   survives the sign in it triggers (20.10). */
if (!session) return Astro.redirect(signInWith(Astro.url));
if (account) return Astro.redirect('/app/');

const openProgram = org?.signupMode === 'open';

/* The database is the enforcement; this is so a person finds out before
   filling in a form rather than after. A tenant that lists domains accepts
   only those domains, whatever Google was willing to authenticate. */
const emailDomain = (session.email ?? '').split('@')[1]?.toLowerCase() ?? '';
const allowedDomains = (org?.verifiedDomains ?? []) as string[];
const domainRefused =
  org?.signupMode === 'domain' && !allowedDomains.includes(emailDomain);

/* Sign out on the spot. Leaving someone signed in to an account that cannot
   be used here, and asking them to sign themselves out, is two steps of
   nothing. The message survives because the address was already read. */
if (domainRefused) {
  const supabase = serverClient(
    Astro.request,
    Astro.cookies,
    (Astro.locals as any).runtime?.env
  );
  await supabase.auth.signOut();
}

const year = new Date().getFullYear();
const gradYears = [year, year + 1, year + 2, year + 3, year + 4];

/* Seeded from the redirect a POST answers with. See
   src/lib/post-redirect.ts. */
let { error: error, refused: refusedFromUrl } = outcomeFrom(Astro.url);
let sent: Record<string, string> = {};
let refused = refusedFromUrl;

if (Astro.request.method === 'POST') {
  /* One client for the whole handler. It used to be built inside the branch
     that succeeds, which was fine until the refusal branch needed to sign
     somebody out. */
  const supabase = serverClient(
    Astro.request,
    Astro.cookies,
    (Astro.locals as any).runtime?.env
  );

  const form = await Astro.request.formData();
  for (const [k, v] of form.entries()) sent[k] = String(v);
  const ageBand = String(form.get('age_band') ?? '');
  const guardianEmail = String(form.get('guardian_email') ?? '').trim();
  const gradYear = String(form.get('grad_year') ?? '');

  if (ageBand === 'under_13') {
    /* A refusal, not a correction. Carried separately from `error` because
       the page has to render it differently: everything else on this form is
       something to fix and try again, and this is the one answer that ends
       the signup. Told apart here rather than by matching the sentence,
       which is how a message becomes load-bearing.
    
       **And "nothing has been saved" is made true here.** By the time this
       page runs, Google or a password has already created a row in
       `auth.users`: the age question is asked after the sign-in, because
       there is nowhere to ask it before. Refusing and leaving that row
       behind means a twelve year old has an authentication record at a
       service that has just told them it kept nothing — and can sign in
       again tomorrow and be walked through the same form.
    
       So the identity is deleted with the admin client, the result is
       checked rather than assumed, and they are signed out. There is no
       row in `public.users` yet, so there is nothing else to remove. */
    refused = true;

    const uid = session?.id ?? null;

    if (uid) {
      try {
        const admin = adminClient((Astro.locals as any).runtime?.env);
        const { error: gone } = await admin.auth.admin.deleteUser(uid);

        /* Logged without the address, the name or the id. What is worth
           recording is that a refusal failed to clean up; who it was is
           precisely the thing that should not be written down about a child
           this service has just declined. */
        if (gone) console.error('under-13 refusal: identity was not removed');
      } catch {
        console.error('under-13 refusal: identity removal raised');
      }
    }

    await supabase.auth.signOut();
  } else if (ageBand === '13_17' && !guardianEmail) {
    error = 'A parent or guardian email is required.';
  } else {
    const { error: rpcError } = await supabase.rpc('complete_signup', {
      p_org_slug: orgSlug,
      p_display_name: String(form.get('display_name') ?? '').trim(),
      p_age_band: ageBand,
      p_grad_year: gradYear ? Number(gradYear) : null,
      p_guardian_name: String(form.get('guardian_name') ?? '').trim() || null,
      p_guardian_email: guardianEmail || null,

      /* Sent only where the form rendered them, and refused server side
         anyway if a school tenant ever receives them. See the note above
         `public.users`. */
      p_school_name: openProgram
        ? String(form.get('school_name') ?? '').trim() || null
        : null,
      p_school_runs_a_fair: openProgram
        ? String(form.get('school_runs_a_fair') ?? '') || null
        : null,
      p_entered_before: openProgram
        ? form.get('entered_before') === 'yes'
          ? true
          : form.get('entered_before') === 'no'
            ? false
            : null
        : null,
    });

    if (rpcError) error = rpcError.message;
    else return leaveTo('/app/');
  }

  /* A refresh should re-read this page, not send the form again. */
  return afterPost(Astro.url, refused ? { refused: true } : { error: error });
}

const suggestedName = sent.display_name ?? session.email?.split('@')[0] ?? '';
const band = sent.age_band ?? '';
---

<Base title="Finish signing up" noindex={true}>
  <div class="wrap">
  <section class="stack">
    <p class="eyebrow">{org?.name}</p>
    <h1>Finish signing up</h1>

    {/* Anchored, and every form on this page posts to it. These pages
        run to several screens, and an outcome rendered at the top after
        a click three screens down reads as nothing having happened. */}
    <div id="outcome" tabindex="-1">
    {error && <p class="note" role="alert">{error}</p>}
    </div>

    {/* THE ONE ANSWER THAT IS NOT A CORRECTION.
    
        Under 13 rendered as an ordinary validation error: a tinted strip
        sized to its own sentence, inside a box it did not fill, in the same
        type as "a parent or guardian email is required". Everything else on
        this form is something to fix and try again. This is not, and
        rendering it as though it were invites somebody to go back and pick a
        different birthday.
    
        So it is the whole panel, in the size of a heading, and the form
        below it goes away. Nothing to correct means nothing to correct. */}
    {refused ? (
      <div class="refusal" role="alert">
        <p>This platform is for students aged 13 and over.</p>
        <p class="after">
          Come back when you are 13. Nothing has been saved, and your school
          account is untouched.
        </p>
      </div>
    ) : domainRefused ? (
      <div class="note" role="alert">
        <h4>That account cannot be used here</h4>
        <p>
          You signed in as <b>{session.email}</b>. {org?.name} accepts accounts
          on {allowedDomains.map((d, i) => (
            <>{i > 0 && <span> or </span>}<b>{d}</b></>
          ))} only.
        </p>
        <p style="margin-top:12px">
          You have been signed out. Sign in again with your school account.
        </p>
        <p style="margin-top:14px">
          <a class="btn" href="/auth/signin/">Sign in with Google</a>
        </p>
      </div>
    ) : (
    <form method="POST" action="#outcome" class="stack">
      {/* "Your name, as it should appear on a byline" explained a consequence
          to somebody who has not published anything and may not know what a
          byline is. It is asking for a name. The consequence is true and
          belongs where it applies: on the profile, where somebody editing a
          name they already have is deciding whether to change it. */}
      <label>
        <span>Your full name</span>
        <input name="display_name" required value={suggestedName} autocomplete="name" />
      </label>

      <fieldset>
        <legend>Current age <i class="req">*</i></legend>
        <label><input type="radio" name="age_band" value="under_13" required checked={band === 'under_13'} /> Under 13</label>
        <label><input type="radio" name="age_band" value="13_17" checked={band === '13_17'} /> 13 to 17</label>
        <label><input type="radio" name="age_band" value="18_plus" checked={band === '18_plus'} /> 18 or older</label>
      </fieldset>

      <label>
        <span>Graduation year</span>
        <select name="grad_year">
          <option value="">Not a student</option>
          {gradYears.map((y) => (
            <option value={y} selected={sent.grad_year === String(y)}>{y}</option>
          ))}
        </select>
      </label>

      <fieldset id="guardian" data-needed={band === '13_17' ? 'yes' : undefined}>
        <legend>Parent or guardian</legend>
        <p class="skipnote"><b>Not needed if you are 18 or older.</b></p>
        <p class="fine">
          If you are under 18, parent or guardian consent is required for
          publishing.
        </p>
        <label>
          <span>Their name <i class="req">*</i></span>
          <input name="guardian_name" value={sent.guardian_name ?? ''} autocomplete="off" />
        </label>
        <label>
          <span>Their email <i class="req">*</i></span>
          <input name="guardian_email" type="email" value={sent.guardian_email ?? ''} autocomplete="off" />
        </label>
      </fieldset>

      {/* **THE THREE AN OPEN TENANT ASKS.**
      
          A school knows which school it is from the hostname and must not ask.
          Here there is no domain and no district, so the school is a claim,
          and these are the only three worth the moment an account is created.
      
          Not asked here, deliberately, and both were on an earlier draft of
          this list. A **zip code** was going to narrow a fair search, but a
          fair belongs to a project rather than to a person and the relevant
          zip is the school's; it is asked where a fair is chosen. A **teacher
          sponsor** is named on the project, per 1.18, because affiliation is
          per participation and one student may have three different teachers
          across three programs.
      
          Nothing here is a protected attribute. Whether a school is Title I,
          and whether it has ever appeared in a fair's results, are both
          looked up from the name afterwards and are facts about a school. */}
      {openProgram && (
        <fieldset>
          <legend>Your school</legend>

          <label>
            <span>School name</span>
            <input
              name="school_name"
              value={sent.school_name ?? ''}
              autocomplete="organization"
            />
          </label>

          {/* `not_sure` is an answer rather than a missing one. A student
              who does not know is telling you nobody has told them, which is
              the single most useful thing this form learns.
             
              The hint sits inside the label rather than as a sibling
              paragraph. Between two fields it read as an introduction to the
              next one; attached, it explains the control above it. */}
          <label>
            <span>Does your school hold its own science fair?</span>
            <select name="school_runs_a_fair">
              <option value="">Choose one</option>
              <option value="yes" selected={sent.school_runs_a_fair === 'yes'}>Yes</option>
              <option value="no" selected={sent.school_runs_a_fair === 'no'}>No</option>
              <option value="not_sure" selected={sent.school_runs_a_fair === 'not_sure'}>
                I am not sure
              </option>
            </select>
            <span class="hint">
              Some fairs take an entry straight from a student where the school
              holds a fair of its own, and some ask the student to come through
              it. Knowing in August is worth a lot more than knowing in January.
            </span>
          </label>

          <label>
            <span>Have you entered a science fair before?</span>
            <select name="entered_before">
              <option value="">Choose one</option>
              <option value="yes" selected={sent.entered_before === 'yes'}>Yes</option>
              <option value="no" selected={sent.entered_before === 'no'}>No</option>
            </select>
          </label>
        </fieldset>
      )}

      <div class="finish">
        <button class="btn" type="submit">Create my account</button>
        <ul class="terms">
          <li><i class="req">*</i> required</li>
          <li>Publishing requires approval of a parent or guardian.</li>
        </ul>
      </div>
    </form>
    )}
  </section>
  </div>
</Base>

<script>
  /* Required only when it applies. The server refuses a minor with no
     guardian address, and being told that after submitting is a worse way to
     learn it than the field being required at the moment it becomes so. */
  const guardian = document.getElementById('guardian');
  const bands = document.querySelectorAll('input[name="age_band"]');
  const guardianFields = guardian ? guardian.querySelectorAll('input') : [];

  function syncGuardian() {
    const chosen = document.querySelector<HTMLInputElement>('input[name="age_band"]:checked');
    const minor = chosen && chosen.value === '13_17';

    if (guardian) guardian.dataset.needed = minor ? 'yes' : '';
    guardianFields.forEach((field) => {
      field.required = Boolean(minor);
    });
  }

  bands.forEach((band) => band.addEventListener('change', syncGuardian));
  syncGuardian();
</script>

<style>
  /* **ONE SHAPE FOR EVERY FIELD.**
  
     `form fieldset > label` was `display: flex; align-items: center`, written
     for the three radio buttons in the age band and correct for them. It
     matched every direct label in every fieldset, so the moment a text box or
     a dropdown went inside one it laid the question beside the control at
     whatever width the words happened to occupy — a different left edge per
     row, and none of them aligned with the fields outside the fieldset that
     were still stacked.
  
     The rule now matches what it was written for. Everything that is not a
     radio gets the same stack: question above, control below, one width, one
     rhythm. Inside a fieldset and outside it are the same, which is the
     property that makes a long form scannable. */
  form.stack { max-width: 52ch; }

  form label { display: block; margin-bottom: 18px; }
  form label:last-child { margin-bottom: 0; }

  /* The question, and it reads as one. 500 rather than 600: these sit above
     every control on the page and bold at that density becomes stripes. */
  form label > span {
    display: block;
    margin-bottom: 6px;
    font-family: var(--face-ui);
    font-size: 0.94rem;
    font-weight: 500;
    color: var(--ink);
    line-height: 1.35;
  }

  form input,
  form select {
    width: 100%;
    padding: 10px 12px;
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    background: var(--card);
    color: var(--ink);
    font: inherit;
  }

  /* A native select is a different height from a text input at the same
     padding, which is visible the moment one sits under the other. */
  form select { height: calc(1lh + 22px); }

  form fieldset {
    border: 1px solid var(--rule-fine);
    border-radius: var(--radius);
    padding: 18px 20px 20px;
    margin: 0 0 20px;
  }

  /* Heavier than the questions inside it, so a section reads as a section.
     Every fieldset on this page carries one and they are the only headings
     the form has. */
  form legend {
    font-family: var(--face-ui);
    font-size: 0.94rem;
    font-weight: 700;
    letter-spacing: 0.01em;
    padding: 0 6px;
  }

  /* Radios only. This is the rule the one above used to be. */
  form fieldset > label:has(input[type='radio']) {
    display: flex;
    align-items: center;
    gap: 4px;
    margin-bottom: 8px;
    font-weight: 400;
  }
  form fieldset label input[type='radio'] { width: auto; margin-right: 8px; }

  /* Attached to the control it explains, rather than floating between two
     fields where it reads as belonging to the next one. */
  .hint {
    display: block;
    margin-top: 6px;
    font-family: var(--face-ui);
    font-size: 0.86rem;
    font-weight: 400;
    color: var(--ink-3);
    line-height: 1.4;
  }

  .fine { color: var(--ink-3); font-size: 0.9rem; margin-top: 10px; }
  .finish { display: flex; flex-wrap: wrap; gap: 20px; align-items: center; margin-top: 6px; }
  .terms { margin: 0; padding-left: 1.1rem; color: var(--ink-3); font-size: 0.92rem; }
  .req { color: var(--alert); font-style: normal; }

  /* THE REFUSAL.
  
     The fill is the panel, not the sentence. As an ordinary error this was a
     tinted strip the width of its own text, floating inside a bordered box
     that stayed empty to the right — which reads as a rendering fault and
     makes the most important sentence on the page look like a footnote.
  
     Sized like a heading because it is the answer, and left aligned at the
     measure of the form it replaced, so the page does not lurch when the
     form disappears. */
  .refusal {
    max-width: 52ch;
    padding: 22px 24px;
    background: var(--alert-bg);
    border: 1px solid var(--alert);
  }
  .refusal p {
    margin: 0;
    font-size: 1.5rem;
    font-weight: 700;
    line-height: 1.25;
    letter-spacing: -0.01em;
  }
  .refusal .after {
    margin-top: 14px;
    font-family: var(--face-ui);
    font-size: 0.98rem;
    font-weight: 400;
    color: var(--ink-2);
  }

  /* The guardian fields matter only for someone under 18, so the asterisks
     are hidden until the age band says otherwise rather than marking a
     field required that half the people filling this in should skip. */
  #guardian .req { display: none; }
  #guardian[data-needed='yes'] .req { display: inline; }
  .terms li { margin-bottom: 3px; }
  .skipnote { margin: 0 0 8px; font-family: var(--face-ui); font-size: 0.94rem; }
  form button { padding: 10px 18px; border: 1px solid var(--ink); background: var(--ink); color: var(--paper); font-family: var(--face-ui); font-size: 1rem; font-weight: 600; cursor: pointer; }
</style>
