---
export const prerender = false;

import Base from '../../layouts/Base.astro';
import AppShell from '../../components/AppShell.astro';
import { activeOrg } from '../../lib/tenant';
import { serverClient } from '../../lib/supabase';
import { standing, selectionLabel } from '../../lib/roles';
import { checkDateOrder, worstFinding } from '../../lib/dateOrder';

const { session, account, roles } = Astro.locals;
const org = activeOrg(Astro);

if (!session) return Astro.redirect('/app/');
if (!account) return Astro.redirect('/app/welcome/');

const me = standing(roles, account?.population);
if (!me.isAdvisor) return Astro.redirect('/app/');

const supabase = serverClient(
  Astro.request,
  Astro.cookies,
  (Astro.locals as any).runtime?.env
);

let error: string | null = null;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const { error: e } = await supabase.rpc('set_selection', {
    p_entry_id: String(form.get('entry_id') ?? ''),
    p_state: String(form.get('state') ?? 'candidate'),
    p_note: String(form.get('note') ?? '') || null,
  });
  if (e) error = e.message;
}

const today = new Date().toISOString().slice(0, 10);
const filter = Astro.url.searchParams.get('show') ?? 'all';

const { data: entries } = await supabase
  .from('entries')
  .select('id, selection_state, selection_decided_at, project_id, programs(name, season_year, selection_cap), projects(id, title, started_on, stage, project_authors(role, self_managed_at, users(id, display_name)))')
  .order('entered_at', { ascending: true });

const entryIds = (entries ?? []).map((e: any) => e.id);
const projectIds = (entries ?? []).map((e: any) => e.project_id);

const { data: milestones } = entryIds.length
  ? await supabase
      .from('entry_milestones')
      .select('id, entry_id, name, due_on, required, blocks_experimentation, completed_on')
      .in('entry_id', entryIds)
  : { data: [] as any[] };

const { data: sponsors } = projectIds.length
  ? await supabase
      .from('project_sponsors')
      .select('project_id, teacher_name, confirmed_at')
      .in('project_id', projectIds)
      .is('superseded_at', null)
  : { data: [] as any[] };

const rows = (entries ?? []).map((e: any) => {
  const mine = (milestones ?? []).filter((m: any) => m.entry_id === e.id);
  const project = e.projects;

  const findings = checkDateOrder({
    startedOn: project?.started_on,
    today,
    obligations: mine.map((m: any) => ({
      id: m.id,
      name: m.name,
      dueOn: m.due_on,
      completedOn: m.completed_on,
      blocksExperimentation: m.blocks_experimentation,
      required: m.required,
    })),
  });

  const attachments = project?.project_authors ?? [];

  return {
    entry: e,
    project,
    authors: attachments.filter((a: any) => a.role === 'author'),
    officers: attachments.filter((a: any) => a.role === 'officer'),
    selfManaged: attachments.filter((a: any) => a.role === 'author' && a.self_managed_at),
    sponsor: (sponsors ?? []).find((s: any) => s.project_id === e.project_id) ?? null,
    done: mine.filter((m: any) => m.completed_on).length,
    total: mine.length,
    worst: worstFinding(findings),
  };
});

const shown = rows.filter((r) => {
  if (filter === 'no_officer') return r.officers.length === 0 && r.selfManaged.length === 0;
  if (filter === 'no_sponsor') return !r.sponsor;
  if (filter === 'flagged') return r.worst?.severity === 'disqualifying';
  if (filter === 'selected') return r.entry.selection_state === 'selected';
  return true;
});

const selected = rows.filter((r) => r.entry.selection_state === 'selected').length;
const cap = (entries ?? [])[0]?.programs?.selection_cap ?? null;

const filters = [
  ['all', 'Everything'],
  ['selected', 'Selected'],
  ['no_officer', 'No officer'],
  ['no_sponsor', 'No sponsor'],
  ['flagged', 'Disqualifying'],
];

const fmt = (d: string | null) =>
  d ? new Date(d).toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) : '—';
---

<Base title="Selection" noindex={true}>
  <div class="wrap">
    <AppShell org={org} account={account} roles={roles} here="/app/selection/" />

    <section class="hero" style="padding-top:0">
      <p class="t-lbl">Teacher club advisor</p>
      <h1 class="t-big">Which projects go forward</h1>
      <p class="lede">
        Every project the club is running, with what is done and what is
        missing. Selection is yours; the decision is recorded with a date.
      </p>

      <div class="counts">
        <div><b>{rows.length}</b><span>projects</span></div>
        <div><b>{selected}{cap ? ` of ${cap}` : ''}</b><span>selected</span></div>
        <div><b>{rows.filter((r) => !r.sponsor).length}</b><span>no sponsor</span></div>
        <div><b>{rows.filter((r) => r.officers.length === 0 && r.selfManaged.length === 0).length}</b><span>no officer</span></div>
        <div><b>{rows.filter((r) => r.worst?.severity === 'disqualifying').length}</b><span>disqualifying</span></div>
      </div>
    </section>

    {error && <p class="note" role="alert">{error}</p>}

    <section class="sec">
      <div class="sec-h">
        <b>Projects</b>
        <span>
          {filters.map(([key, label], i) => (
            <>
              {i > 0 && ' · '}
              <a href={`/app/selection/?show=${key}`} class={filter === key ? 'on' : ''}>{label}</a>
            </>
          ))}
        </span>
      </div>

      <table class="tbl">
        <thead>
          <tr>
            <th scope="col">Project</th>
            <th scope="col">Students</th>
            <th scope="col">Officer</th>
            <th scope="col">Sponsor</th>
            <th scope="col">Obligations</th>
            <th scope="col">Standing</th>
            <th scope="col">Selection</th>
          </tr>
        </thead>
        <tbody>
          {shown.map((r) => (
            <tr class={r.worst?.severity === 'disqualifying' ? 'row-bad' : ''}>
              <td><a href={`/app/project/${r.project?.id}/`}>{r.project?.title}</a></td>
              <td>{r.authors.map((a: any) => a.users?.display_name).join(', ') || '—'}</td>
              <td>
                {r.officers.length > 0
                  ? r.officers.map((a: any) => a.users?.display_name).join(', ')
                  : r.selfManaged.length > 0
                    ? <>{r.selfManaged.map((a: any) => a.users?.display_name).join(', ')}<span class="sub">self-managed</span></>
                    : <span class="miss">none</span>}
              </td>
              <td>
                {r.sponsor
                  ? <>{r.sponsor.teacher_name}{!r.sponsor.confirmed_at && <span class="sub">self-reported</span>}</>
                  : <span class="miss">none named</span>}
              </td>
              <td>{r.total ? `${r.done} of ${r.total}` : '—'}</td>
              <td>{r.worst ? r.worst.name : 'In order'}</td>
              <td>
                <form method="POST" class="inline">
                  <input type="hidden" name="entry_id" value={r.entry.id} />
                  <select name="state">
                    <option value="candidate" selected={r.entry.selection_state === 'candidate'}>Under consideration</option>
                    <option value="selected" selected={r.entry.selection_state === 'selected'}>Selected</option>
                    <option value="not_selected" selected={r.entry.selection_state === 'not_selected'}>Not selected</option>
                    <option value="withdrawn" selected={r.entry.selection_state === 'withdrawn'}>Withdrawn</option>
                  </select>
                  <button type="submit">Set</button>
                </form>
                {r.entry.selection_decided_at && (
                  <span class="sub">{fmt(r.entry.selection_decided_at)}</span>
                )}
              </td>
            </tr>
          ))}
        </tbody>
      </table>

      {shown.length === 0 && <p class="t-sm" style="margin-top:16px">Nothing matches that filter.</p>}
    </section>
  </div>
</Base>

<style>
  .hero { padding: 44px 0 28px; max-width: 74ch; }
  .hero .t-lbl { margin-bottom: 14px; }
  .counts { display: flex; flex-wrap: wrap; margin-top: 26px; border-top: 1px solid var(--rule); border-bottom: 1px solid var(--rule); }
  .counts > div { padding: 14px 22px 14px 0; margin-right: 22px; border-right: 1px solid var(--rule-fine); }
  .counts > div:last-child { border-right: 0; margin-right: 0; }
  .counts b { display: block; font-size: 1.1rem; line-height: 1.2; }
  .counts span { display: block; margin-top: 3px; font-family: var(--face-ui); font-size: 0.84rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--ink-3); }
  .sec-h a.on { color: var(--ink); font-weight: 600; }
  .miss { color: var(--ink-3); font-style: italic; }
  .sub { display: block; margin-top: 2px; font-family: var(--face-ui); font-size: 0.82rem; color: var(--ink-3); }
  .row-bad td { background: var(--alert-bg); }
  .inline { display: flex; gap: 6px; align-items: center; }
  .inline select { padding: 6px 9px; border: 1px solid var(--rule); background: var(--card); color: var(--ink); font: inherit; font-size: 0.86rem; }
  .inline button { padding: 7px 13px; border: 1px solid var(--ink); background: var(--ink); color: var(--paper); font-family: var(--face-ui); font-size: 0.94rem; cursor: pointer; }
</style>
