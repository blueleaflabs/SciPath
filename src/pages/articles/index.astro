---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import RecordCard from '../../components/RecordCard.astro';
import Empty from '../../components/Empty.astro';
import { org } from '../../config/orgs';
import { getCollection } from 'astro:content';

const articles = (await getCollection('articles'))
  .filter((a) => a.data.status !== 'archived')
  .sort((a, b) => b.data.publishedOn.valueOf() - a.data.publishedOn.valueOf());

const byYear = new Map<number, number>();
for (const a of articles) {
  const y = a.data.publishedOn.getUTCFullYear();
  byYear.set(y, (byYear.get(y) ?? 0) + 1);
}
const yearRows = [...byYear.entries()].sort((a, b) => b[0] - a[0]);
---

<Base
  title="Showcase"
  description="Every published record, newest first, each with its full abstract."
>
  <PageHead eyebrow="Published records" title="Showcase" lede={org.showcaseNote}>
    {
      yearRows.length > 0 && (
        <div class="row" style="margin-top:18px">
          {yearRows.map(([y, n]) => (
            <a class="chip" href={`/articles/${y}/`}>
              {y} <span class="t-num">{n}</span>
            </a>
          ))}
        </div>
      )
    }
  </PageHead>

  <div class="wrap">
    {
      articles.length ? (
        <div class="stack">
          {articles.map((a) => (
            <RecordCard article={a} />
          ))}
        </div>
      ) : (
        <Empty
          title="No records published yet"
          body="This page lists every published record, newest first, each with its full abstract at reading size. It is complete and crawlable, so nothing here depends on search working."
        >
          <div class="row" style="justify-content:center">
            <a class="btn btn-2" href="/submit/">How publishing works</a>
            <a class="btn btn-q" href="/guides/">Read the guides</a>
          </div>
        </Empty>
      )
    }
  </div>
</Base>
