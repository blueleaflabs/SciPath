---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';

const automated = [
  'Every required section is present and above its minimum length.',
  'The abstract is within the word limit.',
  'There are at least the minimum number of references.',
  'Every figure has a caption and alt text.',
  'Every figure is referenced somewhere in the body.',
  'No placeholder text is left anywhere in the document.',
  'Every listed co-author has accepted authorship.',
  'Author order has been explicitly saved.',
  'The contributions statement names every listed author.',
];

const human = [
  'Axes are labeled and units are stated.',
  'What the error bars represent is stated, not implied.',
  'Figures are legible at the size they will be read.',
  'Limitations are stated rather than avoided.',
  'The contributions statement matches what the paper describes.',
  'Anything presented or published elsewhere is disclosed.',
];
---

<Base
  title="Pre-submission checklist"
  description="Everything checked before a submission reaches a reviewer, and everything a person checks afterward."
>
  <PageHead
    eyebrow="Publication"
    title="Pre-submission checklist"
    lede="This page is the mirror of what the system actually checks. If it is on the first list, the software blocks submission until it passes, so there is no surprise at the other end."
  />

  <div class="wrap">
    <section class="sec" style="padding-top:0">
      <div class="sec-h"><b>Checked automatically</b><span>Blocks submission</span></div>
      <ul class="check">
        {automated.map((item) => <li>{item}</li>)}
      </ul>
      <p class="t-sm" style="margin-top:14px">
        These are cheaper for a machine to catch than for a reviewer to report, and every
        one of them has been the reason a real submission bounced.
      </p>
    </section>

    <section class="sec">
      <div class="sec-h"><b>Checked by a person</b><span>Flagged for the reviewer</span></div>
      <ul class="check">
        {human.map((item) => <li>{item}</li>)}
      </ul>
    </section>

    <section class="sec">
      <div class="note">
        <h4>One last read</h4>
        <p>
          Read your abstract on its own and ask whether it states what you found. An
          abstract that describes the procedure and stops is the single most common thing a
          reviewer sends back.
        </p>
      </div>
    </section>
  </div>
</Base>

<style>
  .check {
    list-style: none;
    padding: 0;
    margin: 0;
    max-width: var(--measure-text);
  }
  .check li {
    border-top: 1px solid var(--rule-fine);
    padding: 12px 0 12px 30px;
    position: relative;
    font-size: 1rem;
    line-height: 1.55;
  }
  .check li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 16px;
    width: 15px;
    height: 15px;
    border: 2px solid var(--ink-3);
  }
</style>
