---
/* On demand, because the browse-before-you-search panel lists real records
   and those live in the store. */
export const prerender = false;

import Base from '../../layouts/Base.astro';
import { cachePublicPage } from '../../lib/caching';
import PageHead from '../../components/PageHead.astro';
import { disciplines } from '../../config/site';
import { openArchive } from '../../lib/archive';

const archive = await openArchive(Astro);
const articles = archive.all;

const recent = articles.slice(0, 5);
const counts = new Map<string, number>();
for (const a of articles) counts.set(a.discipline, (counts.get(a.discipline) ?? 0) + 1);
const withCounts = disciplines
  .map((d) => ({ ...d, n: counts.get(d.slug) ?? 0 }))
  .filter((d) => d.n > 0);

cachePublicPage(Astro);
---

<Base
  title="Search"
  description="Full text search across every published record. Runs in your browser, so no query is logged anywhere."
>
  <PageHead
    eyebrow="Full text"
    title="Search"
    lede="Every published record, and the guides."
  />
  {/* The lede read "Searches run in your browser against a static index.
      Nothing is sent to a server, so no query is logged anywhere, by us or by
      anyone else."
  
      It is true and it is a good design principle, and stated to a student
      about to type two words into a box it reads as a defense against an
      accusation nobody made. A page that explains what it is not doing
      invites the reader to wonder what it might have done. The property is
      kept — see the privacy policy, which is where a claim of this kind
      belongs and where somebody looking for it will go. */}

  <div class="wrap">
    <div class="card pad stack">
      <form class="sbar" id="search-form" role="search">
        <label class="skip" for="q">Search records</label>
        <input class="in" type="search" id="q" name="q" autocomplete="off" />
        <button class="btn" type="submit">Search</button>
      </form>

      <p class="t-sm" id="status" role="status" aria-live="polite"></p>
      <div id="results" class="stack"></div>

      <div id="browse">
        {
          recent.length ? (
            <>
              <p class="t-lbl">Recently published</p>
              <ul class="linklist">
                {recent.map((a) => (
                  <li>
                    <a href={`/${a.recordKind === 'project' ? 'projects' : 'articles'}/${a.year}/${a.slug}/`}>
                      {a.title}
                    </a>
                    <p>{a.authors.map((x) => x.displayName).join(', ')}</p>
                  </li>
                ))}
              </ul>
              {withCounts.length > 0 && (
                <div class="facets">
                  <div>
                    <p class="t-lbl">Discipline</p>
                    <ul>
                      {withCounts.map((d) => (
                        <li>
                          <a href={`/topics/${d.slug}/`}>{d.label}</a>
                          <span class="c">{d.n}</span>
                        </li>
                      ))}
                    </ul>
                  </div>
                </div>
              )}
            </>
          ) : (
            <div class="void">
              <p class="t-h2">There is nothing to search yet</p>
              <p class="t-sm">
                The index is built from published records at deploy time. Once the first
                record is published, its full text is searchable here.
              </p>
            </div>
          )
        }
      </div>
    </div>

    <p class="t-sm" style="margin-top:18px; max-width:74ch">
      Search is an accelerator over a complete archive, never the only route to it.
      <a href="/articles/">The full list of records</a> is static and works with scripts
      turned off.
    </p>
  </div>
</Base>

<script>
  const form = document.getElementById('search-form') as HTMLFormElement | null;
  const input = document.getElementById('q') as HTMLInputElement | null;
  const results = document.getElementById('results');
  const status = document.getElementById('status');
  const browse = document.getElementById('browse');
  if (!form || !input || !results || !status || !browse) throw new Error('search markup missing');

  let pagefind: any = null;

  /**
   * TWO INDEXES, EITHER OF WHICH MAY BE ABSENT.
   *
   * The static pages are indexed when the site is built, because they change
   * when code ships. Published records are indexed when they are published,
   * because they do not. Both are Pagefind bundles and Pagefind merges them,
   * so one search box answers from both.
   *
   * Neither is guaranteed. In development the site index does not exist at
   * all, because Pagefind runs after `astro build` and the dev server never
   * builds. Before anything is published, the records index does not exist
   * either. Loading the site index first and giving up when it failed meant
   * search was dead in development even with records indexed and waiting,
   * which is exactly where somebody is trying it for the first time.
   *
   * So: whichever loads first becomes the engine, and the other is merged
   * into it if it is there.
   */
  async function loadIndex() {
    if (pagefind) return pagefind;

    /* Built at runtime so the bundler leaves them alone: neither file exists
       when this is compiled. */
    const sitePath = ['', 'pagefind', 'pagefind.js'].join('/');
    const recordsPath = ['', 'records-index', 'pagefind.js'].join('/');

    const load = async (path: string) => {
      try {
        return await import(/* @vite-ignore */ path);
      } catch {
        return null;
      }
    };

    const site = await load(sitePath);

    if (site) {
      pagefind = site;
      await pagefind.options({ excerptLength: 30 });
      try {
        await pagefind.mergeIndex('/records-index', { excerptLength: 30 });
      } catch {
        /* Nothing published yet, or the index has not been rebuilt. The site
           index still answers, which beats a search box that errors. */
      }
      return pagefind;
    }

    const records = await load(recordsPath);
    if (records) {
      pagefind = records;
      await pagefind.options({ excerptLength: 30 });
      return pagefind;
    }

    return null;
  }

  function escapeHtml(value: string) {
    const el = document.createElement('div');
    el.textContent = value;
    return el.innerHTML;
  }

  async function run(query: string, pushState: boolean) {
    const q = query.trim();
    const url = new URL(window.location.href);
    if (q) url.searchParams.set('q', q);
    else url.searchParams.delete('q');
    if (pushState) window.history.replaceState({}, '', url);

    if (!q) {
      results.innerHTML = '';
      status.textContent = '';
      browse.hidden = false;
      return;
    }

    browse.hidden = true;
    status.textContent = 'Searching';

    const pf = await loadIndex();
    if (!pf) {
      status.textContent = '';
      results.innerHTML =
        '<div class="void"><p class="t-h2">The index is not available</p><p class="t-sm">Every record is also listed by year and by discipline.</p><p><a class="btn btn-2" href="/articles/">Browse everything</a></p></div>';
      return;
    }

    const search = await pf.search(q);
    const found = await Promise.all(search.results.slice(0, 20).map((r: any) => r.data()));

    if (found.length === 0) {
      status.textContent = '';
      results.innerHTML = `<div class="void"><p class="t-h2">No records match ${escapeHtml(
        q
      )}</p><p class="t-sm">Try a single word, or drop a filter. Every record is also listed by year and by discipline.</p><p><a class="btn btn-2" href="/articles/">Browse everything</a></p></div>`;
      return;
    }

    status.textContent = `${found.length} ${found.length === 1 ? 'record' : 'records'} for ${q}`;
    results.innerHTML = found
      .map(
        (r: any) => `
        <div class="result">
          <h3 class="t-h2"><a href="${r.url}">${escapeHtml(r.meta?.title ?? r.url)}</a></h3>
          <p class="excerpt">${r.excerpt}</p>
        </div>`
      )
      .join('');
  }

  form.addEventListener('submit', (event) => {
    event.preventDefault();
    run(input.value, true);
  });

  let timer: number | undefined;
  input.addEventListener('input', () => {
    window.clearTimeout(timer);
    timer = window.setTimeout(() => run(input.value, true), 120);
  });

  /* Query lives in the URL, so results are linkable and the back button works. */
  const initial = new URL(window.location.href).searchParams.get('q') ?? '';
  if (initial) {
    input.value = initial;
    run(initial, false);
  }

  /* Prefetch on intent: the index loads when someone means to search. */
  input.addEventListener('focus', () => void loadIndex(), { once: true });
</script>

<style>
  .result {
    border-top: 1px solid var(--rule-fine);
    padding-top: 16px;
  }
  .excerpt {
    margin: 9px 0 0;
    max-width: var(--measure-text);
    font-size: 0.98rem;
    line-height: 1.55;
  }
</style>
