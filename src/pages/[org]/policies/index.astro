---

import { orgPaths } from '../../../lib/tenant-paths';
export const getStaticPaths = orgPaths;

import Base from '../../../layouts/Base.astro';
import PageHead from '../../../components/PageHead.astro';

const policies = [
  {
    href: '/policies/privacy/',
    title: 'What we store',
    note: 'The complete list of what is collected, who sees it, and how to have it deleted. About two minutes to read.',
  },
  {
    href: '/policies/editorial/',
    title: 'Editorial policy',
    note: 'What review here actually is, who performs it, and what it does and does not guarantee.',
  },
  {
    href: '/policies/corrections/',
    title: 'Corrections and retractions',
    note: 'The three things that can happen to a published record when something is wrong, and who authorizes each.',
  },
  {
    href: '/policies/licensing/',
    title: 'Licensing and author rights',
    note: 'What authors keep, what readers may do, and what the license on a record means.',
  },
  {
    href: '/policies/takedown/',
    title: 'Takedown',
    note: 'How a current or former author asks for work to be removed. No account, no reason required.',
  },
  {
    href: '/policies/accessibility/',
    title: 'Accessibility',
    note: 'What this site commits to, and how to report a barrier.',
  },
];
---

<Base title="Policies" description="Editorial policy, corrections, licensing, takedown, privacy, and accessibility.">
  <PageHead
    eyebrow="Policies"
    title="Policies"
    lede="Short pages, written to be read rather than to protect anyone. A policy does not create compliance; it describes how the thing was built."
  />

  <div class="wrap">
    <ul class="linklist">
      {
        policies.map((p) => (
          <li>
            <a href={p.href}>{p.title}</a>
            <p>{p.note}</p>
          </li>
        ))
      }
    </ul>
  </div>
</Base>
