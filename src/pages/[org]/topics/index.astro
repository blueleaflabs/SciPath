---
import { orgPaths } from '../../../lib/tenant-paths';
export const getStaticPaths = orgPaths;

import Base from '../../../layouts/Base.astro';
import PageHead from '../../../components/PageHead.astro';
import { disciplines } from '../../../config/site';
import { getCollection } from 'astro:content';

const articles = (await getCollection('articles')).filter((a) => a.data.status !== 'archived');
const counts = new Map<string, number>();
for (const a of articles) counts.set(a.data.discipline, (counts.get(a.data.discipline) ?? 0) + 1);
---

<Base title="Topics" description="Published records by discipline.">
  <PageHead
    eyebrow="By discipline"
    title="Topics"
    lede="Records are classified by the domain of the question, not by the method used. Machine learning is a keyword, not a field."
  />
  <div class="wrap">
    <ul class="linklist">
      {
        disciplines.map((d) => {
          const n = counts.get(d.slug) ?? 0;
          return (
            <li>
              <div class="row" style="justify-content:space-between">
                {n > 0 ? <a href={`/topics/${d.slug}/`}>{d.label}</a> : <span class="t-sm">{d.label}</span>}
                <span class="t-num">{n}</span>
              </div>
            </li>
          );
        })
      }
    </ul>
  </div>
</Base>
