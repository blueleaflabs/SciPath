---
import { orgPaths } from '../../lib/tenant-paths';
export const getStaticPaths = orgPaths;

import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import { activeOrg } from '../../lib/tenant';
import { resolveProgram, datesFor } from '../../lib/templates';

/**
 * THE PAGE FOR SOMEBODY WHO RUNS A CLUB.
 *
 * The front page is written for a student. This is the other half, and the
 * reader is a teacher or an officer deciding whether to move a season's
 * administration onto something.
 *
 * The pitch is not "we save you time", which every product claims and none
 * proves. It is that the specific things that eat a season — transcribing a
 * fair's rules, chasing signatures in the wrong order, knowledge leaving with
 * the officers who graduate — are each a named problem with a named answer,
 * and all of them are visible on this site without an account.
 *
 * The numbers below are counted from the templates rather than written down,
 * so a claim on this page cannot drift away from what the software does.
 */

const org = activeOrg(Astro);

const counted = (() => {
  let deadlines = 0;
  let deliverables = 0;
  let warnings = 0;
  const programs: string[] = [];

  for (const id of org.programs ?? []) {
    try {
      const program = resolveProgram(id);
      const dated = datesFor(program).filter((d) => d.date);
      if (dated.length === 0) continue;

      programs.push(program.name);
      deadlines += dated.length;
      deliverables += program.deliverables.size;
      warnings += program.steps.filter((s: any) => s.risk).length;
    } catch {
      /* A template named and not present. Counted as nothing rather than
         guessed at. */
    }
  }

  return { deadlines, deliverables, warnings, programs };
})();
---

<Base
  title="For schools and clubs"
  description="Run a research club, a research class, or a fair season without keeping the calendar in somebody's head."
>
  <PageHead
    eyebrow="For schools and clubs"
    title="The season, without the spreadsheet"
    lede="A research club runs on knowledge that lives in the head of whoever is graduating. This is where to put it instead."
  />

  <div class="wrap">
    <!-- ── The problems, named ─────────────────────────────────────────── -->

    <div class="sec">
      <div class="sec-h"><b>What eats a season</b></div>

      <div class="grid">
        <div class="prob">
          <h3>Somebody transcribes the rules every year</h3>
          <p>
            A fair publishes its dates and its forms, and one person copies
            them into a document that is out of date by January. Here they are
            a template: written once, dated, and read by every project at
            once.
          </p>
          <p class="num">
            {counted.deadlines} deadlines across {counted.programs.length}
            {counted.programs.length === 1 ? 'program' : 'programs'}, and you
            can read all of them
            <a href="/deadlines/">without an account</a>.
          </p>
        </div>

        <div class="prob">
          <h3>The forms get signed in the wrong order</h3>
          <p>
            Approvals have to be dated before the work starts. A project that
            gets that backwards is disqualified for a reason no amount of good
            science fixes, and no reminder email catches it because the email
            goes out before anybody has a start date.
          </p>
          <p class="num">
            Checked continuously against the date the work actually began,
            and flagged while it is still fixable.
          </p>
        </div>

        <div class="prob">
          <h3>Nobody knows what is due</h3>
          <p>
            Not because it is secret — because it is in four places. The
            fair's site, a slide deck from September, a group chat, and one
            officer's memory.
          </p>
          <p class="num">
            One calendar per project, grouped into phases, with each deadline
            saying who set it: the fair, the club, or the research itself.
          </p>
        </div>

        <div class="prob">
          <h3>The knowledge graduates</h3>
          <p>
            Sixty percent of a club turns over every year. What the last
            cohort learned about a form, a teacher, or a review committee
            leaves with them, and the next cohort discovers it again the
            expensive way.
          </p>
          <p class="num">
            Officers write down what goes wrong, on the step it goes wrong at.
            The next student meets it on the day they are doing that step.
          </p>
        </div>
      </div>
    </div>

    <!-- ── What you get ───────────────────────────────────────────────── -->

    <div class="sec">
      <div class="sec-h"><b>What running it here looks like</b></div>

      <dl class="what">
        <dt>Every project, in one list</dt>
        <dd>
          What is next on each, what is late, and which have nobody looking
          after them. Officers are assigned per project and each officer sees
          their own load, because "assign randomly" in practice means giving
          it to whoever has fewest.
        </dd>

        <dt>Compliance you can see rather than trust</dt>
        <dd>
          {counted.deliverables} documents across the programs here, each one
          knowing whether it is required, optional, or required only because
          of something this project does. A survey pulls in the human
          participants form without anybody remembering that it should.
        </dd>

        <dt>A notebook that is evidence</dt>
        <dd>
          Appended and dated, never edited, and it exports as a research
          notebook a judge can read. A wet lab student photographs a page; a
          software student pastes a commit summary. Both satisfy the same
          requirement.
        </dd>

        <dt>A showcase, built in</dt>
        <dd>
          Finished work gets a permanent page with its own address, which a
          student can put on an application four years later and have it still
          resolve. Not a PDF in a shared drive that dies with the account.
        </dd>

        <dt>A class is a program too</dt>
        <dd>
          A research course, a club, a journal, and a grant all have the same
          shape: a calendar, documents, people who oversee it, and an outcome.
          A school running two of them runs them the same way.
        </dd>
      </dl>
    </div>

    <!-- ── What it does not do ────────────────────────────────────────── -->

    <div class="sec">
      <div class="sec-h"><b>What it does not do</b></div>

      <p class="plain">
        Worth saying plainly, because a list of everything a product does is
        a list nobody believes.
      </p>

      <ul class="not">
        <li>
          <b>It does not submit anything for you.</b> Fairs take entries on
          their own systems and we do not pretend otherwise. What is here is
          the work, the record, and knowing what is owed.
        </li>
        <li>
          <b>It does not block a student from working.</b> A missing approval
          is a warning, loudly and early, and never a locked door. Software
          that stops somebody working while an adult gets round to clicking
          has confused an administrative state for a permission.
        </li>
        <li>
          <b>It does not grade anything.</b> A teacher decides what a project
          is worth. This tracks what happened, not what it deserved.
        </li>
        <li>
          <b>It does not guess a date.</b> A deadline a program has not
          published says so rather than showing an estimate. A student
          trusting a wrong date is a failure the software caused.
        </li>
      </ul>
    </div>

    <!-- ── The way in ────────────────────────────────────────────────── -->

    <div class="sec cta">
      <h2 class="t-h2">Everything above is readable before you commit to anything.</h2>
      <p>
        The calendar, the pitfalls, and the published work are all open. There
        is no demonstration to book and nothing held back to make you ask: if
        the thing is any good, reading it should be enough to tell.
      </p>
      <p class="go">
        <a class="btn" href="/deadlines/">This season's calendar</a>
        <a class="btn btn-2" href="/mistakes/">What usually goes wrong</a>
        <a class="btn btn-2" href="/contact/">Talk to somebody</a>
      </p>
    </div>
  </div>
</Base>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(24rem, 1fr));
    gap: 28px 40px;
  }

  .prob h3 {
    margin: 0 0 8px;
    font-family: var(--face-ui);
    font-size: 1.08rem;
    font-weight: 650;
    line-height: 1.25;
  }
  .prob p { margin: 0 0 8px; max-width: 52ch; line-height: 1.6; }

  .num {
    font-size: 0.94rem;
    color: var(--ink-2);
    padding-left: 12px;
    border-left: 2px solid var(--rule);
  }

  .what { margin: 0; max-width: var(--measure-text); }
  .what dt {
    margin-top: 22px;
    font-family: var(--face-ui);
    font-weight: 650;
    font-size: 1.02rem;
  }
  .what dd { margin: 6px 0 0; line-height: 1.6; }

  .plain { max-width: var(--measure-text); }

  .not { margin: 14px 0 0; padding-left: 1.1em; max-width: var(--measure-text); }
  .not li { margin-top: 0.8em; line-height: 1.6; }

  .cta { border-top: 2px solid var(--ink); padding-top: 24px; max-width: 74ch; }
  .cta p { margin-top: 12px; }
  .go { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 20px; }
</style>
