---
export const prerender = false;

/**
 * SUPERSEDED BY `/for-organizations/`.
 *
 * The pitch to somebody running a club, a research class or a fair season:
 * what the platform looks like from the side of the adult who would adopt it
 * rather than the student who would use it.
 *
 * It was hidden because the argument for it stood and the page itself was a
 * guess: written before the product had been shown to a single teacher. What
 * brought it back is that the offer is now real rather than imagined, and it
 * came back at a wider name, because a homeschool group and a fair
 * association are not schools and both need the same thing.
 *
 * The address survives as a redirect. Four versions of the site linked it.
 */
import { activeOrg } from '../../lib/tenant';

const org = activeOrg(Astro);

return Astro.redirect(org.isPlatform ? '/for-organizations/' : '/', 301);
---
