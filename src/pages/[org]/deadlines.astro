---
import { orgPaths } from '../../lib/tenant-paths';
export const getStaticPaths = orgPaths;

import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import Empty from '../../components/Empty.astro';
import { activeOrg } from '../../lib/tenant';

const org = activeOrg(Astro);

/**
 * Programs and their dates come from the organization's program templates.
 * Nothing is provisioned yet, so this page shows the shape and says so.
 * A guessed date is worse than a missing one: a student trusting a wrong
 * deadline is a failure the software caused.
 */
const programs: Array<{
  name: string;
  season: string;
  rulesVersion: string;
  verifiedOn: string;
  milestones: Array<{ label: string; due: string | null; source: 'external' | 'internal' }>;
}> = [];
---

<Base
  title="Deadlines"
  description="Every deadline for the season, and the order the forms have to be signed in."
>
  <PageHead
    eyebrow="Calendar"
    title="Deadlines"
    lede="The dates that decide whether an entry is eligible, with the one ordering rule that disqualifies more projects than any other. Reading this needs no account."
  />

  <div class="wrap">
    <div class="note stop">
      <h4>The rule that ends entries before they start</h4>
      <p>
        The required forms have to be signed and dated <b>before</b> experimentation
        begins, and the adult sponsor's signature has to precede the start date you record.
        Signing them afterward cannot be fixed later, no matter how good the work is. The
        working surface checks this ordering for you and warns while it is still fixable.
      </p>
    </div>

    <div class="sec">
      <div class="sec-h">
        <b>Programs</b><span>{programs.length ? `${programs.length} tracked` : 'none provisioned'}</span>
      </div>
      {
        programs.length ? (
          <div class="stack">
            {programs.map((p) => (
              <div class="card">
                <div class="pad">
                  <h2 class="t-h2">{p.name}</h2>
                  <p class="t-num" style="margin-top:6px">
                    {p.season} · rules {p.rulesVersion} · checked {p.verifiedOn}
                  </p>
                </div>
                <table class="tbl">
                  <thead>
                    <tr>
                      <th scope="col">Milestone</th>
                      <th scope="col">Due</th>
                      <th scope="col">Set by</th>
                    </tr>
                  </thead>
                  <tbody>
                    {p.milestones.map((m) => (
                      <tr>
                        <td>{m.label}</td>
                        <td class="n">{m.due ?? 'not yet published'}</td>
                        <td>{m.source === 'external' ? 'the program' : 'this organization'}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            ))}
          </div>
        ) : (
          <Empty
            title="No programs are set up yet"
            body="Each program appears here with its own milestones, the version of the rules those dates came from, and the date a person last checked them against the source. A milestone whose date the program has not published yet says so rather than showing a guess."
          >
            <div class="row" style="justify-content:center">
              <a class="btn btn-2" href="/guides/">Read the guides</a>
              <a class="btn btn-q" href="/contact/">Ask {org.name}</a>
            </div>
          </Empty>
        )
      }
    </div>

    <div class="sec">
      <div class="sec-h"><b>How these dates behave</b><span>Two kinds</span></div>
      <table class="tbl">
        <tbody>
          <tr>
            <th scope="row" style="text-align:left; width:34%">Set by the program</th>
            <td>Published by whoever runs the competition. We copy them and record which version of the rules they came from, so a stale calendar is visible rather than silent.</td>
          </tr>
          <tr>
            <th scope="row" style="text-align:left">Set by this organization</th>
            <td>Internal drafts and check-ins, defined as an offset from a program date. When the program moves a date, everything anchored to it moves with it.</td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>
</Base>
