---

import { orgPaths } from '../../../lib/tenant-paths';
export const getStaticPaths = orgPaths;

import Base from '../../../layouts/Base.astro';
import PageHead from '../../../components/PageHead.astro';
import { activeOrg } from '../../../lib/tenant';

const org = activeOrg(Astro);

/* Who reads a submission, in the tenant's own word (dev-167): a club's
   editors are its officers; elsewhere they are editors. The platform is
   named by its own name. */
const who = org.isPlatform ? 'SciPath' : org.name;
const readers = org.archivePath === '/journal/' && !org.isPlatform ? 'officers' : 'editors';
const journal = org.archivePath === '/journal/' ? (org.showcaseTitle ?? 'the journal') : `the ${org.archiveWord.toLowerCase()}`;

const pages = [
  {
    href: '/submit/checklist/',
    title: 'Pre-submission checklist',
    note: 'If it is on this list, the system checks it before human review.',
  },
  {
    href: '/submit/review-process/',
    title: 'How review works',
    note: 'The detailed review process, how long it takes, who decides, and how to withdraw.',
  },
  {
    href: '/submit/authorship/',
    title: 'Authorship',
    note: 'Who counts as an author, how order is decided, and what the contributions statement has to say.',
  },
  {
    href: '/submit/ethics/',
    title: 'Ethics and eligibility',
    note: 'Human participants, animals, hazardous materials, AI disclosure, and work presented somewhere else first.',
  },
];
---

<Base
  title="Publish your work"
  description="What gets published, who may submit, what happens after you submit, and how long it takes."
>
  <PageHead
    eyebrow="Publication"
    title="Publish your work"
    lede={`Publication is the last stage of a project. When the work is finished, you submit it to ${who}, one or more ${readers} will review it, and if accepted, will publish it to ${journal}.`}
  />

  <div class="wrap">
    <section class="sec" style="padding-top:0">
      <div class="sec-h"><b>What this is</b><span>Stated plainly</span></div>
      <p class="prose">
        {
          org.editorialReview
            ? 'Submissions are read by student reviewers with potential faculty oversight. That is only an editorial review, not double blind peer review.'
            : 'Work is published once the competition season is over, without an editorial review stage.'
        }
      </p>
      <p class="prose" style="margin-top:14px">
        What you get is a permanent, indexed, citable record: its own URL that never
        changes, a stable identifier, a formatted citation, and metadata that lets search
        engines and scholarly indexes find it.
      </p>
    </section>

    <section class="sec">
      <div class="sec-h"><b>What happens when you submit</b><span>Eight steps</span></div>
      <ol class="steps">
        <li><b>Automated structural checks run first.</b> Failures are shown against the section that failed, requiring you to fix them and resubmit.</li>
        <li><b>If you have co-authors, each of them has to accept.</b> A submission listing someone who has not accepted cannot proceed.</li>
        <li><b>The record is created</b> and you get a tracking link that works without logging in.</li>
        <li><b>All co-authors are emailed</b> the tracking link and the expected timeline.</li>
        <li><b>An editor screens it</b> for scope, ethics flags, and prior publication.</li>
        <li><b>One or two reviewers are assigned</b>, each with a due date.</li>
        <li><b>You get one consolidated list</b> of what to change, not raw reviewer output.</li>
        <li><b>Usually there are at most two revision rounds.</b> After the second, the editor accepts or declines. You can withdraw at any point before publication.</li>
      </ol>
    </section>

    <section class="sec">
      <div class="sec-h"><b>Before you submit</b><span>Four pages</span></div>
      <ul class="linklist">
        {
          pages.map((p) => (
            <li>
              <a href={p.href}>{p.title}</a>
              <p>{p.note}</p>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="sec">
      <div class="note">
        <h4>Submitting needs an account. Reading never does.</h4>
        <p>
          The submission form lives on the working surface, where your project already is.
          Everything on this half of the site stays open to anyone.
        </p>
      </div>
    </section>
  </div>
</Base>

<style>
  .steps {
    max-width: var(--measure-text);
    padding-left: 1.3em;
    font-size: 1rem;
    line-height: 1.6;
  }
  .steps li {
    margin-top: 0.8em;
  }
  .steps b {
    font-family: var(--face-ui);
    font-weight: 650;
  }
</style>
