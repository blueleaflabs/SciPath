---
import { orgPaths } from '../../../lib/tenant-paths';
export const getStaticPaths = orgPaths;

import Base from '../../../layouts/Base.astro';
import PageHead from '../../../components/PageHead.astro';
import Empty from '../../../components/Empty.astro';
import { getAuthorPages, monogram } from '../../../lib/authors';

const authors = await getAuthorPages();

const byClass = new Map<string, typeof authors>();
for (const a of authors) {
  const key = a.gradYear ? `Class of ${a.gradYear}` : 'Year not recorded';
  byClass.set(key, [...(byClass.get(key) ?? []), a]);
}
const classes = [...byClass.entries()].sort((a, b) => b[0].localeCompare(a[0]));
---

<Base title="Authors" description="Everyone with published work, with their full publication list.">
  <PageHead
    eyebrow="Author pages"
    title="Authors"
    lede="An author page is created at first publication and its URL never moves. No email address is rendered anywhere on this site."
  />

  <div class="wrap">
    {
      authors.length ? (
        <div class="stack">
          {classes.map(([label, people]) => (
            <section>
              <div class="sec-h">
                <b>{label}</b>
                <span>{people.length}</span>
              </div>
              <ul class="linklist">
                {people.map((a) => (
                  <li>
                    <div class="author-row">
                      <span class="mono-av small" aria-hidden="true">
                        {monogram(a.displayName)}
                      </span>
                      <div>
                        <a href={`/authors/${a.slug}/`}>{a.displayName}</a>
                        <p>
                          {a.articles.length} {a.articles.length === 1 ? 'record' : 'records'}
                          {a.school ? ` · ${a.school}` : ''}
                        </p>
                      </div>
                    </div>
                  </li>
                ))}
              </ul>
            </section>
          ))}
        </div>
      ) : (
        <Empty
          title="No author pages yet"
          body="An author page is created the first time someone publishes, listing everything they have published since. Nothing is created at graduation, and nothing here is ever fetched from a school directory."
        />
      )
    }
  </div>
</Base>

<style>
  .author-row {
    display: flex;
    gap: 14px;
    align-items: center;
  }
  .mono-av.small {
    width: 42px;
    height: 42px;
    font-size: 0.95rem;
    flex: none;
  }
</style>
