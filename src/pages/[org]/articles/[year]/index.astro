---
import Base from '../../../../layouts/Base.astro';
import PageHead from '../../../../components/PageHead.astro';
import RecordCard from '../../../../components/RecordCard.astro';
import { getCollection } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import { withTenants } from '../../../../lib/tenant-paths';

export const getStaticPaths: GetStaticPaths = withTenants(async () => {
  const articles = (await getCollection('articles')).filter((a) => a.data.status !== 'archived');
  const years = [...new Set(articles.map((a) => a.data.publishedOn.getUTCFullYear()))];

  return years.map((year) => ({
    params: { year: String(year) },
    props: {
      articles: articles
        .filter((a) => a.data.publishedOn.getUTCFullYear() === year)
        .sort((a, b) => b.data.publishedOn.valueOf() - a.data.publishedOn.valueOf()),
    },
  }));
});

const { year } = Astro.params;
const { articles } = Astro.props;
---

<Base title={`Published in ${year}`} description={`Records published in ${year}.`}>
  <PageHead
    eyebrow="Year archive"
    title={String(year)}
    lede={`${articles.length} ${articles.length === 1 ? 'record' : 'records'} published in ${year}.`}
  />
  <div class="wrap">
    <div class="stack">
      {articles.map((a) => <RecordCard article={a} />)}
      <p><a href="/articles/">All years</a></p>
    </div>
  </div>
</Base>
