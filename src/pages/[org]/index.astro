---
import { orgPaths } from '../../lib/tenant-paths';
export const getStaticPaths = orgPaths;

import Base from '../../layouts/Base.astro';
import Empty from '../../components/Empty.astro';
import RecordCard from '../../components/RecordCard.astro';
import { activeOrg } from '../../lib/tenant';
import { platform, stages } from '../../config/site';
import { getCollection } from 'astro:content';

const org = activeOrg(Astro);

const published = (await getCollection('articles'))
  .filter((a) => a.data.status !== 'archived')
  .sort((a, b) => b.data.publishedOn.valueOf() - a.data.publishedOn.valueOf());

const latest = published.slice(0, 3);
const authorCount = new Set(
  published.flatMap((a) => a.data.authors.map((x) => x.displayName))
).size;
const years = published.map((a) => a.data.publishedOn.getUTCFullYear());
const span = years.length ? `${Math.min(...years)} to ${Math.max(...years)}` : null;
---

<Base
  title="A scaffold for student research"
  description="Plan, run, and publish a science fair project. Every deadline, every form, and every published record in one place."
>
  <div class="wrap">
    <section class="hero">
      <p class="t-lbl">{org.isPlatform ? platform.name : org.name}</p>
      <h1 class="t-big">Get the science fair right the first time</h1>
      <p class="lede">
        Every deadline, every form, and every step from a first idea to a published paper.
        The things that disqualify good projects are procedural, and they are all knowable
        in advance. This is where they are written down.
      </p>
      <div class="row" style="margin-top:24px">
        <a class="btn" href="/articles/">Read published work</a>
        <a class="btn btn-2" href="/guides/">Start a project</a>
      </div>
    </section>

    <!-- The lifecycle is the product, so it is the first thing on the page. -->
    <section aria-labelledby="lc" class="lifecycle card">
      <div class="lc-head">
        <h2 class="t-h2" id="lc">The five stages</h2>
        <p class="t-sm">
          Publication is the last stage of a project's life, not a separate product.
        </p>
      </div>
      <ol class="strip">
        {
          stages.map((s, i) => (
            <li class={i === 0 ? 'done' : ''}>
              <span class="s">{s.label}</span>
              <span class="d">{String(i + 1).padStart(2, '0')}</span>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="sec">
      <div class="sec-h"><b>What it does</b><span>Three things, plainly</span></div>
      <div class="grid-3">
        <div class="card pad">
          <p class="t-lbl">Dates, checked</p>
          <p class="t-sm" style="margin-top:9px">
            The forms that must be signed before experimentation begins are checked against
            the date the work actually started. Getting that order wrong disqualifies
            students every year, and it is the single failure that no reminder email
            reliably catches.
          </p>
        </div>
        <div class="card pad">
          <p class="t-lbl">Work, recorded</p>
          <p class="t-sm" style="margin-top:9px">
            Field notes are appended and timestamped, never edited. A wet lab student
            photographs a notebook page; a software student pastes a commit summary. Both
            satisfy the same requirement.
          </p>
        </div>
        <div class="card pad">
          <p class="t-lbl">Work, published</p>
          <p class="t-sm" style="margin-top:9px">
            A permanent, indexed, citable record with its own URL, so a student can link it
            from an application years later and it still resolves.
          </p>
        </div>
      </div>
    </section>

    <section class="sec">
      <div class="sec-h"><b>Two halves</b><span>Read freely, work signed in</span></div>
      <p class="t-sm" style="max-width:74ch; margin-bottom:18px">
        The guides, the deadline calendars, the mistakes other students have already made,
        and every published record are open to read. Running your own project needs an
        account, because it holds your work.
      </p>
      <table class="tbl">
        <thead>
          <tr>
            <th scope="col">Surface</th>
            <th scope="col">Holds</th>
            <th scope="col">Account</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>Public</td>
            <td>Published records, guides, deadlines, common mistakes</td>
            <td>Not needed</td>
          </tr>
          <tr>
            <td>Working</td>
            <td>Projects in progress, field notes, milestones, review</td>
            <td>Required</td>
          </tr>
        </tbody>
      </table>
    </section>

    <section class="sec">
      <div class="sec-h">
        <b>Latest records</b>
        <span>{published.length ? `${published.length} published${span ? `, ${span}` : ''}` : 'nothing published yet'}</span>
      </div>
      {
        latest.length ? (
          <div class="stack">
            {latest.map((a) => (
              <RecordCard article={a} />
            ))}
            <div class="row">
              <a class="btn btn-2" href="/articles/">
                Browse everything
              </a>
            </div>
          </div>
        ) : (
          <Empty
            title="Nothing is published here yet"
            body="Published records appear as soon as the first project reaches the publication stage. The guides and the deadline calendars are already open."
          >
            <div class="row" style="justify-content:center">
              <a class="btn btn-2" href="/guides/">Read the guides</a>
              <a class="btn btn-q" href="/submit/">How publishing works</a>
            </div>
          </Empty>
        )
      }
      {authorCount > 0 && <p class="t-sm" style="margin-top:14px">{authorCount} authors</p>}
    </section>

    <section class="sec" style="padding-bottom:8px">
      <div class="sec-h"><b>Start here</b><span>Three ways in</span></div>
      <div class="row">
        <a class="btn btn-2" href="/deadlines/">See this season's deadlines</a>
        <a class="btn btn-2" href="/guides/">Pick a research question</a>
        <a class="btn btn-q" href="/mistakes/">What usually goes wrong</a>
      </div>
    </section>
  </div>
</Base>

<style>
  .hero {
    padding: 64px 0 44px;
    max-width: 74ch;
  }
  .hero .t-lbl {
    margin-bottom: 14px;
  }
  .hero .lede {
    margin-top: 18px;
  }
  .lifecycle {
    overflow: hidden;
  }
  .lc-head {
    padding: 18px 20px 14px;
  }
  .lc-head .t-sm {
    margin-top: 5px;
  }
  @media (max-width: 640px) {
    .hero {
      padding: 40px 0 30px;
    }
  }
</style>
