---
export const prerender = false;

import Base from '../../layouts/Base.astro';
import { cachePublicPage } from '../../lib/caching';
import PageHead from '../../components/PageHead.astro';
import RecordCard from '../../components/RecordCard.astro';
import { openArchive, authorsOf } from '../../lib/archive';

const archive = await openArchive(Astro);
const slug = String(Astro.params.slug ?? '');
const person = authorsOf(archive.all).find((p) => p.slug === slug);

if (!person) return new Response('Not found', { status: 404 });

/* A publication list and nothing else. A profile with a bio and a photograph
   is a profile that is wrong three years after somebody graduates, and these
   pages are permanent. */
const schools = [...new Set(person.records.flatMap((r) =>
  r.authors.filter((a) => a.authorSlug === slug).map((a) => a.school).filter(Boolean)))];

cachePublicPage(Astro);
---

<Base title={person.name} description={`Published work by ${person.name}.`}>
  <PageHead
    eyebrow="Author"
    title={person.name}
    lede={`${person.records.length} published ${person.records.length === 1 ? 'record' : 'records'}${schools.length ? ` · ${schools.join(', ')}` : ''}`}
  />
  <div class="wrap">
    <section class="sec" style="padding-top:0">
      {person.records.map((r) => <RecordCard record={r} />)}
    </section>
  </div>
</Base>
