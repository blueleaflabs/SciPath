---
/**
 * THE HOME PAGE.
 *
 * Outside `[org]/` deliberately, and on demand, because it takes its
 * organization from the hostname. It also showed the three most recent
 * published records until 1.70; that section is gone and the note where it
 * stood says why, but the reason this page is on demand has not changed.
 *
 * It cannot live under `[org]/` while doing that. An on-demand `[org]/index`
 * is a catch-all: a request for /guides/ matches it with org set to "guides",
 * and the middleware then tries to rewrite an on-demand route onto a
 * prerendered one, which Astro refuses. Every single-segment public path on
 * the site broke that way.
 */
export const prerender = false;

import Base from '../layouts/Base.astro';
import { cachePublicPage } from '../lib/caching';
import { activeOrg } from '../lib/tenant';
import { platform } from '../config/site';
import { resolveProgram } from '../lib/templates';
import { formatDate } from '../lib/dates';

import { openArchive } from '../lib/archive';

/* The archive is still read, for the organization it resolves and nothing
   else. The three most recent records used to be shown at the foot of this
   page; see the note where that section stood. */
const archive = await openArchive(Astro);
const org = archive.org;

/**
 * What this school takes part in, this season.
 *
 * `/deadlines/` used to carry this and carried far more: every step of every
 * program, grouped by phase, which is a reference document rather than an
 * answer to the question somebody arriving here is asking. That question is
 * "what could I be part of", and it has a short answer.
 *
 * Per tenant, because `org.programs` is: one school lists its class, its
 * club, the fairs it takes part in and its journal; another lists a single
 * regional fair. Read from the same templates the working surface
 * resolves, so a date seen before signing up is the date they will be held
 * to.
 *
 * A template that fails to resolve is dropped rather than thrown: a public
 * page is the wrong place to find out that a config file has a typo in it.
 */
const season = (org.programs ?? [])
  .map((id: string) => {
    try {
      const p = resolveProgram(id) as any;
      return {
        id,
        name: p.name,
        kind: p.kind,
        role: p.role ?? 'opportunity',
        /* The same anchor the seed writes into `programs.fair_date`, so the
           day shown here is the day the working surface shows. A class ends
           rather than judges, and says so below. */
        date: p.anchors?.fair ?? p.anchors?.community_showcase ?? null,
        blurb: p.program?.description ?? null,
      };
    } catch {
      return null;
    }
  })
  .filter(Boolean) as any[];

/* Classes and clubs first, then everything else, which is the order the
   working surface groups them in and the order of the acts: you join one of
   the first before you enter most of the second. */
const cohorts = season.filter((p) => p.role === 'cohort');
const venues = season.filter((p) => p.role !== 'cohort');

cachePublicPage(Astro);
---

<Base
  title="A scaffold for student research"
  description="Plan, run, and publish a science fair project. Every deadline, every form, and every published record in one place."
>
  <div class="wrap">
    <section class="hero">
      <p class="t-lbl">{org.isPlatform ? platform.name : org.name}</p>
      <h1 class="t-big">From idea through publication</h1>
      <p class="lede">
        {org.isPlatform
          ? 'Plan the project. Meet the requirements. Keep the record.'
          : 'Your high school science research companion'}
      </p>
      {/* One way in, and one way to look before deciding.

          "See this season" pointed at `/deadlines/`, which is gone, and
          "Read published work" pointed at `/articles/`, which is a filtered
          view of the showcase already in the nav. Three buttons of equal
          weight made the one that starts anything a third of the offer.

          The second button here is not a third of the offer: it is lighter
          than the first and it answers the question somebody actually has at
          the front door, which is what this thing looks like with a season
          in it. A school's own visitors already know. */}
      <div class="row" style="margin-top:24px">
        <a class="btn" href={org.isPlatform ? '/get-started/' : '/app/'}>Start a project</a>
        {org.isPlatform && <a class="btn btn-2" href="/try/">See a season in progress</a>}
      </div>
    </section>

    {/* **The problem statement used to sit here, immediately under the
        hero, and it opened the site on what goes wrong.** It is accurate and
        it is the argument for building this, but a reader who has been on
        the page four seconds has not yet been given anything to weigh it
        against, and a product whose first paragraph is about failure reads
        as a product that expects it. It is now the opening of "What this
        does", where the sentence after it is the answer.

        What stands here instead is who this is for, which is the question
        somebody at the front door is actually asking. */}
    {/* **Three readers, addressed by name, at the top of the page.**

        It was four, and one of them was wrong. "Student leaders" described a
        role rather than a person deciding whether to be here: an officer is
        a student who has been given a job by an adult, and the adult is the
        one reading this page. That copy now sits in the educators card,
        where the person who grants the role will see it. `/for-student-leaders/`
        stays, reached from the footer and from the educator page, because it
        is the right page once somebody holds the role.

        Not in the masthead. 7.11 cut the bar from seven items to three on the
        argument that a glance should not have to rank sections, and three
        descriptions of a reader would start it growing again. */}
    {org.isPlatform && (
      <section class="sec">
        <div class="sec-h"><b>SciPath is for</b><span>Three ways to read this</span></div>
        <div class="who-grid">
          <a class="who" href="/for-students/">
            <span class="who-rule" aria-hidden="true"></span>
            <p class="who-t">Solo students</p>
            <p class="who-d">
              No club, no lab, and no teacher with time is the normal case rather than the
              hard one. Run your project, meet what the fair actually asks for, and finish
              with a record worth linking to.
            </p>
            <span class="who-go" aria-hidden="true">Start on your own</span>
          </a>

          <a class="who" href="/for-educators/">
            <span class="who-rule" aria-hidden="true"></span>
            <p class="who-t">Educators</p>
            <p class="who-d">
              See where every project in your program stands and what is missing, without
              chasing each student for it. Keep what your club knows from graduating with
              the officers who knew it, and give them a defined role under your oversight.
            </p>
            <span class="who-go" aria-hidden="true">See the program view</span>
          </a>

          <a class="who" href="/for-organizations/">
            <span class="who-rule" aria-hidden="true"></span>
            <p class="who-t">Schools, clubs and groups</p>
            <p class="who-d">
              Run a repeatable research season with your own calendar, roles and public
              record. Free to adopt and free to keep running, hosted by us or on your own
              infrastructure.
            </p>
            <span class="who-go" aria-hidden="true">Bring it to your students</span>
          </a>
        </div>
      </section>
    )}

    <section class="sec">
      <div class="sec-h"><b>What this does</b><span>The problem, and the answer to it</span></div>
      {/* **The problem statement, moved here from the top of the page.**
          Same sentences, different place. Under the hero it was the first
          thing anybody read; here the three cards under it are the reply,
          and a difficulty stated next to its answer reads as competence
          rather than as complaint. */}
      <p class="problem">
        A good project is lost to a form signed a week late, an approval nobody mentioned,
        a deadline that moved, or work scattered across a folder, an inbox and somebody
        else's memory. Those failures are procedural rather than intellectual, they fall
        hardest on the students whose schools have the least to spare, and software can
        catch every one of them.
      </p>
      <div class="grid-3">
        <div class="card pad">
          <p class="t-lbl">Dates, checked</p>
          <p class="t-sm" style="margin-top:9px">
            The forms that must be signed before experimentation begins are checked against
            the date the work actually started. Getting that order wrong disqualifies
            students every year, and it is the single failure that no reminder email
            reliably catches.
          </p>
        </div>
        <div class="card pad">
          <p class="t-lbl">Work, recorded</p>
          <p class="t-sm" style="margin-top:9px">
            Field notes are appended and timestamped, never edited. A wet lab student
            photographs a notebook page; a software student pastes a commit summary. Both
            satisfy the same requirement.
          </p>
        </div>
        <div class="card pad">
          <p class="t-lbl">Work, published</p>
          <p class="t-sm" style="margin-top:9px">
            A permanent, indexed, citable record with its own URL, so a student can link it
            from an application years later and it still resolves.
          </p>
        </div>
      </div>
    </section>

    {/* The lifecycle is the product, so it is the first thing on the page.
    
        **These five are the product's shape, not a research process.** The
        strip here rendered `process-standard`'s phases — approval, start,
        design, work, tell — which is a way of doing research, one of several
        the templates offer, and a project may be on any of them. What a
        reader wants on a home page is what this thing does to their year, and
        those are different questions that had been given one answer.
    
        Written out rather than resolved, for the same reason. A home page
        describing the product cannot take its content from whichever process
        a template happens to name; the previous version would have said
        something different the day the default process changed, which is a
        live open decision (23.3). */}
    <section aria-labelledby="lc" class="lifecycle">
      <div class="lc-head">
        <h2 class="t-h2" id="lc">How research goes</h2>
        <p class="t-sm">
          Registration through publication, on one page that fills up as the
          year goes.
        </p>
      </div>
      <ol class="steps">
        {
          [
            ['Register', 'The project exists, with authors.'],
            ['Work', 'Notes, files, shared writing.'],
            ['Package', 'Deliverables and whatever the program requires.'],
            ['Participate', 'A class milestone, a fair, or simply the work itself.'],
            ['Share', 'A permanent record with its own address.'],
          ].map(([name, blurb], i) => (
            <li>
              <span class="n" aria-hidden="true">{i + 1}</span>
              <div class="step-card">
                <p class="step-t">{name}</p>
                <p class="step-d">{blurb}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </section>

    {/* The "Two halves" section stood here: a heading, a paragraph and a
        three column table explaining that reading needs no account and
        working does. It was an explanation of the product's shape offered to
        somebody who had not yet seen the product. A reader finds out which
        half needs an account by clicking something and being asked, which is
        one moment of friction against three paragraphs of preamble. */}

    {season.length > 0 && (
      <section class="sec">
        <div class="sec-h">
          <b>This season at {org.name}</b>
          <span>{season.length} {season.length === 1 ? 'program' : 'programs'}</span>
        </div>

        {/* **Per tenant, because taking part is.**
        
            `/deadlines/` held this and held every step of every program
            grouped by phase, which is a reference document. Somebody landing
            here is asking a shorter question — what could I be part of — and
            the answer is a list of names and dates. The steps are still
            resolved from the same templates; they are read on the program's
            own page once there is an account, next to the work they govern.
        
            One school sees its class, its club, the fairs it takes part in
            and its journal; another sees a single regional fair. Neither
            list is written here — both come from the organization record. */}
        {cohorts.length > 0 && (
          <>
            <h3 class="group-h first">Classes and clubs</h3>
            <ul class="season">
              {cohorts.map((p: any) => (
                <li>
                  <b>{p.name}</b>
                  {p.blurb && <span class="sub">{p.blurb}</span>}
                </li>
              ))}
            </ul>
          </>
        )}

        {venues.length > 0 && (
          <>
            <h3 class="group-h">Fairs, grants and the journal</h3>
            <ul class="season">
              {venues.map((p: any) => (
                <li>
                  <b>{p.name}</b>
                  {p.date && <span class="when">{formatDate(p.date, 'long')}</span>}
                  {p.blurb && <span class="sub">{p.blurb}</span>}
                </li>
              ))}
            </ul>
          </>
        )}

        {/* The way in, at the size of an invitation rather than a footnote.
            It read "Sign in to join one, or start a project of your own and
            enter it later" in the small size, under a list of things a reader
            has just decided they want to be part of — the sentence that
            answers "how" was the quietest thing on the page. */}
        <p class="join-cta">
          <a href="/app/">Sign in or sign up to join one</a>
        </p>
      </section>
    )}

    {/* **The showcase came off this page at 1.70.**

        It was a section header, a count, and an empty state explaining that
        records appear once somebody publishes one. Nothing is published yet
        at any tenant, so what a reader met at the foot of the front page was
        a well designed statement that there is nothing here. An empty shelf
        is worth showing inside a product, where it tells somebody what will
        fill it; on the page that has to earn the first account it reads as an
        answer to "has anyone used this".

        It comes back when there is something in it. The showcase itself is
        in the masthead throughout and was never the thing being hidden. */}

    {/* "Start here" offered the guides and the mistakes page as two more
        buttons at the foot of the page. Both are in the nav, and the page
        already asks once, above, for the thing that actually starts
        something. A second call to action below a first one does not double
        the invitation; it makes the first one look unsure. */}
  </div>
</Base>

<style>
  .hero {
    padding: 64px 0 44px;
    max-width: 74ch;
  }
  /* One line, which is how a title of five words should read.
  
     `.t-big` is `clamp(1.8rem, 5vw, 2.8rem)`, so on a narrow window the
     headline stayed large enough to break across two lines and the break
     landed mid-phrase. Above the width where it fits, it is held on one
     line; below it, it wraps and balances, because a headline running off
     the side of a phone is worse than a headline on two lines. */
  .hero h1 { text-wrap: balance; }
  @media (min-width: 46rem) {
    .hero h1 { white-space: nowrap; }
  }
  .hero .t-lbl {
    margin-bottom: 14px;
  }
  /* `.fork` went with the paragraph it styled: it introduced
     `/for-schools/`, which is hidden (23.4). */

  /* The way in, sized to be seen. Larger than body text and set apart, so
     the sentence answering "how do I take part" is not the smallest thing
     under a list of things somebody has just decided they want. */
  .join-cta {
    margin-top: 22px;
    font-size: 1.22rem;
  }
  .join-cta a { font-weight: 600; }

  /* This school's season. A list rather than cards, because the answer to
     "what could I take part in" is short and a card grid makes six names
     look like a catalog. */
  /* The two group headings, which were `t-lbl`.
  
     That is the small uppercase label the section header above them already
     uses, so a heading grouping four items rendered smaller and quieter than
     the items themselves — the reader met *Classes and clubs* as a caption
     rather than as a division, and the two groups blurred into one list of
     six. Larger than what it groups, and in the interface face rather than
     the editorial one, so it separates by size and by shape at once.
  
     Not uppercase. At this size letter-spaced capitals stop being a label and
     start being a shout, and there is one of those at the top already. */
  .group-h {
    margin: 32px 0 4px;
    font-family: var(--face-ui);
    font-weight: 600;
    font-size: 1.18rem;
    color: var(--ink);
  }

  /* The first sits directly under the section rule, which is separation
     enough on its own. */
  .group-h.first {
    margin-top: 8px;
  }

  .season { list-style: none; margin: 0; padding: 0; }
  .season li {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 14px;
    padding: 10px 0;
    border-top: 1px solid var(--rule-fine);
  }
  .season b { font-size: 1.02rem; }
  .season .when {
    font-family: var(--face-num);
    font-size: 0.9rem;
    color: var(--ink-2);
  }
  .season .sub {
    flex: 1 0 100%;
    font-size: 0.9rem;
    color: var(--ink-3);
    max-width: var(--measure-text);
  }

  .hero .lede {
    margin-top: 18px;
  }

  .problem {
    max-width: var(--measure-text);
    font-size: 1.05rem;
    line-height: 1.65;
    color: var(--ink-2);
  }

  /* THE THREE CARDS, WHICH CARRY THE PAGE.
  
     They are the first thing under the hero and the only routing on the
     page, so they are built rather than borrowed: `.card pad` is the neutral
     container used for twenty other things here and reads as a list item.
  
     A whole card is the link, because half of one is a target somebody
     misses on a phone. The brand rule across the top is the only color on
     the page above the fold, and it fills on hover, which is a cheaper
     signal than moving the card and does not reflow anything. */
  .who-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
  }
  @media (max-width: 62rem) {
    .who-grid { grid-template-columns: 1fr; }
  }

  .who {
    display: flex;
    flex-direction: column;
    position: relative;
    padding: 26px 24px 22px;
    background: var(--card);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    box-shadow: var(--lift);
    text-decoration: none;
    color: inherit;
    overflow: hidden;
    transition:
      box-shadow 0.16s ease,
      border-color 0.16s ease,
      transform 0.16s ease;
  }

  .who-rule {
    position: absolute;
    inset: 0 auto auto 0;
    width: 100%;
    height: 3px;
    background: var(--rule);
    transition: background 0.16s ease;
  }

  .who-t {
    font-family: var(--face-ui);
    font-weight: 700;
    font-size: 1.18rem;
    line-height: 1.2;
    color: var(--ink);
    margin: 0;
  }

  .who-d {
    margin: 12px 0 0;
    flex: 1;
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--ink-2);
  }

  /* The affordance says where the card goes rather than saying "learn more",
     which says nothing. Not a link of its own: the card is the link, and a
     link inside a link is a second target for the same destination. */
  .who-go {
    margin-top: 18px;
    font-family: var(--face-ui);
    font-weight: 650;
    font-size: 0.86rem;
    letter-spacing: 0.01em;
    color: var(--brand);
  }
  .who-go::after {
    content: ' \2192';
  }

  .who:hover,
  .who:focus-visible {
    border-color: var(--brand);
    box-shadow: var(--lift-2);
    transform: translateY(-2px);
  }
  .who:hover .who-rule,
  .who:focus-visible .who-rule {
    background: var(--brand);
  }

  /* Somebody who has asked not to be moved is not moved. */
  @media (prefers-reduced-motion: reduce) {
    .who { transition: border-color 0.16s ease; }
    .who:hover,
    .who:focus-visible { transform: none; }
  }
  .lc-head .t-sm {
    margin-top: 5px;
    max-width: 60ch;
  }

  /* Five steps, each a numbered marker above a card.
  
     Not the bordered strip this replaced: five cells of a table read as a
     table, one thing divided five ways, and these are five things that happen
     one after another. Separated cards with the number outside them say
     sequence, which is what the section is about.
  
     **Five columns, stated.** This was `auto-fit` with a `minmax(11rem, …)`
     floor, which computes how many tracks fit and then fills the row — and at
     the width this page actually renders, five times eleven rem plus four
     gaps came to just over the measure, so it laid out four and wrapped the
     fifth onto a line of its own. A sequence broken across two rows stops
     reading as a sequence, and `auto-fit` had been asked to decide something
     that is not its business: there are five steps, and they are five because
     the product has five.
  
     The breakpoints do the wrapping instead, where a narrow screen genuinely
     cannot hold a row. Explicit, so the shape is a decision rather than an
     outcome of arithmetic against whatever the container happens to be. */
  .steps {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 14px;
    margin: 22px 0 0;
    padding: 0;
    list-style: none;
  }

  @media (max-width: 62rem) {
    .steps { grid-template-columns: repeat(3, 1fr); }
  }

  @media (max-width: 40rem) {
    .steps { grid-template-columns: 1fr; }
  }

  .steps li {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  /* Outside the card and above it, so the eye counts the row before reading
     any of it. */
  .n {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.1rem;
    height: 2.1rem;
    border-radius: 50%;
    background: var(--brand);
    color: var(--brand-contrast);
    font-family: var(--face-ui);
    font-weight: 700;
    font-size: 0.9rem;
  }

  .step-card {
    flex: 1;
    padding: 14px 16px;
    background: var(--sunk);
    border: 1px solid var(--rule-fine);
    border-radius: var(--radius);
  }

  .step-t {
    margin: 0;
    font-family: var(--face-ui);
    font-weight: 700;
    font-size: 0.98rem;
    color: var(--ink);
  }

  .step-d {
    margin: 6px 0 0;
    font-size: 0.9rem;
    line-height: 1.5;
    color: var(--ink-2);
  }
  @media (max-width: 640px) {
    .hero {
      padding: 40px 0 30px;
    }
  }
</style>
