---
export const prerender = false;

import Base from '../../../layouts/Base.astro';
import RecordDetail from '../../../components/RecordDetail.astro';
import { openArchive, findRecord, readBody, bodyOf } from '../../../lib/archive';
import { companionOf } from '../../../lib/records-store';

const KIND = 'project' as 'article' | 'project';

const archive = await openArchive(Astro);
const year = Number(Astro.params.year);
const record = findRecord(archive.manifest, KIND, year, String(Astro.params.slug ?? ''));

if (!record) return new Response('Not found', { status: 404 });

const body = bodyOf(await readBody(Astro, record));

/* The other record for the same project, if it has been published. */
const companion = companionOf(archive.all, record);

/* Published records do not change. A correction writes a new one and the
   manifest points at it, so a long cache is safe and makes the common case
   never touch the store. */
Astro.response.headers.set(
  'Cache-Control',
  'public, max-age=300, s-maxage=86400, stale-while-revalidate=604800'
);
---

<Base title={record.title} description={record.abstract.slice(0, 300)}>
  <RecordDetail record={record} body={body} org={archive.org} companion={companion} />
</Base>
