---
import { renderMarkdown } from '../lib/notes';
import { disciplineLabel, disciplineHue, toneStyle } from '../config/site';
import { originForOrg } from '../lib/deployment';
import type { RecordEntry } from '../lib/records-store';
import type { Org } from '../config/orgs';
import { parseVideo } from '../lib/video';
import { isDemonstration } from '../lib/records-store';

interface Props {
  record: RecordEntry;
  body: string;
  org: Org;
  /** The other record for the same project, where there is one. */
  companion?: RecordEntry | null;
}

/**
 * ONE TEMPLATE FOR BOTH KINDS.
 *
 * An article and a project entry differ in what data exists, not in what
 * layout is right. Every block renders only when it has something, so a
 * project with an abstract and a result reads as finished rather than as an
 * article with holes in it.
 */
const { record: d, body, org, companion } = Astro.props;

/* Derived here as well as in the archive, because a detail page finds its
   record in the manifest, which carries no mark (dev-149). */
const demonstration = isDemonstration(org, d);

/* The discipline's colour, carried from the cover and the topic page
   (dev-149, dev-151): the head of a record is the school's block — the
   same dark block that opens every working page — and the subject's
   colour is its accent: the rule under it, the eyebrow, the subject's
   name. The school says whose page it is; the colour says which shelf. */
const hue = disciplineHue(d.discipline);
const hueStyle = toneStyle(d.discipline);

const space = d.recordKind === 'project' ? 'projects' : 'articles';
/* The citation URL is the one a reader will paste into a bibliography years
   from now, so it names the school that published the record. */
const url = new URL(`/${space}/${d.year}/${d.slug}/`, originForOrg(org)).href;

const video = parseVideo(d.video);

/* The still stored with the record, which is our own file. Preferred over
   the one on the host's CDN even for YouTube: a published page should ask
   nobody anything until a reader presses play, and `i.ytimg.com` is
   somebody else. */
const poster = d.videoPoster ?? video?.poster ?? null;

const doi = d.doi ? `https://doi.org/${d.doi.replace(/^https?:\/\/doi\.org\//, '')}` : null;

const citationNames = d.authors
  .map((a) => {
    const parts = a.displayName.trim().split(/\s+/);
    const last = parts.pop() ?? a.displayName;
    const initials = parts.map((p) => `${p[0]}.`).join(' ');
    return initials ? `${last}, ${initials}` : last;
  })
  .join(', ');

const citation = `${citationNames} (${d.year}). ${d.title}. ${org.name}, ${d.recordId}. ${doi ?? url}`;

const bibtex = `@article{${d.recordId.toLowerCase()},
  title   = {${d.title}},
  author  = {${d.authors.map((a) => a.displayName).join(' and ')}},
  year    = {${d.year}},
  journal = {${org.name}},
  note    = {${d.recordId}},
${d.doi ? `  doi     = {${d.doi}},\n` : ''}  url     = {${url}}
}`;

const published =
  d.datePrecision === 'day'
    ? new Date(`${d.publishedOn}T00:00:00`).toLocaleDateString('en-US', {
        month: 'long', day: 'numeric', year: 'numeric',
      })
    : new Date(`${d.publishedOn}T00:00:00`).toLocaleDateString('en-US', {
        month: 'long', year: 'numeric',
      });

/* Through the same rendering as a notebook entry, which escapes every angle
   bracket before the parser sees one and then refuses any URL scheme but
   http, https and mailto.
   
   This called `marked.parse` directly, so a manuscript containing a literal
   script tag was published as one on a public page: the one surface where the
   author and the reader are different people and the reader has no reason to
   distrust it.

   The tag is described rather than written out, and that is not squeamishness.
   Vite's dependency scanner slices a `.astro` file on the opening tag with no
   idea that this one is inside a comment inside the frontmatter, so writing it
   here made the scanner read every line from this comment to the real closing
   tag as JavaScript and fail on the first attribute it met. The production
   build was unaffected, because that scanner runs only in development, so
   this survived every green suite and broke the development server on the
   next cold install. `tests/frontmatter.mjs` now refuses it. */
const html = body ? renderMarkdown(body) : '';
---

<article class="wrap" data-pagefind-body data-pagefind-filter={`discipline:${disciplineLabel(d.discipline)}, year:${d.year}`}>
  <header class="hero">
    <div class:list={['plate', hue !== null && 'toned']} style={hueStyle}>
      {/* The eyebrow a journal puts first (dev-167): the subject, the kind
          of record, and when. The school is the masthead's; the record's
          number is the citation's. */}
      <p class="t-lbl">
        <a class="subject" href={`/topics/${d.discipline}/`}>{disciplineLabel(d.discipline)}</a> · {d.recordKind === 'project' ? 'Fair entry' : 'Paper'} · {published}
        {demonstration && <span class="chip demo">Demonstration</span>}
      </p>
      <h1 class="t-h1" data-pagefind-meta="title">{d.title}</h1>
      <p class="by">
        {d.authors.map((a, i) => (
          <>
            {i > 0 && ', '}
            {a.authorSlug ? <a href={`/authors/${a.authorSlug}/`}>{a.displayName}</a> : a.displayName}
          </>
        ))}
      </p>
      {/* The question, directly under the byline. Somebody scanning decides
          from this line whether to keep reading, and the abstract is too long
          to be that line. */}
      {d.question && <p class="question">{d.question}</p>}

    </div>

    {/* Said once, plainly, on the page a search result lands on. The people,
        the project and the result are invented; the pictures are drawn. The
        real papers on this tenant never show this line. */}
    {demonstration && (
      <p class="demo-note">
        This record is a demonstration: the project, its authors and its result are invented to show what a published record looks like here. The pictures are illustrations.
      </p>
    )}

    {/* What the fair said, before the prose. A reader deciding whether this
        is worth their time weighs an award more heavily than an abstract, and
        the honest presentation of that is to put it where they look. */}
    {d.entries.some((e) => e.placement || e.awards.length || e.advancedTo) && (
      <ul class="honors">
        {d.entries.map((e) => (
          <>
            {e.placement && (
              <li>
                <b>{e.placement}</b>
                <span>{e.program}{e.season ? ` · ${e.season}` : ''}</span>
              </li>
            )}
            {e.awards.map((award) => (
              <li>
                <b>{award}</b>
                <span>{e.program}{e.season ? ` · ${e.season}` : ''}</span>
              </li>
            ))}
            {e.advancedTo && (
              <li>
                <b>Advanced to {e.advancedTo}</b>
                <span>{e.program}{e.season ? ` · ${e.season}` : ''}</span>
              </li>
            )}
          </>
        ))}
      </ul>
    )}

    {/* What the work looked like, before a word of prose. */}
    {d.shots.length > 0 && (
      <ul class:list={['shots', d.shots.length === 1 && 'one']}>
        {d.shots.map((shot) => (
          <li>
            <img src={shot.src} alt={shot.alt} loading="lazy" />
            <p>{shot.caption}</p>
          </li>
        ))}
      </ul>
    )}

    {video && (
      <div class="video" data-embed={video.embed}>
        {poster ? (
          <img class="poster" src={poster} alt="" loading="lazy" />
        ) : (
          /* Drawn here rather than fetched.
           
             YouTube publishes a still at a predictable address; Vimeo's needs
             an API call, which is a request made on a reader's behalf for
             something they have not asked for. So this is a placeholder, and
             an empty box read as a broken page rather than as a video
             waiting to be played. It says which host it is, so somebody can
             decide before pressing anything. */
          <div class="poster drawn">
            <span class="host">{video.host === 'vimeo' ? 'Vimeo' : 'YouTube'}</span>
            <span class="quiet">Nothing loaded yet</span>
          </div>
        )}
        <button type="button" class="play" aria-label="Play the video">
          <span></span>
        </button>
        <p class="vnote">
          Nothing is requested from {video.host === 'vimeo' ? 'Vimeo' : 'YouTube'} until
          you press play. <a href={video.watch} target="_blank" rel="noopener noreferrer">Watch it there instead</a>.
        </p>
      </div>
    )}

  </header>

  {/* Two columns from here (dev-167), the way a journal sets an article:
      the reading column, and a rail with the record's facts, the file and
      the citation, so what a reader looks up is in one place beside the
      text rather than at the end of it. One column on a phone. */}
  <div class="cols">
  <div class="main">
    {d.abstract && (
      <section class="sec">
        <div class="sec-h"><b>Abstract</b></div>
        <p class="prose lede-abs">{d.abstract}</p>
      </section>
    )}

    {d.externalUrl && (
      <p class="prose">
        The version of record is held elsewhere:
        {' '}<a href={d.externalUrl} target="_blank" rel="noopener noreferrer">{d.externalUrl}</a>
      </p>
    )}

    {d.entries.length > 0 && (
      <section class="sec">
        <div class="sec-h"><b>Presented at</b></div>
        <ul class="facts">
          {d.entries.map((e) => (
            <li>
              <b>{e.program}{e.season ? ` ${e.season}` : ''}</b>
              {/* Placement, awards, and advancement are already at the top,
                  where somebody looks first. This is the detail underneath:
                  the category and the fair's own code, which matter to
                  anybody checking a result and to nobody else. */}
              <span>{[e.category, e.entryCode].filter(Boolean).join(' · ')}</span>
            </li>
          ))}
        </ul>
      </section>
    )}

    {html && (
      <section class="sec">
        <div class="body prose" set:html={html} />
      </section>
    )}

    {d.figures.length > 0 && (
      <section class="sec">
        <div class="sec-h"><b>Figures</b><span>{d.figures.length}</span></div>
        <ul class="figs">
          {d.figures.map((f, i) => (
            <li>
              <img src={f.src} alt={f.alt} loading="lazy" />
              <p>Figure {i + 1}. {f.caption}</p>
            </li>
          ))}
        </ul>
      </section>
    )}

    {companion && (
      <section class="sec">
        <div class="sec-h">
          <b>{companion.recordKind === 'project' ? 'The fair entry' : 'The paper'}</b>
        </div>
        <p class="prose">
          {d.recordKind === 'project'
            ? 'This project was also written up as a paper, which carries the methods, the results, and the references.'
            : 'This work was entered at a fair. The entry records the category, the result, and any awards.'}
        </p>
        <p class="row">
          <a
            class="btn"
            href={`/${companion.recordKind === 'project' ? 'projects' : 'articles'}/${companion.year}/${companion.slug}/`}
          >
            {companion.title}
          </a>
        </p>
      </section>
    )}

    {(d.methods.length > 0 || d.dataSources.length > 0 || d.outputs.length > 0 || d.dataLinks.length > 0) && (
      <section class="sec">
        <div class="sec-h"><b>Research at a glance</b></div>
        <div class="glance">
          {d.methods.length > 0 && (
            <div>
              <p class="g-lbl">Methods</p>
              <ul>{d.methods.map((m) => <li>{m}</li>)}</ul>
            </div>
          )}
          {d.dataSources.length > 0 && (
            <div>
              <p class="g-lbl">Data sources</p>
              <ul>{d.dataSources.map((m) => <li>{m}</li>)}</ul>
            </div>
          )}
          {d.outputs.length > 0 && (
            <div>
              <p class="g-lbl">Outputs</p>
              <ul>{d.outputs.map((m) => <li>{m}</li>)}</ul>
            </div>
          )}
          {d.dataLinks.length > 0 && (
            <div>
              <p class="g-lbl">Data and code</p>
              <ul>
                {d.dataLinks.map((l) => (
                  <li><a href={l.url} target="_blank" rel="noopener noreferrer">{l.label}</a></li>
                ))}
              </ul>
            </div>
          )}
        </div>
      </section>
    )}

    {d.contributions && (
      <section class="sec">
        <div class="sec-h"><b>Contributions</b></div>
        <p class="prose">{d.contributions}</p>
      </section>
    )}

    {d.references.length > 0 && (
      <section class="sec">
        <div class="sec-h"><b>References</b><span>{d.references.length}</span></div>
        <ol class="refs">{d.references.map((r) => <li>{r}</li>)}</ol>
      </section>
    )}
  </div>

  <aside class:list={['rail', hue !== null && 'toned']} style={hueStyle} data-pagefind-ignore>
    {d.pdf && (
      <p class="row"><a class="btn pdf" href={d.pdf} target="_blank" rel="noopener noreferrer">Read the paper (PDF)</a></p>
    )}
    <dl class="facts-dl">
      <dt>Published</dt><dd>{published}</dd>
      <dt>Record</dt><dd class="mono">{d.recordId}</dd>
      <dt>Subject</dt><dd><a href={`/topics/${d.discipline}/`}>{disciplineLabel(d.discipline)}</a></dd>
      <dt>Kind</dt><dd>{d.recordKind === 'project' ? 'Fair entry' : 'Paper'}</dd>
      {doi && <><dt>DOI</dt><dd class="mono"><a href={doi} target="_blank" rel="noopener noreferrer">{doi.replace('https://doi.org/', '')}</a></dd></>}
      <dt>License</dt><dd>{d.license}</dd>
    </dl>
    <div class="cite">
      <p class="t-lbl">Cite this record</p>
      <p class="cite-text" id="citation-text">{citation}</p>
      <div class="row" style="margin-top:12px">
        <button class="btn btn-sm" type="button" data-copy="citation-text">Copy citation</button>
        <button class="btn btn-sm btn-q" type="button" data-copy="bibtex-text">Copy BibTeX</button>
      </div>
      <pre id="bibtex-text" hidden>{bibtex}</pre>
    </div>
    <p class="fine">
      {d.reviewed
        ? org.editorialReview
        : d.source === 'migrated'
          ? 'Migrated from an earlier archive. It did not pass through the review process described here.'
          : 'Brought in from work published elsewhere.'}
    </p>
  </aside>
  </div>
</article>

<script>
  /* The embed is created on click and not before. An ordinary iframe would
     contact the video host on load, from a page about a minor's work, on
     behalf of a reader who never asked to watch anything. */
  document.querySelectorAll('.video').forEach((box) => {
    const button = box.querySelector('.play');
    button?.addEventListener('click', () => {
      const frame = document.createElement('iframe');
      frame.src = box.getAttribute('data-embed') ?? '';
      frame.title = 'Video';
      frame.loading = 'lazy';
      frame.allow = 'accelerometer; autoplay; encrypted-media; picture-in-picture';
      frame.allowFullscreen = true;
      frame.referrerPolicy = 'strict-origin-when-cross-origin';
      box.querySelector('.poster')?.replaceWith(frame);
      button.remove();
    });
  });

  document.querySelectorAll('[data-copy]').forEach((button) => {
    button.addEventListener('click', async () => {
      const target = document.getElementById(button.getAttribute('data-copy') ?? '');
      if (!target) return;
      await navigator.clipboard.writeText(target.textContent?.trim() ?? '');
      const original = button.textContent;
      button.textContent = 'Copied';
      setTimeout(() => (button.textContent = original), 2000);
    });
  });
</script>

<style>
  .hero { padding: 28px 0 0; }
  /* The plate: the school's block (the same `--cover` every working page
     opens with), with the subject's colour as its accent — the rule under
     it, the ring, the eyebrow and the subject's name. */
  .plate {
    position: relative;
    overflow: hidden;
    padding: 30px 32px 26px;
    background: var(--cover);
    color: var(--cover-ink);
    border-bottom: 5px solid var(--accent);
  }
  .plate.toned, .rail.toned { --accent: hsl(var(--hue) var(--sat) var(--lum)); }
  .plate::after {
    content: '';
    position: absolute;
    right: -90px;
    top: -110px;
    width: 320px;
    height: 320px;
    border: 24px solid var(--accent);
    border-radius: 50%;
    opacity: 0.18;
    pointer-events: none;
  }
  .plate > * { position: relative; z-index: 1; }
  .plate .t-lbl { color: var(--accent); }
  .plate h1 { color: var(--cover-ink); }
  .plate a { color: inherit; text-decoration-color: var(--accent); }
  .plate .subject { color: var(--accent); }
  .by { margin: 10px 0 0; font-size: 1.05rem; color: var(--cover-ink-2, var(--cover-ink)); }
  .plate .t-lbl a.subject { text-decoration: none; }
  .plate .t-lbl a.subject:hover { text-decoration: underline; }

  /* The columns (dev-167). */
  .cols { display: grid; grid-template-columns: minmax(0, 1fr) 280px; gap: 32px 48px; align-items: start; margin-top: 8px; }
  .rail { position: sticky; top: 16px; padding: 18px 20px 16px; background: var(--card); border: 1px solid var(--rule); border-top: 4px solid var(--accent, var(--brand)); }
  .rail .pdf { width: 100%; text-align: center; }
  .facts-dl { display: grid; grid-template-columns: max-content 1fr; gap: 8px 14px; margin: 16px 0 0; font-size: 0.92rem; }
  .facts-dl dt { font-family: var(--face-ui); font-size: 0.74rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-3); padding-top: 3px; }
  .facts-dl dd { margin: 0; overflow-wrap: anywhere; }
  .facts-dl .mono { font-family: var(--face-num); font-size: 0.88rem; }
  .cite { margin-top: 18px; padding-top: 14px; border-top: 1px solid var(--rule-fine); }
  .cite .cite-text { font-size: 0.9rem; }
  @media (max-width: 900px) {
    .cols { grid-template-columns: minmax(0, 1fr); }
    .rail { position: static; }
  }
  .t-lbl .chip.demo { margin-left: 10px; vertical-align: middle; font-size: 0.72rem; padding: 2px 7px; color: var(--cover-ink); border-color: var(--cover-ink-2, var(--cover-ink)); }
  .demo-note { margin: 14px 0 0; padding: 10px 14px; border: 1px dashed var(--rule); max-width: var(--measure-text); font-size: 0.92rem; color: var(--ink-2); }

  .question {
    margin: 18px 0 0;
    max-width: var(--measure-lede);
    font-size: 1.28rem;
    line-height: 1.45;
    color: var(--cover-ink);
  }
  .demo-note { margin-top: 18px; }

  /* Evidence before prose. Set as a list of facts rather than as prose,
     because that is what it is. */
  .honors {
    list-style: none;
    margin: 24px 0 0;
    padding: 0;
    display: grid;
    gap: 1px;
    background: var(--rule-fine);
    border-block: 1px solid var(--rule-fine);
    max-width: var(--measure-lede);
  }
  .honors li {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 6px 18px;
    padding: 11px 0;
    background: var(--paper);
  }
  .honors b { font-size: 1rem; }
  .honors span {
    font-family: var(--face-num);
    font-size: 0.85rem;
    color: var(--ink-3);
  }

  .glance {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 26px 34px;
    max-width: var(--measure-form);
  }
  .g-lbl {
    margin: 0 0 8px;
    font-family: var(--face-ui);
    font-size: 0.76rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-3);
  }
  .glance ul { list-style: none; margin: 0; padding: 0; }
  .glance li {
    padding: 4px 0;
    line-height: 1.45;
    font-size: 0.95rem;
  }
  @media (max-width: 640px) {
    .glance { grid-template-columns: 1fr; }
  }
  .lede-abs { max-width: var(--measure-read); font-size: 1.05rem; }
  .body { max-width: var(--measure-read); }
  .body :global(h2) { margin: 30px 0 10px; font-size: 1.2rem; }
  .facts { list-style: none; margin: 0; padding: 0; max-width: var(--measure-read); }
  .facts li {
    display: grid;
    gap: 3px;
    padding: 11px 0;
    border-bottom: 1px solid var(--rule-fine);
  }
  .facts span { color: var(--ink-3); font-size: 0.9rem; }
  .shots {
    list-style: none;
    margin: 28px 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 18px;
  }
  .shots.one { grid-template-columns: minmax(0, var(--measure-lede)); }
  .shots img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border: 1px solid var(--rule-fine);
  }
  .shots.one img { aspect-ratio: 16 / 9; }
  .shots p { margin: 8px 0 0; font-size: 0.9rem; color: var(--ink-3); line-height: 1.45; }

  .video {
    position: relative;
    margin: 28px 0 0;
    max-width: var(--measure-lede);
  }
  .video .poster,
  .video :global(iframe) {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    border: 1px solid var(--rule-fine);
    object-fit: cover;
  }
  .video .blank { background: var(--wash); }

  /* Drawn rather than fetched, so it has to look deliberate. An empty box
     reads as a page that failed; this reads as a video that has not been
     asked for yet. */
  .video .drawn {
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 6px;
    background: var(--sunk);
  }
  .video .drawn .host {
    font-family: var(--face-ui);
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--ink-2);
  }
  .video .drawn .quiet {
    font-family: var(--face-mono);
    font-size: 0.76rem;
    color: var(--ink-3);
  }
  .play {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    width: 100%;
    background: none;
    border: 0;
    cursor: pointer;
  }
  .play span {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: var(--ink);
    opacity: 0.86;
    clip-path: circle(50%);
    position: relative;
  }
  .play span::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 54%;
    transform: translate(-50%, -50%);
    border-left: 18px solid var(--paper);
    border-block: 11px solid transparent;
  }
  .play:hover span { opacity: 1; }
  .vnote { margin: 8px 0 0; font-size: 0.88rem; color: var(--ink-3); }

  .figs { list-style: none; margin: 0; padding: 0; display: grid; gap: 24px; }
  .figs img { max-width: 100%; border: 1px solid var(--rule-fine); }
  .figs p { margin: 8px 0 0; color: var(--ink-2); font-size: 0.94rem; }
  .refs { margin: 0; padding-left: 1.4rem; max-width: var(--measure-read); }
  .refs li { margin-bottom: 8px; line-height: 1.5; }
  .cite-text { margin: 0; line-height: 1.6; }
  .doi { margin: 10px 0 0; font-family: var(--face-num); font-size: 0.9rem; }
  .fine { margin-top: 14px; color: var(--ink-3); font-size: 0.84rem; max-width: var(--measure-read); }
</style>
