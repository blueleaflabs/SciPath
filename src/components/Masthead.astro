---
import type { Org } from '../config/orgs';
import { activeOrg } from '../lib/tenant';
import { platform } from '../config/site';
import { SESSION_HINT } from '../lib/session-hint';

interface Props {
  /** Passed down by the layout, which resolved it from the hostname. */
  org?: Org;
}

const org = Astro.props.org ?? activeOrg(Astro);

/**
 * Five items, down from seven.
 *
 * **Showcase holds both kinds.** Papers and fair entries were two items, and
 * two items rank them: most work at a high school fair never becomes a
 * paper, so the second label is where the student who did real work and did
 * not write it up ends up. Every other reading surface already mixes them —
 * author pages, topic listings, search — so this is the index catching up
 * rather than a new idea. `/articles/` and `/projects/` are unchanged and
 * are the filtered views.
 *
 * **Mistakes is gone from here.** 7.11 decided that a wall of things that
 * can go wrong, read by somebody who has not started, is paralyzing or
 * forgettable, and 9.3 removed it from the page inventory. It shipped
 * anyway and stayed in the nav for four versions. The page remains and
 * Guides links to it; what it stops being is a destination.
 *
 * About, contact, policies and the schools page live in the footer, which
 * is where a reader looks for them and where they stop competing with the
 * archive for a glance.
 */
/**
 * **The platform's nav is not the school's.** A school's visitor arrived
 * because they are at that school, and what they want from the bar is the
 * archive and the guides. Somebody at the front door has been told nothing
 * and is deciding, so they get the two pages that decide it: what this does,
 * and a season they can open without making an account.
 *
 * Still four items rather than seven. The audience pages route from the home
 * page and the footer, which is where somebody choosing between four
 * descriptions of themselves is already looking. Publishing is a thing you
 * do after starting, so at the front door it sits in the footer and at a
 * school, where people arrive mid-season, it does not.
 */
/* **Demo is not a destination the masthead offers.**

   `/try/` was the fourth item and it does not belong beside three pages that
   describe the product: a demonstration is something a reader is shown once
   they have a reason to want one, and putting it in the top bar offers a
   sandbox to somebody who has not yet learned what the real thing is. The
   page stays, the footer and `/get-started/` both route to it, and where it
   belongs in the front-door sequence is a decision still to make. */
const nav = org.isPlatform
  ? [
      { href: '/how-it-works/', label: 'How it works' },
      { href: '/showcase/', label: 'Showcase' },
      { href: '/guides/', label: 'Guides' },
    ]
  : [
      { href: '/showcase/', label: 'Showcase', key: 'showcase' },
      { href: '/guides/', label: 'Guides', key: 'guides' },
      { href: '/submit/', label: 'Publish', key: 'publish' },
    ].filter((n: any) => {
      /* A pilot keeps a link off the bar until a date (org-shape.ts,
         `hiddenUntil`). The page still answers; only the way in is
         withheld. */
      const h = org.hiddenUntil;
      if (!h || !n.key || !h.surfaces.includes(n.key)) return true;
      return new Date().toISOString().slice(0, 10) >= h.date;
    });

/* The working surface, reachable from every page. On a prerendered page
   there is no session to read, so the label is the invitation rather than the
   state: /app/ shows a sign-in prompt or the overview, whichever is true. */
const locals = (Astro.locals as any) ?? {};
const signedIn = Boolean(locals.session);
const account = locals.account ?? null;

/* Consent shows as a fragment beside the name rather than a banner on every
   page. It is a state, not an announcement. */
const consentNote =
  account?.consent_state === 'pending'
    ? 'Consent pending'
    : account?.consent_state === 'paused'
      ? 'Consent needed'
      : null;

const here = Astro.url.pathname;
/* Two letters for the chip: the first of the first and last names. */
const initialsOf = (name: string) => { const w = String(name ?? '').trim().split(/\s+/).filter(Boolean); return ((w[0]?.[0] ?? '') + (w.length > 1 ? w[w.length - 1][0] : '')).toUpperCase() || '·'; };
const isCurrent = (href: string) => here === href || (href !== '/' && here.startsWith(href));
---

<header class="mast">
  <div class="wrap">
    <div class="mast-in">
      <a class="lockup" href="/">
        <span class="badge" data-len={String(org.mark.length)} aria-hidden="true">{org.mark}</span>
        <span class="names">
          <span class="org">{org.shortName ?? org.name}</span>
          {!org.isPlatform && <span class="plat">{platform.lockupSuffix}</span>}
        </span>
      </a>
      <nav aria-label="Main" class="mnav-bar">
        <ul class="mnav">
          {
            nav.map((item) => (
              <li>
                <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>

        {/* Searching is a control, not a section.
        
            It sat in the link row as the word "Search", which is a page you
            navigate to in order to reach a box. One fewer step: the box is
            here, and it submits to the same page, which then does what it
            always did. The magnifying glass is the submit control rather
            than a decoration, so a keyboard reaches it and a screen reader
            is told what it does.
        
            A plain GET form, so this works with no script at all — the page
            it lands on reads `?q=` and runs the query. Nothing here needs to
            know how the search itself works. */}
        <form class="mnav-find" role="search" method="GET" action="/search/">
          <label class="skip" for="mnav-q">Search</label>
          <input
            id="mnav-q"
            type="search"
            name="q"
            autocomplete="off"
            placeholder="Search"
          />
          <button class="mnav-go" type="submit" aria-label="Search">
            <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
              <circle cx="7" cy="7" r="4.5" fill="none" stroke="currentColor" stroke-width="1.6" />
              <line x1="10.4" y1="10.4" x2="14" y2="14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
            </svg>
          </button>
        </form>

        {/* The account cluster is a separate group with a rule before it.
            Sections and "who am I" are different kinds of thing and should
            not read as one run of links. */}
        <ul class="mnav mnav-acct">
          {/* **Feedback, on every page, in the accent.** During a pilot the
              value of a report decays by the hour, so the way to send one
              is the one loud thing in the bar. Carries the page it was
              pressed on. */}
          <li class="mnav-fb">
            <a href={`/feedback/?from=${encodeURIComponent(here)}`}>Feedback</a>
          </li>
          {signedIn && account ? (
            <>
              {/* Signed in, the bar reads Feedback, Workbench, the name
                  (which opens the profile), Sign out (2.8). Workbench is
                  the way in; the name is who. */}
              <li>
                <a href="/app/" aria-current={here.startsWith('/app/') && here !== '/app/profile/' ? 'page' : undefined}>Workbench</a>
              </li>
              <li class="mnav-who">
                <a href="/app/profile/" class="mnav-me" aria-current={here === '/app/profile/' ? 'page' : undefined} title="My profile">
                  <span class="mnav-ini" aria-hidden="true">{initialsOf(account.display_name)}</span>
                  <span>{account.display_name}</span>
                </a>
                {consentNote && <span class="mnav-flag">{consentNote}</span>}
              </li>
              <li>
                <form method="POST" action="/auth/signout/">
                  <button type="submit" class="mnav-out">Sign out</button>
                </form>
              </li>
            </>
          ) : (
            <>
              {/* A prerendered page cannot ask who is here, so it renders
                  both answers and the script below picks. The signed in one
                  is hidden rather than built by script, because a sign out
                  is a POST form and markup is the honest place for it. */}
              <li class="mnav-cta" data-anon>
                {/* "Login" to somebody not signed in: the standard word for
                    the door. The page behind it is still the Workbench. */}
                <a href="/app/" aria-current={here.startsWith('/app/') ? 'page' : undefined}>
                  Login
                </a>
              </li>

              {/* The same two elements as the rendered cluster above, filled
                  in by the script below. Present and empty rather than built
                  in script: markup written by JavaScript is markup no test
                  reads, and the flag has a shape the stylesheet has to know
                  about either way. */}
              <li data-known hidden>
                <a href="/app/">Workbench</a>
              </li>
              <li class="mnav-who" data-known hidden>
                <a href="/app/profile/" class="mnav-me" title="My profile"><span class="mnav-ini" aria-hidden="true" data-initials></span><span data-name></span></a>
                <span class="mnav-flag" data-consent hidden></span>
              </li>
              <li data-known hidden>
                <form method="POST" action="/auth/signout/">
                  <button type="submit" class="mnav-out">Sign out</button>
                </form>
              </li>
            </>
          )}
        </ul>
      </nav>
    </div>
  </div>
</header>

{/* Which of the two answers above is right.
 
    A prerendered page has no session, so it greeted somebody who had signed
    in a minute earlier as though they had not. The hint cookie carries their
    display name; this reads it and shows the cluster the rest of the site
    shows, rather than a bare link that reads as *not you*.
 
    Only where the server could not know. Where it rendered the account
    cluster there is nothing to correct, and running this there would be a
    second opinion about a fact the page already has. */}
{!signedIn && (
  <script is:inline define:vars={{ hint: SESSION_HINT }}>
    (() => {
      const raw = document.cookie
        .split('; ')
        .find((c) => c.startsWith(hint + '='));
      if (!raw) return;

      /* `name|state`, and the name is encoded, so a pipe can only be the
         delimiter. A cookie written by an older build carries no pipe and
         reads as a name with no state, which is the correct answer for it. */
      const value = raw.slice(hint.length + 1);
      const cut = value.indexOf('|');
      const state = cut === -1 ? '' : value.slice(cut + 1);

      let name = '';
      try {
        name = decodeURIComponent(cut === -1 ? value : value.slice(0, cut));
      } catch {
        return;
      }
      if (!name) return;

      const who = document.querySelector('[data-name]');
      if (who) who.textContent = name;
      const ini = document.querySelector('[data-initials]');
      if (ini) { const w = name.trim().split(/\s+/).filter(Boolean); ini.textContent = ((w[0]?.[0] ?? '') + (w.length > 1 ? w[w.length - 1][0] : '')).toUpperCase() || '·'; }

      /* The consent flag, on a page the server could not render it on.
      
         A student waiting on a guardian is limited everywhere, not only on
         the pages that happen to be rendered per request, and finding that
         out by walking into a refusal is worse than being told. The word is
         chosen here rather than carried in the cookie so that changing it is
         a change to this file. */
      const flag = document.querySelector('[data-consent]');
      const words = { pending: 'Consent pending', paused: 'Consent needed' };

      if (flag && words[state]) {
        flag.textContent = words[state];
        flag.removeAttribute('hidden');
      }

      document.querySelectorAll('[data-anon]').forEach((el) => el.setAttribute('hidden', ''));
      document.querySelectorAll('[data-known]').forEach((el) => el.removeAttribute('hidden'));
    })();
  </script>
)}

<style>
  /* ONE SHAPE FOR THE CLUSTER (2.9). Feedback, Workbench (or Login), the
     name and Sign out were four kinds of control: a gold block, an
     underlined link, a pill, a bare button. They are one kind now, the
     bordered button the working-surface tabs below use, in the masthead's
     colours: Feedback filled gold, the page you are on filled pale, the
     rest outlined. The name keeps its initials inside the same shape. */
  .mnav-acct a,
  .mnav-acct .mnav-out {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 12px;
    border: 1.5px solid var(--masthead-ink-2);
    border-radius: 3px;
    background: none;
    color: var(--masthead-ink);
    font-family: var(--face-ui);
    font-weight: 600;
    font-size: 0.86rem;
    line-height: 1.2;
    letter-spacing: 0.02em;
    text-decoration: none;
    cursor: pointer;
    transition: background-color 120ms ease, border-color 120ms ease;
  }
  .mnav-acct a:hover,
  .mnav-acct a:focus-visible,
  .mnav-acct .mnav-out:hover,
  .mnav-acct .mnav-out:focus-visible,
  .mnav-acct a[aria-current='page'] {
    background: color-mix(in srgb, var(--masthead-ink) 16%, transparent);
    border-color: var(--masthead-ink);
    text-decoration: none;
  }
  .mnav-fb a {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--accent-ink);
    font-family: var(--face-num);
    font-weight: 700;
    font-size: 0.78rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .mnav-fb a:hover,
  .mnav-fb a:focus-visible { background: var(--accent-pale); border-color: var(--accent-pale); color: var(--accent-ink); }

  /* ONE ROW, AND WHAT GIVES WAY BEFORE IT BECOMES TWO.
  
     `wrap` was the whole answer, so the row split whenever the total ran over
     — which is silent, looks like a rendering fault, and puts the section
     rule between the sections it is meant to separate.
  
     Above the narrow breakpoint nothing wraps, and the pressure goes where it
     costs least: `min-width: 0` lets this group shrink below its content, and
     the search field is the only child that can lose width without losing
     meaning. A nav item that wraps loses a section; a field that narrows
     loses characters somebody is about to type over anyway.
  
     Below it, wrapping is the only honest behavior, and it comes back. */
  .mnav-bar {
    display: flex;
    align-items: center;
    gap: 22px;
    flex-wrap: wrap;
  }

  @media (min-width: 861px) {
    .mnav-bar { flex-wrap: nowrap; min-width: 0; }
    .mnav { flex-wrap: nowrap; }
    .mnav-acct { flex-wrap: nowrap; }
  }

  .mnav-acct {
    align-items: center;
    padding-left: 22px;
    border-left: 1px solid var(--masthead-ink-2);
    /* Never the thing that wraps. Adding the search field pushed this group
       — the workbench link, or somebody's name and sign out — onto a second
       line, which turned a one line bar into two and moved the rule that
       separates the sections into the middle of nowhere. The field gives up
       width instead; it is the only element here that can lose some without
       losing meaning. */
    flex: 0 0 auto;
    white-space: nowrap;
  }

  /* A control on a dark bar.
  
     Outlined rather than filled, so it reads as part of the masthead rather
     than as a white box dropped on it, and the field and its button share one
     border so they are one control rather than two. It shrinks before the
     links do: a nav item that wraps loses a section, and a search field that
     narrows loses nothing but characters. */
  .mnav-find {
    display: flex;
    align-items: stretch;
    flex: 1 1 8rem;
    max-width: 14rem;
    min-width: 4.5rem;
    border: 1px solid var(--masthead-ink-2);
  }
  .mnav-find input {
    flex: 1 1 auto;
    min-width: 0;
    padding: 5px 9px;
    border: 0;
    background: none;
    color: var(--masthead-ink);
    font-family: var(--face-ui);
    font-size: 0.92rem;
  }
  .mnav-find input::placeholder { color: var(--masthead-ink-2); }
  /* The field carries the outline, so the ring goes on the whole control
     rather than inside it. */
  .mnav-find input:focus { outline: none; }
  .mnav-find:focus-within { border-color: var(--masthead-ink); }
  .mnav-go {
    display: flex;
    align-items: center;
    padding: 0 9px;
    border: 0;
    background: none;
    color: var(--masthead-ink-2);
    cursor: pointer;
  }
  .mnav-go:hover,
  .mnav-go:focus-visible { color: var(--masthead-ink); }
  .mnav-find svg { width: 15px; height: 15px; display: block; }

  /* THE FLAG GOES UNDER THE NAME, NOT BESIDE IT.
  
     Beside it, "CONSENT PENDING" is about a hundred and fifty pixels of a row
     that has none to spare: the bar broke into two lines, the lockup on one
     and everything else on the other, and the rule that separates the
     sections ended up in the middle of nowhere. Shrinking the search field
     buys back most of it and not all, and buying it back at one width only
     moves the break to the next width down.
  
     Under it costs nothing at all. The bar is already two lines tall because
     the lockup is — the school's name over the platform suffix — so a name
     with a marker beneath it is the same shape in the same height, and it is
     the shape this masthead already uses to say a second thing about a
     first. */
  .mnav-who {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    gap: 2px;
    line-height: 1.2;
  }
  /* The name is a chip with initials (2.9), so it reads as the profile
     it opens rather than a caption saying who is signed in. */
  .mnav .mnav-me { padding: 4px 12px 4px 5px; }
  .mnav-ini {
    display: inline-grid;
    place-items: center;
    width: 1.7em;
    height: 1.7em;
    border-radius: 50%;
    background: var(--brand-mark);
    color: var(--brand-deep);
    font-family: var(--face-num);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.02em;
  }

  .mnav-flag {
    font-family: var(--face-num);
    font-size: 0.66rem;
    line-height: 1.4;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 0 5px;
    border: 1px solid currentColor;
    color: var(--masthead-ink-2);
    white-space: nowrap;
  }

  /* `font: inherit` took the body serif at full size, so this button was
     half again as large as the links beside it. It has to match .mnav a. */
  .mnav-out { line-height: 1.2; }
  /* A hidden cluster item stays hidden (2.9): the row's flex display
     had been winning over the attribute, and the empty chip showed on a
     page rendered before anybody signed in. */
  .mnav-acct li[hidden] { display: none; }

  /* ── ON A PHONE (2.8) ──────────────────────────────────────────
     Below the one-line width, everything above that was told never to
     wrap or shrink is allowed to: the account cluster (Feedback, Workbench,
     the name, Sign out) had `nowrap` and `flex: 0 0 auto` for the laptop's
     sake and, with no exception here, ran off the right edge and pushed
     the whole page sideways. Now the bar is a stack: the search on its own
     line, full width; the sections on one; the account cluster on the
     next, wrapping as it must, with the rule between the groups gone
     because they are no longer side by side. Everything is left-aligned,
     in the order a thumb reads it. */
  @media (max-width: 860px) {
    .mnav-bar { flex: 1 1 auto; min-width: 0; gap: 10px 18px; }
    .mnav, .mnav-acct { flex-wrap: wrap; gap: 8px 18px; }
    .mnav-acct { padding-left: 0; border-left: 0; flex: 1 1 100%; white-space: normal; min-width: 0; }
    /* The search beside the lockup on a tablet, the sections and the
       account cluster on the row below. */
    .mnav-find { flex: 1 1 10rem; max-width: none; order: -1; }
    .mnav-who { flex-direction: row; align-items: center; gap: 8px; }
  }
  /* A phone: everything stacks, the search full width on its own row. */
  @media (max-width: 600px) {
    .mnav-bar { width: 100%; }
    .mnav-find { flex: 1 1 100%; }
  }
</style>
