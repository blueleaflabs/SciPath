---
interface Props {
  eyebrow?: string;
  title: string;
  lede?: string;
}
const { eyebrow, title, lede } = Astro.props;
---

<div class="wrap">
  <div class="page-head">
    {eyebrow && <p class="t-lbl">{eyebrow}</p>}
    <h1 class="t-big">{title}</h1>
    {lede && <p class="lede">{lede}</p>}
    <slot />
  </div>
</div>
