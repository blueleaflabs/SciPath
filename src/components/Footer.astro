---
import type { Org } from '../config/orgs';
import { activeOrg } from '../lib/tenant';
import { platform } from '../config/site';

interface Props {
  /** Passed down by the layout, which resolved it from the hostname. */
  org?: Org;
}

const org = Astro.props.org ?? activeOrg(Astro);

const columns = [
  /* The footer is where the two kinds are still named separately, and that
     is deliberate. The nav is a glance and must not rank them; a footer is a
     directory, and somebody looking specifically for fair entries should be
     able to say so. */
  {
    label: 'Read',
    links: [
      { href: '/showcase/', label: 'Showcase' },
      { href: '/showcase/?kind=article', label: 'Papers' },
      { href: '/showcase/?kind=project', label: 'Fair entries' },
      { href: '/authors/', label: 'Authors' },
      { href: '/topics/', label: 'Topics' },
      { href: '/search/', label: 'Search' },
    ],
  },
  {
    label: 'Use it',
    links: [
      { href: '/how-it-works/', label: 'How it works' },
      { href: '/guides/', label: 'Guides' },
      { href: '/mistakes/', label: 'Common mistakes' },
      { href: '/submit/', label: 'Publish your work' },
      /* **Both of these were orphaned within two sessions.** `/get-started/`
         was reached from a button in the home hero and `/try/` from the
         masthead; the button went when the hero lost its buttons and the nav
         item went when Demo left the top bar, and neither cut noticed that it
         had taken the page's only route with it. A footer is a directory, so
         this is where a page lands when it is real and does not belong in a
         four-item bar. */
      ...(org.isPlatform
        ? [
            { href: '/get-started/', label: 'Get started' },
            { href: '/try/', label: 'Demonstration' },
          ]
        : []),
    ],
  },
  /* **The four readers, addressed by name.** The masthead deliberately does
     not rank sections and cannot hold four audience pages without becoming
     the seven-item bar it was cut down from. A footer is a directory, which
     is exactly the shape a list of "which of these am I" wants.

     `/for-organizations/` belongs to the platform and redirects at a school,
     so it is offered where it leads somewhere. */
  {
    label: 'Who it is for',
    links: [
      { href: '/for-students/', label: 'Students' },
      { href: '/for-educators/', label: 'Educators' },
      { href: '/for-student-leaders/', label: 'Student leaders' },
      ...(org.isPlatform
        ? [{ href: '/for-organizations/', label: 'Schools and clubs' }]
        : []),
    ],
  },
  {
    label: 'Trust',
    links: [
      { href: '/policies/privacy/', label: 'What we store' },
      { href: '/policies/editorial/', label: 'Editorial policy' },
      { href: '/policies/takedown/', label: 'Takedown' },
      { href: '/policies/accessibility/', label: 'Accessibility' },
    ],
  },
  {
    label: 'About',
    links: [
      { href: '/about/', label: 'About' },
      { href: '/contact/', label: 'Contact' },
      /* Written for a school deciding whether to adopt this, which is a
         different reader from a student and does not belong in a nav aimed
         at students. */
      { href: platform.repoUrl, label: 'Source code' },
    ],
  },
];
---

<footer class="ft">
  <div class="wrap">
    <div class="ft-c">
      <div>
        <p class="t-mark">{platform.name}</p>
        <p class="t-sm" style="color:var(--masthead-ink); margin-top:10px; max-width:32ch">
          {platform.tagline}
        </p>
      </div>
      {
        columns.map((col) => (
          <div>
            <p class="t-lbl">{col.label}</p>
            <ul>
              {col.links.map((l) => (
                <li>
                  <a href={l.href}>{l.label}</a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
    {/* **No line about not tracking readers.** It said reading requires no
        account and nothing is stored about you, which is true and reads as a
        defence — answering an accusation nobody made, in the place a reader
        looks for who runs this. What remains states what happens to a
        student's work and who is responsible for it, which are the two facts
        a footer is for. Positive declarations over statements of absence. */}
    <p class="ft-base">
      We do not sell student data, show advertising, or build profiles. Published
      records carry the license stated on the record; authors keep copyright.<br />
      {org.isPlatform ? platform.operatorCredit : `${org.name} runs on ${platform.name}, free and open source software.`}
    </p>
  </div>
</footer>
