---
import type { Org } from '../config/orgs';
import { activeOrg } from '../lib/tenant';
import { platform } from '../config/site';

interface Props {
  /** Passed down by the layout, which resolved it from the hostname. */
  org?: Org;
}

const org = Astro.props.org ?? activeOrg(Astro);

const columns = [
  /* The footer is where the two kinds are still named separately, and that
     is deliberate. The nav is a glance and must not rank them; a footer is a
     directory, and somebody looking specifically for fair entries should be
     able to say so. */
  {
    label: 'Read',
    links: [
      { href: '/showcase/', label: 'Showcase' },
      { href: '/showcase/?kind=article', label: 'Papers' },
      { href: '/showcase/?kind=project', label: 'Fair entries' },
      { href: '/authors/', label: 'Authors' },
      { href: '/topics/', label: 'Topics' },
      { href: '/search/', label: 'Search' },
    ],
  },
  {
    label: 'Use it',
    links: [
      { href: '/guides/', label: 'Guides' },
      { href: '/mistakes/', label: 'Common mistakes' },
      { href: '/submit/', label: 'Publish your work' },
    ],
  },
  {
    label: 'Trust',
    links: [
      { href: '/policies/privacy/', label: 'What we store' },
      { href: '/policies/editorial/', label: 'Editorial policy' },
      { href: '/policies/takedown/', label: 'Takedown' },
      { href: '/policies/accessibility/', label: 'Accessibility' },
    ],
  },
  {
    label: 'About',
    links: [
      { href: '/about/', label: 'About' },
      { href: '/contact/', label: 'Contact' },
      /* Written for a school deciding whether to adopt this, which is a
         different reader from a student and does not belong in a nav aimed
         at students. */
      { href: platform.repoUrl, label: 'Source code' },
    ],
  },
];
---

<footer class="ft">
  <div class="wrap">
    <div class="ft-c">
      <div>
        <p class="t-mark">{platform.name}</p>
        <p class="t-sm" style="color:var(--masthead-ink); margin-top:10px; max-width:32ch">
          {platform.tagline}
        </p>
      </div>
      {
        columns.map((col) => (
          <div>
            <p class="t-lbl">{col.label}</p>
            <ul>
              {col.links.map((l) => (
                <li>
                  <a href={l.href}>{l.label}</a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
    <p class="ft-base">
      Reading anything on this site requires no account, and nothing is stored about you when
      you do. We do not sell student data, show advertising, or build profiles. Published
      records carry the license stated on the record; authors keep copyright.<br />
      {org.isPlatform ? platform.operatorCredit : `${org.name} runs on ${platform.name}, free and open source software.`}
    </p>
  </div>
</footer>
