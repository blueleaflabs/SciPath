---
import type { Org } from '../config/orgs';

interface Props {
  org: Org;
  account: any;
  here: string;
  roles?: { role: string }[];
}

const { org, account, here, roles = [] } = Astro.props;

const nav = [
  { href: '/app/', label: 'Overview' },
  { href: '/app/fairs/', label: 'Fairs' },
  { href: '/app/profile/', label: 'Profile' },
];
---

<nav class="appnav" aria-label="Working surface">
  <ul>
    {nav.map((n) => (
      <li>
        <a href={n.href} aria-current={here === n.href ? 'page' : undefined}>{n.label}</a>
      </li>
    ))}
  </ul>
  <form method="POST" action="/auth/signout/">
    <button type="submit" class="linkish">Sign out</button>
  </form>
</nav>

{account?.consent_state === 'pending' && (
  <p class="note" role="status">
    Your account is active and you can work normally. Publishing waits until your
    parent or guardian confirms by email.
  </p>
)}

{account?.consent_state === 'paused' && (
  <p class="note" role="alert">
    Work is paused until your parent or guardian confirms.
    <a href="/app/profile/">Check the address we have</a>.
  </p>
)}

<style>
  .appnav {
    display: flex;
    align-items: center;
    gap: 18px;
    border-bottom: 1px solid var(--rule-fine);
    padding-bottom: 10px;
    margin-bottom: 26px;
  }
  .appnav ul {
    display: flex;
    gap: 18px;
    list-style: none;
    margin: 0;
    padding: 0;
    margin-right: auto;
  }
  .appnav a {
    font-family: var(--face-ui);
    font-size: 0.82rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--ink-3);
  }
  .appnav a[aria-current='page'] {
    color: var(--ink);
    box-shadow: inset 0 -2px 0 var(--brand-mark);
  }
  .linkish {
    background: none;
    border: 0;
    padding: 0;
    cursor: pointer;
    font-family: var(--face-ui);
    font-size: 0.82rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--ink-3);
  }
</style>
