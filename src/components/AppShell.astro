---
import type { Org } from '../config/orgs';

interface Props {
  org: Org;
  account: any;
  here: string;
  roles?: { role: string }[];
}

const { org, account, here, roles = [] } = Astro.props;

import { standing } from '../lib/roles';
import { env } from '../lib/supabase';
import { inClass } from '../lib/live-plan';

/* The socket's address and public key, for the browser (2.8). Read from
   the request's environment, since the Worker gets its variables at
   request time and a build cannot bake them in. */
const runtimeEnv = (Astro.locals as any).runtime?.env;
const liveUrl = env('PUBLIC_SUPABASE_URL', runtimeEnv);
const liveKey = env('PUBLIC_SUPABASE_PUBLISHABLE_KEY', runtimeEnv);
const livePlan = JSON.stringify({ ...org.live, timezone: org.timezone });
const classNow = inClass(org.live, new Date(), org.timezone);

const me = standing(roles, account?.population);

/* Editor is a standing fact about a person, unlike reviewing, which is an
   attachment to one submission and therefore never appears here. */
const isEditor = me.isEditor;

/* Profile and sign out live in the masthead, top right, where an account
   menu belongs. This bar is for the work.
 
   Assign, Editorial, Publish. Two are the verb of the job and the third is
   deliberately not: an editor screens, consolidates and decides, and
   "Review" is what the *reviewers* do at /app/review/{id}. One word sending
   two roles to two different places is worse than one label that names a
   role rather than an act.
 
   `Entries` and `Selection` are both gone, for one reason: each held the
   same list the overview holds. Entries listed a student's participations
   beside the overview's own list of them, and Selection listed the school's
   projects beside the overview's, differing by one column. A student's nav
   is one item now, which is right, because a student navigates from their
   project rather than from a bar.

   `What goes wrong` went for the same reason and one better. It was a raw
   list of every warning the club had ever written, which is a page nobody
   reads before they need it and cannot find the right line in once they do.
   The warnings themselves are not gone: they are written on a step and shown
   on that step, next to the work they are warning about, which is the only
   moment they are worth reading. */
/* A class showcase, for anybody who may open one. Labelled with the
   program's own short name, because "Showcase" alone is the public archive
   in the masthead and the two are not the same thing. */
const showcases = ((Astro.locals as any).showcases ?? []) as { program_id: string; name: string; short_name: string | null }[];

/* The class page, for the advisor who runs it: the teacher's day, which
   the Workbench's project list is not. */
const classes = ((Astro.locals as any).classes ?? []) as { program_id: string; name: string; short_name: string | null }[];

/* The reader's own projects, for the tabs that are the project's pages.
   A person with one project gets *My project* (its place in the class,
   which is where the plate and the calendar are), *Notebook*, and one
   more tab per further place the same project is in (*In SCVSEFA*), so
   the tab bar is the model drawn for one person: the notebook is the
   project's and each calendar is a place's. Somebody with two projects
   navigates from the Workbench, where both are cards. */
const projects = ((Astro.locals as any).projects ?? []) as { project_id: string; title: string; places: { program_id: string; name: string; short_name: string | null; cohort: boolean }[] }[];
const one = projects.length === 1 ? projects[0] : null;
const projectTabs = one
  ? [
      ...(one.places[0]
        ? [{ href: `/app/project/${one.project_id}/in/${one.places[0].program_id}/`, label: 'My project' }]
        : []),
      /* The Notebook tab is off the bar for the pilot (2.8): the notebook
         is a section of the project page now, and the full notebook page
         (images, export) is linked from there. */
      ...one.places.slice(1).map((pl) => ({ href: `/app/project/${one.project_id}/in/${pl.program_id}/`, label: `In ${pl.short_name ?? pl.name}` })),
    ]
  : [];

/* Whoever runs a class lands on it from `/app/`, and supervises from it:
   the Workbench's care list is the class as a table, which the Class
   page does better, so the tab is off her bar (the page still answers
   at `?view=workbench`). A student with one project lands on it and has
   its pages as tabs; the Workbench is where they go with two. Everybody
   else, which is an Elder, has the Workbench first. */
const landsOnProject = classes.length === 0 && !me.runsTheClub && one !== null && one.places.length > 0;
/* The tracker: the family's scores, the teacher's whole class and the
   Elder's own family, filled in on the grid. */
const families = ((Astro.locals as any).families ?? []) as { program_id: string; name: string; short_name: string | null }[];
const trackers = [
  ...classes.map((c) => ({ href: `/app/program/${c.program_id}/tracker/`, label: `${c.short_name ?? c.name} Tracker` })),
  ...families.filter((f) => !classes.some((c) => c.program_id === f.program_id)).map((f) => ({ href: `/app/program/${f.program_id}/tracker/`, label: `${f.short_name ?? f.name} Tracker` })),
];

const nav = [
  ...classes.map((c) => ({ href: `/app/program/${c.program_id}/class/`, label: `${c.short_name ?? c.name} Class` })),
  ...(classes.length === 0 && !landsOnProject ? [{ href: '/app/', label: 'Projects Workbench' }] : []),
  ...projectTabs,
  ...trackers,
  ...showcases.map((s) => ({ href: `/app/program/${s.program_id}/showcase/`, label: `${s.short_name ?? s.name} Showcase` })),
  ...(isEditor ? [{ href: '/app/editorial/', label: 'Editorial', key: 'editorial' }] : []),
  ...(isEditor ? [{ href: '/app/publish/', label: 'Publish', key: 'publish' }] : []),
  ...(me.runsTheClub ? [{ href: '/app/assign/', label: 'Assign', key: 'assign' }] : []),
  ...(me.isAdvisor ? [{ href: '/app/roles/', label: 'Roles', key: 'roles' }] : []),
].filter((n: any) => {
  /* A school's pilot can keep a tab off the bar until a date (org-shape.ts,
     `hiddenUntil`). The page still answers; only the way in is withheld. */
  const h = org.hiddenUntil;
  if (!h || !n.key || !h.surfaces.includes(n.key)) return true;
  return new Date().toISOString().slice(0, 10) >= h.date;
});
---

<nav class="appnav" aria-label="Working surface" data-live-url={liveUrl} data-live-key={liveKey} data-live-me={account?.id ?? ''} data-live-plan={livePlan} data-live-class={classNow ? '1' : '0'}>
  <ul>
    {nav.map((n) => (
      <li>
        <a href={n.href} aria-current={here === n.href.split('?')[0] ? 'page' : undefined}>{n.label}</a>
      </li>
    ))}
  </ul>
</nav>

<script>
  import { live, join, myTopics, onMessage, onHealth, fail, health, type Health } from '../lib/live-client';
  import { inClass, fallbackDelay } from '../lib/live-plan';
  /**
   * LIVE REGIONS (2.8).
   *
   * A page marks the parts of itself that other people change (a thread
   * under a field, the plate, the care table) with `data-live="name"`.
   * When a change arrives, the page is fetched again and each live region
   * is replaced by its newer self, unless the reader is typing inside it.
   * Nothing else on the page moves, the editors keep their text, and a
   * reply to a question arrives where the question was asked. A region
   * that gains new markup announces `live:updated` so a page's script can
   * rebind what it needs. Server-rendered pages need no other work.
   *
   * HOW A CHANGE ARRIVES. Over the socket, first: the browser joins the
   * person's own channel and the rooms of their projects and classes, and
   * the database broadcasts into those rooms from triggers. The edge sees
   * nothing of it. Only when the socket will not connect (a school network
   * that drops WebSockets, most often) does this fall back to asking the
   * pulse, paced by the school's clock: quickly during a class period,
   * once an hour outside one. The fallback is announced on the page, and
   * reported once so whoever runs the platform hears about the network.
   */
  const regions = () => Array.from(document.querySelectorAll<HTMLElement>('[data-live]'));
  const nav = document.querySelector<HTMLElement>('.appnav');
  const plan = (() => { try { return JSON.parse(nav?.dataset.livePlan ?? ''); } catch { return null; } })();

  let busy = false;
  let queued = false;
  const refresh = async () => {
    if (regions().length === 0) return;
    if (busy) { queued = true; return; }
    busy = true;
    try {
      const res = await fetch(location.pathname + location.search, { credentials: 'same-origin', cache: 'no-store', headers: { 'X-Live': '1' } });
      if (!res.ok) return;
      const fresh = new DOMParser().parseFromString(await res.text(), 'text/html');
      for (const el of regions()) {
        const key = el.dataset.live!;
        const next = fresh.querySelector<HTMLElement>(`[data-live="${CSS.escape(key)}"]`);
        if (!next || next.innerHTML === el.innerHTML) continue;
        const active = document.activeElement;
        if (active && active !== document.body && el.contains(active)) continue;
        /* Open disclosures stay open across the swap. */
        const open = new Set(Array.from(el.querySelectorAll<HTMLDetailsElement>('details[open]')).map((d) => d.id || d.dataset.key || ''));
        el.innerHTML = next.innerHTML;
        for (const d of el.querySelectorAll<HTMLDetailsElement>('details')) if (open.has(d.id || d.dataset.key || '') && (d.id || d.dataset.key)) d.open = true;
        el.dispatchEvent(new CustomEvent('live:updated', { bubbles: true }));
      }
    } catch { /* the next message or tick tries again */ }
    finally {
      busy = false;
      if (queued) { queued = false; window.setTimeout(() => refresh(), 400); }
    }
  };
  /* A burst of messages (a save and its broadcasts) is one re-read. */
  let coalesce: number | undefined;
  const refreshSoon = () => { window.clearTimeout(coalesce); coalesce = window.setTimeout(() => refresh().catch(() => {}), 350); };
  /* A page that just wrote something asks for its regions now. */
  document.addEventListener('live:refresh', () => { refresh().catch(() => {}); });

  /* Back to a page the browser kept (2.9). The back button can restore a
     page from its own cache without asking the server, no-store or not
     (Safari always; Chrome increasingly), so the deliverables list still
     said Start after the document it linked to had been opened. A page
     restored that way is a page that missed everything: its regions
     re-read at once, and a page with no regions is reloaded. */
  window.addEventListener('pageshow', (ev) => {
    if (!ev.persisted) return;
    if (regions().length > 0) refresh().catch(() => location.reload());
    else location.reload();
  });

  /* ── The socket ─────────────────────────────────────────────────────── */
  const st = live();
  if (st) {
    onMessage((m) => {
      /* A field broadcast is the document page's business (it updates the
         one box); everything else is a region re-read. */
      if (m.event === 'field') return;
      refreshSoon();
    });
    document.addEventListener('live:reconnected', () => refreshSoon());
    myTopics().then((topics) => {
      if (topics.length === 0) { fail('no topics for this session'); return; }
      for (const t of topics) join(t);
    }).catch((e) => fail(`topics: ${e?.message ?? e}`));
  }

  /* ── The backup: the pulse, on the school's clock ───────────────────── */
  let last: string | null = null;
  let pollBusy = false;
  const tick = async () => {
    if (document.hidden || pollBusy) return;
    pollBusy = true;
    try {
      const res = await fetch('/app/api/pulse/', { credentials: 'same-origin', cache: 'no-store' });
      if (res.ok) {
        const out = await res.json();
        const at = out?.at ? String(out.at) : null;
        if (last !== null && at !== null && at !== last) await refresh();
        if (at !== null) last = at;
      }
    } catch { /* the next tick tries again */ }
    pollBusy = false;
  };
  let lastTouch = Date.now();
  let timer: number | undefined;
  let polling = false;
  const classNow = () => (plan ? inClass(plan, new Date(), plan.timezone) : false);
  const delay = () => (plan ? fallbackDelay(plan, Date.now() - lastTouch, classNow()) : (Date.now() - lastTouch < 15 * 60 * 1000 ? 30000 : null));
  const loop = async () => {
    if (!polling) return;
    const d = delay();
    if (d === null) { timer = undefined; return; }
    await tick();
    if (polling) timer = window.setTimeout(loop, d);
  };
  const startPolling = () => { if (polling) return; polling = true; last = null; loop(); };
  const stopPolling = () => { polling = false; window.clearTimeout(timer); timer = undefined; };
  const touch = () => { lastTouch = Date.now(); if (polling && timer === undefined) loop(); };
  for (const ev of ['keydown', 'pointerdown', 'pointermove', 'scroll', 'focus']) window.addEventListener(ev, touch, { passive: true });
  document.addEventListener('visibilitychange', () => { if (!document.hidden) { touch(); if (polling) tick(); } });

  /* ── The strip, and the report ──────────────────────────────────────── */
  const strip = document.createElement('div');
  strip.className = 'live-strip';
  strip.hidden = true;
  strip.setAttribute('role', 'status');
  document.body.appendChild(strip);
  const report = (state: 'fallback' | 'recovered', detail: string) => {
    try {
      fetch('/app/api/live-incident/', { method: 'POST', credentials: 'same-origin', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ state, page: location.pathname, detail }) }).catch(() => {});
    } catch {}
  };
  /* Reported only when it lasts (2.9): a fallback that the socket
     recovers from inside ninety seconds is a lid closing or a token
     refreshing, and the strip has already said what to expect. One that
     is still in fallback after that is a network worth a mail, and the
     recovery mail says how long it was. */
  const REPORT_AFTER = 90_000;
  let reportTimer: number | undefined;
  let reported = false;
  let fellAt = 0;
  onHealth((h: Health, detail: string) => {
    if (h === 'fallback' || h === 'off') {
      const enabled = plan?.fallback?.enabled !== false;
      if (enabled) startPolling();
      const every = classNow() ? `every ${plan?.fallback?.inClass ?? 60} seconds while you work` : 'once an hour outside class';
      strip.textContent = enabled
        ? `Live updates are on the backup path (checking ${every}). Your work still saves as you type.`
        : 'Live updates are off on this network; reload the page to see new replies. Your work still saves as you type.';
      strip.hidden = false;
      if (h === 'fallback' && reportTimer === undefined && !reported) {
        fellAt = Date.now();
        reportTimer = window.setTimeout(() => { reportTimer = undefined; if (health() !== 'live') { reported = true; report('fallback', `${detail} · still on the backup path after ${Math.round(REPORT_AFTER / 1000)} seconds`); } }, REPORT_AFTER);
      }
    } else if (h === 'live') {
      stopPolling();
      strip.hidden = true;
      window.clearTimeout(reportTimer); reportTimer = undefined;
      if (reported) { reported = false; report('recovered', `after ${Math.round((Date.now() - fellAt) / 1000)} seconds`); }
    }
    /* `starting`: nothing yet; the deadline decides. */
  });
</script>


<style>
  .appnav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 18px;
    border-bottom: 1px solid var(--rule-fine);
    padding-bottom: 12px;
    /* Off the gold rule above by a step, and the page's first thing close
       under it (2.9): the tabs had touched the masthead and stood a wide
       gap above the plate. */
    margin: 16px 0 14px;
  }
  .appnav ul {
    display: flex;
    /* Wraps when a narrow laptop window holds more tabs than fit; on a
       phone the strip below scrolls instead. */
    flex-wrap: wrap;
    gap: 8px 18px;
    list-style: none;
    margin: 0;
    padding: 0;
    margin-right: auto;
  }
  /* Tabs that look like tabs (2.9): the brand's colour in a bold face,
     each a button-shaped block, the current one filled. Before this the
     labels were the quiet grey of a caption and read as a heading, not a
     menu. */
  .appnav a {
    font-family: var(--face-ui);
    font-size: 0.88rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--brand);
    padding: 7px 12px;
    border: 1.5px solid var(--brand);
    border-radius: 3px;
    line-height: 1;
    transition: background-color 120ms ease, color 120ms ease;
  }
  .appnav a:hover,
  .appnav a:focus-visible {
    background: var(--accent-pale);
    color: var(--brand-deep);
    border-color: var(--brand-deep);
  }
  .appnav a[aria-current='page'] {
    background: var(--brand);
    color: var(--card);
    border-color: var(--brand);
  }

  /* ── ON A PHONE (2.8) ──────────────────────────────────────────
     A tab bar does not wrap: an uppercase, letter-spaced label broken
     across two lines reads as two tabs, and the last one was cut off.
     Below the one-line width the bar is a strip that scrolls sideways
     under the thumb, each label whole, the current one scrolled into view
     on load (the script below), with a fade at the right edge that says
     there is more. The scrollbar is hidden; the strip is the affordance. */
  @media (max-width: 720px) {
    .appnav {
      overflow-x: auto;
      overflow-y: hidden;
      flex-wrap: nowrap;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      scroll-snap-type: x proximity;
      /* The current tab, scrolled into view on load, lands after the
         page's padding rather than under the fade at the edge (2.9). */
      scroll-padding-inline: var(--shell-pad);
      margin-bottom: 18px;
      /* Full-bleed to the screen's edges, so the strip scrolls from edge
         to edge rather than inside the page's padding. */
      margin-inline: calc(-1 * var(--shell-pad));
      padding-inline: var(--shell-pad);
      -webkit-mask-image: linear-gradient(to right, transparent 0, var(--ink) var(--shell-pad), var(--ink) calc(100% - 28px), transparent 100%);
      mask-image: linear-gradient(to right, transparent 0, var(--ink) var(--shell-pad), var(--ink) calc(100% - 28px), transparent 100%);
    }
    .appnav::-webkit-scrollbar { display: none; }
    .appnav ul { flex-wrap: nowrap; gap: 20px; }
    .appnav li { scroll-snap-align: start; }
    .appnav a { white-space: nowrap; display: inline-block; padding: 7px 12px; }
  }
</style>

<script>
  /* The current tab into view on a phone, where the bar scrolls. */
  const cur = document.querySelector<HTMLElement>('.appnav a[aria-current="page"]');
  const bar = cur?.closest<HTMLElement>('.appnav');
  if (cur && bar && bar.scrollWidth > bar.clientWidth) {
    bar.scrollLeft = Math.max(0, cur.offsetLeft - 16);
  }
</script>
