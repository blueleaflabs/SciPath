---
import type { Org } from '../config/orgs';

interface Props {
  org: Org;
  account: any;
  here: string;
  roles?: { role: string }[];
}

const { org, account, here, roles = [] } = Astro.props;

import { standing } from '../lib/roles';

const me = standing(roles, account?.population);

/* Editor is a standing fact about a person, unlike reviewing, which is an
   attachment to one submission and therefore never appears here. */
const isEditor = me.isEditor;

/* Profile and sign out live in the masthead, top right, where an account
   menu belongs. This bar is for the work. */
const nav = [
  { href: '/app/', label: 'Overview' },
  ...(isEditor ? [{ href: '/app/editorial/', label: 'Editorial' }] : []),
  ...(isEditor ? [{ href: '/app/publish/', label: 'Publishing' }] : []),
  ...(me.runsTheClub ? [{ href: '/app/assign/', label: 'Assign' }] : []),
  ...(me.isAdvisor ? [{ href: '/app/selection/', label: 'Selection' }] : []),
  ...(me.isAdvisor ? [{ href: '/app/roles/', label: 'Roles' }] : []),
  { href: '/app/fairs/', label: 'Entries' },
];
---

<nav class="appnav" aria-label="Working surface">
  <ul>
    {nav.map((n) => (
      <li>
        <a href={n.href} aria-current={here === n.href ? 'page' : undefined}>{n.label}</a>
      </li>
    ))}
  </ul>
</nav>


<style>
  .appnav {
    display: flex;
    align-items: center;
    gap: 18px;
    border-bottom: 1px solid var(--rule-fine);
    padding-bottom: 10px;
    margin-bottom: 26px;
  }
  .appnav ul {
    display: flex;
    gap: 18px;
    list-style: none;
    margin: 0;
    padding: 0;
    margin-right: auto;
  }
  .appnav a {
    font-family: var(--face-ui);
    font-size: 0.88rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--ink-3);
  }
  .appnav a[aria-current='page'] {
    color: var(--ink);
    box-shadow: inset 0 -2px 0 var(--brand-mark);
  }
  .linkish {
    background: none;
    border: 0;
    padding: 0;
    cursor: pointer;
    font-family: var(--face-ui);
    font-size: 0.88rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--ink-3);
  }
</style>
