---
import { disciplineLabel } from '../config/site';
import type { RecordEntry } from '../lib/records-store';

interface Props {
  record: RecordEntry;
}

const { record: d } = Astro.props;
const space = d.recordKind === 'project' ? 'projects' : 'articles';
const href = `/${space}/${d.year}/${d.slug}/`;

/* Every listing carries its full abstract at reading size. No truncation and
   no "read more": a visitor is reading science within three seconds, and the
   page makes no claim about quality it cannot support. */
const awards = d.entries.flatMap((e) => e.awards);
const seq = d.recordId.split('-').pop();
---

<article class="record s-pub">
  <div class="record-top">
    <div class="record-no">{seq}<small>Record</small></div>
    <div class="record-main">
      <h3><a href={href}>{d.title}</a></h3>
      <p class="by">
        {d.authors.map((a, i) => (
          <>
            {i > 0 && ', '}
            {a.authorSlug ? <a href={`/authors/${a.authorSlug}/`}>{a.displayName}</a> : a.displayName}
          </>
        ))}
      </p>
    </div>
    <span class="chip pub">
      <span class="dot"></span>
      {d.recordKind === 'project' ? 'Project' : 'Published'}
    </span>
  </div>

  {d.abstract && <p class="abs">{d.abstract}</p>}

  <p class="meta">
    <a href={`/topics/${d.discipline}/`}>{disciplineLabel(d.discipline)}</a>
    <span>·</span>
    <span>{d.publishedOn.slice(0, 7)}</span>
    {d.entries.map((e) => (
      <>
        <span>·</span>
        <span>{e.program}{e.season ? ` ${e.season}` : ''}{e.placement ? `, ${e.placement}` : ''}</span>
      </>
    ))}
    {awards.map((a) => (<><span>·</span><span>{a}</span></>))}
  </p>
</article>

<style>
  .record { padding: 24px 0; border-bottom: 1px solid var(--rule-fine); }
  .record-top { display: flex; gap: 18px; align-items: baseline; }
  .record-no {
    font-family: var(--face-num);
    font-size: 1.3rem;
    color: var(--ink-3);
    min-width: 4.5rem;
  }
  .record-no small { display: block; font-size: 0.68rem; letter-spacing: 0.08em; text-transform: uppercase; }
  .record-main { flex: 1; }
  .record-main h3 { margin: 0; font-size: 1.35rem; line-height: 1.25; }
  .by { margin: 5px 0 0; color: var(--ink-2); }
  .abs { margin: 14px 0 0 5.9rem; max-width: var(--measure-text); line-height: 1.6; }
  .meta {
    margin: 12px 0 0 5.9rem;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    font-size: 0.88rem;
    color: var(--ink-3);
  }
  @media (max-width: 640px) {
    .record-top { flex-wrap: wrap; }
    .abs, .meta { margin-left: 0; }
  }
</style>
