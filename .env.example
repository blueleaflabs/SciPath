# Which organization record this deployment renders. See src/config/orgs.ts.
PUBLIC_ORG=montavista

# The working surface only. The public archive must build with these absent,
# and CI proves it on every push.
# PUBLIC_SUPABASE_URL=
# PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server side only, never in a client bundle. Bypasses row level security.
# SUPABASE_SECRET_KEY=

# Local stack only. The hosted project holds these in its own dashboard.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
