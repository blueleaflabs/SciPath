{
  "name": "scipath",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/index-search.mjs",
    "build:public-only": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "test:contrast": "node tests/contrast.mjs",
    "test:static": "node tests/no-db-in-static.mjs",
    "test": "npm run test:dates && npm run test:structure && npm run test:workflow && npm run test:roster && npm run test:publish && npm run test:pdftext && npm run test:search && npm run test:devvars && npm run test:drift && npm run test:props && npm run test:policy && npm run test:sqlcols && npm run test:embeds && npm run test:contrast && npm run test:static && npm run test:tokens && npm run test:config && npm run test:tenant && npm run test:routes",
    "test:tokens": "node tests/tokens-only.mjs",
    "test:config": "node tests/config-secrets.mjs",
    "seed:demo": "node scripts/seed-demo.mjs",
    "test:tenant": "node tests/tenant-resolution.mjs",
    "test:routes": "node --experimental-strip-types tests/tenant-routes.mjs",
    "test:output": "node tests/tenant-output.mjs",
    "verify": "npm run build && npm test && npm run test:output",
    "test:dates": "node --experimental-strip-types tests/date-order.mjs",
    "test:drift": "node tests/schema-drift.mjs",
    "reset:storage": "node scripts/reset-storage.mjs",
    "reset": "npx supabase db reset && node scripts/reset-storage.mjs && node scripts/seed-demo.mjs && node scripts/seed-scenarios.mjs",
    "seed:scenarios": "node scripts/seed-scenarios.mjs",
    "test:props": "node tests/dead-props.mjs",
    "test:structure": "node --experimental-strip-types tests/structure.mjs",
    "test:policy": "node tests/policy-scope.mjs",
    "test:workflow": "node --experimental-strip-types tests/workflow.mjs",
    "test:sqlcols": "node tests/sql-columns.mjs",
    "test:embeds": "node tests/embeds.mjs",
    "test:roster": "node --experimental-strip-types tests/roster.mjs",
    "test:devvars": "node tests/dev-vars.mjs",
    "test:publish": "node --experimental-strip-types tests/publish.mjs",
    "test:search": "node tests/search-scope.mjs",
    "test:pdftext": "node --experimental-strip-types tests/pdf-text.mjs"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^12.6.0",
    "@astrojs/rss": "^4.0.11",
    "@astrojs/sitemap": "^3.4.0",
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.58.0",
    "astro": "^5.12.0",
    "js-yaml": "^4.1.0",
    "marked": "^18.0.7"
  },
  "devDependencies": {
    "pagefind": "^1.3.0",
    "supabase": "^2.111.0"
  }
}
