# Custom
supabase/seed/local/
.dev.vars

# Dependencies and build output
node_modules/
dist/
.astro/
.output/
.vercel/
.netlify/

# Cloudflare and Wrangler
.wrangler/
# Holds the Supabase service_role key, which bypasses row level security.
# This is the most likely accidental commit in this project and it is not
# covered by any standard Node template.
.dev.vars
.dev.vars.*

# Environment
.env
.env.*
!.env.example

# The specification, the policy drafts, and the migration inventory.
# This repository is public. The policy drafts are unreviewed, and the
# migration inventory names identifiable students alongside flags recording
# human subjects work. Publishing either would be a real disclosure.
prd/

# Dumps, sample exports, and any working file with real names in it.
# Named this rather than test/ so the test namespace stays clean: ignoring
# a directory called test silently breaks CI the day someone adds a spec.
local-data/

# Editor and OS
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Logs
*.log
npm-debug.log*
build.log

# Deliberately committed, stated so a blanket ignore never eats them:
#   supabase/migrations/   the schema, which is the system of record
#   supabase/config.toml
#   supabase/seed.sql
#   public/pdf/            the archive itself
#   src/content/           published records and guides
#   tests/                 automated tests and fixtures
