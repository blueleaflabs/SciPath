# ── Dependencies ────────────────────────────────────────
node_modules/
.pnp/
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/releases
!.yarn/plugins
!.yarn/versions

# ── Build output ────────────────────────────────────────
dist/
.astro/
.output/
.cache/

# Pagefind writes its index into dist/ at build, so it is
# already covered. If the config ever changes, add it here.

# ── Secrets ─────────────────────────────────────────────
# Nothing below this line may ever be committed.
.env
.env.*
!.env.example

# Wrangler local secrets. This is the one people forget,
# and it holds the Supabase service_role key.
.dev.vars
.dev.vars.*

# ── Cloudflare ──────────────────────────────────────────
.wrangler/
wrangler.toml.bak

# ── Supabase ────────────────────────────────────────────
# NOTE: supabase/migrations/, supabase/seed.sql, and
# supabase/config.toml MUST be committed. Schema lives in
# migration files, never in the dashboard. See brief 12.4.
supabase/.temp/
supabase/.branches/

# ── Editors and OS ──────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
*.swp
*.swo
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# ── Logs and diagnostics ────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
build.log
coverage/

# ── Design docs, never pushed ───────────────────────────
# Working specification, briefs, policy drafts, and the
# migration inventory. Kept out of a PUBLIC repo because
# they contain unreviewed legal drafts and notes about
# identifiable students. See brief 12.5a.
/prd/

# ── Local data and scratch, never pushed ────────────────
# Dumps, sample exports, anything with real names in it,
# and general working scratch. Deliberately NOT called
# "test", so that automated tests keep a clean namespace.
/local-data/
/tmp/
*.local

# ── Deliberately NOT ignored ────────────────────────────
# /tests/ — automated tests and their fixtures. Committed,
#   because CI has to be able to run them.
# public/pdf/*.pdf  — article PDFs are the archive and are
#   committed. Do not add a blanket *.pdf rule.
# supabase/migrations/ — see above.
# src/content/ — article markdown is the product.
