{
  // Cloudflare bindings. Read by the Astro adapter's platform proxy in dev,
  // so the same code path runs locally and in production: a dev path that
  // differs from production is where the surprises live.
  "name": "scipath",
  "compatibility_date": "2026-05-01",
  "compatibility_flags": ["nodejs_compat"],

  // THE CLOCK.
  //
  // Cloudflare calls the Worker's `scheduled` export on this schedule.
  // `src/worker.js` is what receives it and drains the notification outbox.
  //
  // Every fifteen minutes, for the pilot. It sat at midnight on the first
  // of January until the nudge loop was closed (design brief 2.2): a nudge
  // and its reply are worth most in the hour they are written, and a
  // message queued for a drain that never runs is the same as no message.
  // The send window in `drain.ts` is an hour, so a schedule sparser than
  // that would skip messages as stale rather than send them late;
  // tests/scripts.mjs checks the two against each other. What actually
  // goes out is still decided by MAIL_TRANSPORT and MAIL_ALLOWLIST in the
  // deployment's variables.
  //
  "triggers": {
    "crons": ["*/15 * * * *"]
  },

  "r2_buckets": [
    {
      // Notebook photographs and signed forms. Private: no public URL, no
      // custom domain. Every read goes through /app/media/, which checks
      // project membership first.
      "binding": "NOTEBOOK",
      "bucket_name": "scipath-notebook",
      "preview_bucket_name": "scipath-notebook-preview"
    }
  ]
}
